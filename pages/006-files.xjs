<?xjs
    var _files = listFiles(_dir);
    _files.forEach(function(file) {
        var ext = fileExt(file.name);
        var vtype = viewableType(ext);
        var dlUrl = './api/files.ssjs?call=download-file&dir=' + encodeURIComponent(_dir) + '&file=' + encodeURIComponent(file.name);
        var viewUrl = './api/files.ssjs?call=view-file&dir=' + encodeURIComponent(_dir) + '&file=' + encodeURIComponent(file.name);
?>
    <div class="files-item" data-name="<? write(escHtml(file.name)); ?>"
         data-size="<? write(file._size); ?>"
         data-date="<? write(file.uldate); ?>">
        <div class="files-item-header">
            <span class="files-item-name"><? write(escHtml(file.name)); ?></span>
            <div class="files-item-meta">
                <span class="files-item-size"><? write(file.size); ?></span>
                <span class="files-item-date"><? write(system.timestr(file.uldate)); ?></span>
            </div>
        </div>
        <?xjs if (file.desc || file.extdesc) { ?>
        <div class="files-item-desc">
            <?xjs if (typeof file.extdesc !== 'undefined') { ?>
                <?xjs if (file.extdesc.search(/(\x1B\[|[\xA8-\xFE])|\x01/) > -1) { ?>
                    <pre class="ansi"><? write(html_encode(file.extdesc, true, false, true, true)); ?></pre>
                <?xjs } else { ?>
                    <pre><? write(escHtml(file.extdesc)); ?></pre>
                <?xjs } ?>
            <?xjs } else if (file.desc) { ?>
                <? write(escHtml(file.desc)); ?>
            <?xjs } ?>
        </div>
        <?xjs } ?>
        <div class="files-item-actions">
            <?xjs if (vtype) { ?>
            <button class="files-btn files-btn-view" onclick="viewFile(this, '<? write(escHtml(vtype)); ?>', '<? write(escHtml(viewUrl)); ?>')">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="3"/><path d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5z"/></svg>
                View
            </button>
            <?xjs } ?>
            <a class="files-btn files-btn-dl" href="<? write(escHtml(dlUrl)); ?>" target="_blank">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 2v9m0 0l-3-3m3 3l3-3M3 13h10"/></svg>
                Download
            </a>
        </div>
    </div>
<?xjs }); ?>
</div>
