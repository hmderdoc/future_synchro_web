<!--Files-->

<?xjs
    var request = require({}, settings.web_lib + 'request.js', 'request');
    load(settings.web_lib + 'files.js');
    locale.section = 'page_files';

    /* ── Helpers ── */
    function escHtml(s) {
        return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;')
            .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function fileExt(name) {
        var m = String(name||'').match(/\.([^.]+)$/);
        return m ? m[1].toLowerCase() : '';
    }
    function viewableType(ext) {
        var images = ['png','jpg','jpeg','gif','bmp','svg','webp','ico'];
        var text   = ['txt','log','nfo','diz','asc','cfg','ini','md','csv','json','js','c','h','py','sh','bat'];
        var ansi   = ['ans'];
        var audio  = ['mp3','wav','ogg','flac','m4a'];
        if (images.indexOf(ext) >= 0) return 'image';
        if (text.indexOf(ext) >= 0)   return 'text';
        if (ansi.indexOf(ext) >= 0)   return 'ansi';
        if (audio.indexOf(ext) >= 0)  return 'audio';
        return '';
    }
?>

<style>
/* ── Files page styles ── */
.files-breadcrumb {
    margin: 0 0 0.4rem;
    padding: 0.65rem 1rem !important;
    border-radius: 8px !important;
}
.files-breadcrumb li,
.files-breadcrumb li a {
    display: inline-flex;
    align-items: center;
}

/* Library cards on root view */
.files-lib-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
}
.files-lib-card {
    background: #000;
    border: 1px solid var(--cga-bright-cyan, #55FFFF);
    border-radius: 0.375rem;
    padding: 0.85rem 1rem;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
    text-decoration: none !important;
    display: block;
}
.files-lib-card:hover {
    border-color: var(--cga-bright-cyan, #55FFFF);
    box-shadow: 0 0 8px rgba(85, 255, 255, 0.25);
}
.files-lib-name {
    font-weight: bold;
    font-size: 1.05rem;
    color: var(--cga-bright-cyan, #55FFFF);
    margin: 0;
}
.files-lib-desc {
    color: var(--cga-light-gray, #AAAAAA);
    font-size: 0.85rem;
    margin: 0.2rem 0 0;
}

/* Directory cards */
.files-dir-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
}
.files-dir-card {
    background: #000;
    border: 1px solid var(--cga-light-gray, #AAAAAA);
    border-radius: 0.375rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
    text-decoration: none !important;
    display: block;
}
.files-dir-card:hover {
    border-color: var(--cga-bright-green, #55FF55);
    box-shadow: 0 0 6px rgba(85, 255, 85, 0.2);
}
.files-dir-name {
    font-weight: bold;
    color: var(--cga-bright-green, #55FF55);
    margin: 0;
}
.files-dir-desc {
    color: var(--cga-light-gray, #AAAAAA);
    font-size: 0.85rem;
    margin: 0.15rem 0 0;
}
.files-dir-count {
    color: var(--cga-bright-magenta, #FF55FF);
    font-size: 0.8rem;
}

/* File list */
.files-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}
.files-item {
    background: #000;
    border: 1px solid #333;
    border-radius: 0.375rem;
    padding: 0.65rem 0.85rem;
    transition: border-color 0.15s;
}
.files-item:hover {
    border-color: #555;
}
.files-item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
}
.files-item-name {
    font-weight: bold;
    color: var(--cga-yellow, #FFFF55);
    font-size: 0.95rem;
    word-break: break-all;
}
.files-item-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
}
.files-item-size {
    color: var(--cga-bright-cyan, #55FFFF);
    font-size: 0.8rem;
    white-space: nowrap;
}
.files-item-date {
    color: var(--cga-light-gray, #AAAAAA);
    font-size: 0.8rem;
    white-space: nowrap;
}
.files-item-desc {
    color: #ccc;
    font-size: 0.85rem;
    margin-top: 0.3rem;
}
.files-item-desc pre {
    margin: 0.3rem 0 0;
    font-size: 0.82rem;
    white-space: pre-wrap;
    background: transparent;
    border: none;
    padding: 0;
    color: #ccc;
}
.files-item-actions {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.45rem;
}
.files-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    border: 1px solid #555;
    border-radius: 3px;
    background: #111;
    color: #ccc;
    font-size: 0.8rem;
    cursor: pointer;
    text-decoration: none !important;
    transition: background 0.15s, border-color 0.15s;
}
.files-btn:hover {
    background: #222;
    border-color: #888;
    color: #fff;
}
.files-btn-view {
    border-color: var(--cga-bright-green, #55FF55);
    color: var(--cga-bright-green, #55FF55);
}
.files-btn-view:hover {
    background: rgba(85, 255, 85, 0.1);
    color: var(--cga-bright-green, #55FF55);
}
.files-btn-dl {
    border-color: var(--cga-bright-cyan, #55FFFF);
    color: var(--cga-bright-cyan, #55FFFF);
}
.files-btn-dl:hover {
    background: rgba(85, 255, 255, 0.1);
    color: var(--cga-bright-cyan, #55FFFF);
}
.files-btn svg {
    width: 14px;
    height: 14px;
}

/* Sort controls */
.files-sort-bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.5rem;
}

/* Preview panel */
.files-preview {
    margin-top: 0.5rem;
    border: 1px solid #333;
    border-radius: 0.375rem;
    overflow: hidden;
    background: #0a0a0a;
}
.files-preview-close {
    float: right;
    background: none;
    border: none;
    color: #FF5555;
    cursor: pointer;
    font-size: 1.1rem;
    padding: 4px 8px;
    line-height: 1;
}
.files-preview-close:hover {
    color: #FF8888;
}
.files-preview img {
    max-width: 100%;
    height: auto;
    display: block;
    image-rendering: auto;
}
.files-preview pre {
    margin: 0;
    padding: 0.75rem;
    max-height: 400px;
    overflow: auto;
    white-space: pre-wrap;
    font-size: 0.82rem;
    color: #ccc;
    background: transparent;
    border: none;
}
.files-preview .ansi-wrap {
    padding: 10px;
    overflow: auto;
}
.files-preview .ansi-wrap pre.ansi {
    margin: 0;
    display: inline-block;
    white-space: pre;
    font-family: 'Courier New', 'Courier', monospace;
    font-size: 13px;
    line-height: 1.2;
    background: #000;
}
.files-preview audio {
    width: 100%;
    display: block;
}
.files-preview-loading {
    padding: 1.5rem;
    text-align: center;
    color: #AAAAAA;
}

@media (max-width: 600px) {
    .files-item-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.3rem;
    }
    .files-item-actions {
        flex-wrap: wrap;
    }
}
</style>

