<script>
(function () {
    /* ── Sort ── */
    window.fileSort = function (field, asc) {
        var list = document.getElementById('files-list');
        if (!list) return;
        var items = Array.from(list.querySelectorAll('.files-item'));
        items.sort(function (a, b) {
            var va = a.getAttribute('data-' + field) || '';
            var vb = b.getAttribute('data-' + field) || '';
            if (field === 'size' || field === 'date') { va = Number(va); vb = Number(vb); }
            if (va < vb) return asc ? -1 : 1;
            if (va > vb) return asc ? 1 : -1;
            return 0;
        });
        items.forEach(function (el) { list.appendChild(el); });
    };

    /* ── Preview / View ── */
    window.viewFile = function (btn, type, url) {
        var item = btn.closest('.files-item');
        if (!item) return;
        var existing = item.querySelector('.files-preview');
        if (existing) { existing.remove(); return; }    /* toggle off */

        var panel = document.createElement('div');
        panel.className = 'files-preview';

        var closeBtn = '<button class="files-preview-close" onclick="this.parentNode.remove()" title="Close">&times;</button>';

        if (type === 'image') {
            panel.innerHTML = closeBtn + '<img src="' + url + '" alt="preview" loading="lazy">';
        } else if (type === 'audio') {
            panel.innerHTML = closeBtn + '<div class="files-preview-loading">Loading…</div>';
            fetch(url).then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.blob();
            }).then(function (blob) {
                var blobUrl = URL.createObjectURL(blob);
                var aud = document.createElement('audio');
                aud.controls = true;
                aud.preload = 'auto';
                aud.src = blobUrl;
                aud.addEventListener('ended', function () { URL.revokeObjectURL(blobUrl); });
                var loading = panel.querySelector('.files-preview-loading');
                if (loading) loading.replaceWith(aud);
            }).catch(function (err) {
                var loading = panel.querySelector('.files-preview-loading');
                if (loading) loading.textContent = 'Failed to load audio: ' + err.message;
            });
        } else if (type === 'text') {
            panel.innerHTML = closeBtn + '<div class="files-preview-loading">Loading…</div>';
            fetch(url).then(function (r) { return r.text(); }).then(function (txt) {
                var pre = document.createElement('pre');
                pre.textContent = txt;
                panel.querySelector('.files-preview-loading').replaceWith(pre);
            }).catch(function () {
                panel.querySelector('.files-preview-loading').textContent = 'Failed to load file.';
            });
        } else if (type === 'ansi') {
            panel.innerHTML = closeBtn + '<div class="files-preview-loading">Loading…</div>';
            fetch(url).then(function (r) { return r.text(); }).then(function (html) {
                var wrap = document.createElement('div');
                wrap.className = 'ansi-wrap';
                wrap.innerHTML = '<pre class="ansi">' + html + '</pre>';
                panel.querySelector('.files-preview-loading').replaceWith(wrap);
            }).catch(function () {
                panel.querySelector('.files-preview-loading').textContent = 'Failed to load ANSI.';
            });
        }

        item.appendChild(panel);
    };
})();
</script>
