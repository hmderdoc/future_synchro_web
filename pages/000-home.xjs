}
.ahv-count {
    color: #55FFFF;
    font-size: 0.8em;
    white-space: nowrap;
}
.ahv-file {
    color: #FF55FF;
    font-size: 0.8em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.ahv-nav {
    display: flex;
    align-items: center;
    gap: 6px;
}
.ahv-nav button {
    background: transparent;
    border: 1px solid #AAAAAA;
    color: #FFFF55;
    font-family: monospace;
    font-size: 14px;
