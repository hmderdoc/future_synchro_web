<?xjs
    require('sbbsdefs.js', 'SYS_CLOSED');
    var ansi_viewer = load({}, settings.web_lib + 'ansi-viewer.js');

    var _bltn_subcode = 'LOCAL-NOTICES';
    var _bltn_max = 10;
    var _bltn_body_maxlen = 600;
    var _ansi_state = ansi_viewer.build_state({ mode: 'random' });
    var _ansi_state_client = {
        ok: _ansi_state.ok,
        galleries: _ansi_state.galleries,
        gallery: _ansi_state.gallery,
        directories: _ansi_state.directories,
        current_dir: _ansi_state.current_dir,
        current_dir_label: _ansi_state.current_dir_label,
        files: _ansi_state.files,
        current_file: _ansi_state.current_file,
        current_file_label: _ansi_state.current_file_label,
        current_index: _ansi_state.current_index,
        current_count: _ansi_state.current_count,
        render_html: '',
        error: _ansi_state.error,
        status_text: _ansi_state.status_text
    };
    var _ansi_state_json = JSON.stringify(_ansi_state_client).replace(/<\//g, '<\\/');

    function _homeEsc(value) {
        return ansi_viewer.escape_html(value);
    }

    var _bltn_msgs = [];
    var _bltn_mb = new MsgBase(_bltn_subcode);
    if (_bltn_mb.open()) {
        var _bltn_count = 0;
        for (var _bm = _bltn_mb.last_msg; _bm >= _bltn_mb.first_msg && _bltn_count < _bltn_max; _bm--) {
            var _bh = _bltn_mb.get_msg_header(_bm);
            if (_bh === null || (_bh.attr & MSG_DELETE))
                continue;
            var _bb = _bltn_mb.get_msg_body(_bm) || '';
            _bb = _bb.replace(/\x01./g, '').replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim();
            if (_bb.length > _bltn_body_maxlen)
                _bb = _bb.substring(0, _bltn_body_maxlen) + '...';
            _bltn_msgs.push({
                subject: _bh.subject.replace(/</g, '&lt;'),
                date: system.timestr(_bh.when_written_time),
                body: _bb.replace(/</g, '&lt;')
            });
            _bltn_count++;
        }
        _bltn_mb.close();
    }

    /* Fetch AI co-writer names + avatar data for Futureland performers */
    var _cowriters = [];
    try {
        var _cw_sub = 'local-aidefinitions';
        if (msg_area.sub[_cw_sub]) {
            var _cw_mb = new MsgBase(_cw_sub);
            if (_cw_mb.open()) {
                var _cw_hdrs = _cw_mb.get_all_msg_headers(true);
                if (_cw_hdrs) {
                    var _cw_origins = {};
                    var _cw_order = [];
                    for (var _ch in _cw_hdrs) {
                        if (_cw_hdrs[_ch] === null) continue;
                        if (_cw_hdrs[_ch].attr & MSG_DELETE) continue;
                        var _cw_tid = _cw_hdrs[_ch].thread_id;
                        if (!_cw_origins[_cw_tid]) {
                            _cw_origins[_cw_tid] = _cw_hdrs[_ch];
                            _cw_order.push(_cw_tid);
                        }
                    }
                    for (var _ci = 0; _ci < _cw_order.length; _ci++) {
                        var _cw_hdr = _cw_origins[_cw_order[_ci]];
                        var _cw_name = _cw_hdr.subject.replace(/^re:\s*/ig, '').trim();
                        if (!_cw_name) continue;
                        var _cw_avatar = '';
                        try {
                            var _cw_body = _cw_mb.get_msg_body(_cw_hdr.number) || '';
                            var _m1 = _cw_body.indexOf('avatar_data_begin');
                            var _m2 = _cw_body.indexOf('avatar_data_end');
                            if (_m1 >= 0 && _m2 > _m1) {
                                _cw_avatar = _cw_body.substring(_m1 + 17, _m2).replace(/[\r\n\s]/g, '');
                            }
                        } catch (_ce) {}
                        _cowriters.push({ name: _cw_name, avatar: _cw_avatar });
                    }
                }
                _cw_mb.close();
            }
        }
    } catch (_cw_err) {}
    var _cowriters_json = JSON.stringify(_cowriters).replace(/<\//g, '<\\/');
?>

<!-- Welcome Banner -->
<div id="home-terminal-launch" class="card mb-3 overflow-hidden" style="border: 1px solid #AA00AA; cursor: pointer;" role="button" tabindex="0" aria-controls="terminal-panel" aria-label="Open terminal">
    <img src="./images/vektrax_banner.png" alt="<? write(system.name); ?>" class="img-fluid w-100" style="display:block;">
</div>

<script>
(function () {
    var launch = document.getElementById('home-terminal-launch');
    if (!launch) return;

    function toggleTerminal() {
        var btn = document.getElementById('btn-terminal');
        if (!btn) return;
        btn.click();
    }

    launch.addEventListener('click', toggleTerminal);
    launch.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        toggleTerminal();
    });
})();
</script>

<!-- ═══════════ Futureland Records ═══════════ -->
<style>
.flr-panel{--bs-card-border-color:#5555FF;--bs-card-bg:#000;--bs-card-cap-bg:#000;--bs-card-cap-color:#5555FF;border-color:#5555FF!important;background:#000!important;container-type:inline-size}
.flr-panel>.card-header{color:#5555FF!important;background:#000!important;border-bottom:2px solid #5555FF!important;display:flex;justify-content:space-between;align-items:center;gap:8px}
.flr-brand{display:inline-flex;align-items:center;gap:12px;font-weight:bold;white-space:nowrap;color:#5555FF}
.flr-brand-head{width:36px;height:36px;flex:0 0 auto;display:block;object-fit:contain;background:transparent;image-rendering:auto;filter:drop-shadow(0 0 8px rgba(85,255,85,.6))}
.flr-brand-label{display:inline-block;color:#5555FF;border-bottom:2px solid #55FFFF;padding-bottom:2px;line-height:1}
.flr-nav{display:flex;align-items:center;gap:6px}
.flr-nav button{background:transparent;border:1px solid #5555FF;color:#55FFFF;font-family:monospace;font-size:14px;line-height:1;padding:2px 8px;cursor:pointer;border-radius:2px}
.flr-nav button:hover{background:rgba(85,255,255,.12);border-color:#55FFFF;color:#55FFFF}
.flr-counter{color:#AAAAAA;font-size:.75em;font-weight:normal}
.flr-body{padding:clamp(16px,3vw,24px);display:grid;grid-template-columns:minmax(0,1fr);grid-template-areas:"art" "meta";gap:clamp(16px,3vw,22px);align-items:start;justify-items:center}
.flr-art-wrap{grid-area:art;width:min(100%,420px);aspect-ratio:1/1;background:#111;border:1px solid #333;border-radius:4px;overflow:hidden;display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative;transition:box-shadow .3s;justify-self:center}
.flr-art-wrap:hover{box-shadow:0 0 18px rgba(255,85,255,.4)}
.flr-art-wrap img{width:100%;height:100%;object-fit:cover}
.flr-art-wrap .flr-no-art{color:#555;font-size:3em}
.flr-play-badge{position:absolute;bottom:6px;right:6px;background:rgba(0,0,0,.72);color:#55FF55;font-size:1.3em;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .25s}
.flr-art-wrap:hover .flr-play-badge{opacity:1}
.flr-meta{grid-area:meta;min-width:0;width:min(100%,420px);display:flex;flex-direction:column;gap:12px;align-items:flex-start;justify-content:center}
.flr-title{color:#55FFFF;font-weight:bold;font-size:clamp(1.05rem,2.2cqi,1.55rem);line-height:1.08;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.flr-credits{display:flex;flex-wrap:wrap;align-items:baseline;gap:.34em;font-size:clamp(.92rem,1.65cqi,1.15rem);line-height:1.2}
.flr-artist-name{color:#55FF55}
.flr-credit-sep{color:#AAAAAA}
.flr-composer-name{color:#55FF55}
.flr-album-year{color:#FF5555}
.flr-detail{color:#AAAAAA;font-size:clamp(.8rem,1.25cqi,.92rem);line-height:1.35}
.flr-detail .flr-genre{color:#FFFF55}
.flr-performers{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end;margin:4px 0 2px}
.flr-performer{display:flex;flex-direction:column;align-items:center;gap:2px}
.flr-performer-avatar{width:60px;height:36px;image-rendering:pixelated;background:#111;border:1px solid #333;overflow:hidden;display:flex;align-items:center;justify-content:center}
.flr-performer-avatar img{display:block;width:100%;height:100%;image-rendering:pixelated;object-fit:contain}
.flr-performer-avatar:empty::after{content:'?';color:#555;font-size:1rem}
.flr-performer-name{font-size:.62rem;color:#55FF55;text-align:center;max-width:60px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.flr-performer-name.is-persona{color:#FF55FF}
.flr-play-btn{margin-top:auto;padding-top:10px}
.flr-play-btn button{background:transparent;border:1px solid #00AA00;color:#55FF55;font-family:monospace;font-size:.82em;padding:4px 14px;cursor:pointer;border-radius:2px;transition:background .2s,color .2s,border-color .2s}
.flr-play-btn button:hover{background:#00AA00;color:#000}
.flr-play-icon{color:#55FFFF}
.flr-play-btn button.flr-playing{border-color:#FF55FF;color:#FF55FF;cursor:default}
.flr-play-btn button.flr-playing:hover{background:transparent;color:#FF55FF}
.flr-loading{color:#AAAAAA;padding:32px 14px;text-align:center;width:100%}
.flr-empty{color:#AA5500;padding:32px 14px;text-align:center;width:100%}
@container (min-width:600px){
    .flr-body{grid-template-columns:minmax(260px,min(34cqi,360px)) minmax(300px,min(40cqi,420px));grid-template-areas:"meta art";gap:clamp(18px,2.4cqi,28px);align-items:center;justify-content:center;padding:clamp(18px,2.4cqi,28px)}
    .flr-art-wrap{width:min(40cqi,420px);justify-self:start}
    .flr-meta{width:min(34cqi,360px)}
    .flr-title{font-size:clamp(1.2rem,2.6cqi,1.85rem)}
    .flr-credits{font-size:clamp(1rem,1.8cqi,1.28rem)}
    .flr-detail{font-size:clamp(.84rem,1.2cqi,.96rem)}
}
@media(max-width:600px){
    .flr-art-wrap{width:min(82vw,280px)}
    .flr-meta{width:min(100%,320px)}
    .flr-title{white-space:normal}
}
</style>

<div class="card mb-3 flr-panel" id="flr-panel">
    <div class="card-header">
        <div class="flr-brand"><img src="./images/vektrax-head-anim.png" alt="" class="flr-brand-head"><span class="flr-brand-label">Futureland Records</span></div>
        <div class="flr-nav">
            <button id="flr-prev" title="Previous">&laquo;</button>
            <span class="flr-counter" id="flr-counter">&mdash;</span>
            <button id="flr-next" title="Next">&raquo;</button>
        </div>
    </div>
    <div id="flr-body" class="flr-body">
        <div class="flr-loading" id="flr-loading">Loading tracks&hellip;</div>
    </div>
</div>

<script>
(function () {
    'use strict';
    var API_URL     = './api/files.ssjs?call=list-files&dir=originalcontent_mp3s';
    var STREAM_URL  = './radio-stream/';
    var RANGE_BYTES = 262144;           // 256 KB for ID3 header
    var ROTATE_MS   = 8000;             // auto-advance every 8 s
    var panel       = document.getElementById('flr-panel');
    if (!panel || panel.dataset.bound === '1') return;
    panel.dataset.bound = '1';
    var PERSONA_LIST = [];
    try { PERSONA_LIST = <?xjs write(typeof _cowriters_json === 'string' ? _cowriters_json : '[]'); ?>; } catch(_e) {}

    var body    = document.getElementById('flr-body');
    var counter = document.getElementById('flr-counter');
    var prevBtn = document.getElementById('flr-prev');
    var nextBtn = document.getElementById('flr-next');
    var tracks  = [];   // [{name, tags, artURL}]
    var cur     = 0;
    var rotateTimer = null;
    var nowPlaying  = '';   // filename currently playing in radio

    // ── helpers ──
    function esc(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function mergeTrackTags(base, override) {
        var merged = {};
        var key;

        base = base || {};
        override = override || {};

        for (key in base) {
            if (!Object.prototype.hasOwnProperty.call(base, key)) continue;
            merged[key] = base[key];
        }
        for (key in override) {
            if (!Object.prototype.hasOwnProperty.call(override, key)) continue;
            if (override[key] === undefined || override[key] === null || override[key] === '') continue;
            merged[key] = override[key];
        }

        return merged;
    }

    // ── fetch track list then ID3 for each ──
    function init() {
        fetch(API_URL, { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (list) {
                if (!list || !list.length) {
                    body.innerHTML = '<div class="flr-empty">No tracks available.</div>';
                    return;
                }
                return parseAll(list);
            })
            .then(function () {
                if (tracks.length === 0) {
                    body.innerHTML = '<div class="flr-empty">No tracks with metadata found.</div>';
                    return;
                }
                // shuffle so every page load is different
                shuffle(tracks);
                render();
                startRotate();
            })
            .catch(function (err) {
                console.error('[flr] init error:', err);
                body.innerHTML = '<div class="flr-empty">Unable to load tracks.</div>';
            });
    }

    function shuffle(arr) {
        for (var i = arr.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
        }
    }

    function parseAll(list) {
        // parse ID3 for every track in parallel (limited concurrency)
        var promises = list.map(function (item) {
            var url = STREAM_URL + encodeURIComponent(item.name);
            return fetch(url, {
                headers: { Range: 'bytes=0-' + (RANGE_BYTES - 1) }
            })
            .then(function (r) { return r.arrayBuffer(); })
            .then(function (buf) {
                if (typeof window.parseID3v2 !== 'function') return null;
                var tags = mergeTrackTags(window.parseID3v2(buf), item && item.tags ? item.tags : {});
                // require at least artist or picture
                if (!tags.artist && !tags.picture) return null;
                var artURL = '';
                if (tags.picture && tags.picture.blob) {
                    artURL = URL.createObjectURL(tags.picture.blob);
                }
                tracks.push({
                    name: item.name,
                    tags: tags,
                    artURL: artURL
                });
            })
            .catch(function () { /* skip unreadable files */ });
        });
        return Promise.all(promises);
    }

    // ── performer helpers ──
    function parsePerformers(artistStr) {
        if (!artistStr) return [];
        var parts = artistStr.split(/\s*(?:feat\.?|ft\.?|&|,|\band\b)\s*/i)
            .map(function (s) { return s.trim(); })
            .filter(Boolean);
        if (parts.length === 0) return [];
        return parts.map(function (name, idx) {
            var isPersona = parts.length === 3 && idx === 1;
            return { name: name, persona: isPersona };
        });
    }
    function findPersonaAvatar(name) {
        for (var i = 0; i < PERSONA_LIST.length; i++) {
            if (PERSONA_LIST[i].name.toLowerCase() === name.toLowerCase()) {
                return PERSONA_LIST[i].avatar || '';
            }
        }
        return '';
    }

    // ── rendering ──
    function render() {
        if (!tracks.length) return;
        var t = tracks[cur];
        var tags = t.tags;
        counter.textContent = (cur + 1) + ' / ' + tracks.length;

        var isPlaying = (nowPlaying === t.name);

        var html = '';
        // album art
        html += '<div class="flr-art-wrap" data-flr-play="' + esc(t.name) + '">';
        if (t.artURL) {
            html += '<img src="' + esc(t.artURL) + '" alt="Album art">';
        } else {
            html += '<div class="flr-no-art">♫</div>';
        }
        html += '<div class="flr-play-badge">▶</div>';
        html += '</div>';

        // metadata
        html += '<div class="flr-meta">';
        html += '<div class="flr-title">' + esc(tags.title || t.name.replace(/\.mp3$/i, '').replace(/_/g, ' ')) + '</div>';

        // performer avatars
        var _perfs = parsePerformers(tags.artist || '');
        if (_perfs.length) {
            html += '<div class="flr-performers" id="flr-perf-' + cur + '">';
            var _userAvatars = [];
            _perfs.forEach(function (p) {
                html += '<div class="flr-performer">';
                if (p.persona) {
                    html += '<div class="flr-performer-avatar" data-persona-name="' + esc(p.name) + '"></div>';
                } else {
                    html += '<div class="flr-performer-avatar" data-avatar="' + esc(p.name) + '"></div>';
                    _userAvatars.push(p.name);
                }
                html += '<div class="flr-performer-name' + (p.persona ? ' is-persona' : '') + '">' + esc(p.name) + '</div>';
                html += '</div>';
            });
            html += '</div>';
        }

        if (tags.artist || tags.composer) {
            html += '<div class="flr-credits">';
            if (tags.artist) html += '<span class="flr-artist-name">' + esc(tags.artist) + '</span>';
            if (tags.artist && tags.composer) html += '<span class="flr-credit-sep">and</span>';
            if (tags.composer) html += '<span class="flr-composer-name">' + esc(tags.composer) + '</span>';
            html += '</div>';
        }

        // year + genre on one line
        if (tags.year || tags.genre) {
            html += '<div class="flr-detail">';
            if (tags.year) html += '<span class="flr-album-year">' + esc(tags.year) + '</span>';
            if (tags.year && tags.genre) html += ' ';
            if (tags.genre) html += '<span class="flr-genre">' + esc(tags.genre) + '</span>';
            html += '</div>';
        }

        html += '<div class="flr-play-btn">';
        if (isPlaying) {
            html += '<button class="flr-playing" disabled>♫ Now Playing</button>';
        } else {
            html += '<button data-flr-play="' + esc(t.name) + '"><span class="flr-play-icon">▶</span> Play This Track</button>';
        }
        html += '</div>';
        html += '</div>';

        body.innerHTML = html;

        // render performer avatars
        if (_perfs.length) {
            // BBS user avatars
            var _uaNames = [];
            _perfs.forEach(function (p) { if (!p.persona) _uaNames.push(p.name); });
            if (_uaNames.length && typeof Avatars !== 'undefined' && Avatars.draw) {
                Avatars.draw(_uaNames);
            }
            // Persona avatars via GraphicsConverter
            _perfs.forEach(function (p) {
                if (!p.persona) return;
                var b64 = findPersonaAvatar(p.name);
                if (!b64 || !window.GraphicsConverter) return;
                var el = body.querySelector('[data-persona-name="' + p.name + '"]');
                if (!el) return;
                try {
                    GraphicsConverter.shared().from_bin(
                        atob(b64), 10, 6,
                        function (img) {
                            el.innerHTML = '';
                            if (typeof img === 'string') {
                                var i = new Image(); i.src = img;
                                el.appendChild(i);
                            } else {
                                el.appendChild(img);
                            }
                        }, true
                    );
                } catch (_e) {}
            });
        }

        // attach click-to-play handlers
        var playEls = body.querySelectorAll('[data-flr-play]');
        for (var i = 0; i < playEls.length; i++) {
            playEls[i].addEventListener('click', onPlay);
        }
    }

    // ── play handler ──
    function onPlay(e) {
        var el = e.currentTarget;
        var name = el.getAttribute('data-flr-play');
        if (!name || name === nowPlaying) return;
        document.dispatchEvent(new CustomEvent('viz:picktrack', {
            detail: { name: name }
        }));
        document.dispatchEvent(new CustomEvent('viz:open'));
        pauseRotate();
        startRotate();
    }

    // ── navigation ──
    function go(dir) {
        if (!tracks.length) return;
        cur = ((cur + dir) % tracks.length + tracks.length) % tracks.length;
        render();
        pauseRotate();
        startRotate();
    }

    prevBtn.addEventListener('click', function () { go(-1); });
    nextBtn.addEventListener('click', function () { go(1); });

    // ── auto-rotate ──
    function startRotate() {
        pauseRotate();
        rotateTimer = setInterval(function () { go(1); }, ROTATE_MS);
    }
    function pauseRotate() {
        if (rotateTimer) { clearInterval(rotateTimer); rotateTimer = null; }
    }

    // pause rotation while user hovers
    panel.addEventListener('mouseenter', pauseRotate);
    panel.addEventListener('mouseleave', startRotate);

    // ── react to radio events ──
    document.addEventListener('radio:trackchange', function (e) {
        if (e.detail && e.detail.filename) {
            nowPlaying = e.detail.filename;
            render();
        }
    });

    // pick up current track if radio is already playing
    if (window.sbbsRadio && window.sbbsRadio.currentTrackFile) {
        nowPlaying = window.sbbsRadio.currentTrackFile;
    }

    init();
})();
</script>

<!-- Bulletins Carousel -->
<style>
.bl-panel {
    --bs-card-border-color: #AA5500;
    --bs-card-bg: #000;
    --bs-card-cap-bg: #000;
    --bs-card-cap-color: #FFFF55;
    border-color: #AA5500 !important;
}
.bl-panel > .card-header {
    color: #FFFF55 !important;
    background: #000 !important;
    border-bottom: 2px solid #AA5500 !important;
    font-weight: bold;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
}
.bl-header-left {
    flex: 1;
    min-width: 0;
    overflow: hidden;
}
.bl-header-subject {
    color: #FFFF55;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: bold;
}
.bl-header-date {
    color: #55FF55;
    font-size: 0.75em;
    font-weight: normal;
    white-space: nowrap;
}
.bl-nav { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.bl-nav button {
    background: transparent;
    border: 1px solid #AA5500;
    color: #FFFF55;
    font-family: monospace;
    font-size: 14px;
    line-height: 1;
    padding: 2px 8px;
    cursor: pointer;
    border-radius: 2px;
}
.bl-nav button:hover { background: #AA5500; color: #000; }
.bl-counter { color: #AAAAAA; font-size: 0.75em; font-weight: normal; }
.bl-slide { display: none; padding: 12px 14px; }
.bl-slide.active { display: block; }
.bl-body { color: #FFFFFF; font-size: 0.9em; white-space: pre-wrap; word-wrap: break-word; line-height: 1.45; }
.bl-empty { color: #AA5500; padding: 12px 14px; }
</style>

<div class="card mb-3 bl-panel">
    <div class="card-header">
        <div class="bl-header-left">
            <div class="bl-header-subject" id="bl-title"><?xjs write(_bltn_msgs.length ? _bltn_msgs[0].subject : 'Bulletins'); ?></div>
            <div class="bl-header-date" id="bl-date"><?xjs write(_bltn_msgs.length ? _bltn_msgs[0].date : ''); ?></div>
        </div>
<?xjs if (_bltn_msgs.length > 1) { ?>
        <div class="bl-nav">
            <button id="bl-prev" title="Previous">&laquo;</button>
            <span class="bl-counter" id="bl-counter">1 / <?xjs write(_bltn_msgs.length); ?></span>
            <button id="bl-next" title="Next">&raquo;</button>
        </div>
<?xjs } ?>
    </div>
    <div class="card-body p-0" id="bl-carousel">
<?xjs
    if (_bltn_msgs.length === 0) {
?>
        <div class="bl-empty">No bulletins posted.</div>
<?xjs
    }
    _bltn_msgs.forEach(function (msg, idx) {
?>
        <div class="bl-slide<?xjs if (idx === 0) write(' active'); ?>" data-bl-idx="<?xjs write(idx); ?>" data-bl-subject="<?xjs write(msg.subject); ?>" data-bl-date="<?xjs write(msg.date); ?>">
            <div class="bl-body"><?xjs write(msg.body); ?></div>
        </div>
<?xjs
    });
?>
    </div>
</div>

<?xjs if (_bltn_msgs.length > 1) { ?>
<script>
(function () {
    var total = <?xjs write(_bltn_msgs.length); ?>;
    var cur = 0;
    var slides = document.querySelectorAll('.bl-slide');
    var counter = document.getElementById('bl-counter');
    var titleEl = document.getElementById('bl-title');
    var dateEl = document.getElementById('bl-date');

    function show(idx) {
        cur = ((idx % total) + total) % total;
        slides.forEach(function (s) { s.classList.remove('active'); });
        slides[cur].classList.add('active');
        if (counter) counter.textContent = (cur + 1) + ' / ' + total;
        if (titleEl) titleEl.textContent = slides[cur].getAttribute('data-bl-subject');
        if (dateEl) dateEl.textContent = slides[cur].getAttribute('data-bl-date');
    }

    document.getElementById('bl-prev').addEventListener('click', function () { show(cur - 1); });
    document.getElementById('bl-next').addEventListener('click', function () { show(cur + 1); });
})();
</script>
<?xjs } ?>
<style>
.ahv-panel {
    --bs-card-border-color: #AAAAAA;
    --bs-card-bg: #000;
    --bs-card-cap-bg: #000;
    --bs-card-cap-color: #AAAAAA;
    border-color: #AAAAAA !important;
    background: #000 !important;
}
.ahv-panel > .card-header {
    color: #FFFF55 !important;
    background: #000 !important;
    border-bottom: 2px solid #AAAAAA !important;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}
.ahv-header-copy {
    min-width: 0;
    flex: 1 1 280px;
}
.ahv-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
}
.ahv-title {
    color: #FFFF55;
    font-weight: bold;
}
.ahv-count {
    color: #55FFFF;
    font-size: 0.8em;
    white-space: nowrap;
}
.ahv-file {
    color: #FF55FF;
    font-size: 0.8em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.ahv-nav {
    display: flex;
    align-items: center;
    gap: 6px;
}
.ahv-nav button {
    background: transparent;
    border: 1px solid #AAAAAA;
    color: #FFFF55;
    font-family: monospace;
    font-size: 14px;
    line-height: 1;
    padding: 4px 10px;
    cursor: pointer;
    border-radius: 2px;
}
.ahv-nav button:hover:not(:disabled) {
    background: #AAAAAA;
    color: #000;
}
.ahv-nav button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
}
.ahv-panel .card-body {
    background: #000;
    padding: 14px;
}
.ahv-controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 14px;
}
.ahv-control {
    display: block;
}
.ahv-control span {
    display: block;
    color: #AAAAAA;
    font-size: 0.72em;
    margin-bottom: 4px;
    text-transform: uppercase;
}
.ahv-control select {
    width: 100%;
    background: #050505;
    color: #FFFFFF;
    border: 1px solid #5555FF;
    padding: 7px 10px;
    border-radius: 2px;
    font-family: inherit;
}
.ahv-stage-wrap {
    border: 1px solid #333333;
    background: #000;
    padding: 0;
    overflow: hidden;
    min-height: 280px;
}
.ahv-stage {
    width: fit-content;
    margin: 0 auto;
    transform-origin: top center;
}
.ahv-stage pre.ahv-ansi-pre {
    margin: 0;
    background: transparent;
    color: #A8A8A8;
    display: inline-block;
    white-space: pre;
}
.ahv-empty {
    color: #AAAAAA;
    padding: 32px 12px;
    text-align: center;
}
.ahv-status {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 10px;
    font-size: 0.8em;
}
.ahv-status-text {
    color: #55FFFF;
}
.ahv-error {
    color: #FF5555;
}
.ahv-loading .ahv-stage {
    opacity: 0.55;
}
@media (max-width: 900px) {
    .ahv-controls {
        grid-template-columns: 1fr;
    }
    .ahv-title-row {
        align-items: flex-start;
        flex-direction: column;
        gap: 4px;
    }
}
</style>

<div class="card mb-3 ahv-panel" id="ahv-panel">
    <div class="card-header">
        <div class="ahv-header-copy">
            <div class="ahv-title-row">
                <div class="ahv-title">ANSI Viewer</div>
                <div class="ahv-count" id="ahv-count">
<?xjs
    if (_ansi_state.current_count > 0) {
        write(format('%u ANSI files', _ansi_state.current_count));
    } else {
        write('No ANSI files');
    }
?>
                </div>
            </div>
            <div class="ahv-file" id="ahv-file"><?xjs write(_homeEsc(_ansi_state.current_file_label || 'No ANSI selected')); ?></div>
        </div>
        <div class="ahv-nav">
            <button type="button" id="ahv-prev" title="Previous ANSI">&laquo;</button>
            <button type="button" id="ahv-random" title="Random ANSI">Random</button>
            <button type="button" id="ahv-next" title="Next ANSI">&raquo;</button>
        </div>
    </div>
    <div class="card-body">
        <div class="ahv-controls">
            <label class="ahv-control" for="ahv-gallery">
                <span>Gallery</span>
                <select id="ahv-gallery"></select>
            </label>
            <label class="ahv-control" for="ahv-dir">
                <span>Directory</span>
                <select id="ahv-dir"></select>
            </label>
            <label class="ahv-control" for="ahv-file-select">
                <span>File</span>
                <select id="ahv-file-select"></select>
            </label>
        </div>
        <div class="ahv-stage-wrap">
            <div class="ahv-stage" id="ahv-stage"><?xjs write(_ansi_state.render_html); ?></div>
        </div>
        <div class="ahv-status">
            <span class="ahv-status-text" id="ahv-status"><?xjs write(_homeEsc(_ansi_state.status_text || '')); ?></span>
            <span class="ahv-error" id="ahv-error"><?xjs if (_ansi_state.error) write(_homeEsc(_ansi_state.error)); ?></span>
        </div>
    </div>
</div>

<script>
(function () {
    var root = document.getElementById('ahv-panel');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    var state = <?xjs write(_ansi_state_json); ?>;
    var stage = document.getElementById('ahv-stage');
    var gallerySelect = document.getElementById('ahv-gallery');
    var dirSelect = document.getElementById('ahv-dir');
    var fileSelect = document.getElementById('ahv-file-select');
    var fileLabel = document.getElementById('ahv-file');
    var countLabel = document.getElementById('ahv-count');
    var statusLabel = document.getElementById('ahv-status');
    var errorLabel = document.getElementById('ahv-error');
    var prevButton = document.getElementById('ahv-prev');
    var nextButton = document.getElementById('ahv-next');
    var randomButton = document.getElementById('ahv-random');

    function fillSelect(select, items, valueKey, labelKey, currentValue, emptyLabel) {
        select.innerHTML = '';
        if (!items || !items.length) {
            var emptyOption = document.createElement('option');
            emptyOption.value = '';
            emptyOption.textContent = emptyLabel;
            select.appendChild(emptyOption);
            select.disabled = true;
            return;
        }

        select.disabled = false;
        items.forEach(function (item) {
            var option = document.createElement('option');
            option.value = item[valueKey];
            option.textContent = item[labelKey];
            if (option.value === currentValue) option.selected = true;
            select.appendChild(option);
        });
    }

    function setLoading(loading) {
        root.classList.toggle('ahv-loading', loading);
        [gallerySelect, dirSelect, fileSelect, prevButton, nextButton, randomButton].forEach(function (el) {
            if (!el) return;
            if (loading) {
                el.setAttribute('disabled', 'disabled');
            } else {
                el.removeAttribute('disabled');
            }
        });
    }

    function updateControls(payload) {
        var hasFiles = payload.current_count > 0;
        fillSelect(
            gallerySelect,
            payload.galleries || [],
            'id',
            'description',
            payload.gallery ? payload.gallery.id : '',
            'No galleries'
        );
        fillSelect(
            dirSelect,
            payload.directories || [],
            'path',
            'label',
            payload.current_dir || '',
            'No directories'
        );
        fillSelect(
            fileSelect,
            payload.files || [],
            'name',
            'label',
            payload.current_file || '',
            'No ANSI files'
        );
        prevButton.disabled = !hasFiles;
        nextButton.disabled = !hasFiles;
        randomButton.disabled = !hasFiles;
    }

    function scaleAnsi() {
        var wrap = document.querySelector('.ahv-stage-wrap');
        if (!wrap || !stage) return;
        stage.style.transform = 'none';
        wrap.style.height = 'auto';
        var pre = stage.querySelector('pre.ahv-ansi-pre');
        if (!pre) return;
        var wrapW = wrap.clientWidth;
        var preW = pre.scrollWidth;
        if (preW > 0) {
            var s = wrapW / preW;
            if (Math.abs(s - 1) > 0.02) {
                stage.style.transform = 'scale(' + s + ')';
                wrap.style.height = (Math.ceil(pre.scrollHeight * s) + 2) + 'px';
            }
        }
    }

    function scheduleScale() {
        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(function () {
                requestAnimationFrame(scaleAnsi);
            });
        } else {
            requestAnimationFrame(function () {
                setTimeout(scaleAnsi, 50);
            });
        }
    }

    function scheduleScale() {
        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(function () {
                requestAnimationFrame(scaleAnsi);
            });
        } else {
            requestAnimationFrame(function () {
                setTimeout(scaleAnsi, 50);
            });
        }
    }

    var _ahvResizeTimer;
    window.addEventListener('resize', function () {
        clearTimeout(_ahvResizeTimer);
        _ahvResizeTimer = setTimeout(scaleAnsi, 150);
    });

    function render(payload) {
        state = payload;
        if (payload.render_html) {
            stage.innerHTML = payload.render_html;
        } else if (!stage.innerHTML.length) {
            stage.innerHTML = '<div class="ahv-empty">No ANSI available.</div>';
        }
        fileLabel.textContent = payload.current_file_label || 'No ANSI selected';
        countLabel.textContent = payload.current_count > 0
            ? ((payload.current_index + 1) + ' / ' + payload.current_count + ' in ' + ((payload.gallery && payload.gallery.description) || 'gallery'))
            : 'No ANSI files';
        statusLabel.textContent = payload.status_text || '';
        errorLabel.textContent = payload.error || '';
        updateControls(payload);
        scheduleScale();
    }

    function fetchState(mode, overrides) {
        var params = new URLSearchParams();
        overrides = overrides || {};

        params.set('mode', mode || 'select');
        params.set('gallery', overrides.gallery !== undefined
            ? overrides.gallery
            : ((state.gallery && state.gallery.id) || '')
        );
        params.set('dir', overrides.dir !== undefined ? overrides.dir : (state.current_dir || ''));
        if ((overrides.file !== undefined ? overrides.file : state.current_file || '').length) {
            params.set('file', overrides.file !== undefined ? overrides.file : state.current_file);
        }

        setLoading(true);
        fetch('./api/ansi-viewer.ssjs?' + params.toString(), {
            credentials: 'same-origin'
        })
            .then(function (response) { return response.json(); })
            .then(function (payload) {
                setLoading(false);
                render(payload);
            })
            .catch(function (error) {
                errorLabel.textContent = 'ANSI viewer request failed: ' + error;
                setLoading(false);
                updateControls(state);
            });
    }

    gallerySelect.addEventListener('change', function () {
        fetchState('random', {
            gallery: gallerySelect.value,
            dir: '',
            file: ''
        });
    });

    dirSelect.addEventListener('change', function () {
        fetchState('first', {
            gallery: gallerySelect.value,
            dir: dirSelect.value,
            file: ''
        });
    });

    fileSelect.addEventListener('change', function () {
        fetchState('select', {
            gallery: gallerySelect.value,
            dir: dirSelect.value,
            file: fileSelect.value
        });
    });

    prevButton.addEventListener('click', function () {
        fetchState('prev');
    });

    randomButton.addEventListener('click', function () {
        fetchState('random');
    });

    nextButton.addEventListener('click', function () {
        fetchState('next');
    });

    render(state);
})();
</script>
