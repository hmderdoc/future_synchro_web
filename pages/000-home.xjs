?>
        <div class="bl-empty">No bulletins posted.</div>
<?xjs
    }
    _bltn_msgs.forEach(function (msg, idx) {
?>
        <div class="bl-slide<?xjs if (idx === 0) write(' active'); ?>" data-bl-idx="<?xjs write(idx); ?>" data-bl-subject="<?xjs write(_homeEsc(msg.subject_raw)); ?>" data-bl-date="<?xjs write(_homeEsc(msg.date)); ?>">
            <div class="bl-body"><?xjs write(msg.body); ?></div>
