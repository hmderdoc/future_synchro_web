    --bs-card-bg: #000;
    --bs-card-cap-bg: #000;
    --bs-card-cap-color: #AAAAAA;
    border-color: #AAAAAA !important;
    background: #000 !important;
}
.ahv-panel > .card-header {
    color: #FFFF55 !important;
    background: #000 !important;
    border-bottom: 2px solid #AAAAAA !important;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}
.ahv-header-copy {
    min-width: 0;
    flex: 1 1 280px;
}
.ahv-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
}
.ahv-title {
    color: #FFFF55;
