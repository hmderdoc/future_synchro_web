<!--HIDDEN:Home-->

<?xjs
    require('sbbsdefs.js', 'SYS_CLOSED');

    var _tdf = load({}, settings.web_lib + 'tdf-heading.js');

    var _bltn_subcode = 'LOCAL-NOTICES';
    var _bltn_max = 10;
    var _bltn_body_maxlen = 600;
    function _homeEsc(value) {
        return String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    var _bltn_msgs = [];
    var _bltn_mb = new MsgBase(_bltn_subcode);
    if (_bltn_mb.open()) {
        var _bltn_count = 0;
        for (var _bm = _bltn_mb.last_msg; _bm >= _bltn_mb.first_msg && _bltn_count < _bltn_max; _bm--) {
            var _bh = _bltn_mb.get_msg_header(_bm);
            if (_bh === null || (_bh.attr & MSG_DELETE))
                continue;
            var _bb = _bltn_mb.get_msg_body(_bm) || '';
            _bb = _bb.replace(/\x01./g, '').replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim();
            if (_bb.length > _bltn_body_maxlen)
                _bb = _bb.substring(0, _bltn_body_maxlen) + '...';
            _bltn_msgs.push({
                subject: _bh.subject.replace(/</g, '&lt;'),
                date: system.timestr(_bh.when_written_time),
                body: _bb.replace(/</g, '&lt;')
            });
            _bltn_count++;
        }
        _bltn_mb.close();
    }

    /* Connection details for the intro card, read from the live config so
       the page never drifts from what the terminal server actually listens on. */
    var _conn_host = system.inet_addr || system.name;
    /* The original-doors link appears once that wiki page exists. */
    var _doors_wiki = file_exists(system.data_dir + 'wiki/pages/original-doors.jsonl');
    var _conn_telnet = 23;
    var _conn_ssh = 22;
    var _conn_ini = new File(system.ctrl_dir + 'sbbs.ini');
    if (_conn_ini.open('r')) {
        try {
            _conn_telnet = _conn_ini.iniGetValue('BBS', 'TelnetPort', 23);
            _conn_ssh = _conn_ini.iniGetValue('BBS', 'SSHPort', 22);
        } finally { _conn_ini.close(); }
    }
?>

<!-- About + connection info: the plain text crawlers and link previews read -->
<style>
.hm-intro {
    --bs-card-border-color: #AA00AA;
    --bs-card-bg: #000;
    border-color: #AA00AA !important;
    background: #000 !important;
}
.hm-intro { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.hm-intro ~ .bl-panel { border-top: 0; border-top-left-radius: 0; border-top-right-radius: 0; }
.hm-intro .card-body { padding: 16px 18px; }
.hm-intro-sub {
    color: #55FFFF;
    font-size: 1rem;
    font-weight: bold;
    margin: 0 0 8px;
}
#hm-intro-title { margin: 12px 0 24px; container-type: inline-size; cursor: pointer; }
/* The font changes every few seconds; a fixed box (the widest allowed
   shape, 10:1) keeps the text below from jumping. */
#hm-intro-title .tdf-art { aspect-ratio: auto; height: min(7rem, 10cqi); align-items: center; }
.hm-intro-lede a { color: #55FF55; }
.hm-intro-lede { color: #FFFFFF; margin: 0 0 14px; line-height: 1.5; max-width: 70ch; }
.hm-intro-connect {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 4px 14px;
    margin: 0;
    font-family: monospace;
}
.hm-intro-connect dt { color: #55FFFF; font-weight: normal; }
.hm-intro-connect dd { color: #FFFF55; margin: 0; word-break: break-all; }
.hm-intro-connect dd .hm-intro-note { color: #AAAAAA; word-break: normal; }
</style>

<section class="card mb-0 hm-intro" aria-labelledby="hm-intro-title">
    <div class="card-body">
        <?xjs write(_tdf.tdf_heading(system.name, { tag: 'h1', id: 'hm-intro-title', font: 'random', align: 'center' })); ?>
        <p class="hm-intro-lede">
            We like to think this might be the most customized Synchronet BBS out there. Alongside the
            classic doors, we write our own, and the board is under constant development<?xjs
    if (_doors_wiki) { ?> (<a href="./?page=010-wiki.xjs#wiki/original-doors">see our original doors</a>)<?xjs } ?>.
            We carry DoveNet, fsxNet and tqwNet, and we're the home and info center of
            <a href="https://futureland.today/cheesenet/" data-no-spa>CheeseNet</a>. Live chat runs across four networks, so there's
            usually someone around to talk to. And we enjoy pushing what a terminal can do: multimedia,
            demoscene tricks, and experimental music and video broadcasts.
        </p>
        <h2 class="hm-intro-sub">Connection info</h2>
        <dl class="hm-intro-connect">
            <dt>Telnet</dt>
            <dd><?xjs write(_homeEsc(_conn_host)); if (_conn_telnet != 23) write(':' + _conn_telnet); ?></dd>
            <dt>SSH</dt>
            <dd><?xjs write(_homeEsc(_conn_host) + ':' + _conn_ssh); ?></dd>
            <dt>Client</dt>
            <dd><a href="https://syncterm.bbsdev.net/" rel="noopener">SyncTERM</a> <span class="hm-intro-note">recommended, or any ANSI terminal</span></dd>
        </dl>
    </div>
</section>

<script>
/* Landing title: every 3-5 s a new random font and a new avatar effect;
   a click skips ahead. Fonts come from api/tdf-heading.ssjs in batches of
   10 (one request per ~40 s). Lives here, not in js/, so the service
   worker's asset revision is left alone. Pauses offscreen / hidden tab. */
(function () {
    var head = document.getElementById('hm-intro-title');
    if (!head || head.__hmCycle) return;
    head.__hmCycle = true;
    var MIN_MS = 3000, MAX_MS = 5000, BATCH = 10;
    var variants = [], fetching = false, timer = null, visible = true, effect = null;

    function host() { return head.querySelector('.tdf-art-cells'); }
    function names() { return window.AvatarFx ? AvatarFx.list().map(function (n) { return n.split(':')[1]; }) : []; }
    function nextEffect() {
        var pool = names().filter(function (n) { return n !== effect; });
        effect = pool.length ? pool[Math.floor(Math.random() * pool.length)] : null;
    }
    function play() {
        var h = host();
        if (window.AvatarFx && h && effect && h.querySelector('img')) AvatarFx.play(h, effect);
    }

    function fetchMore() {
        if (fetching) return;
        fetching = true;
        var req = [{ tag: 'h1', text: head.querySelector('.tdf-text').textContent, align: 'center' }];
        fetch('./api/tdf-heading.ssjs?variants=' + BATCH + '&h=' + encodeURIComponent(JSON.stringify(req)), { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (d) { variants = variants.concat(d.html || []); })
            .catch(function () { /* keep the current font */ })
            .then(function () { fetching = false; });
    }

    /* Swap in the next font, then start a new effect once it has drawn. */
    function step() {
        nextEffect();
        var next = null;
        while (variants.length && !next) {
            var tmp = document.createElement('div');
            tmp.innerHTML = variants.shift();
            var h = tmp.firstElementChild;
            if (h && h.getAttribute('data-tdf-font') !== head.getAttribute('data-tdf-font')) next = h;
        }
        if (variants.length < 3) fetchMore();
        var art = next && next.querySelector('.tdf-art'), old = head.querySelector('.tdf-art');
        if (!art || !old || !window.renderTdfHeadings) { play(); return; }
        if (window.AvatarFx && host()) AvatarFx.stop(host());
        head.setAttribute('data-tdf-font', next.getAttribute('data-tdf-font'));
        old.replaceWith(art);
        renderTdfHeadings(head);
        var waited = 0;
        (function whenDrawn() {
            if (host() && host().querySelector('img') && host().querySelector('img').complete) { play(); return; }
            if ((waited += 50) < 3000) setTimeout(whenDrawn, 50);
        })();
    }

    function schedule() {
        clearTimeout(timer);
        timer = setTimeout(function () {
            if (!head.isConnected) return;
            if (visible && !document.hidden) step();
            schedule();
        }, MIN_MS + Math.random() * (MAX_MS - MIN_MS));
    }

    head.addEventListener('click', function () { step(); schedule(); });
    if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
            visible = entries[entries.length - 1].isIntersecting;
            if (!visible && window.AvatarFx && host()) AvatarFx.stop(host());
        }).observe(head);
    }
    fetchMore();
    var waited = 0;
    (function firstPlay() {
        if (host() && host().querySelector('img')) { nextEffect(); play(); return; }
        if ((waited += 100) < 5000) setTimeout(firstPlay, 100);
    })();
    schedule();
})();
</script>

<!-- Bulletins Carousel -->
<style>
.bl-panel {
    --bs-card-border-color: #AA5500;
    --bs-card-bg: #000;
    --bs-card-cap-bg: #000;
    --bs-card-cap-color: #FFFF55;
    border-color: #AA5500 !important;
}
.bl-panel > .card-header {
    color: #FFFF55 !important;
    background: #000 !important;
    border-bottom: 2px solid #AA5500 !important;
    font-weight: bold;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
}
.bl-header-left {
    flex: 1;
    min-width: 0;
    overflow: hidden;
}
.bl-header-subject {
    color: #FFFF55;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: bold;
}
.bl-header-date {
    color: #55FF55;
    font-size: 0.75em;
    font-weight: normal;
    white-space: nowrap;
}
.bl-nav { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.bl-nav button {
    background: transparent;
    border: 1px solid #AA5500;
    color: #FFFF55;
    font-family: monospace;
    font-size: 14px;
    line-height: 1;
    padding: 2px 8px;
    cursor: pointer;
    border-radius: 2px;
}
.bl-nav button:hover { background: #AA5500; color: #000; }
.bl-counter { color: #AAAAAA; font-size: 0.75em; font-weight: normal; }
.bl-slide { display: none; padding: 12px 14px; }
.bl-slide.active { display: block; }
.bl-body { color: #FFFFFF; font-size: 0.9em; white-space: pre-wrap; word-wrap: break-word; line-height: 1.45; }
.bl-empty { color: #AA5500; padding: 12px 14px; }
</style>

<div class="card mb-3 bl-panel">
    <div class="card-header">
        <div class="bl-header-left">
            <div class="bl-header-subject" id="bl-title"><?xjs write(_bltn_msgs.length ? _bltn_msgs[0].subject : 'Bulletins'); ?></div>
            <div class="bl-header-date" id="bl-date"><?xjs write(_bltn_msgs.length ? _bltn_msgs[0].date : ''); ?></div>
        </div>
<?xjs if (_bltn_msgs.length > 1) { ?>
        <div class="bl-nav">
            <button id="bl-prev" title="Previous">&laquo;</button>
            <span class="bl-counter" id="bl-counter">1 / <?xjs write(_bltn_msgs.length); ?></span>
            <button id="bl-next" title="Next">&raquo;</button>
        </div>
<?xjs } ?>
    </div>
    <div class="card-body p-0" id="bl-carousel">
<?xjs
    if (_bltn_msgs.length === 0) {
?>
        <div class="bl-empty">No bulletins posted.</div>
<?xjs
    }
    _bltn_msgs.forEach(function (msg, idx) {
?>
        <div class="bl-slide<?xjs if (idx === 0) write(' active'); ?>" data-bl-idx="<?xjs write(idx); ?>" data-bl-subject="<?xjs write(msg.subject); ?>" data-bl-date="<?xjs write(msg.date); ?>">
            <div class="bl-body"><?xjs write(msg.body); ?></div>
        </div>
<?xjs
    });
?>
    </div>
</div>

<?xjs if (_bltn_msgs.length > 1) { ?>
<script>
(function () {
    var total = <?xjs write(_bltn_msgs.length); ?>;
    var cur = 0;
    var slides = document.querySelectorAll('.bl-slide');
    var counter = document.getElementById('bl-counter');
    var titleEl = document.getElementById('bl-title');
    var dateEl = document.getElementById('bl-date');

    function show(idx) {
        cur = ((idx % total) + total) % total;
        slides.forEach(function (s) { s.classList.remove('active'); });
        slides[cur].classList.add('active');
        if (counter) counter.textContent = (cur + 1) + ' / ' + total;
        if (titleEl) titleEl.textContent = slides[cur].getAttribute('data-bl-subject');
        if (dateEl) dateEl.textContent = slides[cur].getAttribute('data-bl-date');
    }

    document.getElementById('bl-prev').addEventListener('click', function () { show(cur - 1); });
    document.getElementById('bl-next').addEventListener('click', function () { show(cur + 1); });
})();
</script>
<?xjs } ?>
