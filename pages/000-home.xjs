<!--HIDDEN:Home-->

<?xjs
    require('sbbsdefs.js', 'SYS_CLOSED');

    var _tdf = load({}, settings.web_lib + 'tdf-heading.js');

    var _bltn_subcode = 'LOCAL-NOTICES';
    var _bltn_max = 10;
    var _bltn_body_maxlen = 600;
    /* Narrow columns may wrap a host name only before a '.' or ':'. */
    function _hmBreakable(value) {
        return _homeEsc(value).replace(/([.:])/g, '<wbr>$1');
    }

    function _homeEsc(value) {
        return String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    /* Bulletin body -> HTML that keeps its Ctrl-A colors (signatures are
       colored). Hand-rolled because html_encode() hard-wraps at 80 columns.
       Letters krgybmcw set the foreground, digits 0-7 the background, H high
       intensity, N resets; uncolored text inherits the card's white. The
       preview cut counts visible characters only, so it never splits a code. */
    var _CA_LETTERS = 'krgybmcw';
    var _CA_NORMAL = ['#000000', '#AA0000', '#00AA00', '#AA5500', '#0000AA', '#AA00AA', '#00AAAA', '#AAAAAA'];
    var _CA_BRIGHT = ['#555555', '#FF5555', '#55FF55', '#FFFF55', '#5555FF', '#FF55FF', '#55FFFF', '#FFFFFF'];

    function _blBodyHtml(raw) {
        var out = '', run = '', seen = 0, fg = -1, bg = -1, hi = false, open = false, i = 0;
        function style() {
            var css = '';
            if (fg >= 0) css += 'color:' + (hi ? _CA_BRIGHT : _CA_NORMAL)[fg] + ';';
            else if (hi) css += 'color:#FFFFFF;';
            if (bg > 0) css += 'background-color:' + _CA_NORMAL[bg] + ';';
            return css;
        }
        function flush() {
            if (!run) return;
            var css = style();
            out += css ? '<span style="' + css + '">' + _homeEsc(run) + '</span>' : _homeEsc(run);
            run = '';
        }
        for (; i < raw.length && seen < _bltn_body_maxlen; i++) {
            var ch = raw.charAt(i);
            if (ch === '\x01' && i + 1 < raw.length) {
                var code = raw.charAt(++i), lower = code.toLowerCase(), k = _CA_LETTERS.indexOf(lower);
                flush();
                if (k >= 0) fg = k;
                else if (code >= '0' && code <= '7') bg = +code;
                else if (lower === 'h') hi = true;
                else if (lower === 'n') { fg = -1; bg = -1; hi = false; }
                continue;
            }
            run += ch;
            seen++;
        }
        flush();
        if (i < raw.length) out += '...';
        return out.replace(/^\s+/, '');
    }

    var _bltn_msgs = [];
    var _bltn_mb = new MsgBase(_bltn_subcode);
    if (_bltn_mb.open()) {
        var _bltn_count = 0;
        for (var _bm = _bltn_mb.last_msg; _bm >= _bltn_mb.first_msg && _bltn_count < _bltn_max; _bm--) {
            var _bh = _bltn_mb.get_msg_header(_bm);
            if (_bh === null || (_bh.attr & MSG_DELETE))
                continue;
            var _bb = _bltn_mb.get_msg_body(_bm) || '';
            _bb = _bb.replace(/\r\n/g, '\n').replace(/\r/g, '\n').replace(/\s+$/, '');
            _bltn_msgs.push({
                subject: _bh.subject.replace(/</g, '&lt;'),
                subject_raw: _bh.subject,
                date: system.timestr(_bh.when_written_time),
                body: _blBodyHtml(_bb)
            });
            _bltn_count++;
        }
        _bltn_mb.close();
    }

    /* Connection details for the intro card, read from the live config so
       the page never drifts from what the terminal server actually listens on. */
    var _conn_host = system.inet_addr || system.name;
    /* The original-doors link appears once that wiki page exists. */
    var _doors_wiki = file_exists(system.data_dir + 'wiki/pages/original-doors.jsonl');
    var _conn_telnet = 23;
    var _conn_ssh = 22;
    var _conn_ini = new File(system.ctrl_dir + 'sbbs.ini');
    if (_conn_ini.open('r')) {
        try {
            _conn_telnet = _conn_ini.iniGetValue('BBS', 'TelnetPort', 23);
            _conn_ssh = _conn_ini.iniGetValue('BBS', 'SSHPort', 22);
        } finally { _conn_ini.close(); }
    }
?>

<!-- About + connection info: the plain text crawlers and link previews read -->
<style>
.hm-intro {
    --bs-card-border-color: #AA00AA;
    --bs-card-bg: #000;
    border-color: #AA00AA !important;
    background: #000 !important;
}
.hm-intro { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.hm-intro ~ .bl-panel { border-top: 0; border-top-left-radius: 0; border-top-right-radius: 0; }
.hm-intro .card-body { padding: 16px 18px; }
#hm-intro-title { margin: 12px 0 24px; container-type: inline-size; cursor: pointer; }
/* The font changes every few seconds; a fixed box (the widest allowed
   shape, 10:1) keeps the text below from jumping. */
#hm-intro-title .tdf-art { aspect-ratio: auto; height: min(7rem, 10cqi); align-items: center; }
.hm-intro-lede a { color: #55FF55; }
.hm-intro .hm-intro-lede { color: #FFFFFF; margin: 0 auto 18px; line-height: 1.5; max-width: 70ch; text-align: center; }
.hm-connect {
    width: 100%;
    max-width: 52rem;
    margin: 0 auto;
    table-layout: fixed;
    border-collapse: collapse;
    text-align: center;
    font-family: inherit;   /* the site's Spleen CP437 face */
}
.hm-connect th, .hm-connect td { padding: 4px 8px; vertical-align: top; }
.hm-connect .hm-connect-label th { color: #55FFFF; font-weight: normal; }
.hm-connect td { color: #FFFF55; overflow-wrap: normal; }
.hm-connect td a { color: #55FF55; }
/* Terminal options flow inline (wrapping only on narrow screens). */
.hm-connect-terms > * { display: inline-block; margin: 0 6px; }
.hm-connect-web {
    padding: 0;
    border: 0;
    background: none;
    color: #55FF55;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
}
.hm-connect-web:hover { color: #FFFFFF; }
#hm-news-title { margin: 14px 0 6px; container-type: inline-size; --tdf-max-h: min(3.5rem, 9cqi); --tdf-max-w: 100%; }
#hm-news-title .tdf-art { margin: 0 auto; }
</style>

<section class="card mb-0 hm-intro" aria-labelledby="hm-intro-title">
    <div class="card-body">
        <?xjs write(_tdf.tdf_heading(system.name, { tag: 'h1', id: 'hm-intro-title', font: 'random', align: 'center' })); ?>
        <p class="hm-intro-lede">
            We like to think this might be the most customized Synchronet BBS out there. Alongside the
            classic doors, we write our own, and the board is under constant development<?xjs
    if (_doors_wiki) { ?> (<a href="./?page=010-wiki.xjs#wiki/original-doors">see our original doors</a>)<?xjs } ?>.
            We carry DoveNet, fsxNet and tqwNet, and we're the home and info center of
            <a href="https://futureland.today/cheesenet/" data-no-spa>CheeseNet</a>. Live chat runs across four networks, so there's
            usually someone around to talk to. And we enjoy pushing what a terminal can do: multimedia,
            demoscene tricks, and experimental music and video broadcasts.
        </p>
        <table class="hm-connect">
            <thead>
                <tr class="hm-connect-label"><th scope="col">Telnet</th><th scope="col">SSH</th><th scope="col">Terminal</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td><?xjs write(_hmBreakable(_conn_host + ':' + _conn_telnet)); ?></td>
                    <td><?xjs write(_hmBreakable(_conn_host + ':' + _conn_ssh)); ?></td>
                    <td class="hm-connect-terms"><a href="https://syncterm.bbsdev.net" rel="noopener" data-no-spa>SyncTERM</a> <a href="./?page=010-wiki.xjs#wiki/other-terminals">More</a> <button type="button" class="hm-connect-web" id="hm-connect-web" aria-controls="terminal-panel" title="Open the built-in web terminal">Web</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<script>
/* "Web" in the connection table opens the built-in terminal: the same
   toggle (and connect) as the navbar's terminal button. */
(function () {
    var web = document.getElementById('hm-connect-web');
    if (!web || web.__bound) return;
    web.__bound = true;
    web.addEventListener('click', function () {
        var btn = document.getElementById('btn-terminal');
        if (btn) btn.click();
    });
})();
</script>
<script>
/* Landing title: every 3-5 s a new random font and a new avatar effect;
   a click skips ahead. Fonts come from api/tdf-heading.ssjs in batches of
   10 (one request per ~40 s). Lives here, not in js/, so the service
   worker's asset revision is left alone. Pauses offscreen / hidden tab. */
(function () {
    var head = document.getElementById('hm-intro-title');
    if (!head || head.__hmCycle) return;
    head.__hmCycle = true;
    var MIN_MS = 3000, MAX_MS = 5000, BATCH = 10;
    var variants = [], fetching = false, timer = null, visible = true, effect = null;

    function host() { return head.querySelector('.tdf-art-cells'); }
    function names() { return window.AvatarFx ? AvatarFx.list().map(function (n) { return n.split(':')[1]; }) : []; }
    function nextEffect() {
        var pool = names().filter(function (n) { return n !== effect; });
        effect = pool.length ? pool[Math.floor(Math.random() * pool.length)] : null;
    }
    function play() {
        var h = host();
        if (window.AvatarFx && h && effect && h.querySelector('img')) AvatarFx.play(h, effect);
    }

    function fetchMore() {
        if (fetching) return;
        fetching = true;
        var req = [{ tag: 'h1', text: head.querySelector('.tdf-text').textContent, align: 'center' }];
        fetch('./api/tdf-heading.ssjs?variants=' + BATCH + '&h=' + encodeURIComponent(JSON.stringify(req)), { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (d) { variants = variants.concat(d.html || []); })
            .catch(function () { /* keep the current font */ })
            .then(function () { fetching = false; });
    }

    /* Swap in the next font, then start a new effect once it has drawn. */
    function step() {
        nextEffect();
        var next = null;
        while (variants.length && !next) {
            var tmp = document.createElement('div');
            tmp.innerHTML = variants.shift();
            var h = tmp.firstElementChild;
            if (h && h.getAttribute('data-tdf-font') !== head.getAttribute('data-tdf-font')) next = h;
        }
        if (variants.length < 3) fetchMore();
        var art = next && next.querySelector('.tdf-art'), old = head.querySelector('.tdf-art');
        if (!art || !old || !window.renderTdfHeadings) { play(); return; }
        if (window.AvatarFx && host()) AvatarFx.stop(host());
        head.setAttribute('data-tdf-font', next.getAttribute('data-tdf-font'));
        old.replaceWith(art);
        renderTdfHeadings(head);
        var waited = 0;
        (function whenDrawn() {
            if (host() && host().querySelector('img') && host().querySelector('img').complete) { play(); return; }
            if ((waited += 50) < 3000) setTimeout(whenDrawn, 50);
        })();
    }

    function schedule() {
        clearTimeout(timer);
        timer = setTimeout(function () {
            if (!head.isConnected) return;
            if (visible && !document.hidden) step();
            schedule();
        }, MIN_MS + Math.random() * (MAX_MS - MIN_MS));
    }

    head.addEventListener('click', function () { step(); schedule(); });
    if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
            visible = entries[entries.length - 1].isIntersecting;
            if (!visible && window.AvatarFx && host()) AvatarFx.stop(host());
        }).observe(head);
    }
    fetchMore();
    var waited = 0;
    (function firstPlay() {
        if (host() && host().querySelector('img')) { nextEffect(); play(); return; }
        if ((waited += 100) < 5000) setTimeout(firstPlay, 100);
    })();
    schedule();
})();
</script>

<!-- Bulletins Carousel -->
<?xjs
    /* One random font for every bulletin subject this load (coverage judged
       on all of them), so flipping through keeps a consistent look. */
    var _bl_font = _bltn_msgs.length
        ? _tdf.tdf_pick_font(_bltn_msgs.map(function (m) { return m.subject_raw; }))
        : '';
?>
<style>
.bl-panel {
    --bs-card-border-color: #FFFF55;
    --bs-card-bg: #000;
    --bs-card-cap-bg: #000;
    --bs-card-cap-color: #FFFF55;
    border-color: #FFFF55 !important;
}
/* Head: arrows at the card's edges, level with the "Latest News" title;
   the current bulletin's date and subject centered beneath. */
.bl-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
}
.bl-head #hm-news-title { grid-column: 2; }
.bl-arrow {
    background: transparent;
    border: 1px solid #55FF55;
    color: #FFFF55;
    font-family: inherit;
    font-size: 18px;
    line-height: 1;
    padding: 6px 12px;
    cursor: pointer;
    border-radius: 2px;
}
.bl-arrow:hover { background: #55FF55; color: #000; }
.bl-arrow[hidden] { display: block; visibility: hidden; }
.bl-date {
    color: #55FF55;
    font-size: 1.125em;
    text-align: center;
    margin: 0 0 6px;
}
.bl-subject { padding: 0 14px 10px; border-bottom: 2px solid #FFFF55; }
#bl-subject-title {
    margin: 0;
    color: #FFFF55;
    text-align: center;
    font-size: 1.25rem;
    container-type: inline-size;
    --tdf-max-h: min(2.75rem, 6.5cqi);
    --tdf-max-w: 100%;
}
#bl-subject-title .tdf-art { margin: 0 auto; }
.bl-slide { display: none; padding: 12px 14px; }
.bl-slide.active { display: block; }
.bl-body { color: #FFFFFF; font-size: 0.9em; white-space: pre-wrap; word-wrap: break-word; line-height: 1.45; text-align: center; }
.bl-empty { color: #AA5500; padding: 12px 14px; text-align: center; }
</style>

<div class="card mb-3 bl-panel">
    <div class="bl-head">
        <button type="button" class="bl-arrow" id="bl-prev" title="Previous bulletin" aria-label="Previous bulletin"<?xjs if (_bltn_msgs.length < 2) write(' hidden'); ?>>&laquo;</button>
        <?xjs write(_tdf.tdf_heading('Latest News', { tag: 'h2', id: 'hm-news-title', font: 'random', align: 'center' })); ?>
        <button type="button" class="bl-arrow" id="bl-next" title="Next bulletin" aria-label="Next bulletin"<?xjs if (_bltn_msgs.length < 2) write(' hidden'); ?>>&raquo;</button>
    </div>
<?xjs if (_bltn_msgs.length) { ?>
    <div class="bl-date" id="bl-date"><?xjs write(_homeEsc(_bltn_msgs[0].date)); ?></div>
    <div class="bl-subject" id="bl-subject" data-tdf-font="<?xjs write(_homeEsc(_bl_font)); ?>">
        <?xjs write(_tdf.tdf_heading(_bltn_msgs[0].subject_raw, { tag: 'h3', id: 'bl-subject-title', font: _bl_font || 'random', align: 'center' })); ?>
    </div>
<?xjs } ?>
    <div class="card-body p-0" id="bl-carousel">
<?xjs
    if (_bltn_msgs.length === 0) {
?>
        <div class="bl-empty">No bulletins posted.</div>
<?xjs
    }
    _bltn_msgs.forEach(function (msg, idx) {
?>
        <div class="bl-slide<?xjs if (idx === 0) write(' active'); ?>" data-bl-idx="<?xjs write(idx); ?>" data-bl-subject="<?xjs write(_homeEsc(msg.subject_raw)); ?>" data-bl-date="<?xjs write(_homeEsc(msg.date)); ?>">
            <div class="bl-body"><?xjs write(msg.body); ?></div>
        </div>
<?xjs
    });
?>
    </div>
</div>

<?xjs if (_bltn_msgs.length > 1) { ?>
<script>
/* Bulletin carousel: arrows flip slides; the date and the TDF subject
   follow. Subjects for the other slides are rendered in the same font in
   one batch request after load, then swapped in instantly. */
(function () {
    var slides = document.querySelectorAll('.bl-slide');
    var total = slides.length, cur = 0;
    var dateEl = document.getElementById('bl-date');
    var subjectBox = document.getElementById('bl-subject');
    var font = subjectBox ? subjectBox.getAttribute('data-tdf-font') : '';
    var rendered = {};   /* slide index -> heading html */

    function subjectOf(i) { return slides[i].getAttribute('data-bl-subject'); }

    function prefetch() {
        var idx = [], req = [];
        for (var i = 1; i < total; i++) { idx.push(i); req.push({ tag: 'h3', text: subjectOf(i), align: 'center' }); }
        var url = './api/tdf-heading.ssjs?h=' + encodeURIComponent(JSON.stringify(req)) +
            (font ? '&fonts=' + encodeURIComponent(JSON.stringify({ h3: font })) : '');
        fetch(url, { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (d) { idx.forEach(function (n, k) { if (d.html && d.html[k]) rendered[n] = d.html[k]; }); })
            .catch(function () { /* plain subjects as a fallback */ });
    }

    function showSubject(i) {
        var old = document.getElementById('bl-subject-title');
        if (!old) return;
        var el;
        if (rendered[i]) {
            var tmp = document.createElement('div');
            tmp.innerHTML = rendered[i];
            el = tmp.firstElementChild;
        } else {
            el = document.createElement('h3');
            el.textContent = subjectOf(i);
        }
        el.id = 'bl-subject-title';
        old.replaceWith(el);
        if (window.renderTdfHeadings) renderTdfHeadings(subjectBox);
    }

    function show(i) {
        cur = ((i % total) + total) % total;
        Array.prototype.forEach.call(slides, function (s) { s.classList.remove('active'); });
        slides[cur].classList.add('active');
        if (dateEl) dateEl.textContent = slides[cur].getAttribute('data-bl-date');
        showSubject(cur);
    }

    document.getElementById('bl-prev').addEventListener('click', function () { show(cur - 1); });
    document.getElementById('bl-next').addEventListener('click', function () { show(cur + 1); });
    prefetch();
})();
</script>
<?xjs } ?>
