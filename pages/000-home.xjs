<style>
.bl-panel {
    --bs-card-border-color: #FFFF55;
    --bs-card-bg: #000;
    --bs-card-cap-bg: #000;
    --bs-card-cap-color: #FFFF55;
    border-color: #FFFF55 !important;
}
/* Head: arrows at the card's edges, level with the "Latest News" title;
   the current bulletin's date and subject centered beneath. */
.bl-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
}
.bl-head #hm-news-title { grid-column: 2; }
.bl-arrow {
    background: transparent;
    border: 1px solid #55FF55;
    color: #FFFF55;
    font-family: inherit;
    font-size: 18px;
    line-height: 1;
    padding: 6px 12px;
    cursor: pointer;
    border-radius: 2px;
}
.bl-arrow:hover { background: #55FF55; color: #000; }
.bl-arrow[hidden] { display: block; visibility: hidden; }
.bl-date {
    color: #55FF55;
    font-size: 1.125em;
    text-align: center;
