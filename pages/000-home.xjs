<!--HIDDEN:Home-->

<?xjs
    require('sbbsdefs.js', 'SYS_CLOSED');

    var _tdf = load({}, settings.web_lib + 'tdf-heading.js');

    var _bltn_subcode = 'LOCAL-NOTICES';
    var _bltn_max = 10;
    var _bltn_body_maxlen = 600;
    /* Narrow columns may wrap a host name only before a '.' or ':'. */
    function _hmBreakable(value) {
        return _homeEsc(value).replace(/([.:])/g, '<wbr>$1');
    }

    function _homeEsc(value) {
        return String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    /* Bulletin body -> HTML that keeps its Ctrl-A colors (signatures are
       colored). Hand-rolled because html_encode() hard-wraps at 80 columns.
       Letters krgybmcw set the foreground, digits 0-7 the background, H high
       intensity, N resets; uncolored text inherits the card's white. The
       preview cut counts visible characters only, so it never splits a code. */
    var _CA_LETTERS = 'krgybmcw';
    var _CA_NORMAL = ['#000000', '#AA0000', '#00AA00', '#AA5500', '#0000AA', '#AA00AA', '#00AAAA', '#AAAAAA'];
    var _CA_BRIGHT = ['#555555', '#FF5555', '#55FF55', '#FFFF55', '#5555FF', '#FF55FF', '#55FFFF', '#FFFFFF'];

    function _blBodyHtml(raw) {
        var out = '', run = '', seen = 0, fg = -1, bg = -1, hi = false, open = false, i = 0;
        function style() {
            var css = '';
            if (fg >= 0) css += 'color:' + (hi ? _CA_BRIGHT : _CA_NORMAL)[fg] + ';';
            else if (hi) css += 'color:#FFFFFF;';
            if (bg > 0) css += 'background-color:' + _CA_NORMAL[bg] + ';';
            return css;
        }
        function flush() {
            if (!run) return;
            var css = style();
            out += css ? '<span style="' + css + '">' + _homeEsc(run) + '</span>' : _homeEsc(run);
            run = '';
        }
        for (; i < raw.length && seen < _bltn_body_maxlen; i++) {
            var ch = raw.charAt(i);
            if (ch === '\x01' && i + 1 < raw.length) {
                var code = raw.charAt(++i), lower = code.toLowerCase(), k = _CA_LETTERS.indexOf(lower);
                flush();
                if (k >= 0) fg = k;
                else if (code >= '0' && code <= '7') bg = +code;
                else if (lower === 'h') hi = true;
                else if (lower === 'n') { fg = -1; bg = -1; hi = false; }
                continue;
            }
            run += ch;
            seen++;
        }
        flush();
        if (i < raw.length) out += '...';
        return out.replace(/^\s+/, '');
    }

    /* Message editors hard-wrap at ~79 columns; on the web those breaks
       fight the card's own wrapping. A line that ran near that width was
       wrapped by the editor, so it rejoins the next one. Short lines
       (signatures, deliberate breaks), blank lines and lines that start
       indented or as a list item keep their break. */
    var _BL_SOFT_WRAP = 60;
    function _blUnwrap(text) {
        var lines = text.split('\n'), out = [];
        for (var i = 0; i < lines.length; i++) {
            var line = lines[i];
            var prev = out.length ? out[out.length - 1] : null;
            if (prev !== null && line.replace(/\x01./g, '').trim() !== '' && !/^\s|^(?:\x01.)*\s*(?:[-*+>]|\d+[.)])\s/.test(line)
                && prev.lastLen >= _BL_SOFT_WRAP) {
                prev.text = prev.text.replace(/\s+$/, '') + ' ' + line;
                prev.lastLen = line.replace(/\x01./g, '').length;
                continue;
            }
            out.push({ text: line, lastLen: line.replace(/\x01./g, '').length });
        }
        return out.map(function (o) { return o.text; }).join('\n');
    }

    var _bltn_msgs = [];
    var _bltn_mb = new MsgBase(_bltn_subcode);
    if (_bltn_mb.open()) {
        var _bltn_count = 0;
        for (var _bm = _bltn_mb.last_msg; _bm >= _bltn_mb.first_msg && _bltn_count < _bltn_max; _bm--) {
            var _bh = _bltn_mb.get_msg_header(_bm);
            if (_bh === null || (_bh.attr & MSG_DELETE))
                continue;
            var _bb = _bltn_mb.get_msg_body(_bm) || '';
            _bb = _bb.replace(/\r\n/g, '\n').replace(/\r/g, '\n').replace(/\s+$/, '');
            _bltn_msgs.push({
                subject: _bh.subject.replace(/</g, '&lt;'),
                subject_raw: _bh.subject,
                date: system.timestr(_bh.when_written_time),
                body: _blBodyHtml(_blUnwrap(_bb))
            });
            _bltn_count++;
        }
        _bltn_mb.close();
    }

    /* Connection details for the intro card, read from the live config so
       the page never drifts from what the terminal server actually listens on. */
    var _conn_host = system.inet_addr || system.name;
    /* The original-doors link appears once that wiki page exists. */
    var _doors_wiki = file_exists(system.data_dir + 'wiki/pages/original-doors.jsonl');
    var _conn_telnet = 23;
    var _conn_ssh = 22;
    var _conn_ini = new File(system.ctrl_dir + 'sbbs.ini');
    if (_conn_ini.open('r')) {
        try {
            _conn_telnet = _conn_ini.iniGetValue('BBS', 'TelnetPort', 23);
            _conn_ssh = _conn_ini.iniGetValue('BBS', 'SSHPort', 22);
        } finally { _conn_ini.close(); }
    }
?>

<!-- About + connection info: the plain text crawlers and link previews read -->
<style>
.hm-intro {
    --bs-card-border-color: #AA00AA;
    --bs-card-bg: #000;
    border-color: #AA00AA !important;
    background: #000 !important;
}
.hm-intro { border-bottom-width: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
/* Stacked cards share one edge: the upper card drops its bottom border and
   the lower card draws the seam, blending from the upper card's color
   (--seam-from) into its own (--seam-to). */
.hm-seam { border-top: 0; border-top-left-radius: 0; border-top-right-radius: 0; }
.hm-seam::before {
    content: '';
    position: absolute;
    top: 0;
    left: -1px;
    right: -1px;
    height: 1px;
    background: linear-gradient(to right, var(--seam-from), var(--seam-to));
    pointer-events: none;
    z-index: 1;
}
.bl-panel { --seam-from: #AA00AA; --seam-to: #FFFF55; }
.hm-intro .card-body { padding: 16px 18px 10px; }
#hm-intro-title { margin: 12px 0 24px; container-type: inline-size; cursor: pointer; }
/* The font changes every few seconds; a fixed box (the widest allowed
   shape, 10:1) keeps the text below from jumping. */
#hm-intro-title .tdf-art { aspect-ratio: auto; height: min(7rem, 10cqi); align-items: center; }
.hm-intro-lede a { color: #55FF55; }
.hm-intro .hm-intro-lede { color: #FFFFFF; margin: 0 auto 10px; line-height: 1.5; max-width: 70ch; text-align: center; }
.hm-connect {
    width: 100%;
    max-width: 52rem;
    margin: 0 auto;
    table-layout: fixed;
    border-collapse: collapse;
    text-align: center;
    font-family: inherit;   /* the site's Spleen CP437 face */
}
.hm-connect th, .hm-connect td { padding: 0 8px; line-height: 1.25; vertical-align: top; }
.hm-connect .hm-connect-label th { color: #55FFFF; font-weight: normal; }
.hm-connect td { color: #FFFF55; overflow-wrap: normal; }
.hm-connect td a { color: #55FF55; }
/* Terminal options flow inline (wrapping only on narrow screens). */
.hm-connect-terms > * { display: inline-block; margin: 0 6px; }
.hm-connect-web {
    padding: 0;
    border: 0;
    background: none;
    color: #55FF55;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
}
.hm-connect-web:hover { color: #FFFFFF; }
#hm-news-title { margin: 14px 0 6px; container-type: inline-size; --tdf-max-h: min(3.5rem, 9cqi); --tdf-max-w: 100%; }
#hm-news-title .tdf-art { margin: 0 auto; }
</style>

<section class="card mb-0 hm-intro" aria-labelledby="hm-intro-title">
    <div class="card-body">
        <?xjs write(_tdf.tdf_heading(system.name, { tag: 'h1', id: 'hm-intro-title', font: 'random', align: 'center' })); ?>
        <p class="hm-intro-lede">
            We like to think this might be the most customized Synchronet BBS out there. Alongside the
            classic doors, we write our own, and the board is under constant development<?xjs
    if (_doors_wiki) { ?> (<a href="./?page=010-wiki.xjs#wiki/original-doors">see our original doors</a>)<?xjs } ?>.
            We carry DoveNet, fsxNet and tqwNet, and we're the home and info center of
            <a href="https://futureland.today/cheesenet/" data-no-spa>CheeseNet</a>. Live chat runs across four networks, so there's
            usually someone around to talk to. And we enjoy pushing what a terminal can do: multimedia,
            demoscene tricks, and experimental music and video broadcasts.
        </p>
        <table class="hm-connect">
            <thead>
                <tr class="hm-connect-label"><th scope="col">Telnet</th><th scope="col">SSH</th><th scope="col">Terminal</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td><?xjs write(_hmBreakable(_conn_host + ':' + _conn_telnet)); ?></td>
                    <td><?xjs write(_hmBreakable(_conn_host + ':' + _conn_ssh)); ?></td>
                    <td class="hm-connect-terms"><a href="https://syncterm.bbsdev.net" rel="noopener" data-no-spa>SyncTERM</a> <a href="./?page=010-wiki.xjs#wiki/other-terminals">More</a> <button type="button" class="hm-connect-web" id="hm-connect-web" aria-controls="terminal-panel" title="Open the built-in web terminal">Web</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<script>
/* "Web" in the connection table opens the built-in terminal: the same
   toggle (and connect) as the navbar's terminal button. */
(function () {
    var web = document.getElementById('hm-connect-web');
    if (!web || web.__bound) return;
    web.__bound = true;
    web.addEventListener('click', function () {
        var btn = document.getElementById('btn-terminal');
        if (btn) btn.click();
    });
})();
</script>
<script>
/* Landing title: every 3-5 s a new random font and a new avatar effect;
   a click skips ahead. Fonts come from api/tdf-heading.ssjs in batches of
   10 (one request per ~40 s). Lives here, not in js/, so the service
   worker's asset revision is left alone. Pauses offscreen / hidden tab. */
(function () {
    var head = document.getElementById('hm-intro-title');
    if (!head || head.__hmCycle) return;
    head.__hmCycle = true;
    var MIN_MS = 3000, MAX_MS = 5000, BATCH = 10;
    var variants = [], fetching = false, timer = null, visible = true, effect = null;

    function host() { return head.querySelector('.tdf-art-cells'); }
    function names() { return window.AvatarFx ? AvatarFx.list().map(function (n) { return n.split(':')[1]; }) : []; }
    function nextEffect() {
        var pool = names().filter(function (n) { return n !== effect; });
        effect = pool.length ? pool[Math.floor(Math.random() * pool.length)] : null;
    }
    function play() {
        var h = host();
        if (window.AvatarFx && h && effect && h.querySelector('img')) AvatarFx.play(h, effect);
    }

    function fetchMore() {
        if (fetching) return;
        fetching = true;
        var req = [{ tag: 'h1', text: head.querySelector('.tdf-text').textContent, align: 'center' }];
        fetch('./api/tdf-heading.ssjs?variants=' + BATCH + '&h=' + encodeURIComponent(JSON.stringify(req)), { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (d) { variants = variants.concat(d.html || []); })
            .catch(function () { /* keep the current font */ })
            .then(function () { fetching = false; });
    }

    /* Swap in the next font, then start a new effect once it has drawn. */
    function step() {
        nextEffect();
        var next = null;
        while (variants.length && !next) {
            var tmp = document.createElement('div');
            tmp.innerHTML = variants.shift();
            var h = tmp.firstElementChild;
            if (h && h.getAttribute('data-tdf-font') !== head.getAttribute('data-tdf-font')) next = h;
        }
        if (variants.length < 3) fetchMore();
        var art = next && next.querySelector('.tdf-art'), old = head.querySelector('.tdf-art');
        if (!art || !old || !window.renderTdfHeadings) { play(); return; }
        if (window.AvatarFx && host()) AvatarFx.stop(host());
        head.setAttribute('data-tdf-font', next.getAttribute('data-tdf-font'));
        old.replaceWith(art);
        renderTdfHeadings(head);
        var waited = 0;
        (function whenDrawn() {
            if (host() && host().querySelector('img') && host().querySelector('img').complete) { play(); return; }
            if ((waited += 50) < 3000) setTimeout(whenDrawn, 50);
        })();
    }

    function schedule() {
        clearTimeout(timer);
        timer = setTimeout(function () {
            if (!head.isConnected) return;
            if (visible && !document.hidden) step();
            schedule();
        }, MIN_MS + Math.random() * (MAX_MS - MIN_MS));
    }

    head.addEventListener('click', function () { step(); schedule(); });
    if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
            visible = entries[entries.length - 1].isIntersecting;
            if (!visible && window.AvatarFx && host()) AvatarFx.stop(host());
        }).observe(head);
    }
    fetchMore();
    var waited = 0;
    (function firstPlay() {
        if (host() && host().querySelector('img')) { nextEffect(); play(); return; }
        if ((waited += 100) < 5000) setTimeout(firstPlay, 100);
    })();
    schedule();
})();
</script>

<!-- Header effects: small CGA animations in the gaps between a section's
     arrows and its title (Notices waves, Hot Tracks fire, Art Drops drips,
     Rico coins, Suave lava). -->
<style>
.hm-gap-fx {
    position: absolute;
    bottom: 0;
    width: 0;
    height: 100%;
    image-rendering: pixelated;
    pointer-events: none;
}
.bl-head, .tt-head, .la-head { position: relative; }
</style>
<script>
/* hmGapFx(head, opts) runs an effect in the head's two .hm-gap-fx canvases,
   fitted between opts.prev / opts.next and the title art. One cell is 4 CSS
   pixels. opts.create(geo) is called whenever a canvas is (re)sized, with
   geo = { w, h, side (0 left, 1 right), ox, oy (title center in cells,
   relative to that canvas) }, and returns { cells, step() }: step() advances
   one frame and fills cells (a CGA color index per cell). opts.warm frames
   run up front so it opens mid-flow. Pauses offscreen and in hidden tabs;
   a still frame for reduced motion. */
window.hmGapFx = window.hmGapFx || function (head, opts) {
    if (!head || head.__gapFx) return;
    head.__gapFx = true;
    var CELL = 4, GAP = 10, FPS = opts.fps || 24;
    var CGA = [[0, 0, 0], [0, 0, 170], [0, 170, 0], [0, 170, 170], [170, 0, 0], [170, 0, 170], [170, 85, 0], [170, 170, 170],
        [85, 85, 85], [85, 85, 255], [85, 255, 85], [85, 255, 255], [255, 85, 85], [255, 85, 255], [255, 255, 85], [255, 255, 255]];
    var still = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    var slots = Array.prototype.map.call(head.querySelectorAll('.hm-gap-fx'), function (c) {
        return { canvas: c, key: '', fx: null, ctx: null, img: null };
    });
    var visible = true, timer = null;

    function place() {
        var a = head.querySelector('.tdf-art-inner') || head.querySelector('.tdf-heading');
        if (!a || !opts.prev || !opts.next) return;
        var hr = head.getBoundingClientRect(), ar = a.getBoundingClientRect();
        var spans = [
            [opts.prev.getBoundingClientRect().right - hr.left + GAP, ar.left - hr.left - GAP],
            [ar.right - hr.left + GAP, opts.next.getBoundingClientRect().left - hr.left - GAP]
        ];
        slots.forEach(function (s, i) {
            var left = spans[i][0];
            var w = Math.floor((spans[i][1] - left) / CELL), h = Math.ceil(hr.height / CELL);
            if (w < 4) { s.canvas.style.width = '0'; s.fx = null; s.key = ''; return; }
            s.canvas.style.left = left + 'px';
            s.canvas.style.width = (w * CELL) + 'px';
            var geo = { w: w, h: h, side: i,
                ox: (ar.left + ar.width / 2 - hr.left - left) / CELL,
                oy: (ar.top + ar.height / 2 - hr.top) / CELL };
            var key = w + ',' + h + ',' + Math.round(geo.ox);
            if (key === s.key) return;
            s.key = key;
            s.canvas.width = w; s.canvas.height = h;
            s.ctx = s.canvas.getContext('2d');
            s.img = s.ctx.createImageData(w, h);
            s.fx = opts.create(geo);
            for (var t = 0; t < (opts.warm || 1); t++) s.fx.step();
        });
        draw();
    }

    function draw() {
        slots.forEach(function (s) {
            if (!s.fx) return;
            var c = s.fx.cells, d = s.img.data;
            for (var i = 0; i < c.length; i++) {
                var rgb = CGA[c[i] & 15], o = i * 4;
                d[o] = rgb[0]; d[o + 1] = rgb[1]; d[o + 2] = rgb[2]; d[o + 3] = 255;
            }
            s.ctx.putImageData(s.img, 0, 0);
        });
    }

    function tick() {
        timer = null;
        if (!head.isConnected || !visible || document.hidden) return;
        slots.forEach(function (s) { if (s.fx) s.fx.step(); });
        draw();
        timer = setTimeout(tick, 1000 / FPS);
    }
    function run() { if (!still && !timer) tick(); }

    if ('ResizeObserver' in window) new ResizeObserver(place).observe(head);
    window.addEventListener('resize', place);
    /* The title art arrives as an image after the page renders. */
    var mo = new MutationObserver(function () {
        if (head.querySelector('.tdf-art-cells img')) { mo.disconnect(); place(); }
    });
    mo.observe(head, { childList: true, subtree: true });
    place();
    if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
            visible = entries[entries.length - 1].isIntersecting;
            if (visible) run();
        }).observe(head);
    }
    document.addEventListener('visibilitychange', function () { if (!document.hidden) run(); });
    run();
};
</script>

<!-- Bulletins Carousel -->
<?xjs
    /* Section headings each get their own random font, never the same one. */
    var _news_font = _tdf.tdf_pick_font(['Notices']);
    var _tracks_font = '';
    for (var _tf = 0; _tf < 6 && (!_tracks_font || _tracks_font === _news_font); _tf++) {
        _tracks_font = _tdf.tdf_pick_font(['Hot Tracks']);
    }
    var _art_font = '';
    for (var _af = 0; _af < 6 && (!_art_font || _art_font === _news_font || _art_font === _tracks_font); _af++) {
        _art_font = _tdf.tdf_pick_font(['Art Drops']);
    }
    var _forums_font = '', _posters_font = '', _rico_font = '', _suave_font = '';
    for (var _ff = 0; _ff < 6 && (!_forums_font || [_news_font, _tracks_font, _art_font].indexOf(_forums_font) !== -1); _ff++) {
        _forums_font = _tdf.tdf_pick_font(['Forums']);
    }
    for (var _pf = 0; _pf < 6 && (!_posters_font || [_news_font, _tracks_font, _art_font, _forums_font].indexOf(_posters_font) !== -1); _pf++) {
        _posters_font = _tdf.tdf_pick_font(['Posters']);
    }
    for (var _rf = 0; _rf < 6 && (!_rico_font || [_news_font, _tracks_font, _art_font, _forums_font, _posters_font].indexOf(_rico_font) !== -1); _rf++) {
        _rico_font = _tdf.tdf_pick_font(['Rico']);
    }
    for (var _sf = 0; _sf < 6 && (!_suave_font || [_news_font, _tracks_font, _art_font, _forums_font, _posters_font, _rico_font].indexOf(_suave_font) !== -1); _sf++) {
        _suave_font = _tdf.tdf_pick_font(['Suave']);
    }
    /* Art uploaded before this date isn't shown (the earlier batch was weak). */
    var _art_since = Math.floor(new Date(2026, 8, 23).getTime() / 1000);

    /* Each bulletin's subject gets its own random font (no repeats this
       load), rendered here so flipping back shows the same one. */
    var _bl_used = {};
    _bltn_msgs.forEach(function (m) {
        var f = '';
        for (var t = 0; t < 6 && (!f || _bl_used[f]); t++) f = _tdf.tdf_pick_font([m.subject_raw]);
        _bl_used[f] = true;
        m.heading = _tdf.tdf_heading(m.subject_raw, { tag: 'h3', cls: 'bl-subject-title', font: f || 'random', align: 'center' });
    });
?>
<style>
.bl-panel {
    --bs-card-border-color: #FFFF55;
    --bs-card-bg: #000;
    --bs-card-cap-bg: #000;
    --bs-card-cap-color: #FFFF55;
    border-color: #FFFF55 !important;
}
/* Head: arrows at the card's edges, level with the "Notices" title;
   the current bulletin's date and subject centered beneath. */
.bl-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    border-bottom: 2px solid #FFFF55;
}
.bl-head #hm-news-title { grid-column: 2; }
.bl-arrow {
    background: transparent;
    border: 1px solid #55FF55;
    color: #FFFF55;
    font-family: inherit;
    font-size: 18px;
    line-height: 1;
    padding: 6px 12px;
    cursor: pointer;
    border-radius: 2px;
}
.bl-arrow:hover { background: #55FF55; color: #000; }
.bl-arrow[hidden] { display: block; visibility: hidden; }
.bl-date {
    color: #AAAAAA;
    font-size: 0.85em;
    text-align: center;
    padding: 0 14px;
}
.bl-subject { padding: 12px 14px 4px; }
.bl-subject-title {
    margin: 0;
    color: #FFFF55;
    text-align: center;
    font-size: 1.5rem;
    container-type: inline-size;
    --tdf-max-h: min(3.25rem, 7.75cqi);
    --tdf-max-w: 100%;
}
.bl-subject-title .tdf-art { margin: 0 auto; }
.bl-slide { display: none; padding: 12px 14px; }
.bl-slide.active { display: block; }
/* Same measure as the intro paragraph under the title. */
.bl-body { color: #FFFFFF; white-space: pre-wrap; word-wrap: break-word; line-height: 1.5; text-align: center; max-width: 70ch; margin: 0 auto; }
.bl-empty { color: #AA5500; padding: 12px 14px; text-align: center; }
</style>

<div class="card mb-0 bl-panel hm-seam">
    <div class="bl-head" id="bl-head">
        <canvas class="hm-gap-fx" aria-hidden="true"></canvas>
        <canvas class="hm-gap-fx" aria-hidden="true"></canvas>
        <button type="button" class="bl-arrow" id="bl-prev" title="Previous bulletin" aria-label="Previous bulletin"<?xjs if (_bltn_msgs.length < 2) write(' hidden'); ?>>&laquo;</button>
        <?xjs write(_tdf.tdf_heading('Notices', { tag: 'h2', palette: [[14, 15], [5, 13], [6, 14], [2, 10], [14, 15], [3, 11]], id: 'hm-news-title', font: _news_font || 'random', align: 'center' })); ?>
        <button type="button" class="bl-arrow" id="bl-next" title="Next bulletin" aria-label="Next bulletin"<?xjs if (_bltn_msgs.length < 2) write(' hidden'); ?>>&raquo;</button>
    </div>
