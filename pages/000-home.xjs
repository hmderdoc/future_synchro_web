    padding: 4px 10px;
    cursor: pointer;
    border-radius: 2px;
}
.ahv-nav button:hover:not(:disabled) {
    background: #AAAAAA;
    color: #000;
}
.ahv-nav button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
}
.ahv-panel .card-body {
