        <button class="btn btn-default btn-sm" data-sort="started" onclick="setSort('started')" title="Sort by thread creation date"><span class="bin-icon" data-icon="calendar"></span>Started</button>
        <button class="btn btn-default btn-sm" data-sort="subject" onclick="setSort('subject')" title="Sort alphabetically by subject"><span class="bin-icon" data-icon="doc_edit"></span>Subject</button>
        <button class="btn btn-default btn-sm" data-sort="replies" onclick="setSort('replies')" title="Sort by number of replies"><span class="bin-icon" data-icon="chat_new"></span>Replies</button>
