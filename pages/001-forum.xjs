                    From <strong data-thread-from></strong>
                    on <span data-thread-date-start></span>
                </p>
                <div data-replies hidden>
                    <strong data-message-count></strong>
                    <span data-suffix-reply hidden> reply.</span>
                    <span data-suffix-replies hidden> replies.</span>
                    Latest reply by <strong data-last-from></strong>
                    on <span data-last-time></span>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="pull-right" data-stats hidden>
                    <span data-unread-messages title="Unread messages" class="badge" hidden></span>
                    <span data-upvotes-badge title="Upvotes" class="badge upvote-bg" style="display:none;">
                        <span class="bin-icon bin-icon-sm" data-icon="thumbs_up"></span>
                        <span data-upvotes></span>
                    </span>
                    <span data-downvotes-badge title="Downvotes" class="badge downvote-bg" style="display:none;">
                        <span class="bin-icon bin-icon-sm" data-icon="thumbs_down"></span>
                        <span data-downvotes></span>
                    </span>
                </div>
            </div>
        </div>
    </a>
</div>

