<!--Forum-->

<?xjs
    var request = require({}, settings.web_lib + 'request.js', 'request');
    load(settings.web_lib + 'forum.js');
    locale.section = 'page_forum';

    /* Icon resolution for breadcrumbs */
    var _fIconDir = system.mods_dir;
    if (_fIconDir && _fIconDir.slice(-1) !== '/' && _fIconDir.slice(-1) !== '\\') _fIconDir += '/';
    _fIconDir += 'future_shell/assets/';
    function _fIconFind(name, fallback) {
        if (!name) name = fallback;
        var names = [name];
        if (fallback && fallback !== name) names.push(fallback);
        for (var n = 0; n < names.length; n++) {
            var base = ('' + names[n]).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
            var variants = [names[n], ('' + names[n]).toLowerCase(), base];
            for (var v = 0; v < variants.length; v++) {
                var p = _fIconDir + variants[v] + '.bin';
                try {
                    if (file_exists(p)) {
                        var f = new File(p);
                        if (f.open('rb')) { var d = base64_encode(f.read()); f.close(); return d; }
                    }
                } catch(e) {}
            }
        }
        return null;
    }
?>

<script type="text/javascript" src="./js/xjs-forum.js"></script>
<script type="text/javascript" src="./js/cache.js"></script>

<?xjs
    var _searchScope = 'forum';
    var _searchGroup = '';
    var _searchSub = '';
    var _searchQuery = request.has_param('q') ? request.get_param('q') : '';
    var _searchSort = request.has_param('sort') ? request.get_param('sort') : '';
    var _searchDir = request.has_param('dir') ? request.get_param('dir') : '';
    if (request.has_param('sub') && msg_area.sub[request.get_param('sub')] !== undefined) {
        if (!request.has_param('thread')) {
            _searchScope = 'sub';
            _searchSub = request.get_param('sub');
            _searchGroup = String(msg_area.sub[request.get_param('sub')].grp_index);
        }
    } else if (request.has_param('group') && msg_area.grp_list[request.get_param('group')] !== undefined) {
        _searchScope = 'group';
        _searchGroup = request.get_param('group');
    }
?>

<? if (!request.has_param('thread')) { ?>
<div id="forum-search-bar" data-scope="<? write(_searchScope); ?>" data-group="<? write(_searchGroup); ?>" data-sub="<? write(_searchSub); ?>">
    <div class="input-group" style="margin-bottom:0.75em;">
        <input type="text" id="forum-search-input" class="form-control" placeholder="Search forums..." value="<? write(_searchQuery.replace(/"/g, '&quot;')); ?>" />
        <span class="input-group-btn">
            <button id="forum-search-scope-btn" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button">
                <span id="forum-search-scope-label"></span> <span class="caret"></span>
            </button>
            <ul id="forum-search-scope-menu" class="dropdown-menu dropdown-menu-right"></ul>
            <button id="forum-search-btn" class="btn btn-default" type="button" onclick="searchForum()">
                <span class="bin-icon bin-icon-sm" data-icon="search"></span>
            </button>
            <button id="forum-search-clear" class="btn btn-default" type="button" onclick="clearSearch()" hidden>
                <span class="bin-icon bin-icon-sm" data-icon="stop"></span>
            </button>
        </span>
    </div>
</div>
<script type="text/javascript">
    (function() {
        var bar = document.getElementById('forum-search-bar');
        if (!bar) return;
        var scope = bar.getAttribute('data-scope');
        var group = bar.getAttribute('data-group');
        var sub = bar.getAttribute('data-sub');
        var label = document.getElementById('forum-search-scope-label');
        var menu = document.getElementById('forum-search-scope-menu');

        var scopes = [{ key: 'forum', label: 'All Forums' }];
        if (group) scopes.push({ key: 'group', label: 'This Group' });
        if (sub) scopes.push({ key: 'sub', label: 'This Sub' });

        function setScope(s) {
            bar.setAttribute('data-scope', s);
            for (var i = 0; i < scopes.length; i++) {
                if (scopes[i].key === s) { label.textContent = scopes[i].label; break; }
            }
        }
        menu.innerHTML = '';
        for (var i = 0; i < scopes.length; i++) {
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = '#';
            a.textContent = scopes[i].label;
            a.setAttribute('data-scope', scopes[i].key);
            a.onclick = (function(s) { return function(e) { e.preventDefault(); setScope(s); }; })(scopes[i].key);
            li.appendChild(a);
            menu.appendChild(li);
        }
        setScope(scope);

        var input = document.getElementById('forum-search-input');
        if (input) {
            input.addEventListener('keydown', function(e) {
                e.stopImmediatePropagation();
                if (e.keyCode === 13) searchForum();
            });
        }

        if (input && input.value) {
            document.getElementById('forum-search-clear').removeAttribute('hidden');
        }
    })();
</script>

<!-- Search result template (available at all view levels) -->
<div hidden>
    <a id="forum-search-result-template" href="#" class="list-group-item striped" data-thread>
        <div class="row">
            <div class="col-sm-9">
                <strong data-thread-subject></strong>
                <span data-search-sub-badge class="badge" style="margin-left:0.5em;background:#5bc0de;" hidden></span>
