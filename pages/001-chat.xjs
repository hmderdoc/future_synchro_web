</div>

<script>
(function () {
    'use strict';

    var chatService = window.ChatService || null;
    var sbbsConfig = window.sbbsConfig || {};
    var isLoggedIn = !!sbbsConfig.isLoggedIn;
    var userAlias = String(sbbsConfig.userAlias || '');
    var userSystemName = String(sbbsConfig.systemName || '');
    var users = chatService && chatService.getUsersSnapshot ? chatService.getUsersSnapshot() : [];

    var sidebar = document.querySelector('.chat-web-sidebar');
    var roomsList = document.getElementById('chat-rooms');
    var privateList = document.getElementById('chat-private');
    var mobileRoomsToggle = document.getElementById('chat-mobile-rooms-toggle');
    var mobilePrivateToggle = document.getElementById('chat-mobile-private-toggle');
    var pickerModal = document.getElementById('chat-room-picker-modal');
    var pickerTitle = document.getElementById('chat-room-picker-title');
    var pickerText = document.getElementById('chat-room-picker-text');
    var pickerList = document.getElementById('chat-room-picker-list');
    var pickerForm = document.getElementById('chat-room-picker-form');
    var pickerInput = document.getElementById('chat-room-picker-input');
    var pickerSubmit = document.getElementById('chat-room-picker-submit');
    var pickerClose = document.getElementById('chat-room-picker-close');
    var pickerCancel = document.getElementById('chat-room-picker-cancel');
    var pickerMode = ''; /* 'local' (join a room here) | 'mrc' (change MRC room) */
    var pickerRefreshTimer = 0;
    var motdActions = document.getElementById('chat-motd-actions');
    var noRoomsModal = document.getElementById('chat-norooms-modal');
    var noRoomsMain = document.getElementById('chat-norooms-main');
    var noRoomsPick = document.getElementById('chat-norooms-pick');
    var noRoomsClose = document.getElementById('chat-norooms-close');
    var noRoomsCancel = document.getElementById('chat-norooms-cancel');
    var usersModal = document.getElementById('chat-users-modal');
    var viewLabel = document.getElementById('chat-view-label');
    var userCount = document.getElementById('chat-user-count');
    var statusBox = document.getElementById('chat-status');
    var statusText = document.getElementById('chat-status-text');
    var statusRetry = document.getElementById('chat-status-retry');
    var usersPanel = document.getElementById('chat-users-panel');
    var usersTitle = document.getElementById('chat-users-title');
    var usersList = document.getElementById('chat-users-list');
    var usersClose = document.getElementById('chat-users-close');
    var msgContainer = document.getElementById('chat-messages');
    var chatInput = document.getElementById('chat-input');
    var chatText = document.getElementById('chat-text');
    var usersPanelRoom = getActiveView().currentChannel || 'main';
    var usersPanelUsers = Array.isArray(users) ? users.slice() : [];
    var usersPanelRequestToken = 0;
    var forceMessageScrollToBottom = true;
    var messageBottomLocked = true;
    var pendingMessageScrollFrame = 0;
    var compactSidebarMedia = window.matchMedia ? window.matchMedia('(max-width: 980px)') : null;
    var wasCompactSidebarLayout = compactSidebarMedia ? compactSidebarMedia.matches : (window.innerWidth <= 980);
    var onCompactSidebarMediaChanged = null;
    var onCompactSidebarWindowResize = null;

    function trimText(value) {
        return String(value || '').replace(/^\s+|\s+$/g, '');
    }

    function isCompactSidebarLayout() {
        if (compactSidebarMedia && typeof compactSidebarMedia.matches === 'boolean') {
            return compactSidebarMedia.matches;
        }
        return window.innerWidth <= 980;
    }

    function syncMobileSidebarButtons(activePanel) {
        var roomsActive = activePanel === 'rooms';
        var privateActive = activePanel === 'private';

        if (mobileRoomsToggle) {
            mobileRoomsToggle.classList.toggle('is-active', roomsActive);
            mobileRoomsToggle.setAttribute('aria-expanded', roomsActive ? 'true' : 'false');
        }
        if (mobilePrivateToggle) {
            mobilePrivateToggle.classList.toggle('is-active', privateActive);
            mobilePrivateToggle.setAttribute('aria-expanded', privateActive ? 'true' : 'false');
        }
    }

    function setMobileSidebarPanel(panelName) {
        var nextPanel = panelName === 'rooms' || panelName === 'private' ? panelName : '';

        if (sidebar) {
            sidebar.setAttribute('data-mobile-panel', nextPanel);
        }
        syncMobileSidebarButtons(nextPanel);
    }

    function collapseMobileSidebarPanels() {
        if (!isCompactSidebarLayout()) {
            return;
        }
        setMobileSidebarPanel('');
    }

    function toggleMobileSidebarPanel(panelName) {
        var currentPanel;

        if (!isCompactSidebarLayout()) {
            return;
        }
        currentPanel = sidebar ? (sidebar.getAttribute('data-mobile-panel') || '') : '';
        setMobileSidebarPanel(currentPanel === panelName ? '' : panelName);
    }

    function syncMobileSidebarLayout(forceCollapse) {
        var isCompact = isCompactSidebarLayout();
        var currentPanel = sidebar ? (sidebar.getAttribute('data-mobile-panel') || '') : '';

        if (!sidebar) {
            return;
        }

        if (isCompact) {
            if (!wasCompactSidebarLayout || forceCollapse) {
                currentPanel = '';
            }
            setMobileSidebarPanel(currentPanel);
        } else {
            sidebar.setAttribute('data-mobile-panel', '');
            syncMobileSidebarButtons('');
        }

        wasCompactSidebarLayout = isCompact;
    }

    function getMessageBottomGap() {
        if (!msgContainer) {
            return 0;
        }
        return Math.max(0, msgContainer.scrollHeight - msgContainer.clientHeight - msgContainer.scrollTop);
    }

    function isMessageListNearBottom() {
        return getMessageBottomGap() <= 32;
    }

    function cancelPendingMessageScroll() {
        if (!pendingMessageScrollFrame) {
            return;
        }
        window.cancelAnimationFrame(pendingMessageScrollFrame);
        pendingMessageScrollFrame = 0;
    }

    function jumpMessagesToBottom() {
        if (!msgContainer) {
            return;
        }
        msgContainer.scrollTop = msgContainer.scrollHeight;
    }

    function queueMessageScrollToBottom() {
        cancelPendingMessageScroll();
        pendingMessageScrollFrame = window.requestAnimationFrame(function () {
            pendingMessageScrollFrame = 0;
            jumpMessagesToBottom();
            window.requestAnimationFrame(jumpMessagesToBottom);
        });
    }

    function syncMessageBottomLock() {
        messageBottomLocked = forceMessageScrollToBottom || isMessageListNearBottom();
        if (!messageBottomLocked && !forceMessageScrollToBottom) {
            cancelPendingMessageScroll();
        }
    }

    function normalizeUpper(value) {
        return trimText(value).toUpperCase();
    }

    function sanitizeChannelName(raw) {
        var channel = String(raw || 'main').replace(/[^a-zA-Z0-9_-]/g, '');
        return channel.length ? channel : 'main';
    }

    function sanitizeAlias(raw) {
        return trimText(String(raw || '')).replace(/[\x00-\x1f]/g, '').substr(0, 60);
    }

    function buildThreadKey(name, system) {
        return normalizeUpper(name).replace(/[^A-Z0-9]/g, '') + '|' + normalizeUpper(system);
    }

    /* The person menu's handoff: the global (SPA navigation) or its
       sessionStorage copy (survives the service-worker reload); either way
       it is consumed once and only while fresh. */
    function takeHandoff(key) {
        var value = window[key] || null;
        var raw = null;
        window[key] = null;
        try {
            raw = window.sessionStorage.getItem('fl.' + key);
            if (raw !== null) window.sessionStorage.removeItem('fl.' + key);
        } catch (_e) { raw = null; }
        if (value) return value;
        if (!raw) return null;
        try {
            var parsed = JSON.parse(raw);
            if (parsed && parsed.value && Date.now() - (parsed.at || 0) < 60000) return parsed.value;
        } catch (_e2) { }
        return null;
    }

    function parseRoute() {
        var params;

        /* The person menu sets this just before navigating here; the SPA
           pushes the new URL only after this page's scripts ran, so the
           query string is not yet trustworthy at init. */
        var handed = takeHandoff('__pendingPrivateThread');
        if (handed && typeof handed === 'object' && handed.name) {
            return {
                channel: 'main',
                privateName: sanitizeAlias(handed.name),
                privateSystem: trimText(handed.system || ''),
                privateBridge: normalizeBridge(handed.bridge || '')
            };
        }

        try {
            params = new URLSearchParams(window.location.search);
        } catch (_error) {
            return {
                channel: 'main',
                privateName: '',
                privateSystem: '',
                privateBridge: ''
            };
        }

        return {
            channel: sanitizeChannelName(params.get('channel') || 'main'),
            privateName: sanitizeAlias(params.get('private') || ''),
            privateSystem: trimText(params.get('system') || ''),
            privateBridge: normalizeBridge(params.get('bridge') || '')
        };
    }

    function normalizeBridge(raw) {
        var key = String(raw || '').toLowerCase();
        return key === 'mrc' || key === 'ddial' ? key : '';
    }

    function bridgeLabel(net) {
        return net === 'mrc' ? 'MRC' : (net === 'ddial' ? 'DDial' : '');
    }

    function escapeHtml(str) {
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str || ''));
        return div.innerHTML;
    }

    function escapeAttr(str) {
        return escapeHtml(str || '').replace(/"/g, '&quot;');
    }

    function linkify(text) {
        return escapeHtml(text || '').replace(/(https?:\/\/[^\s<]+)/gi, '<a href="$1" target="_blank" rel="noopener">$1</a>');
    }

    function filenameTitle(name) {
        return String(name || '')
            .replace(/\.mp3$/i, '')
            .replace(/_/g, ' ')
            .replace(/\s+/g, ' ')
            .replace(/^\s+|\s+$/g, '');
    }

    function formatSeconds(seconds) {
        var total = parseInt(seconds, 10);
        var mins;
        var secs;

        if (!isFinite(total) || total < 0) return '';
        mins = Math.floor(total / 60);
        secs = total % 60;
        return mins > 0 ? (mins + 'm ' + secs + 's') : (secs + 's');
    }

    function normalizeTrackLookupText(value) {
        return trimText(String(value || ''))
            .toLowerCase()
            .replace(/[\u2018\u2019]/g, "'")
            .replace(/[\u201c\u201d]/g, '"')
            .replace(/feat\./g, 'feat')
            .replace(/[^a-z0-9]+/g, ' ')
            .replace(/\s+/g, ' ');
    }

    function extractAudioTitleHint(label) {
        var quoted = String(label || '').match(/"([^"]+)"/);
        var byline;

        if (quoted && trimText(quoted[1]).length) {
            return trimText(quoted[1]);
        }

        byline = String(label || '').match(/^(.+?)\s+by\s+/i);
        if (byline && trimText(byline[1]).length) {
            return trimText(byline[1]).replace(/^["']|["']$/g, '');
        }

        return trimText(String(label || '').replace(/^["']|["']$/g, ''));
    }

    function parseUploadMeta(text) {
        var match = String(text || '').match(/(?:^|\s)(?:--|—|–|-)?\s*uploaded to\s+([A-Z0-9_]+)\s*\((\d+)s\)\s*$/i);

        if (!match) return null;
        return {
            dirCode: match[1],
            dirCodeLower: String(match[1] || '').toLowerCase(),
            seconds: parseInt(match[2], 10) || 0,
            matchText: match[0]
        };
    }

    function parseAudioEmbed(text) {
        var match = String(text || '').match(/^\s*(?:🎵\s*)?\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)\s*(?:--|—|–|-)\s*uploaded to\s+([A-Z0-9_]+)\s*\((\d+)s\)\s*$/i);

        if (!match) return null;

        return {
            label: trimText(match[1]),
            titleHint: extractAudioTitleHint(match[1]),
            url: match[2],
            dirCode: match[3],
            dirCodeLower: String(match[3] || '').toLowerCase(),
            seconds: parseInt(match[4], 10) || 0
        };
    }

    function parseImageEmbed(text) {
        var source = String(text || '');
        var match = /!\[([^\]]*)\]\((https?:\/\/[^\s)]+)\)/i.exec(source);
        var suffixMeta;
        var suffixText;

        if (!match) return null;

        suffixText = source.slice(match.index + match[0].length);
        suffixMeta = parseUploadMeta(suffixText);

        if (suffixMeta) {
            suffixText = suffixText.replace(suffixMeta.matchText, '');
        }

        return {
            prefixText: source.slice(0, match.index),
            alt: trimText(match[1]),
            url: match[2],
            suffixText: suffixText,
            uploadMeta: suffixMeta
        };
    }

    function renderAudioEmbedHtml(embed) {
        var durationText = formatSeconds(embed.seconds);

        if (embed.dirCodeLower !== 'originalcontent_mp3s') {
            return '<a href="' + escapeAttr(embed.url) + '" target="_blank" rel="noopener">' + escapeHtml(embed.label) + '</a>';
        }

        return '<div class="chat-rich-audio-card" data-chat-audio-card="1" data-chat-audio-label="' + escapeAttr(embed.label) + '" data-chat-audio-title="' + escapeAttr(embed.titleHint) + '" data-chat-audio-url="' + escapeAttr(embed.url) + '" data-chat-audio-dir="' + escapeAttr(embed.dirCodeLower) + '">' +
            '<div class="chat-rich-audio-main">' +
            '<div class="chat-rich-audio-icon" aria-hidden="true">&#9835;</div>' +
            '<div class="chat-rich-audio-copy">' +
            '<div class="chat-rich-audio-title">' + escapeHtml(embed.label) + '</div>' +
            '<div class="chat-rich-audio-meta">' + escapeHtml(embed.dirCode) + (durationText.length ? (' • ' + escapeHtml(durationText)) : '') + '</div>' +
            '</div>' +
            '<button type="button" class="chat-rich-audio-button" data-chat-audio-play="1" disabled>Loading Track</button>' +
            '</div>' +
            '<div class="chat-rich-audio-actions">' +
            '<a class="chat-rich-audio-link" href="' + escapeAttr(embed.url) + '" target="_blank" rel="noopener">Open Upload</a>' +
            '<span class="chat-rich-audio-status" data-chat-audio-status>Resolving track…</span>' +
            '</div>' +
            '</div>';
    }

    function renderImageEmbedHtml(embed) {
        var parts = [];
        var suffixText = trimText(embed.suffixText);
        var durationText = embed.uploadMeta ? formatSeconds(embed.uploadMeta.seconds) : '';

        if (trimText(embed.prefixText).length) {
            parts.push('<div class="chat-rich-text">' + linkify(trimText(embed.prefixText)) + '</div>');
        }

        var nsfwImage = !!(window.ChatEmbeds && ChatEmbeds.isNsfwText && (ChatEmbeds.isNsfwText(embed.url) || ChatEmbeds.isNsfwText(embed.alt || '')));
        parts.push(
            '<div class="chat-rich-image-card' + (nsfwImage ? ' is-nsfw' : '') + '">' +
                '<a class="chat-rich-image-link" href="' + escapeAttr(embed.url) + '" target="_blank" rel="noopener">' +
                    '<span class="chat-rich-image-frame">' +
                        '<img class="chat-rich-image-preview" src="' + escapeAttr(embed.url) + '" alt="' + escapeAttr(embed.alt || 'Chat image') + '" loading="lazy">' +
                        (nsfwImage ? '<span class="chat-rich-nsfw-veil" data-chat-nsfw-reveal>NSFW<small>click to reveal</small></span>' : '') +
                    '</span>' +
                    '<span class="chat-rich-image-fallback">Open image</span>' +
                '</a>' +
                (embed.alt.length ? ('<div class="chat-rich-image-caption">' + escapeHtml(embed.alt) + '</div>') : '') +
                (embed.uploadMeta ? ('<div class="chat-rich-image-meta">' + escapeHtml(embed.uploadMeta.dirCode) + (durationText.length ? (' • ' + escapeHtml(durationText)) : '') + '</div>') : '') +
            '</div>'
        );

        if (suffixText.length) {
            parts.push('<div class="chat-rich-text">' + linkify(suffixText) + '</div>');
        }

        return '<div class="chat-rich-block">' + parts.join('') + '</div>';
    }

    function renderRichMessageHtml(text, colorRuns) {
        var audioEmbed = parseAudioEmbed(text);
        var imageEmbed;

        if (audioEmbed) {
            return renderAudioEmbedHtml(audioEmbed);
        }

        imageEmbed = parseImageEmbed(text);
        if (imageEmbed) {
            return renderImageEmbedHtml(imageEmbed);
        }

        // Bare URLs: image/video/audio/YouTube/Vimeo cards + OpenGraph link
        // previews (chat-embeds.js). Cards are stateless — playback lives in
        // the floating dock, so the full transcript re-render can't kill it.
        if (window.ChatEmbeds) {
            return ChatEmbeds.renderRichHtml(text || '', { allowLinkPreviews: isLoggedIn, colorRuns: colorRuns || null });
        }

        return linkify(text || '');
    }

    function formatTime(ts) {
        if (!ts) return '';
        var d = new Date(ts);
        var h = d.getHours();
        var m = d.getMinutes();
        var ampm = h >= 12 ? 'PM' : 'AM';
        h = h % 12 || 12;
        return h + ':' + (m < 10 ? '0' : '') + m + ' ' + ampm;
    }

    function getRooms() {
        return chatService && chatService.getRooms ? chatService.getRooms() : [];
    }

    function getPrivateThreads() {
        return chatService && chatService.getPrivateThreads ? chatService.getPrivateThreads() : [];
    }

    function getMessages() {
        return chatService && chatService.getMessages ? chatService.getMessages() : [];
    }

    function getActiveView() {
        return chatService && chatService.getActiveView ? chatService.getActiveView() : {
            type: 'channel',
            name: 'main',
            system: '',
            avatar: '',
            currentChannel: 'main'
        };
    }

    /* BBS name beside a sender; MRC boards colour theirs with Mystic pipe
       codes (`systemPipe`). */
    function renderSystemName(message) {
        if (message.systemPipe && window.ChatEmbeds && ChatEmbeds.colorizePipeLabel) {
            return ChatEmbeds.colorizePipeLabel(message.systemPipe);
        }
        return escapeHtml(message.system);
    }

    function getCurrentChannelName() {
        var activeView = getActiveView();
        return sanitizeChannelName(activeView.currentChannel || (activeView.type === 'channel' ? activeView.name : 'main') || 'main');
    }

    function updateQueryString(view) {
        var next;

        if (!window.history || !window.history.replaceState) {
            return;
        }

        next = new URL(window.location.href);
        if (view.type === 'private') {
            next.searchParams.set('channel', view.currentChannel || 'main');
            next.searchParams.set('private', view.name);
            if (view.system) {
                next.searchParams.set('system', view.system);
            } else {
                next.searchParams.delete('system');
            }
            if (view.bridge) {
                next.searchParams.set('bridge', view.bridge);
            } else {
                next.searchParams.delete('bridge');
            }
        } else {
            next.searchParams.set('channel', view.name || 'main');
            next.searchParams.delete('private');
            next.searchParams.delete('system');
            next.searchParams.delete('bridge');
        }

        window.history.replaceState({}, '', next.toString());
    }

    function renderEmbeddedAvatars(root) {
        if (chatService && chatService._renderEmbeddedAvatars) {
            chatService._renderEmbeddedAvatars(root);
        }
    }

    function renderEmbeddedBitmaps(root) {
        if (chatService && chatService._renderEmbeddedBitmaps) {
            chatService._renderEmbeddedBitmaps(root);
        }
    }

    function renderLocalAvatars(root) {
        var scope = root || document;
        var avatarEls;
        var ids = [];

        if (typeof Avatars === 'undefined' || !Avatars.draw) {
            return;
        }

        avatarEls = scope.querySelectorAll('div[data-avatar]');
        avatarEls.forEach(function (el) {
            var id = el.getAttribute('data-avatar');
            if (id && id !== '0') {
                ids.push(id);
            }
        });

        if (ids.length) {
            Avatars.draw(ids);
        }
    }

    function renderAvatarFallbacks(root) {
        var scope = root || document;
        var placeholders = scope.querySelectorAll('.chat-web-avatar-placeholder[data-initial], .chat-avatar-placeholder[data-initial]');

        placeholders.forEach(function (el) {
            if (el.parentNode && el.parentNode.children.length > 1) {
                el.remove();
            }
        });
    }

    function renderStatus(status) {
        if (!statusBox || !statusText) {
            return;
        }

        statusBox.classList.remove('is-visible', 'is-warning', 'is-error');
        if (!status || !status.message) {
            statusText.textContent = '';
            if (statusRetry) statusRetry.style.display = 'none';
            return;
        }

        /* Guest users: show informational note instead of error+retry */
        if (!isLoggedIn && status.showRetry) {
            statusText.textContent = 'Viewing recent chat history. Log in for live updates and messaging.';
            statusBox.classList.add('is-visible', 'is-warning');
            if (statusRetry) statusRetry.style.display = 'none';
            return;
        }

        statusText.textContent = status.message;
        statusBox.classList.add('is-visible');
        statusBox.classList.add(status.type === 'error' ? 'is-error' : 'is-warning');
        if (statusRetry) {
            statusRetry.style.display = (isLoggedIn && status.showRetry) ? '' : 'none';
        }
    }

    function renderUsersTitle() {
        if (!usersTitle) {
            return;
        }

        usersTitle.textContent = 'Users in #' + sanitizeChannelName(usersPanelRoom || getCurrentChannelName());
    }

    function loadUsersForRoom(roomName, silent) {
        var requestedRoom = sanitizeChannelName(roomName || getCurrentChannelName());
        var requestToken = ++usersPanelRequestToken;

        return window.fetch('./api/chat.ssjs?action=who&channel=' + encodeURIComponent(requestedRoom), {
            credentials: 'same-origin'
        }).then(function (response) {
            if (!response.ok) {
                throw new Error('Unable to fetch room roster');
            }

            return response.json();
        }).then(function (payload) {
            if (payload && payload.error) {
                throw new Error(String(payload.error));
            }
            if (
                requestToken !== usersPanelRequestToken ||
                normalizeUpper(usersPanelRoom) !== normalizeUpper(requestedRoom)
            ) {
                return false;
            }

            usersPanelUsers = payload && Array.isArray(payload.users) ? payload.users : [];
            renderUsers();
            return true;
        }).catch(function () {
            if (!silent) {
                renderStatus({
                    type: 'warning',
                    message: 'Unable to load the room user list right now.',
                    showRetry: false
                });
            }
            return false;
        });
    }

    function openUsersPanelForRoom(roomName) {
        usersPanelRoom = sanitizeChannelName(roomName || getCurrentChannelName());
        renderUsersTitle();
        if (usersModal) {
            usersModal.classList.add('is-open');
            usersModal.setAttribute('aria-hidden', 'false');
        }

        if (normalizeUpper(usersPanelRoom) === normalizeUpper(getCurrentChannelName())) {
            usersPanelUsers = Array.isArray(users) ? users.slice() : [];
            renderUsers();
        }

        loadUsersForRoom(usersPanelRoom, true);
    }

    function closeUsersModal() {
        if (!usersModal) {
            return;
        }

        usersModal.classList.remove('is-open');
        usersModal.setAttribute('aria-hidden', 'true');
    }

    function renderLockedRoomHtml() {
        var currentChannel = getCurrentChannelName();
        var count = 0;
        var last = 0;
        var facts = [];

        getRooms().forEach(function (room) {
            if (normalizeUpper(room.name) === normalizeUpper(currentChannel)) {
                count = typeof room.userCount === 'number' ? room.userCount : 0;
                last = room.lastTimestamp || 0;
            }
        });

        facts.push(String(count) + ' user' + (count === 1 ? '' : 's') + ' here');
        if (last > 0) {
            facts.push('last message ' + formatTime(last));
        }

        return '<div class="chat-web-empty chat-web-locked">' +
            '<div class="chat-web-locked-title">Login to see messages</div>' +
            '<div class="chat-web-locked-facts">#' + escapeHtml(sanitizeChannelName(currentChannel)) +
            ' &middot; ' + escapeHtml(facts.join(' \u00b7 ')) + '</div>' +
            '</div>';
    }

    function updateUserCountButton() {
        var currentChannel = getCurrentChannelName();
        var count = users.length;
        var rooms = getRooms();

        rooms.forEach(function (room) {
            if (normalizeUpper(room.name) === normalizeUpper(currentChannel)) {
                count = typeof room.userCount === 'number' ? room.userCount : count;
            }
        });

        if (userCount) {
            userCount.textContent = String(count) + ' user' + (count === 1 ? '' : 's');
        }
    }

    /* DDial / MRC rooms relay plain text: the ANSI editor's bitmap posts
       can't cross those networks, so the button is hidden there. */
    function currentBridge() {
        var view = getActiveView();
        if (view.type === 'private') return '';
        var current = normalizeUpper(getCurrentChannelName());
        var room = getRooms().filter(function (r) { return normalizeUpper(r.name) === current; })[0];
        return room && room.bridge ? String(room.bridge) : '';
    }

    function updateComposer() {
        var activeView = getActiveView();
        var ansiButton = document.getElementById('chat-ansi-toggle');
        if (ansiButton) ansiButton.hidden = !!currentBridge();
        if (!chatText) return;

        if (activeView.type === 'private') {
            chatText.placeholder = 'Message @' + activeView.name +
                (activeView.bridge ? ' on ' + bridgeLabel(activeView.bridge) : '') + '...';
            return;
        }

        chatText.placeholder = 'Message #' + (activeView.name || 'main') + '...';
    }

    function renderViewLabel(view) {
        var activeView = view || getActiveView();

        if (!viewLabel) return;
        if (activeView.type === 'private') {
            viewLabel.textContent = '@' + activeView.name + (activeView.bridge ? ' (' + bridgeLabel(activeView.bridge) + ')' : '');
        } else {
            viewLabel.textContent = '#' + (activeView.name || 'main');
        }
    }

    /* Room picker. One modal, two jobs: join-or-create a room of this BBS
       (the list is every public room, from the room summaries), or change
       MRC room (the server's LIST reply, cached by the mux; it trickles in,
       so a pending answer is re-asked). */
    function renderPickerList(mode, result) {
        var current = mode === 'mrc'
            ? normalizeUpper(result.room || chatService.getBridgeRoom('mrc') || '')
            : normalizeUpper(getCurrentChannelName());
        var rooms = result.rooms || [];
        var html = '';

        if (!pickerList) return;
        if (!rooms.length) {
            html = '<div class="chat-web-nav-empty">' +
                (mode === 'mrc'
                    ? (result.pending ? 'Asking MRC for its room list...' : 'MRC did not list any rooms. Type one below.')
                    : 'No public rooms yet. Type a name below to create one.') + '</div>';
        } else {
            rooms.forEach(function (room) {
                var isCurrent = normalizeUpper(room.name) === current;
                var state = isCurrent ? 'Current' : (room.joined ? 'Joined' : '');
                html += '<button type="button" class="chat-picker-room' + (isCurrent ? ' is-current' : '') +
                    '" data-picker-room="' + escapeAttr(room.name) + '">' +
                    '<span class="chat-picker-room-name">#' + escapeHtml(room.name) + '</span>' +
                    (typeof room.userCount === 'number'
                        ? '<span class="chat-picker-room-count">' + escapeHtml(String(room.userCount)) + ' user' + (room.userCount === 1 ? '' : 's') + '</span>'
                        : '') +
                    (state ? '<span class="chat-web-nav-state">' + state + '</span>' : '') +
                    '</button>';
            });
            if (result.pending) {
                html += '<div class="chat-web-nav-empty">Refreshing...</div>';
            }
        }
        pickerList.innerHTML = html;
    }

    function loadPickerRooms(mode, retries) {
        if (pickerRefreshTimer) {
            clearTimeout(pickerRefreshTimer);
            pickerRefreshTimer = 0;
        }
        if (mode === 'local') {
            var local = getRooms().filter(function (room) { return !room.bridge; }).map(function (room) {
                return { name: room.name, userCount: room.userCount || 0, joined: !!room.joined };
            });
            local.sort(function (a, b) {
                if ((a.userCount || 0) !== (b.userCount || 0)) return (b.userCount || 0) - (a.userCount || 0);
                return String(a.name).localeCompare(String(b.name));
            });
            renderPickerList('local', { rooms: local, pending: false });
            return;
        }
        chatService.fetchBridgeRooms('mrc').then(function (result) {
            if (!pickerModal || !pickerModal.classList.contains('is-open') || pickerMode !== 'mrc') return;
            renderPickerList('mrc', result);
            if (result.pending && retries > 0) {
                pickerRefreshTimer = setTimeout(function () { loadPickerRooms('mrc', retries - 1); }, 2500);
            }
        }).catch(function (error) {
            if (pickerList) {
                pickerList.innerHTML = '<div class="chat-web-nav-empty">' +
                    escapeHtml(error && error.message ? error.message : 'MRC is unavailable right now') + '</div>';
            }
        });
    }

    function isPickerOpen() {
        return !!(pickerModal && pickerModal.classList.contains('is-open'));
    }

    function openRoomPicker(mode) {
        if (!pickerModal) return;
        pickerMode = mode === 'mrc' ? 'mrc' : 'local';
        if (pickerTitle) pickerTitle.textContent = pickerMode === 'mrc' ? 'MRC Rooms' : 'Join a Room';
        if (pickerText) {
            pickerText.textContent = pickerMode === 'mrc'
                ? 'Your MRC session moves to the room you pick.'
                : 'Pick a room, or type a new name (letters, numbers, _ or -) to create one.';
        }
        if (pickerInput) {
            pickerInput.value = '';
            pickerInput.placeholder = pickerMode === 'mrc' ? '#room' : 'new-room';
            pickerInput.maxLength = pickerMode === 'mrc' ? 30 : 32;
        }
        if (pickerSubmit) pickerSubmit.textContent = pickerMode === 'mrc' ? 'Go' : 'Join';
        pickerModal.classList.add('is-open');
        pickerModal.setAttribute('aria-hidden', 'false');
        if (pickerList && pickerMode === 'mrc') {
            pickerList.innerHTML = '<div class="chat-web-nav-empty">Asking MRC for its room list...</div>';
        }
        loadPickerRooms(pickerMode, 2);
        if (pickerInput) pickerInput.focus();
    }

    function closeRoomPicker() {
        if (!pickerModal) return;
        if (pickerRefreshTimer) {
            clearTimeout(pickerRefreshTimer);
            pickerRefreshTimer = 0;
        }
        pickerModal.classList.remove('is-open');
        pickerModal.setAttribute('aria-hidden', 'true');
        pickerMode = '';
    }

    function pickRoom(name) {
        if (pickerMode === 'mrc') {
            var mrcName = String(name || '').replace(/^#/, '').replace(/[^A-Za-z0-9_.-]/g, '').substr(0, 30);
            if (!mrcName.length) return;
            closeRoomPicker();
            chatService.setBridgeRoom('mrc', mrcName);
            collapseMobileSidebarPanels();
            return;
        }
        var raw = trimText(String(name || '').replace(/^#/, ''));
        var next = sanitizeChannelName(raw);
        if (!raw.length || !next.length) return;
        chatService.joinRoom(next).then(function (ok) {
            if (!ok) return;
            closeRoomPicker();
            collapseMobileSidebarPanels();
        });
    }

    /* Leave one of this BBS's rooms; when it was the last one, offer #main. */
    function leaveLocalRoom(name) {
        chatService.leaveRoom(name).then(function () {
            if (!chatService.hasJoinedRooms()) {
                openNoRoomsModal();
            }
        });
    }

    function openNoRoomsModal() {
        if (!noRoomsModal) return;
        noRoomsModal.classList.add('is-open');
        noRoomsModal.setAttribute('aria-hidden', 'false');
        if (noRoomsMain) noRoomsMain.focus();
    }

    function closeNoRoomsModal() {
        if (!noRoomsModal) return;
        noRoomsModal.classList.remove('is-open');
        noRoomsModal.setAttribute('aria-hidden', 'true');
    }

    function isNoRoomsOpen() {
        return !!(noRoomsModal && noRoomsModal.classList.contains('is-open'));
    }

    /* Banner above the transcript while the user is in no room at all. */
    function renderNoRoomsBanner() {
        var view = getActiveView();
        if (!isLoggedIn || view.type !== 'channel' || currentBridge() || chatService.hasJoinedRooms()) {
            return '';
        }
        return '<div class="chat-web-norooms">You are not in any chat rooms.' +
            '<button type="button" class="chat-motd-action is-primary" data-join-main>Join #main</button>' +
            '<button type="button" class="chat-motd-action" data-open-picker>Pick a room</button></div>';
    }

    function roomRowTitle(room) {
        if (room.bridge === 'mrc') return 'MRC' + (room.room ? ' #' + room.room : '');
        if (room.bridge === 'ddial') return 'DDial';
        return '#' + room.name;
    }

    /* The sidebar is the switcher: every room the user is in (joined local
       rooms + the networks), unread first, then most recent; the open one is
       highlighted. Local rows get an X to leave; MRC gets a room switch and,
       while on the network, an X to log off; DDial is select-only. */
    function renderRooms() {
        var rooms = getRooms().filter(function (room) { return room.joined || room.bridge; }).slice();
        var html = '';
        var currentChannel = getCurrentChannelName();
        var inPrivate = getActiveView().type === 'private';

        /* This BBS's own rooms first, the networks after; within each,
           unread, then most recent. */
        rooms.sort(function (a, b) {
            var aNet = a.bridge ? 1 : 0;
            var bNet = b.bridge ? 1 : 0;
            var aUnread = (a.unreadCount || 0) > 0 ? 1 : 0;
            var bUnread = (b.unreadCount || 0) > 0 ? 1 : 0;

            if (aNet !== bNet) {
                return aNet - bNet;
            }
            if (aUnread !== bUnread) {
                return bUnread - aUnread;
            }
            if ((a.lastTimestamp || 0) !== (b.lastTimestamp || 0)) {
                return (b.lastTimestamp || 0) - (a.lastTimestamp || 0);
            }
            return String(a.name).localeCompare(String(b.name));
        });

        if (!rooms.length) {
            roomsList.innerHTML = '<div class="chat-web-nav-empty">No rooms yet.</div>';
            updateUserCountButton();
            return;
        }

        rooms.forEach(function (room) {
            var isCurrent = !inPrivate && normalizeUpper(room.name) === normalizeUpper(currentChannel);
            var isMain = !room.bridge && normalizeUpper(room.name) === 'MAIN';
            var label = roomRowTitle(room);

            html += '<div class="chat-web-nav-item chat-web-room' + (isCurrent ? ' is-active' : '') +
                '" role="button" tabindex="0" data-room-open="' + escapeAttr(room.name) + '">';
            html += '<div class="chat-web-nav-top">';
            if (room.bridge) {
                html += '<span class="chat-web-presence-dot ' + (room.held ? 'is-online' : 'is-offline') + '" aria-hidden="true" title="' +
                    (room.held ? 'You are on this network' : 'Not connected') + '"></span>';
            }
            html += '<span class="chat-web-nav-title">' + escapeHtml(label) + '</span>';
            if (room.bridge) {
                html += '<span class="chat-web-net-pill">' + escapeHtml(bridgeLabel(room.bridge)) + '</span>';
            }
            if ((room.unreadCount || 0) > 0) {
                html += '<span class="chat-web-badge is-unread">' + escapeHtml(String(room.unreadCount)) + '</span>';
            }
            html += '<span class="chat-web-nav-icons">';
            if (room.bridge === 'mrc') {
                html += '<button type="button" class="chat-web-nav-icon" data-room-switch="mrc" title="Change MRC room" aria-label="Change MRC room">&#8644;</button>';
            }
            if (!room.bridge && !isMain) {
                html += '<button type="button" class="chat-web-nav-icon is-leave" data-room-leave="' + escapeAttr(room.name) + '" title="Leave #' + escapeAttr(room.name) + '" aria-label="Leave #' + escapeAttr(room.name) + '">&times;</button>';
            }
            if (room.bridge === 'mrc' && room.held) {
                html += '<button type="button" class="chat-web-nav-icon is-leave" data-room-leave="mrc" title="Log off MRC" aria-label="Log off MRC">&times;</button>';
            }
            html += '</span>';
            html += '</div>';
            html += '<div class="chat-web-nav-secondary">' + escapeHtml(String(room.userCount || 0)) + ' user' + ((room.userCount || 0) === 1 ? '' : 's') +
                (isCurrent ? ' \u00b7 Current' : '') + '</div>';
            html += '<div class="chat-web-nav-actions">';
            html += '<button type="button" class="chat-web-nav-action" data-room-users="' + escapeAttr(room.name) + '">Users</button>';
            html += '</div>';
            html += '</div>';
        });

        roomsList.innerHTML = html;
        updateUserCountButton();
    }

    function renderPrivateThreads() {
        var threads = getPrivateThreads().slice();
        var html = '';

        /* Unread first, then whoever is online, then most recent; the open
           thread only breaks ties (it is highlighted wherever it lands). */
        threads.sort(function (a, b) {
            var aUnread = (a.unreadCount || 0) > 0 ? 1 : 0;
            var bUnread = (b.unreadCount || 0) > 0 ? 1 : 0;
            var aOnline = a.isOnline ? 1 : 0;
            var bOnline = b.isOnline ? 1 : 0;

            if (aUnread !== bUnread) {
                return bUnread - aUnread;
            }
            if (aOnline !== bOnline) {
                return bOnline - aOnline;
            }
            if ((a.lastTimestamp || 0) !== (b.lastTimestamp || 0)) {
                return (b.lastTimestamp || 0) - (a.lastTimestamp || 0);
            }
            return (b.isActive ? 1 : 0) - (a.isActive ? 1 : 0);
        });

        if (!threads.length) {
            privateList.innerHTML = '<div class="chat-web-nav-empty">No private chats yet.</div>';
            return;
        }

        threads.forEach(function (thread) {
            var initial = thread.name ? thread.name.charAt(0).toUpperCase() : '?';
            var statusClass = thread.isOnline ? 'is-online' : 'is-offline';
            var attrs = ' data-private-nav="' + escapeAttr(thread.name) + '" data-private-system="' + escapeAttr(thread.system || '') +
                '" data-private-bridge="' + escapeAttr(thread.bridge || '') + '" data-private-avatar="' + escapeAttr(thread.avatar || '') + '"';

            /* A div, not a button: the row carries its own dismiss button. */
            html += '<div class="chat-web-nav-item chat-web-thread' + (thread.isActive ? ' is-active' : '') + '" role="button" tabindex="0"' + attrs + '>';
            html += '<div class="chat-web-thread-row">';
            html += '<span class="chat-web-presence-dot ' + statusClass + '" aria-hidden="true"></span>';
            html += '<div class="chat-web-thread-avatar">';
            if (thread.avatar) {
                html += '<div data-avatar-bin="' + escapeAttr(thread.avatar) + '"></div>';
            } else {
                html += '<div class="chat-web-avatar-placeholder" data-initial="' + escapeAttr(initial) + '">' + escapeHtml(initial) + '</div>';
            }
            html += '</div>';
            html += '<div>';
            html += '<div class="chat-web-nav-top">';
            html += '<span class="chat-web-nav-title is-user">@' + escapeHtml(thread.name) + '</span>';
            if (thread.bridge) {
                html += '<span class="chat-web-net-pill">' + escapeHtml(bridgeLabel(thread.bridge)) + '</span>';
            }
            if ((thread.unreadCount || 0) > 0) {
                html += '<span class="chat-web-badge is-unread">' + escapeHtml(String(thread.unreadCount)) + '</span>';
            }
            html += '</div>';
            if (thread.system) {
                html += '<div class="chat-web-nav-secondary chat-web-system-name">' + escapeHtml(thread.system) + '</div>';
            }
            if (thread.preview) {
                html += '<div class="chat-web-nav-preview">' + escapeHtml(thread.preview) + '</div>';
            }
            html += '</div>';
            html += '</div>';
            html += '<button type="button" class="chat-web-thread-dismiss" data-private-dismiss aria-label="Dismiss chat with ' + escapeAttr(thread.name) + '" title="Dismiss (comes back on a new message)">&times;</button>';
            html += '</div>';
        });

        privateList.innerHTML = html;
        renderEmbeddedAvatars(privateList);
        renderAvatarFallbacks(privateList);
    }

    function renderUsers() {
        var html = '';
        var visibleUsers = Array.isArray(usersPanelUsers) ? usersPanelUsers : [];

        if (!usersList) {
            return;
        }

        renderUsersTitle();

        if (!isLoggedIn) {
            usersList.innerHTML = '<div class="chat-web-empty">Login to see who is here.</div>';
            updateUserCountButton();
            return;
        }

        if (!visibleUsers.length) {
            usersList.innerHTML = '<div class="chat-web-empty">No users in #' + escapeHtml(sanitizeChannelName(usersPanelRoom || getCurrentChannelName())) + '.</div>';
            updateUserCountButton();
            return;
        }

        visibleUsers.forEach(function (entry) {
            var initial = entry.nick ? entry.nick.charAt(0).toUpperCase() : '?';

            html += '<button type="button" class="chat-web-user" data-private-user="' + escapeAttr(entry.nick || '') + '" data-private-system="' + escapeAttr(entry.system || '') + '" data-private-bridge="' + escapeAttr(entry.bridge || '') + '" data-private-avatar="' + escapeAttr(entry.avatar || '') + '">';
            html += '<div class="chat-web-user-avatar">';
            if (entry.avatar) {
                html += '<div data-avatar-bin="' + escapeAttr(entry.avatar) + '"></div>';
            } else if (entry.userNumber && entry.userNumber > 0) {
                html += '<div data-avatar="' + String(entry.userNumber) + '"></div>';
            } else {
                html += '<div class="chat-web-avatar-placeholder" data-initial="' + escapeAttr(initial) + '">' + escapeHtml(initial) + '</div>';
            }
            html += '</div>';
            html += '<div>';
            var nameHtml = (entry.nick && entry.nickColors && window.ChatEmbeds && ChatEmbeds.colorizeRuns)
                ? ChatEmbeds.colorizeRuns(entry.nick, entry.nickColors, escapeHtml) : null;
            html += '<div><strong class="chat-web-user-name">' + (nameHtml || escapeHtml(entry.nick || 'Unknown')) + '</strong></div>';
            if (entry.system) {
                html += '<div class="chat-web-channel chat-web-system-name">' + escapeHtml(entry.system) + '</div>';
            }
            html += '</div></button>';
        });

        usersList.innerHTML = html;
        renderEmbeddedAvatars(usersList);
        renderLocalAvatars(usersList);
        renderAvatarFallbacks(usersList);
        updateUserCountButton();
    }

    function buildActorAttrs(message, isSelf) {
        if (isSelf || !message.sender) {
            return '';
        }

        return ' data-private-user="' + escapeAttr(message.sender) + '"' +
            ' data-private-system="' + escapeAttr(message.system || '') + '"' +
            ' data-private-bridge="' + escapeAttr(message.bridge || '') + '"' +
            ' data-private-avatar="' + escapeAttr(message.avatar || '') + '"';
    }

    function renderBitmapBubble(message) {
        var cols = Math.max(1, message.bitmapWidth || 80);
        var rows = Math.max(1, message.bitmapHeight || 25);
        var pixelWidth = cols * 8;
        var pixelHeight = rows * 16;
        var label = 'image ' + cols + 'x' + rows;

        return '<div class="chat-bitmap-shell" style="' + escapeAttr('max-width:' + pixelWidth + 'px;') + '">' +
            '<div class="chat-bitmap-frame">' +
            '<div class="chat-bitmap-stage" data-chat-bitmap-key="' + escapeAttr(message.bitmapKey || '') + '" data-chat-bitmap-alt="' + escapeAttr(label) + '" data-chat-bitmap-ts="' + escapeAttr(String(message.timestamp || 0)) + '" style="' + escapeAttr('aspect-ratio:' + pixelWidth + ' / ' + pixelHeight + ';') + '">' +
            '<div class="chat-bitmap-placeholder">Rendering ' + escapeHtml(label) + '...</div>' +
            '</div>' +
            '</div>' +
            '</div>';
    }

    var CHAT_AUDIO_DIR = 'originalcontent_mp3s';
    var chatAudioCatalogPromise = null;
    var chatAudioCatalog = null;

    function addTrackLookupKeys(target, seen, value) {
        var key = normalizeTrackLookupText(value);

        if (!key.length || seen[key]) return;
        seen[key] = true;
        target.push(key);
    }

    function buildChatAudioCatalogEntry(item) {
        var name = String((item && item.name) || '');
        var desc = String((item && item.desc) || '');
        var title = filenameTitle(name);
        var keys = [];
        var seen = {};

        addTrackLookupKeys(keys, seen, name);
        addTrackLookupKeys(keys, seen, title);
        addTrackLookupKeys(keys, seen, desc);

        return {
            name: name,
            desc: desc,
            title: title,
            matchKeys: keys
        };
    }

    function loadChatAudioCatalog() {
        if (chatAudioCatalog) {
            return Promise.resolve(chatAudioCatalog);
        }
        if (chatAudioCatalogPromise) {
            return chatAudioCatalogPromise;
        }

        chatAudioCatalogPromise = window.fetch('./api/files.ssjs?call=list-files&dir=' + CHAT_AUDIO_DIR, {
            credentials: 'same-origin'
        })
            .then(function (response) { return response.json(); })
            .then(function (list) {
                var catalog = {
                    entries: [],
                    lookup: {}
                };

                if (!Array.isArray(list)) {
                    return catalog;
                }

                catalog.entries = list.map(buildChatAudioCatalogEntry).filter(function (entry) {
                    return entry.name.length > 0;
                });

                catalog.entries.forEach(function (entry) {
                    entry.matchKeys.forEach(function (key) {
                        if (!catalog.lookup[key]) {
                            catalog.lookup[key] = [];
                        }
                        catalog.lookup[key].push(entry);
                    });
                });

                chatAudioCatalog = catalog;
                return catalog;
            })
            .catch(function (error) {
                console.error('[chat] audio catalog load failed:', error);
                chatAudioCatalogPromise = null;
                return {
                    entries: [],
                    lookup: {}
                };
            });

        return chatAudioCatalogPromise;
    }

    function resolveChatAudioTrack(card, catalog) {
        var label = card.getAttribute('data-chat-audio-label') || '';
        var title = card.getAttribute('data-chat-audio-title') || '';
        var candidateKeys = [];
        var seen = {};
        var exactMatches;
        var i;

        function pushCandidate(value) {
            var key = normalizeTrackLookupText(value);
            if (!key.length || seen[key]) return;
            seen[key] = true;
            candidateKeys.push(key);
        }

        pushCandidate(label);
        pushCandidate(title);

        for (i = 0; i < candidateKeys.length; i += 1) {
            exactMatches = catalog.lookup[candidateKeys[i]] || [];
            if (exactMatches.length === 1) {
                return exactMatches[0];
            }
        }

        for (i = 0; i < candidateKeys.length; i += 1) {
            exactMatches = catalog.lookup[candidateKeys[i]] || [];
            if (exactMatches.length > 0) {
                return exactMatches[0];
            }
        }

        if (candidateKeys.length) {
            for (i = 0; i < catalog.entries.length; i += 1) {
                if (catalog.entries[i].matchKeys.indexOf(candidateKeys[0]) >= 0) {
                    return catalog.entries[i];
                }
            }
        }

        return null;
    }

    function updateChatAudioPlaybackState(root) {
        var scope = root || document;
        var cards = scope.querySelectorAll('[data-chat-audio-card]');
        var currentTrack = window.sbbsRadio && window.sbbsRadio.currentTrackFile
            ? window.sbbsRadio.currentTrackFile
            : '';
        var isPlaying = !!(window.sbbsRadio && window.sbbsRadio.isPlaying);

        cards.forEach(function (card) {
            var button = card.querySelector('[data-chat-audio-play]');
            var status = card.querySelector('[data-chat-audio-status]');
            var trackName = card.getAttribute('data-chat-track-name') || '';

            if (!button || !status) return;

            if (!trackName.length) {
                button.disabled = true;
                if (card.classList.contains('is-missing')) {
                    button.textContent = 'Track Missing';
                    status.textContent = 'Could not match this upload to the radio playlist';
                } else {
                    button.textContent = 'Loading Track';
                    status.textContent = 'Resolving track…';
                }
                return;
            }

            card.classList.add('is-ready');
            card.classList.remove('is-missing');

            if (currentTrack === trackName && isPlaying) {
                button.disabled = true;
                button.textContent = 'Now Playing';
                status.textContent = 'Playing in Futureland Records';
            } else if (currentTrack === trackName) {
                button.disabled = false;
                button.textContent = 'Resume Track';
                status.textContent = 'Loaded in Futureland Records';
            } else {
                button.disabled = false;
                button.textContent = 'Play Track';
                status.textContent = 'Ready in Futureland Records';
            }
        });
    }

    function hydrateChatAudioEmbeds(root) {
        var scope = root || document;
        var cards = scope.querySelectorAll('[data-chat-audio-card]');

        if (!cards.length) return;

        loadChatAudioCatalog().then(function (catalog) {
            cards.forEach(function (card) {
                var button = card.querySelector('[data-chat-audio-play]');
                var status = card.querySelector('[data-chat-audio-status]');
                var entry;

                if (!button || !status) return;
                if ((card.getAttribute('data-chat-audio-dir') || '') !== CHAT_AUDIO_DIR) return;

                entry = resolveChatAudioTrack(card, catalog);
                if (entry) {
                    card.setAttribute('data-chat-track-name', entry.name);
                    updateChatAudioPlaybackState(card.parentNode || scope);
                    return;
                }

                card.classList.add('is-missing');
                button.disabled = true;
                button.textContent = 'Track Missing';
                status.textContent = 'Could not match this upload to the radio playlist';
            });
        });
    }

    function hydrateChatImageEmbeds(root) {
        var scope = root || document;
        var images = scope.querySelectorAll('.chat-rich-image-preview');

        images.forEach(function (img) {
            if (img.dataset.bound === '1') return;
            img.dataset.bound = '1';
            img.addEventListener('error', function () {
                var card = img.closest('.chat-rich-image-card');
                if (card) {
                    card.classList.add('is-error');
                }
            });
        });
    }

    function hydrateRichChatEmbeds(root) {
        hydrateChatImageEmbeds(root);
        hydrateChatAudioEmbeds(root);
    }

    function playChatAudioCard(button) {
        var card = button && button.closest('[data-chat-audio-card]');
        var trackName = card ? (card.getAttribute('data-chat-track-name') || '') : '';
        var radio = window.sbbsRadio;
        var playButton;

        if (!card || !trackName.length) return;

        if (radio && radio.currentTrackFile === trackName) {
            document.dispatchEvent(new CustomEvent('viz:open'));
            if (!radio.isPlaying) {
                playButton = document.getElementById('radio-play');
                if (playButton) {
                    playButton.click();
                }
            }
            updateChatAudioPlaybackState(msgContainer || document);
            return;
        }

        document.dispatchEvent(new CustomEvent('viz:picktrack', {
            detail: { name: trackName }
        }));
        document.dispatchEvent(new CustomEvent('viz:open'));
        window.setTimeout(function () {
            updateChatAudioPlaybackState(msgContainer || document);
        }, 80);
    }

    function renderMessages() {
        var msgs = getMessages();
        var html = '';
        var prevSender = '';
        var prevTime = 0;
        var groupWindow = 120000;
        var shouldStickToBottom = forceMessageScrollToBottom || isMessageListNearBottom();
        var previousScrollTop = msgContainer ? msgContainer.scrollTop : 0;

        if (!isLoggedIn && getActiveView().type !== 'private') {
            // The server sends guests no message content (api/chat.ssjs
            // isAuthedUser); show that the room is alive without showing it.
            msgContainer.innerHTML = renderLockedRoomHtml();
            messageBottomLocked = true;
            forceMessageScrollToBottom = false;
            return;
        }

        if (!msgs.length) {
            msgContainer.innerHTML = renderNoRoomsBanner() + '<div class="chat-web-empty">No messages yet. Say hello.</div>';
            messageBottomLocked = true;
            forceMessageScrollToBottom = false;
            queueMessageScrollToBottom();
            return;
        }
        html += renderNoRoomsBanner();

        var hiddenBySender = 0;
        msgs.forEach(function (message) {
            // The ignore list is shared with the terminal shell (person menu > Ignore).
            if (!message.isSelf && message.sender && window.PersonMenu && PersonMenu.isIgnored(message.sender, message.bridge || 'local')) { hiddenBySender++; return; }
            var displaySender = message.sender || message.bitmapFromName || '';
            if (!displaySender && message.kind === 'bitmap' && message.bitmapKey) {
                displaySender = 'Image';
            }
            var isSystem = !displaySender;
            var isSelf = !!message.isSelf;
            var sameGroup = displaySender === prevSender && Math.abs((message.timestamp || 0) - prevTime) < groupWindow;
            var avatarInitial = displaySender ? displaySender.charAt(0).toUpperCase() : '?';
            var actorAttrs = buildActorAttrs(message, isSelf);

            if (!isSelf && userAlias) {
                isSelf =
                    normalizeUpper(displaySender) === normalizeUpper(userAlias) &&
                    (!message.system || !userSystemName || normalizeUpper(message.system) === normalizeUpper(userSystemName));
            }

            if (isSystem) {
                // Close the open group first: a notice left inside it nests
                // every later group one level deeper, and each level is
                // another max-width: 88% of the last.
                if (prevSender.length) {
                    html += '</div></div>';
                }
                html += '<div class="chat-system-msg">' + escapeHtml(message.text || '') + '</div>';
                prevSender = '';
                prevTime = 0;
                return;
            }

            if (!sameGroup) {
                if (prevSender.length) {
                    html += '</div></div>';
                }

                html += '<div class="chat-msg-group ' + (isSelf ? 'chat-msg-group-self' : 'chat-msg-group-other') + '">';
                if (actorAttrs.length) {
                    html += '<button type="button" class="chat-avatar chat-web-actor"' + actorAttrs + '>';
                } else {
                    html += '<div class="chat-avatar">';
                }

                if (message.avatar) {
                    html += '<div data-avatar-bin="' + escapeAttr(message.avatar) + '"></div>';
                } else if (message.userNumber && message.userNumber > 0) {
                    html += '<div data-avatar="' + String(message.userNumber) + '"></div>';
                } else {
                    html += '<div class="chat-avatar-placeholder" data-initial="' + escapeAttr(avatarInitial) + '">' + escapeHtml(avatarInitial) + '</div>';
                }

                html += actorAttrs.length ? '</button>' : '</div>';
                html += '<div class="chat-msg-content">';
                html += '<div class="chat-header">';
                if (actorAttrs.length) {
                    html += '<button type="button" class="chat-sender chat-web-sender-button"' + actorAttrs + '>';
                } else {
                    html += '<div class="chat-sender">';
                }
                // Bridged DDial names arrive with the net's own handle colours.
                var senderHtml = (message.senderColors && window.ChatEmbeds && ChatEmbeds.colorizeRuns)
                    ? ChatEmbeds.colorizeRuns(displaySender, message.senderColors, escapeHtml) : null;
                html += '<strong class="chat-sender-name">' + (senderHtml === null ? escapeHtml(displaySender) : senderHtml) + '</strong>';
                if (message.system) {
                    html += ' <span class="chat-web-channel chat-web-system-name">' + renderSystemName(message) + '</span>';
                }
                html += ' <small class="chat-timestamp">' + escapeHtml(formatTime(message.timestamp)) + '</small>';
                if (actorAttrs.length) {
                    html += '</button>';
                } else {
                    html += '</div>';
                }
                html += '</div>';
            }

            if (message.kind === 'bitmap' && message.bitmapKey) {
                html += '<div class="chat-bubble ' + (isSelf ? 'chat-bubble-self' : 'chat-bubble-other') + ' chat-bitmap-bubble">' + renderBitmapBubble(message) + '</div>';
            } else {
                html += '<div class="chat-bubble ' + (isSelf ? 'chat-bubble-self' : 'chat-bubble-other') + '">' + renderRichMessageHtml(message.text || '', message.textColors) + '</div>';
            }
            prevSender = displaySender;
            prevTime = message.timestamp || 0;
        });

        if (prevSender.length) {
            html += '</div></div>';
        }

        msgContainer.innerHTML = html;
        renderEmbeddedAvatars(msgContainer);
        renderEmbeddedBitmaps(msgContainer);
        hydrateRichChatEmbeds(msgContainer);
        if (window.ChatEmbeds) {
            ChatEmbeds.init(msgContainer);
            ChatEmbeds.hydrate(msgContainer, { enabled: isLoggedIn });
        }
        renderLocalAvatars(msgContainer);
        renderAvatarFallbacks(msgContainer);
        if (shouldStickToBottom) {
            messageBottomLocked = true;
            queueMessageScrollToBottom();
        } else {
            msgContainer.scrollTop = previousScrollTop;
            syncMessageBottomLock();
        }
        forceMessageScrollToBottom = false;
    }

    function renderAll() {
        var activeView = getActiveView();
        renderViewLabel(activeView);
        renderStatus(chatService && chatService.getStatus ? chatService.getStatus() : {});
        renderRooms();
        renderPrivateThreads();
        renderUsers();
        renderMessages();
        updateQueryString(activeView);
        updateComposer();
    }

    function syncRouteIntoService() {
        var route = parseRoute();
        var activeView = getActiveView();

        if (route.privateName.length && isLoggedIn) {
            if (
                activeView.type !== 'private' ||
                normalizeUpper(activeView.name || '') !== normalizeUpper(route.privateName) ||
                normalizeUpper(activeView.system || '') !== normalizeUpper(route.privateSystem) ||
                (activeView.bridge || '') !== route.privateBridge
            ) {
                chatService.openPrivateThread(route.privateName, route.privateSystem, '', route.privateBridge);
                return true;
            }
            return false;
        }

        if (
            activeView.type !== 'channel' ||
            normalizeUpper(activeView.name || '') !== normalizeUpper(route.channel)
        ) {
            chatService.setActiveChannel(route.channel);
            return true;
        }

        return false;
    }

    function onMessagesUpdated() {
        renderMessages();
    }

    function onRoomsUpdated() {
        renderRooms();
        refreshMotdBar();
        updateComposer();
        if (isPickerOpen() && pickerMode === 'local') loadPickerRooms('local', 0);
        /* Membership changed under the transcript: add or drop the banner. */
        if (msgContainer) {
            var bannerShown = msgContainer.querySelector('.chat-web-norooms') !== null;
            var bannerWanted = renderNoRoomsBanner().length > 0;
            if (bannerShown !== bannerWanted) renderMessages();
        }
    }

    function onPrivateUpdated() {
        renderPrivateThreads();
    }

    function onUsersUpdated(e) {
        users = e.detail || [];
        if (normalizeUpper(usersPanelRoom) === normalizeUpper(getCurrentChannelName())) {
            usersPanelUsers = Array.isArray(users) ? users.slice() : [];
            renderUsers();
        }
    }

    function onStatusUpdated(e) {
        renderStatus(e.detail || {});
    }

    function onRadioPlaybackChanged() {
        updateChatAudioPlaybackState(msgContainer || document);
    }

    function onViewChanged(e) {
        var view = e.detail || getActiveView();
        forceMessageScrollToBottom = true;
        renderViewLabel(view);
        renderRooms();
        refreshMotdBar();
        renderPrivateThreads();
        updateQueryString(view);
        updateComposer();
        collapseMobileSidebarPanels();
    }

    function openPrivateFromButton(button) {
        var name;

        if (!button || !chatService || !chatService.openPrivateThread) {
            return;
        }

        name = button.getAttribute('data-private-user') || button.getAttribute('data-private-nav');
        if (!name) {
            return;
        }

        chatService.openPrivateThread(
            name,
            button.getAttribute('data-private-system'),
            button.getAttribute('data-private-avatar'),
            button.getAttribute('data-private-bridge')
        );
        collapseMobileSidebarPanels();
    }

    function dismissThreadFromButton(button) {
        var row = button ? button.closest('[data-private-nav]') : null;
        if (!row || !chatService || !chatService.dismissPrivateThread) {
            return;
        }
        chatService.dismissPrivateThread(
            row.getAttribute('data-private-nav'),
            row.getAttribute('data-private-system'),
            row.getAttribute('data-private-bridge')
        );
    }

    if (!chatService) {
        renderStatus({
            type: 'error',
            message: 'Chat service is not available on this page.',
            showRetry: false
        });
        return;
    }

    window.addEventListener('chat:messagesUpdated', onMessagesUpdated);
    window.addEventListener('chat:roomsUpdated', onRoomsUpdated);
    window.addEventListener('chat:privateUpdated', onPrivateUpdated);
    window.addEventListener('chat:usersUpdated', onUsersUpdated);
    window.addEventListener('chat:status', onStatusUpdated);
    window.addEventListener('chat:viewChanged', onViewChanged);

    if (usersClose) {
        usersClose.addEventListener('click', closeUsersModal);
    }

    if (mobileRoomsToggle) {
        mobileRoomsToggle.addEventListener('click', function () {
            toggleMobileSidebarPanel('rooms');
        });
    }

    if (mobilePrivateToggle) {
        mobilePrivateToggle.addEventListener('click', function () {
            toggleMobileSidebarPanel('private');
        });
    }

    if (compactSidebarMedia && compactSidebarMedia.addEventListener) {
        onCompactSidebarMediaChanged = function () {
            syncMobileSidebarLayout(false);
        };
        compactSidebarMedia.addEventListener('change', onCompactSidebarMediaChanged);
    } else {
        onCompactSidebarWindowResize = function () {
            syncMobileSidebarLayout(false);
        };
        window.addEventListener('resize', onCompactSidebarWindowResize);
    }

    if (statusRetry) {
        statusRetry.addEventListener('click', function () {
            chatService.retrySync();
        });
    }

    if (roomsList) {
        roomsList.addEventListener('click', function (event) {
            var switchButton = event.target.closest('[data-room-switch]');
            var leaveButton = event.target.closest('[data-room-leave]');
            var usersButton = event.target.closest('[data-room-users]');
            var row = event.target.closest('[data-room-open]');

            if (switchButton) {
                event.stopPropagation();
                openRoomPicker('mrc');
                return;
            }
            if (leaveButton) {
                event.stopPropagation();
                var leaving = leaveButton.getAttribute('data-room-leave');
                if (normalizeBridge(leaving)) {
                    chatService.leaveBridge(leaving);
                } else {
                    leaveLocalRoom(leaving);
                }
                return;
            }
            if (usersButton) {
                event.stopPropagation();
                openUsersPanelForRoom(usersButton.getAttribute('data-room-users'));
                return;
            }
            if (row) {
                chatService.setActiveChannel(row.getAttribute('data-room-open'));
                collapseMobileSidebarPanels();
            }
        });
        /* Room rows are divs: keyboard-open them. */
        roomsList.addEventListener('keydown', function (event) {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            if (event.target.closest('button')) return;
            var row = event.target.closest('[data-room-open]');
            if (!row) return;
            event.preventDefault();
            chatService.setActiveChannel(row.getAttribute('data-room-open'));
            collapseMobileSidebarPanels();
        });
    }

    if (privateList) {
        privateList.addEventListener('click', function (event) {
            var dismiss = event.target.closest('[data-private-dismiss]');
            if (dismiss) {
                event.stopPropagation();
                dismissThreadFromButton(dismiss);
                return;
            }
            openPrivateFromButton(event.target.closest('[data-private-nav]'));
        });
        /* Thread rows are divs (see renderPrivateThreads): keyboard-open them. */
        privateList.addEventListener('keydown', function (event) {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            if (event.target.closest('[data-private-dismiss]')) return;
            var row = event.target.closest('[data-private-nav]');
            if (!row) return;
            event.preventDefault();
            openPrivateFromButton(row);
        });
    }

    if (pickerList) {
        pickerList.addEventListener('click', function (event) {
            var pick = event.target.closest('[data-picker-room]');
            if (pick) {
                pickRoom(pick.getAttribute('data-picker-room'));
            }
        });
    }
    if (pickerForm) {
        pickerForm.addEventListener('submit', function (event) {
            event.preventDefault();
            pickRoom(pickerInput ? pickerInput.value : '');
        });
    }
    if (pickerClose) {
        pickerClose.addEventListener('click', closeRoomPicker);
    }
    if (pickerCancel) {
        pickerCancel.addEventListener('click', closeRoomPicker);
    }
    if (pickerModal) {
        pickerModal.addEventListener('click', function (event) {
            if (event.target === pickerModal) {
                closeRoomPicker();
            }
        });
    }
    if (motdActions) {
        motdActions.addEventListener('click', function (event) {
            var target = event.target.closest('button');
            if (!target) return;
            if (target.hasAttribute('data-motd-switch')) { openRoomPicker('mrc'); return; }
            if (target.hasAttribute('data-motd-join')) { openRoomPicker('local'); return; }
            if (target.hasAttribute('data-motd-join-this')) { chatService.joinRoom(target.getAttribute('data-motd-join-this')); return; }
            if (target.hasAttribute('data-motd-leave')) { leaveLocalRoom(target.getAttribute('data-motd-leave')); }
        });
    }
    if (noRoomsMain) {
        noRoomsMain.addEventListener('click', function () {
            closeNoRoomsModal();
            chatService.joinRoom('main');
        });
    }
    if (noRoomsPick) {
        noRoomsPick.addEventListener('click', function () {
            closeNoRoomsModal();
            openRoomPicker('local');
        });
    }
    if (noRoomsClose) noRoomsClose.addEventListener('click', closeNoRoomsModal);
    if (noRoomsCancel) noRoomsCancel.addEventListener('click', closeNoRoomsModal);
    if (noRoomsModal) {
        noRoomsModal.addEventListener('click', function (event) {
            if (event.target === noRoomsModal) closeNoRoomsModal();
        });
    }

    if (msgContainer) {
        msgContainer.addEventListener('scroll', syncMessageBottomLock, { passive: true });
        msgContainer.addEventListener('load', function (event) {
            if (!messageBottomLocked) {
                return;
            }
            if (event.target && String(event.target.tagName || '').toUpperCase() === 'IMG') {
                queueMessageScrollToBottom();
            }
        }, true);
        msgContainer.addEventListener('click', function (event) {
            var veil = event.target.closest('[data-chat-nsfw-reveal]');
            if (veil) {
                event.preventDefault();
                var card = veil.closest('.chat-rich-image-card');
                if (card) card.classList.add('is-revealed');
                return;
            }
            var audioButton = event.target.closest('[data-chat-audio-play]');

            if (audioButton) {
                event.preventDefault();
                playChatAudioCard(audioButton);
                return;
            }
            if (event.target.closest('[data-join-main]')) { chatService.joinRoom('main'); return; }
            if (event.target.closest('[data-open-picker]')) { openRoomPicker('local'); return; }
            openPrivateFromButton(event.target.closest('[data-private-user]'));
        });
    }

    /* Avatar / name / roster-row click -> the person menu (profile, PM,
       ignore, sysop overrides), like the terminal's. Capture phase so the
       older "click = open PM" handlers below it do not fire first. */
    document.addEventListener('click', function (event) {
        var actor = event.target.closest('.chat-web-actor, .chat-web-sender-button, .chat-web-user');
        if (!actor || !window.PersonMenu || !actor.getAttribute('data-private-user')) return;
        event.preventDefault();
        event.stopPropagation();
        PersonMenu.open({
            name: actor.getAttribute('data-private-user'),
            network: actor.getAttribute('data-private-bridge') || 'local',
            system: actor.getAttribute('data-private-system') || '',
            avatar: actor.getAttribute('data-private-avatar') || '',
            x: event.clientX, y: event.clientY,
            onPrivate: function () { openPrivateFromButton(actor); }
        });
    }, true);
    if (window.PersonMenu) {
        PersonMenu.loadIgnored();
        document.addEventListener('person-menu:ignored-changed', function () { renderMessages(); });
    }

    document.addEventListener('radio:trackchange', onRadioPlaybackChanged);
    document.addEventListener('radio:statechange', onRadioPlaybackChanged);

    if (usersModal) {
        usersModal.addEventListener('click', function (event) {
            if (event.target === usersModal) {
                closeUsersModal();
            }
        });
    }

    // Textarea auto-resize + Enter to send (Shift+Enter for newline)
    if (chatText && chatText.tagName === 'TEXTAREA') {
        function autoResize() {
            chatText.style.height = 'auto';
            chatText.style.height = Math.min(chatText.scrollHeight, 160) + 'px';
        }
        chatText.addEventListener('input', autoResize);

        // --- Tab-completion for usernames ---
        var tabState = { active: false, matches: [], index: 0, start: 0, prefix: '' };

        chatText.addEventListener('input', function () {
            // Any manual typing resets tab cycle
            tabState.active = false;
        });

        chatText.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                if (chatInput) chatInput.dispatchEvent(new Event('submit', { cancelable: true }));
                tabState.active = false;
                return;
            }

            if (e.key === 'Tab') {
                e.preventDefault();
                var val = chatText.value;
                var cursor = chatText.selectionStart;

                if (!tabState.active) {
                    // Find the word fragment before the cursor
                    var before = val.substring(0, cursor);
                    var wordStart = before.lastIndexOf(' ') + 1;
                    // Strip a leading quote if the user already typed one
                    var raw = before.substring(wordStart);
                    var prefix = raw.replace(/^"/, '').toLowerCase();
                    if (!prefix.length) return;

                    // Get online nicks
                    var nicks = (Array.isArray(usersPanelUsers) ? usersPanelUsers : [])
                        .map(function (u) { return u.nick || ''; })
                        .filter(function (n) { return n.toLowerCase().indexOf(prefix) === 0; });
                    if (!nicks.length) return;

                    tabState.active = true;
                    tabState.matches = nicks;
                    tabState.index = 0;
                    tabState.start = wordStart;
                    tabState.prefix = prefix;
                } else {
                    // Cycle to next match
                    tabState.index = (tabState.index + 1) % tabState.matches.length;
                }

                var nick = tabState.matches[tabState.index];
                var needs_quotes = nick.indexOf(' ') >= 0;
                var replacement = needs_quotes ? '"' + nick + '"' : nick;
                // Add trailing space if at end of input
                var after = val.substring(cursor);
                // Find end of previous completion (might have trailing space or quote)
                var tail = val.substring(tabState.start);
                // Remove the old completion: everything from wordStart to cursor
                var newVal = val.substring(0, tabState.start) + replacement;
                // If nothing follows or only whitespace, add a space
                var rest = val.substring(cursor).replace(/^"?[^ ]*\s?/, '');
                if (!rest.length) newVal += ' ';
                else newVal += rest;
                chatText.value = newVal;
                var newCursor = tabState.start + replacement.length + (!rest.length ? 1 : 0);
                chatText.setSelectionRange(newCursor, newCursor);
            }
        });
    }

    if (chatInput) {
        chatInput.addEventListener('submit', function (event) {
            event.preventDefault();

            // If ANSI editor is active, encode cells as BITMAP and send
            if (ansiEditorActive && ansiEditorInstance && ansiEditorInstance.doc) {
                var doc = ansiEditorInstance.doc;
                var cells = doc.data;
                var cols = doc.columns;
                var rows = doc.rows;
                var fromName = (window.sbbsConfig && window.sbbsConfig.userAlias) || '';

                forceMessageScrollToBottom = true;
                chatService.buildBitmapPayload(cells, cols, rows, fromName).then(function (payload) {
                    return chatService.send(payload);
                }).then(function (ok) {
                    if (!ok) return;
                    closeAnsiEditor();
                });
                return;
            }

            // Normal text send
            var text = chatText.value.replace(/^\s+|\s+$/g, '');
            if (!text.length) return;

            forceMessageScrollToBottom = true;
            chatService.send(text).then(function (ok) {
                if (!ok) return;
                chatText.value = '';
                if (chatText.tagName === 'TEXTAREA') {
                    chatText.style.height = 'auto';
                }
            });
        });
    }

    // ═══ Drag-and-drop uploads ═══
    // Dropping a file is the intent to post it, so the URL is sent as its own
    // message once the upload (and, for video, the conversion) is done. The
    // compose box is deliberately left alone throughout — a video can take the
    // better part of a minute and chat should stay usable while it runs.
    var uploadHost = document.getElementById('chat-upload-host');
    if (window.ChatUpload && uploadHost && msgContainer) {
        window.ChatUpload.init({
            dropTarget: msgContainer,
            pasteTarget: chatText,
            chipHost: uploadHost,
            send: function (url) {
                forceMessageScrollToBottom = true;
                return chatService.send(url);
            }
        });
    }

    // ═══ ANSI Editor Toggle ═══
    var ansiToggle = document.getElementById('chat-ansi-toggle');
    var ansiEditorInstance = null;
    var ansiEditorActive = false;

    function openAnsiEditor() {
        if (!window.AnsiEditorModal) { console.error('AnsiEditorModal not loaded'); return; }
        if (AnsiEditorModal.isOpen) return;
        ansiToggle.classList.add('active');
        ansiToggle.textContent = 'Text';
        ansiEditorActive = true;

        AnsiEditorModal.open({
            title: 'ANSI Editor — Chat',
            columns: 80,
            rows: 25,
            fontUrl: './fonts/ansi-editor/IBM VGA.F16',
            onDone: function (editor) {
                // editor.doc is still available because we receive it before destroy
                if (editor && editor.doc) {
                    var doc = editor.doc;
                    var cells = doc.data;
                    var cols = doc.columns;
                    var rows = doc.rows;
                    var fromName = (window.sbbsConfig && window.sbbsConfig.userAlias) || '';
                    forceMessageScrollToBottom = true;
                    chatService.buildBitmapPayload(cells, cols, rows, fromName).then(function (payload) {
                        return chatService.send(payload);
                    });
                }
                resetAnsiToggle();
            },
            onCancel: function () {
                resetAnsiToggle();
            }
        });
    }

    function closeAnsiEditor() {
        if (AnsiEditorModal && AnsiEditorModal.isOpen) {
            AnsiEditorModal.close();
        }
        resetAnsiToggle();
    }

    function resetAnsiToggle() {
        if (ansiToggle) {
            ansiToggle.classList.remove('active');
            ansiToggle.textContent = 'ANSI';
        }
        ansiEditorActive = false;
        ansiEditorInstance = null;
    }

    if (ansiToggle) {
        ansiToggle.addEventListener('click', function () {
            if (ansiEditorActive) {
                closeAnsiEditor();
            } else {
                openAnsiEditor();
            }
        });
    }


    /* ── MOTD ticker ── */
    var motdBar = document.getElementById('chat-motd');
    var motdWindow = document.getElementById('chat-motd-window');
    var motdTrack = document.getElementById('chat-motd-track');
    var motdPrimary = document.getElementById('chat-motd-primary');
    var motdClone = document.getElementById('chat-motd-clone');
    var motdText = '';
    var motdRenderSignature = '';

    function syncMotdTicker() {
        var primaryWidth = 0;
        var windowWidth = 0;
        var gap = 40;
        var distance = 0;
        var duration = 0;

        if (!motdBar || !motdWindow || !motdTrack || !motdPrimary || !motdClone) return;

        motdBar.classList.remove('is-scrolling');
        motdTrack.style.removeProperty('--motd-scroll-width');
        motdTrack.style.removeProperty('--motd-duration');
        motdClone.style.display = 'none';

        if (!motdText.length) {
            motdBar.classList.add('is-empty');
            return;
        }

        motdBar.classList.remove('is-empty');
        primaryWidth = motdPrimary.scrollWidth || 0;
        windowWidth = motdWindow.clientWidth || 0;

        if (primaryWidth <= windowWidth + 8) return;

        distance = primaryWidth + gap;
        duration = Math.max(12, Math.round(distance / 42));
        motdClone.style.display = 'inline-block';
        motdBar.classList.add('is-scrolling');
        motdTrack.style.setProperty('--motd-scroll-width', String(distance) + 'px');
        motdTrack.style.setProperty('--motd-duration', String(duration) + 's');
    }

    function renderMotdBar(text) {
        text = (text || '').replace(/^\s+|\s+$/g, '');
        motdText = text;
        var primaryText = text.length ? text : '';
        var cloneText = text.length ? text : '';
        var sig = primaryText + '|' + cloneText;

        if (!motdPrimary || !motdClone) return;
        if (motdRenderSignature === sig) return;

        motdRenderSignature = sig;
        motdPrimary.textContent = primaryText;
        motdClone.textContent = cloneText;
        window.requestAnimationFrame(syncMotdTicker);
    }

    /* The bar shows this BBS's chat MOTD, except in the MRC room, where it
       shows MRC's own room topic instead (empty topic = hidden bar). */
    var motdLabel = document.getElementById('chat-motd-label');
    var jsonMotdText = '';

    function refreshMotdBar() {
        var view = getActiveView();
        var current = normalizeUpper(getCurrentChannelName());
        var room = null;
        if (view.type !== 'private') {
            room = getRooms().filter(function (r) { return normalizeUpper(r.name) === current; })[0] || null;
        }
        var isMrc = !!(room && room.bridge === 'mrc');
        if (motdLabel) motdLabel.textContent = isMrc ? 'TOPIC' : 'MOTD';
        renderMotdActions(view, room);
        renderMotdBar(isMrc ? (room.topic || '') : jsonMotdText);
    }

    /* The room controls sit beside the MOTD / topic, where it is clear what
       they act on: Join / Leave for a room of this BBS (Join #name when the
       viewed room is not joined), Switch rooms on MRC, nothing on DDial or in
       a private thread. */
    function renderMotdActions(view, room) {
        var html = '';
        if (!motdActions) return;
        if (isLoggedIn && view.type === 'channel' && room) {
            if (room.bridge === 'mrc') {
                html = '<button type="button" class="chat-motd-action" data-motd-switch title="Change MRC room">Switch rooms</button>';
            } else if (!room.bridge) {
                if (room.joined) {
                    html = '<button type="button" class="chat-motd-action" data-motd-join title="Join another room">Join</button>' +
                        '<button type="button" class="chat-motd-action is-leave" data-motd-leave="' + escapeAttr(room.name) + '" title="Leave #' + escapeAttr(room.name) + '">Leave</button>';
                } else {
                    html = '<button type="button" class="chat-motd-action is-primary" data-motd-join-this="' + escapeAttr(room.name) + '">Join #' + escapeHtml(room.name) + '</button>' +
                        '<button type="button" class="chat-motd-action" data-motd-join title="Join another room">Other rooms</button>';
                }
            }
        }
        if (motdActions.innerHTML !== html) motdActions.innerHTML = html;
        if (motdBar) motdBar.classList.toggle('has-actions', html.length > 0);
    }

    function loadMotd() {
        window.fetch('./api/chat.ssjs?action=motd', { credentials: 'include' })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                jsonMotdText = data && data.previewText ? String(data.previewText) : '';
                refreshMotdBar();
            })
            .catch(function () { jsonMotdText = ''; refreshMotdBar(); });
    }

    loadMotd();
    // refresh MOTD every 5 minutes
    var motdRefreshTimer = setInterval(loadMotd, 5 * 60 * 1000);

        chatService.setChatPageActive(true);
    renderAll();
    if (!syncRouteIntoService()) {
        chatService.loadHistory();
        chatService.getUsers();
    }

    window.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && usersModal && usersModal.classList.contains('is-open')) {
            closeUsersModal();
            return;
        }
        if (event.key === 'Escape' && isPickerOpen()) {
            closeRoomPicker();
            return;
        }
        if (event.key === 'Escape' && isNoRoomsOpen()) {
            closeNoRoomsModal();
        }
    });

    function cleanup() {
        if (ansiEditorActive) closeAnsiEditor();
        if (pickerRefreshTimer) clearTimeout(pickerRefreshTimer);
        window.removeEventListener('chat:messagesUpdated', onMessagesUpdated);
        window.removeEventListener('chat:roomsUpdated', onRoomsUpdated);
        window.removeEventListener('chat:privateUpdated', onPrivateUpdated);
        window.removeEventListener('chat:usersUpdated', onUsersUpdated);
        window.removeEventListener('chat:status', onStatusUpdated);
        window.removeEventListener('chat:viewChanged', onViewChanged);
        window.removeEventListener('spa:beforeNavigate', cleanup);
        document.removeEventListener('radio:trackchange', onRadioPlaybackChanged);
        document.removeEventListener('radio:statechange', onRadioPlaybackChanged);
        if (compactSidebarMedia && compactSidebarMedia.removeEventListener && onCompactSidebarMediaChanged) {
            compactSidebarMedia.removeEventListener('change', onCompactSidebarMediaChanged);
        }
        if (onCompactSidebarWindowResize) {
            window.removeEventListener('resize', onCompactSidebarWindowResize);
        }
        cancelPendingMessageScroll();
        if (motdRefreshTimer) clearInterval(motdRefreshTimer);
        chatService.setChatPageActive(false);
    }

    syncMobileSidebarLayout(true);
    window.addEventListener('spa:beforeNavigate', cleanup);
})();
</script>
