<!--Chat-->
<script type="text/javascript" src="./js/ansi-editor.js"></script>
<script type="text/javascript" src="./js/ansi-editor-modal.js"></script>
<link rel="stylesheet" href="./css/ansi-editor-modal.css">
<style>
/* ═══ Chat page – CGA BBS aesthetic ═══ */
.chat-web-page {
    --chat-bg: #000;
    --chat-panel: #000;
    --chat-border: #555555;
    --chat-border-accent: #55FFFF;
    --chat-muted: #AAAAAA;
    --chat-fg: #AAAAAA;
    color: var(--chat-fg);
    min-height: 0;
    padding: 0 0 0.25rem;
}

/* ── Shell ── */
.chat-web-page .chat-web-shell {
    display: flex;
    flex-direction: column;
    gap: 0;
    height: calc(100vh - 140px);
    height: calc(100dvh - 140px);
    min-height: 0;
    overflow: hidden;
    padding: 0;
    border: 1px solid #AAAAAA;
    border-radius: 0.375rem;
    background: #000;
}

/* ── Layout grid ── */
.chat-web-page .chat-web-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 0;
    align-items: stretch;
    flex: 1 1 auto;
    min-height: 0;
}

/* ── Sidebar + Main common ── */
.chat-web-page .chat-web-sidebar,
.chat-web-page .chat-web-main {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-height: 0;
}

/* ── Sidebar ── */
.chat-web-page .chat-web-sidebar {
    border-right: 1px solid var(--chat-border);
    background: #000;
    padding: 0;
    overflow-y: auto;
}

.chat-web-page .chat-web-main {
    min-width: 0;
    overflow: hidden;
    gap: 0;
}

/* ── Sidebar sections ── */
.chat-web-page .chat-web-sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 0;
}
.chat-web-page .chat-web-sidebar-section + .chat-web-sidebar-section {
    margin-top: 0;
    padding-top: 0;
    border-top: 1px solid var(--chat-border);
}

.chat-web-page .chat-web-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 6px 8px;
    border-bottom: 1px solid #333;
    background: rgba(85, 255, 255, 0.06);
}
.chat-web-page .chat-web-sidebar-heading,
.chat-web-page .chat-web-title {
    margin: 0;
    font-size: 0.85rem;
    color: #FFFF55;
}

/* ── Sidebar inputs / buttons ── */
.chat-web-page .chat-web-sidebar-form,
.chat-web-page .chat-web-form {
    display: flex;
    gap: 0.4rem;
}
.chat-web-page .chat-web-sidebar-input,
.chat-web-page .chat-web-input {
    flex: 1 1 auto;
    border: 1px solid var(--chat-border);
    background: #000;
    color: #FFFFFF;
    border-radius: 0;
    padding: 0.5rem 0.6rem;
}
textarea.chat-web-input {
    resize: none;
    overflow: hidden;
    min-height: 2.6rem;
    max-height: 8rem;
    line-height: 1.4;
    font-family: inherit;
    font-size: inherit;
    overflow-y: auto;
    field-sizing: content;
}
#chat-text {
    border-color: #FFFF55;
}
#chat-text:focus {
    border-color: #FFFF55;
    outline: none;
    box-shadow: 0 0 0 1px rgba(255, 255, 85, 0.3);
}
.chat-web-page .chat-web-sidebar-button,
.chat-web-page .chat-web-send,
.chat-web-page .chat-web-status-button,
.chat-web-page .chat-web-users-close {
    border: 1px solid var(--chat-border);
    background: #000;
    color: #AAAAAA;
    border-radius: 0;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    font-size: 0.82rem;
}
#chat-room-open {
    color: #55FF55;
    text-decoration: underline;
    text-decoration-color: #FF55FF;
    text-underline-offset: 3px;
}
.chat-web-page .chat-web-sidebar-button:hover {
    border-color: #55FFFF;
    color: #55FFFF;
}
.chat-web-page .chat-web-send {
    background: #000;
    color: #FF55FF;
    border-color: #55FF55;
    font-weight: bold;
    min-width: 70px;
}
.chat-web-page .chat-web-send:hover {
    background: rgba(85, 255, 85, 0.1);
}

/* ── MOTD ticker ── */
.chat-web-page .chat-motd-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #000;
    padding: 4px 8px;
    border-bottom: 1px solid var(--chat-border);
    min-height: 0;
    overflow: hidden;
}
.chat-web-page .chat-motd-bar.is-empty {
    display: none;
}
.chat-web-page .chat-motd-label {
    font-size: 0.72rem;
    font-weight: bold;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #55FF55;
    flex-shrink: 0;
}
.chat-web-page .chat-motd-window {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
}
.chat-web-page .chat-motd-track {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    min-width: 100%;
    --motd-scroll-width: 0px;
    --motd-duration: 18s;
}
.chat-web-page .chat-motd-bar.is-scrolling .chat-motd-track {
    animation: chat-motd-scroll var(--motd-duration) linear infinite;
}
.chat-web-page .chat-motd-item {
    display: inline-block;
    white-space: nowrap;
    color: #55FF55;
    font-size: 0.82rem;
}
.chat-web-page .chat-motd-item-clone {
    display: none;
}
@keyframes chat-motd-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-1 * var(--motd-scroll-width))); }
}

/* ── Nav list (rooms / private threads) ── */
.chat-web-page .chat-web-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0;
}
.chat-web-page .chat-web-nav-empty,
.chat-web-page .chat-web-empty {
    color: var(--chat-muted);
    padding: 8px;
    font-size: 0.82rem;
}
.chat-web-page .chat-web-nav-item {
    border: none;
    border-bottom: 1px solid #222;
    background: transparent;
    color: var(--chat-fg);
    border-radius: 0;
    padding: 6px 8px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.chat-web-page .chat-web-nav-item:hover {
    background: rgba(85, 255, 255, 0.05);
}
.chat-web-page .chat-web-nav-item.is-active {
    border-left: 2px solid #55FFFF;
    background: rgba(85, 255, 255, 0.08);
}
.chat-web-page .chat-web-nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
}
.chat-web-page .chat-web-nav-title {
    font-weight: bold;
    min-width: 0;
    font-size: 0.85rem;
    color: #FFFFFF;
}
.chat-web-page .chat-web-nav-secondary,
.chat-web-page .chat-web-nav-preview,
.chat-web-page .chat-web-channel {
    color: #555555;
    font-size: 0.78rem;
}
.chat-web-page .chat-web-nav-preview {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.chat-web-page .chat-web-nav-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
    margin-top: 2px;
}
.chat-web-page .chat-web-nav-action,
.chat-web-page .chat-web-nav-state {
    border: 1px solid #555;
    border-radius: 0;
    padding: 2px 8px;
    font-size: 0.75rem;
    line-height: 1.2;
}
.chat-web-page .chat-web-nav-action {
    background: transparent;
    color: #AAAAAA;
    cursor: pointer;
}
.chat-web-page .chat-web-nav-action:hover {
    border-color: #55FFFF;
    color: #55FFFF;
}
.chat-web-page .chat-web-nav-action.is-primary {
    border-color: #55FFFF;
    color: #55FFFF;
    background: transparent;
    font-weight: bold;
}
.chat-web-page .chat-web-nav-state {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border-color: #00AAAA;
    color: #55FFFF;
    font-size: 0.72rem;
}

/* ── Badge ── */
.chat-web-page .chat-web-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.2rem;
    padding: 1px 5px;
    border-radius: 0;
    font-size: 0.7rem;
    font-weight: bold;
    background: transparent;
    color: #55FFFF;
    border: 1px solid #55FFFF;
}
.chat-web-page .chat-web-badge.is-unread {
    background: transparent;
    color: #FFFF55;
    border-color: #FFFF55;
}

/* ── Private thread row ── */
.chat-web-page .chat-web-thread-row {
    display: grid;
    grid-template-columns: 10px 36px minmax(0, 1fr);
    gap: 6px;
    align-items: center;
}
.chat-web-page .chat-web-presence-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
}
.chat-web-page .chat-web-presence-dot.is-online {
    background: #55FF55;
}
.chat-web-page .chat-web-presence-dot.is-offline {
    background: #AA0000;
}
.chat-web-page .chat-web-thread-avatar {
    width: 36px;
    min-width: 36px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #333;
    border-radius: 0;
    background: #000;
    overflow: hidden;
}
.chat-web-page .chat-web-thread-avatar img {
    max-width: 100%;
    max-height: 100%;
    image-rendering: pixelated;
}

/* ── Modals ── */
.chat-web-page .chat-web-modal {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.8);
    padding: 1rem;
    z-index: 1050;
}
.chat-web-page .chat-web-modal.is-open {
    display: flex;
}
.chat-web-page .chat-web-modal-card {
    width: min(400px, 100%);
    border: 1px solid var(--chat-border);
    border-radius: 0;
    background: #000;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.chat-web-page .chat-web-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
}
.chat-web-page .chat-web-modal-title {
    margin: 0;
    color: #FFFF55;
}
.chat-web-page .chat-web-modal-text {
    color: var(--chat-muted);
    margin: 0;
    font-size: 0.85rem;
}
.chat-web-page .chat-web-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.4rem;
}

/* ── Topbar ── */
.chat-web-page .chat-web-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
}
.chat-web-page .chat-web-count {
    border: 1px solid var(--chat-border);
    background: transparent;
    color: #55FFFF;
    border-radius: 0;
    padding: 3px 8px;
    cursor: pointer;
    font-size: 0.82rem;
}

/* ── Status bar ── */
.chat-web-page .chat-web-status {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    border: none;
    border-bottom: 1px solid #333;
    border-radius: 0;
    padding: 6px 10px;
    background: rgba(85, 85, 85, 0.08);
    font-size: 0.82rem;
}
.chat-web-page .chat-web-status.is-visible {
    display: flex;
}
.chat-web-page .chat-web-status.is-warning {
    border-bottom-color: #AA5500;
    color: #FFFF55;
}
.chat-web-page .chat-web-status.is-error {
    border-bottom-color: #AA0000;
    color: #FF5555;
}

/* ── Users modal ── */
.chat-web-page .chat-web-users-modal-card {
    width: min(480px, 100%);
    max-height: min(72vh, 600px);
}
.chat-web-page .chat-web-users-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0;
    color: #FFFF55;
}
.chat-web-page .chat-web-users-list {
    display: grid;
    gap: 0;
    flex: 1 1 auto;
    min-height: 0;
    max-height: none;
    overflow-y: auto;
}
.chat-web-page .chat-web-user {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 8px;
    align-items: center;
    border: none;
    border-bottom: 1px solid #222;
    background: transparent;
    color: var(--chat-fg);
    border-radius: 0;
    padding: 6px 8px;
    text-align: left;
}
.chat-web-page .chat-web-user:hover {
    background: rgba(85, 255, 255, 0.05);
}
.chat-web-page .chat-web-user-avatar,
.chat-web-page .chat-web-avatar {
    width: 40px;
    min-width: 40px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #333;
    border-radius: 0;
    background: #000;
    overflow: hidden;
}
.chat-web-page .chat-web-user-avatar img,
.chat-web-page .chat-web-avatar img {
    max-width: 100%;
    max-height: 100%;
    image-rendering: pixelated;
}

/* ── Chat panel (messages area) ── */
.chat-web-page .chat-web-chatpanel {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    border: none;
    border-radius: 0;
    background: #000;
}
.chat-web-page .chat-web-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #555555;
    font-weight: bold;
    font-size: 1rem;
}
.chat-web-page .chat-web-actor,
.chat-web-page .chat-web-sender-button {
    border: 0;
    background: transparent;
    color: inherit;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font: inherit;
    text-align: inherit;
}
.chat-web-page .chat-web-sender-button {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
}

/* ── Messages container ── */
.chat-web-page .chat-web-messages {
    flex: 1 1 0;
    border: 0;
    background: transparent;
    border-radius: 0;
    padding: 8px 10px 6px;
    overflow-y: auto;
    min-height: 0;
    margin: 0;
}

/* ── System messages ── */
.chat-web-page .chat-web-system,
.chat-web-page .chat-system-msg {
    text-align: center;
    color: #555555;
    margin: 4px 0 8px;
    font-size: 0.78rem;
    font-style: italic;
}

/* ── Message groups ── */
.chat-web-page .chat-web-group,
.chat-web-page .chat-msg-group {
    display: flex;
    gap: 8px;
    margin-bottom: 8px;
    max-width: 88%;
}
.chat-web-page .chat-web-group.is-self,
.chat-web-page .chat-msg-group-self {
    margin-left: auto;
    flex-direction: row-reverse;
    align-self: flex-end;
}
.chat-web-page .chat-msg-group-other {
    align-self: flex-start;
}

/* ── Content column ── */
.chat-web-page .chat-web-content,
.chat-web-page .chat-msg-content {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

/* ── Header ── */
.chat-web-page .chat-web-header,
.chat-web-page .chat-header {
    font-size: 0.82rem;
    margin-bottom: 2px;
}
.chat-web-page .chat-web-group.is-self .chat-web-header,
.chat-web-page .chat-msg-group-self .chat-header {
    text-align: right;
}

/* ── Sender / timestamp ── */
.chat-web-page .chat-web-system-name,
.chat-web-page .chat-web-time,
.chat-web-page .chat-timestamp {
    color: #555555;
    font-size: 0.72rem;
}
.chat-web-page .chat-sender {
    font-size: 0.82rem;
    font-weight: 700;
    color: #FF55FF;
    padding: 0;
    margin: 0;
}

/* ── Avatars (message bubbles) ── */
.chat-web-page .chat-avatar {
    flex-shrink: 0;
    align-self: flex-start;
    width: 44px;
    border-radius: 0;
    overflow: hidden;
    background: #000;
    border: 1px solid #333;
}
.chat-web-page .chat-avatar img {
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    display: block;
}
.chat-web-page .chat-avatar-placeholder {
    color: #555;
    font-size: 14px;
    font-weight: bold;
    line-height: 58px;
    text-align: center;
    display: block;
    width: 100%;
}

/* ════════════════════════════════════════════════
   Chat Bubbles – CGA bordered style
   ════════════════════════════════════════════════ */
.chat-web-page .chat-web-bubble,
.chat-web-page .chat-bubble {
    display: block;
    padding: 6px 10px;
    border-radius: 0;
    margin-bottom: 3px;
    max-width: 100%;
    word-break: break-word;
    line-height: 1.45;
    background: transparent;
}

/* Other people's bubbles: cyan border, white text */
.chat-web-page .chat-web-group:not(.is-self) .chat-web-bubble,
.chat-web-page .chat-bubble-other {
    border: 1px solid #55FFFF;
    color: #FFFFFF;
    background: transparent;
}

/* Self bubbles: blue border, light gray text */
.chat-web-page .chat-web-group.is-self .chat-web-bubble,
.chat-web-page .chat-bubble-self {
    border: 1px solid #5555FF;
    color: #AAAAAA;
    background: transparent;
}
.chat-web-page .chat-bubble-self a {
    color: #55FFFF;
}
.chat-web-page .chat-bubble-other a {
    color: #FF55FF;
}

/* ── Bitmap bubbles ── */
.chat-web-page .chat-bubble.chat-bitmap-bubble {
    padding: 4px;
    overflow: hidden;
}
.chat-web-page .chat-bitmap-shell {
    width: 100%;
}
.chat-web-page .chat-bitmap-frame {
    width: 100%;
    border: 1px solid #333;
    border-radius: 0;
    background: #000;
    overflow: hidden;
}
.chat-web-page .chat-bitmap-stage {
    width: 100%;
    background: #000;
    position: relative;
}
.chat-web-page .chat-bitmap-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 5rem;
    padding: 8px;
    color: #555555;
    font-size: 0.78rem;
    text-align: center;
}
.chat-web-page .chat-bitmap-stage.is-error .chat-bitmap-placeholder {
    color: #FF5555;
}
.chat-web-page .chat-bitmap-image {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    background: #000;
}

/* ── Composer form ── */
.chat-web-page .chat-web-form {
    margin: 0;
    padding: 8px 10px;
    border-top: 1px solid var(--chat-border);
    background: transparent;
}
.chat-web-page .chat-web-login {
    color: var(--chat-muted);
    text-align: center;
    margin: 0;
    padding: 10px;
    border-top: 1px solid var(--chat-border);
    font-size: 0.85rem;
}
.chat-web-page .chat-web-login a {
    color: #55FFFF;
}

/* ── Responsive ── */
@media (max-width: 980px) {
    .chat-web-page .chat-web-layout {
        grid-template-columns: 1fr;
        grid-template-rows: minmax(0, auto) minmax(0, 1fr);
        gap: 0;
    }
    .chat-web-page .chat-web-sidebar {
        max-height: 28vh;
        border-right: none;
        border-bottom: 1px solid var(--chat-border);
    }
}
@media (max-width: 768px) {
    .chat-web-page {
        padding-top: 0.3rem;
    }
    .chat-web-page .chat-web-shell {
        height: calc(100vh - 120px);
        height: calc(100dvh - 120px);
    }
    .chat-web-page .chat-msg-group,
    .chat-web-page .chat-web-group {
        max-width: 100%;
    }
    .chat-web-page .chat-web-messages {
        padding: 6px 8px;
    }
}

/* ── ANSI Editor in chat ── */
.chat-web-page .chat-ansi-toggle {
    border: 1px solid var(--chat-border);
    background: transparent;
    color: #AAAAAA;
    border-radius: 0;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    font-size: 0.82rem;
    white-space: nowrap;
}
.chat-web-page .chat-ansi-toggle:hover {
    border-color: #FF55FF;
    color: #FF55FF;
}
.chat-web-page .chat-ansi-toggle.active {
    border-color: #FF55FF;
    color: #FF55FF;
    background: transparent;
    font-weight: bold;
}
.chat-web-page .chat-ansi-wrap {
    display: none;
    width: 100%;
    border: 1px solid #333;
    border-radius: 0;
    overflow: hidden;
    background: #000;
}
.chat-web-page .chat-ansi-wrap.active {
    display: block;
}
.chat-web-page .chat-ansi-wrap .me-editor {
    max-height: 520px;
}

</style>

<div class="chat-web-page">
    <div class="chat-web-shell">
        <div class="chat-web-layout">
            <aside class="chat-web-sidebar">
                <div class="chat-web-sidebar-section">
                    <div class="chat-web-sidebar-header">
                        <h4 class="chat-web-sidebar-heading">Public Rooms</h4>
                    </div>
<?xjs if (user.number > 0) { ?>
                    <button id="chat-room-open" class="chat-web-sidebar-button" type="button">Create Room</button>
<?xjs } else { ?>
                    <button id="chat-room-open" class="chat-web-sidebar-button" type="button" disabled>Create Room</button>
<?xjs } ?>
                    <div id="chat-rooms" class="chat-web-nav-list"></div>
                </div>

                <div class="chat-web-sidebar-section">
                    <div class="chat-web-sidebar-header">
                        <h4 class="chat-web-sidebar-heading">Private Chats</h4>
                    </div>
                    <div id="chat-private" class="chat-web-nav-list"></div>
                </div>
            </aside>

            <div class="chat-web-main">
                <div class="chat-web-chatpanel">
                    <div id="chat-status" class="chat-web-status" role="alert" aria-live="polite">
                        <div id="chat-status-text"></div>
                        <button id="chat-status-retry" class="chat-web-status-button" type="button">Retry now</button>
                    </div>

                    <div id="chat-motd" class="chat-motd-bar is-empty">
                        <span class="chat-motd-label">MOTD</span>
                        <div id="chat-motd-window" class="chat-motd-window">
                            <div id="chat-motd-track" class="chat-motd-track">
                                <span id="chat-motd-primary" class="chat-motd-item"></span>
                                <span id="chat-motd-clone" class="chat-motd-item chat-motd-item-clone" aria-hidden="true"></span>
                            </div>
                        </div>
                    </div>

                    <div id="chat-motd" class="chat-motd-bar is-empty">
                        <span class="chat-motd-label">MOTD</span>
                        <div id="chat-motd-window" class="chat-motd-window">
                            <div id="chat-motd-track" class="chat-motd-track">
                                <span id="chat-motd-primary" class="chat-motd-item"></span>
                                <span id="chat-motd-clone" class="chat-motd-item chat-motd-item-clone" aria-hidden="true"></span>
                            </div>
                        </div>
                    </div>

                    <div id="chat-messages" class="chat-web-messages chat-messages">
                        <div class="chat-web-empty">Loading chat history...</div>
                    </div>

<?xjs if (user.number > 0) { ?>
                    <div id="chat-ansi-wrap" class="chat-ansi-wrap"></div>
                    <form id="chat-input" class="chat-input-area chat-web-form" autocomplete="off">
                        <textarea id="chat-text" class="chat-web-input" maxlength="2000" rows="1" placeholder="Type a message..."></textarea>
                        <button type="button" id="chat-ansi-toggle" class="chat-ansi-toggle">ANSI</button>
                        <button class="chat-web-send" type="submit">Send</button>
                    </form>
<?xjs } else { ?>
                    <div class="chat-web-login">
                        You are viewing a snapshot of recent chat. <a href="/?page=000-login.xjs">Log in</a> for live updates, messaging, and private chats.
                    </div>
<?xjs } ?>
                </div>
            </div>
        </div>
    </div>

    <div id="chat-users-modal" class="chat-web-modal" aria-hidden="true">
        <div id="chat-users-panel" class="chat-web-modal-card chat-web-users-modal-card" role="dialog" aria-modal="true" aria-labelledby="chat-users-title">
            <div class="chat-web-users-header">
                <strong id="chat-users-title">Users in #main</strong>
                <button id="chat-users-close" class="chat-web-users-close" type="button">&times;</button>
            </div>
            <div id="chat-users-list" class="chat-web-users-list"></div>
        </div>
    </div>

<?xjs if (user.number > 0) { ?>
    <div id="chat-room-modal" class="chat-web-modal" aria-hidden="true">
        <div class="chat-web-modal-card">
            <div class="chat-web-modal-header">
                <h4 class="chat-web-modal-title">Create Room</h4>
                <button id="chat-room-close" class="chat-web-users-close" type="button">&times;</button>
            </div>
            <p class="chat-web-modal-text">Pick a short public room name using letters, numbers, `_` or `-`.</p>
            <form id="chat-room-form" class="chat-web-sidebar-form" autocomplete="off">
                <input id="chat-room-input" class="chat-web-sidebar-input" type="text" maxlength="32" placeholder="new-room">
                <button class="chat-web-sidebar-button" type="submit">Create</button>
            </form>
            <div class="chat-web-modal-actions">
                <button id="chat-room-cancel" class="chat-web-sidebar-button" type="button">Cancel</button>
            </div>
        </div>
    </div>
<?xjs } ?>
</div>

<script>
(function () {
    'use strict';

    var chatService = window.ChatService || null;
    var sbbsConfig = window.sbbsConfig || {};
    var isLoggedIn = !!sbbsConfig.isLoggedIn;
    var userAlias = String(sbbsConfig.userAlias || '');
    var userSystemName = String(sbbsConfig.systemName || '');
    var users = chatService && chatService.getUsersSnapshot ? chatService.getUsersSnapshot() : [];

    var roomsList = document.getElementById('chat-rooms');
    var privateList = document.getElementById('chat-private');
    var roomOpen = document.getElementById('chat-room-open');
    var roomForm = document.getElementById('chat-room-form');
    var roomInput = document.getElementById('chat-room-input');
    var roomModal = document.getElementById('chat-room-modal');
    var roomClose = document.getElementById('chat-room-close');
    var roomCancel = document.getElementById('chat-room-cancel');
    var usersModal = document.getElementById('chat-users-modal');
    var viewLabel = document.getElementById('chat-view-label');
    var userCount = document.getElementById('chat-user-count');
    var statusBox = document.getElementById('chat-status');
    var statusText = document.getElementById('chat-status-text');
    var statusRetry = document.getElementById('chat-status-retry');
    var usersPanel = document.getElementById('chat-users-panel');
    var usersTitle = document.getElementById('chat-users-title');
    var usersList = document.getElementById('chat-users-list');
    var usersClose = document.getElementById('chat-users-close');
    var msgContainer = document.getElementById('chat-messages');
    var chatInput = document.getElementById('chat-input');
    var chatText = document.getElementById('chat-text');
    var usersPanelRoom = getActiveView().currentChannel || 'main';
    var usersPanelUsers = Array.isArray(users) ? users.slice() : [];
    var usersPanelRequestToken = 0;

    function trimText(value) {
        return String(value || '').replace(/^\s+|\s+$/g, '');
    }

    function normalizeUpper(value) {
        return trimText(value).toUpperCase();
    }

    function sanitizeChannelName(raw) {
        var channel = String(raw || 'main').replace(/[^a-zA-Z0-9_-]/g, '');
        return channel.length ? channel : 'main';
    }

    function sanitizeAlias(raw) {
        return trimText(String(raw || '')).replace(/[\x00-\x1f]/g, '').substr(0, 60);
    }

    function buildThreadKey(name, system) {
        return normalizeUpper(name).replace(/[^A-Z0-9]/g, '') + '|' + normalizeUpper(system);
    }

    function parseRoute() {
        var params;

        try {
            params = new URLSearchParams(window.location.search);
        } catch (_error) {
            return {
                channel: 'main',
                privateName: '',
                privateSystem: ''
            };
        }

        return {
            channel: sanitizeChannelName(params.get('channel') || 'main'),
            privateName: sanitizeAlias(params.get('private') || ''),
            privateSystem: trimText(params.get('system') || '')
        };
    }

    function escapeHtml(str) {
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str || ''));
        return div.innerHTML;
    }

    function escapeAttr(str) {
        return escapeHtml(str || '').replace(/"/g, '&quot;');
    }

    function linkify(text) {
        return escapeHtml(text || '').replace(/(https?:\/\/[^\s<]+)/gi, '<a href="$1" target="_blank" rel="noopener">$1</a>');
    }

    function formatTime(ts) {
        if (!ts) return '';
        var d = new Date(ts);
        var h = d.getHours();
        var m = d.getMinutes();
        var ampm = h >= 12 ? 'PM' : 'AM';
        h = h % 12 || 12;
        return h + ':' + (m < 10 ? '0' : '') + m + ' ' + ampm;
    }

    function getRooms() {
        return chatService && chatService.getRooms ? chatService.getRooms() : [];
    }

    function getPrivateThreads() {
        return chatService && chatService.getPrivateThreads ? chatService.getPrivateThreads() : [];
    }

    function getMessages() {
        return chatService && chatService.getMessages ? chatService.getMessages() : [];
    }

    function getActiveView() {
        return chatService && chatService.getActiveView ? chatService.getActiveView() : {
            type: 'channel',
            name: 'main',
            system: '',
            avatar: '',
            currentChannel: 'main'
        };
    }

    function getCurrentChannelName() {
        var activeView = getActiveView();
        return sanitizeChannelName(activeView.currentChannel || (activeView.type === 'channel' ? activeView.name : 'main') || 'main');
    }

    function updateQueryString(view) {
        var next;

        if (!window.history || !window.history.replaceState) {
            return;
        }

        next = new URL(window.location.href);
        if (view.type === 'private') {
            next.searchParams.set('channel', view.currentChannel || 'main');
            next.searchParams.set('private', view.name);
            if (view.system) {
                next.searchParams.set('system', view.system);
            } else {
                next.searchParams.delete('system');
            }
        } else {
            next.searchParams.set('channel', view.name || 'main');
            next.searchParams.delete('private');
            next.searchParams.delete('system');
        }

        window.history.replaceState({}, '', next.toString());
    }

    function renderEmbeddedAvatars(root) {
        if (chatService && chatService._renderEmbeddedAvatars) {
            chatService._renderEmbeddedAvatars(root);
        }
    }

    function renderEmbeddedBitmaps(root) {
        if (chatService && chatService._renderEmbeddedBitmaps) {
            chatService._renderEmbeddedBitmaps(root);
        }
    }

    function renderLocalAvatars(root) {
        var scope = root || document;
        var avatarEls;
        var ids = [];

        if (typeof Avatars === 'undefined' || !Avatars.draw) {
            return;
        }

        avatarEls = scope.querySelectorAll('div[data-avatar]');
        avatarEls.forEach(function (el) {
            var id = el.getAttribute('data-avatar');
            if (id && id !== '0') {
                ids.push(id);
            }
        });

        if (ids.length) {
            Avatars.draw(ids);
        }
    }

    function renderAvatarFallbacks(root) {
        var scope = root || document;
        var placeholders = scope.querySelectorAll('.chat-web-avatar-placeholder[data-initial], .chat-avatar-placeholder[data-initial]');

        placeholders.forEach(function (el) {
            if (el.parentNode && el.parentNode.children.length > 1) {
                el.remove();
            }
        });
    }

    function renderStatus(status) {
        if (!statusBox || !statusText) {
            return;
        }

        statusBox.classList.remove('is-visible', 'is-warning', 'is-error');
        if (!status || !status.message) {
            statusText.textContent = '';
            if (statusRetry) statusRetry.style.display = 'none';
            return;
        }

        /* Guest users: show informational note instead of error+retry */
        if (!isLoggedIn && status.showRetry) {
            statusText.textContent = 'Viewing recent chat history. Log in for live updates and messaging.';
            statusBox.classList.add('is-visible', 'is-warning');
            if (statusRetry) statusRetry.style.display = 'none';
            return;
        }

        statusText.textContent = status.message;
        statusBox.classList.add('is-visible');
        statusBox.classList.add(status.type === 'error' ? 'is-error' : 'is-warning');
        if (statusRetry) {
            statusRetry.style.display = (isLoggedIn && status.showRetry) ? '' : 'none';
        }
    }

    function renderUsersTitle() {
        if (!usersTitle) {
            return;
        }

        usersTitle.textContent = 'Users in #' + sanitizeChannelName(usersPanelRoom || getCurrentChannelName());
    }

    function loadUsersForRoom(roomName, silent) {
        var requestedRoom = sanitizeChannelName(roomName || getCurrentChannelName());
        var requestToken = ++usersPanelRequestToken;

        return window.fetch('./api/chat.ssjs?action=who&channel=' + encodeURIComponent(requestedRoom), {
            credentials: 'same-origin'
        }).then(function (response) {
            if (!response.ok) {
                throw new Error('Unable to fetch room roster');
            }

            return response.json();
        }).then(function (payload) {
            if (payload && payload.error) {
                throw new Error(String(payload.error));
            }
            if (
                requestToken !== usersPanelRequestToken ||
                normalizeUpper(usersPanelRoom) !== normalizeUpper(requestedRoom)
            ) {
                return false;
            }

            usersPanelUsers = payload && Array.isArray(payload.users) ? payload.users : [];
            renderUsers();
            return true;
        }).catch(function () {
            if (!silent) {
                renderStatus({
                    type: 'warning',
                    message: 'Unable to load the room user list right now.',
                    showRetry: false
                });
            }
            return false;
        });
    }

    function openUsersPanelForRoom(roomName) {
        usersPanelRoom = sanitizeChannelName(roomName || getCurrentChannelName());
        renderUsersTitle();
        if (usersModal) {
            usersModal.classList.add('is-open');
            usersModal.setAttribute('aria-hidden', 'false');
        }

        if (normalizeUpper(usersPanelRoom) === normalizeUpper(getCurrentChannelName())) {
            usersPanelUsers = Array.isArray(users) ? users.slice() : [];
            renderUsers();
        }

        loadUsersForRoom(usersPanelRoom, true);
    }

    function closeUsersModal() {
        if (!usersModal) {
            return;
        }

        usersModal.classList.remove('is-open');
        usersModal.setAttribute('aria-hidden', 'true');
    }

    function updateUserCountButton() {
        var currentChannel = getCurrentChannelName();
        var count = users.length;
        var rooms = getRooms();

        rooms.forEach(function (room) {
            if (normalizeUpper(room.name) === normalizeUpper(currentChannel)) {
                count = typeof room.userCount === 'number' ? room.userCount : count;
            }
        });

        if (userCount) {
            userCount.textContent = String(count) + ' user' + (count === 1 ? '' : 's');
        }
    }

    function updateComposer() {
        var activeView = getActiveView();
        if (!chatText) return;

        if (activeView.type === 'private') {
            chatText.placeholder = 'Message @' + activeView.name + '...';
            return;
        }

        chatText.placeholder = 'Message #' + (activeView.name || 'main') + '...';
    }

    function renderViewLabel(view) {
        var activeView = view || getActiveView();

        if (!viewLabel) return;
        if (activeView.type === 'private') {
            viewLabel.textContent = '@' + activeView.name;
        } else {
            viewLabel.textContent = '#' + (activeView.name || 'main');
        }
    }

    function renderRooms() {
        var rooms = getRooms().filter(function (room) {
            return normalizeUpper(room.name) === normalizeUpper(getCurrentChannelName()) || (room.userCount || 0) > 0 || (room.unreadCount || 0) > 0;
        }).slice();
        var html = '';
        var currentChannel = getCurrentChannelName();

        rooms.sort(function (a, b) {
            var aCurrent = normalizeUpper(a.name) === normalizeUpper(currentChannel) ? 1 : 0;
            var bCurrent = normalizeUpper(b.name) === normalizeUpper(currentChannel) ? 1 : 0;

            if (aCurrent !== bCurrent) {
                return bCurrent - aCurrent;
            }
            if ((a.unreadCount || 0) !== (b.unreadCount || 0)) {
                return (b.unreadCount || 0) - (a.unreadCount || 0);
            }
            return (b.lastTimestamp || 0) - (a.lastTimestamp || 0);
        });

        if (!rooms.length) {
            roomsList.innerHTML = '<div class="chat-web-nav-empty">No public rooms yet.</div>';
            updateUserCountButton();
            return;
        }

        var inPrivate = getActiveView().type === 'private';

        rooms.forEach(function (room) {
            var isCurrent = !inPrivate && normalizeUpper(room.name) === normalizeUpper(currentChannel);

            html += '<div class="chat-web-nav-item' + (isCurrent ? ' is-active' : '') + '">';
            html += '<div class="chat-web-nav-top">';
            html += '<span class="chat-web-nav-title">#' + escapeHtml(room.name) + '</span>';
            if ((room.unreadCount || 0) > 0) {
                html += '<span class="chat-web-badge is-unread">' + escapeHtml(String(room.unreadCount)) + '</span>';
            }
            html += '</div>';
            html += '<div class="chat-web-nav-secondary">' + escapeHtml(String(room.userCount || 0)) + ' user' + ((room.userCount || 0) === 1 ? '' : 's') + '</div>';
            html += '<div class="chat-web-nav-actions">';
            if (isCurrent) {
                html += '<span class="chat-web-nav-state">Current</span>';
            } else {
                html += '<button type="button" class="chat-web-nav-action is-primary" data-room-join="' + escapeAttr(room.name) + '">Join</button>';
            }
            html += '<button type="button" class="chat-web-nav-action" data-room-users="' + escapeAttr(room.name) + '">Users</button>';
            html += '</div>';
            html += '</div>';
        });

        roomsList.innerHTML = html;
        updateUserCountButton();
    }

    function renderPrivateThreads() {
        var threads = getPrivateThreads().slice();
        var html = '';

        threads.sort(function (a, b) {
            var aOnline = a.isOnline ? 1 : 0;
            var bOnline = b.isOnline ? 1 : 0;

            if (aOnline !== bOnline) {
                return bOnline - aOnline;
            }
            if ((a.isActive ? 1 : 0) !== (b.isActive ? 1 : 0)) {
                return (b.isActive ? 1 : 0) - (a.isActive ? 1 : 0);
            }
            if ((a.unreadCount || 0) !== (b.unreadCount || 0)) {
                return (b.unreadCount || 0) - (a.unreadCount || 0);
            }
            return (b.lastTimestamp || 0) - (a.lastTimestamp || 0);
        });

        if (!threads.length) {
            privateList.innerHTML = '<div class="chat-web-nav-empty">No private chats yet.</div>';
            return;
        }

        threads.forEach(function (thread) {
            var initial = thread.name ? thread.name.charAt(0).toUpperCase() : '?';
            var statusClass = thread.isOnline ? 'is-online' : 'is-offline';

            html += '<button type="button" class="chat-web-nav-item' + (thread.isActive ? ' is-active' : '') + '" data-private-nav="' + escapeAttr(thread.name) + '" data-private-system="' + escapeAttr(thread.system || '') + '" data-private-avatar="' + escapeAttr(thread.avatar || '') + '">';
            html += '<div class="chat-web-thread-row">';
            html += '<span class="chat-web-presence-dot ' + statusClass + '" aria-hidden="true"></span>';
            html += '<div class="chat-web-thread-avatar">';
            if (thread.avatar) {
                html += '<div data-avatar-bin="' + escapeAttr(thread.avatar) + '"></div>';
            } else {
                html += '<div class="chat-web-avatar-placeholder" data-initial="' + escapeAttr(initial) + '">' + escapeHtml(initial) + '</div>';
            }
            html += '</div>';
            html += '<div>';
            html += '<div class="chat-web-nav-top">';
            html += '<span class="chat-web-nav-title">@' + escapeHtml(thread.name) + '</span>';
            if ((thread.unreadCount || 0) > 0) {
                html += '<span class="chat-web-badge is-unread">' + escapeHtml(String(thread.unreadCount)) + '</span>';
            }
            html += '</div>';
            if (thread.system) {
                html += '<div class="chat-web-nav-secondary">' + escapeHtml(thread.system) + '</div>';
            }
            if (thread.preview) {
                html += '<div class="chat-web-nav-preview">' + escapeHtml(thread.preview) + '</div>';
            }
            html += '</div>';
            html += '</div>';
            html += '</button>';
        });

        privateList.innerHTML = html;
        renderEmbeddedAvatars(privateList);
        renderAvatarFallbacks(privateList);
    }

    function renderUsers() {
        var html = '';
        var visibleUsers = Array.isArray(usersPanelUsers) ? usersPanelUsers : [];

        if (!usersList) {
            return;
        }

        renderUsersTitle();

        if (!visibleUsers.length) {
            usersList.innerHTML = '<div class="chat-web-empty">No users in #' + escapeHtml(sanitizeChannelName(usersPanelRoom || getCurrentChannelName())) + '.</div>';
            updateUserCountButton();
            return;
        }

        visibleUsers.forEach(function (entry) {
            var initial = entry.nick ? entry.nick.charAt(0).toUpperCase() : '?';

            html += '<button type="button" class="chat-web-user" data-private-user="' + escapeAttr(entry.nick || '') + '" data-private-system="' + escapeAttr(entry.system || '') + '" data-private-avatar="' + escapeAttr(entry.avatar || '') + '">';
            html += '<div class="chat-web-user-avatar">';
            if (entry.avatar) {
                html += '<div data-avatar-bin="' + escapeAttr(entry.avatar) + '"></div>';
            } else if (entry.userNumber && entry.userNumber > 0) {
                html += '<div data-avatar="' + String(entry.userNumber) + '"></div>';
            } else {
                html += '<div class="chat-web-avatar-placeholder" data-initial="' + escapeAttr(initial) + '">' + escapeHtml(initial) + '</div>';
            }
            html += '</div>';
            html += '<div>';
            html += '<div><strong>' + escapeHtml(entry.nick || 'Unknown') + '</strong></div>';
            if (entry.system) {
                html += '<div class="chat-web-channel">' + escapeHtml(entry.system) + '</div>';
            }
            html += '</div></button>';
        });

        usersList.innerHTML = html;
        renderEmbeddedAvatars(usersList);
        renderLocalAvatars(usersList);
        renderAvatarFallbacks(usersList);
        updateUserCountButton();
    }

    function buildActorAttrs(message, isSelf) {
        if (isSelf || !message.sender) {
            return '';
        }

        return ' data-private-user="' + escapeAttr(message.sender) + '"' +
            ' data-private-system="' + escapeAttr(message.system || '') + '"' +
            ' data-private-avatar="' + escapeAttr(message.avatar || '') + '"';
    }

    function renderBitmapBubble(message) {
        var cols = Math.max(1, message.bitmapWidth || 80);
        var rows = Math.max(1, message.bitmapHeight || 25);
        var pixelWidth = cols * 8;
        var pixelHeight = rows * 16;
        var label = 'image ' + cols + 'x' + rows;

        return '<div class="chat-bitmap-shell" style="' + escapeAttr('max-width:' + pixelWidth + 'px;') + '">' +
            '<div class="chat-bitmap-frame">' +
            '<div class="chat-bitmap-stage" data-chat-bitmap-key="' + escapeAttr(message.bitmapKey || '') + '" data-chat-bitmap-alt="' + escapeAttr(label) + '" style="' + escapeAttr('aspect-ratio:' + pixelWidth + ' / ' + pixelHeight + ';') + '">' +
            '<div class="chat-bitmap-placeholder">Rendering ' + escapeHtml(label) + '...</div>' +
            '</div>' +
            '</div>' +
            '</div>';
    }

    function renderMessages() {
        var msgs = getMessages();
        var html = '';
        var prevSender = '';
        var prevTime = 0;
        var groupWindow = 120000;

        if (!msgs.length) {
            msgContainer.innerHTML = '<div class="chat-web-empty">No messages yet. Say hello.</div>';
            return;
        }

        msgs.forEach(function (message) {
            var displaySender = message.sender || message.bitmapFromName || '';
            if (!displaySender && message.kind === 'bitmap' && message.bitmapKey) {
                displaySender = 'Image';
            }
            var isSystem = !displaySender;
            var isSelf = !!message.isSelf;
            var sameGroup = displaySender === prevSender && Math.abs((message.timestamp || 0) - prevTime) < groupWindow;
            var avatarInitial = displaySender ? displaySender.charAt(0).toUpperCase() : '?';
            var actorAttrs = buildActorAttrs(message, isSelf);

            if (!isSelf && userAlias) {
                isSelf =
                    normalizeUpper(displaySender) === normalizeUpper(userAlias) &&
                    (!message.system || !userSystemName || normalizeUpper(message.system) === normalizeUpper(userSystemName));
            }

            if (isSystem) {
                html += '<div class="chat-system-msg">' + escapeHtml(message.text || '') + '</div>';
                prevSender = '';
                prevTime = 0;
                return;
            }

            if (!sameGroup) {
                if (prevSender.length) {
                    html += '</div></div>';
                }

                html += '<div class="chat-msg-group ' + (isSelf ? 'chat-msg-group-self' : 'chat-msg-group-other') + '">';
                if (actorAttrs.length) {
                    html += '<button type="button" class="chat-avatar chat-web-actor"' + actorAttrs + '>';
                } else {
                    html += '<div class="chat-avatar">';
                }

                if (message.avatar) {
                    html += '<div data-avatar-bin="' + escapeAttr(message.avatar) + '"></div>';
                } else if (message.userNumber && message.userNumber > 0) {
                    html += '<div data-avatar="' + String(message.userNumber) + '"></div>';
                } else {
                    html += '<div class="chat-avatar-placeholder" data-initial="' + escapeAttr(avatarInitial) + '">' + escapeHtml(avatarInitial) + '</div>';
                }

                html += actorAttrs.length ? '</button>' : '</div>';
                html += '<div class="chat-msg-content">';
                html += '<div class="chat-header">';
                if (actorAttrs.length) {
                    html += '<button type="button" class="chat-sender chat-web-sender-button"' + actorAttrs + '>';
                } else {
                    html += '<div class="chat-sender">';
                }
                html += '<strong>' + escapeHtml(displaySender) + '</strong>';
                if (message.system) {
                    html += ' <span class="chat-web-channel">- ' + escapeHtml(message.system) + '</span>';
                }
                html += ' <small class="chat-timestamp">' + escapeHtml(formatTime(message.timestamp)) + '</small>';
                if (actorAttrs.length) {
                    html += '</button>';
                } else {
                    html += '</div>';
                }
                html += '</div>';
            }

            if (message.kind === 'bitmap' && message.bitmapKey) {
                html += '<div class="chat-bubble ' + (isSelf ? 'chat-bubble-self' : 'chat-bubble-other') + ' chat-bitmap-bubble">' + renderBitmapBubble(message) + '</div>';
            } else {
                html += '<div class="chat-bubble ' + (isSelf ? 'chat-bubble-self' : 'chat-bubble-other') + '">' + linkify(message.text || '') + '</div>';
            }
            prevSender = displaySender;
            prevTime = message.timestamp || 0;
        });

        if (prevSender.length) {
            html += '</div></div>';
        }

        msgContainer.innerHTML = html;
        renderEmbeddedAvatars(msgContainer);
        renderEmbeddedBitmaps(msgContainer);
        renderLocalAvatars(msgContainer);
        renderAvatarFallbacks(msgContainer);
        requestAnimationFrame(function () {
            msgContainer.scrollTop = msgContainer.scrollHeight;
        });
    }

    function renderAll() {
        var activeView = getActiveView();
        renderViewLabel(activeView);
        renderStatus(chatService && chatService.getStatus ? chatService.getStatus() : {});
        renderRooms();
        renderPrivateThreads();
        renderUsers();
        renderMessages();
        updateQueryString(activeView);
        updateComposer();
    }

    function syncRouteIntoService() {
        var route = parseRoute();
        var activeView = getActiveView();

        if (route.privateName.length && isLoggedIn) {
            if (
                activeView.type !== 'private' ||
                normalizeUpper(activeView.name || '') !== normalizeUpper(route.privateName) ||
                normalizeUpper(activeView.system || '') !== normalizeUpper(route.privateSystem)
            ) {
                chatService.openPrivateThread(route.privateName, route.privateSystem, '');
                return true;
            }
            return false;
        }

        if (
            activeView.type !== 'channel' ||
            normalizeUpper(activeView.name || '') !== normalizeUpper(route.channel)
        ) {
            chatService.setActiveChannel(route.channel);
            return true;
        }

        return false;
    }

    function onMessagesUpdated() {
        renderMessages();
    }

    function onRoomsUpdated() {
        renderRooms();
    }

    function onPrivateUpdated() {
        renderPrivateThreads();
    }

    function onUsersUpdated(e) {
        users = e.detail || [];
        if (normalizeUpper(usersPanelRoom) === normalizeUpper(getCurrentChannelName())) {
            usersPanelUsers = Array.isArray(users) ? users.slice() : [];
            renderUsers();
        }
    }

    function onStatusUpdated(e) {
        renderStatus(e.detail || {});
    }

    function onViewChanged(e) {
        var view = e.detail || getActiveView();
        renderViewLabel(view);
        renderRooms();
        renderPrivateThreads();
        updateQueryString(view);
        updateComposer();
    }

    function openPrivateFromButton(button) {
        var name;

        if (!button || !chatService || !chatService.openPrivateThread) {
            return;
        }

        name = button.getAttribute('data-private-user') || button.getAttribute('data-private-nav');
        if (!name) {
            return;
        }

        chatService.openPrivateThread(
            name,
            button.getAttribute('data-private-system'),
            button.getAttribute('data-private-avatar')
        );
    }

    function openRoomModal() {
        if (!roomModal) {
            return;
        }
        roomModal.classList.add('is-open');
        roomModal.setAttribute('aria-hidden', 'false');
        if (roomInput) {
            roomInput.focus();
            roomInput.select();
        }
    }

    function closeRoomModal() {
        if (!roomModal) {
            return;
        }
        roomModal.classList.remove('is-open');
        roomModal.setAttribute('aria-hidden', 'true');
        if (roomInput) {
            roomInput.value = '';
        }
    }

    if (!chatService) {
        renderStatus({
            type: 'error',
            message: 'Chat service is not available on this page.',
            showRetry: false
        });
        return;
    }

    window.addEventListener('chat:messagesUpdated', onMessagesUpdated);
    window.addEventListener('chat:roomsUpdated', onRoomsUpdated);
    window.addEventListener('chat:privateUpdated', onPrivateUpdated);
    window.addEventListener('chat:usersUpdated', onUsersUpdated);
    window.addEventListener('chat:status', onStatusUpdated);
    window.addEventListener('chat:viewChanged', onViewChanged);

    if (usersClose) {
        usersClose.addEventListener('click', closeUsersModal);
    }

    if (statusRetry) {
        statusRetry.addEventListener('click', function () {
            chatService.retrySync();
        });
    }

    if (roomsList) {
        roomsList.addEventListener('click', function (event) {
            var joinButton = event.target.closest('[data-room-join]');
            var usersButton = event.target.closest('[data-room-users]');

            if (joinButton) {
                chatService.setActiveChannel(joinButton.getAttribute('data-room-join'));
                return;
            }

            if (usersButton) {
                openUsersPanelForRoom(usersButton.getAttribute('data-room-users'));
            }
        });
    }

    if (privateList) {
        privateList.addEventListener('click', function (event) {
            openPrivateFromButton(event.target.closest('[data-private-nav]'));
        });
    }

    if (usersList) {
        usersList.addEventListener('click', function (event) {
            openPrivateFromButton(event.target.closest('[data-private-user]'));
        });
    }

    if (msgContainer) {
        msgContainer.addEventListener('click', function (event) {
            openPrivateFromButton(event.target.closest('[data-private-user]'));
        });
    }

    if (roomForm) {
        roomForm.addEventListener('submit', function (event) {
            var raw = roomInput ? trimText(roomInput.value) : '';
            var nextRoom = sanitizeChannelName(raw);

            event.preventDefault();
            if (!raw.length || !nextRoom.length) {
                return;
            }

            chatService.createRoom(nextRoom).then(function (ok) {
                if (!ok) return;
                closeRoomModal();
            });
        });
    }

    if (roomOpen) {
        roomOpen.addEventListener('click', openRoomModal);
    }

    if (roomClose) {
        roomClose.addEventListener('click', closeRoomModal);
    }

    if (roomCancel) {
        roomCancel.addEventListener('click', closeRoomModal);
    }

    if (roomModal) {
        roomModal.addEventListener('click', function (event) {
            if (event.target === roomModal) {
                closeRoomModal();
            }
        });
    }

    if (usersModal) {
        usersModal.addEventListener('click', function (event) {
            if (event.target === usersModal) {
                closeUsersModal();
            }
        });
    }

    // Textarea auto-resize + Enter to send (Shift+Enter for newline)
    if (chatText && chatText.tagName === 'TEXTAREA') {
        function autoResize() {
            chatText.style.height = 'auto';
            chatText.style.height = Math.min(chatText.scrollHeight, 160) + 'px';
        }
        chatText.addEventListener('input', autoResize);
        chatText.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                if (chatInput) chatInput.dispatchEvent(new Event('submit', { cancelable: true }));
            }
        });
    }

    if (chatInput) {
        chatInput.addEventListener('submit', function (event) {
            event.preventDefault();

            // If ANSI editor is active, encode cells as BITMAP and send
            if (ansiEditorActive && ansiEditorInstance && ansiEditorInstance.doc) {
                var doc = ansiEditorInstance.doc;
                var cells = doc.data;
                var cols = doc.columns;
                var rows = doc.rows;
                var fromName = (window.sbbsConfig && window.sbbsConfig.userAlias) || '';

                chatService.buildBitmapPayload(cells, cols, rows, fromName).then(function (payload) {
                    return chatService.send(payload);
                }).then(function (ok) {
                    if (!ok) return;
                    closeAnsiEditor();
                });
                return;
            }

            // Normal text send
            var text = chatText.value.replace(/^\s+|\s+$/g, '');
            if (!text.length) return;

            chatService.send(text).then(function (ok) {
                if (!ok) return;
                chatText.value = '';
                if (chatText.tagName === 'TEXTAREA') {
                    chatText.style.height = 'auto';
                }
            });
        });
    }

    // ═══ ANSI Editor Toggle ═══
    var ansiToggle = document.getElementById('chat-ansi-toggle');
    var ansiEditorInstance = null;
    var ansiEditorActive = false;

    function openAnsiEditor() {
        if (!window.AnsiEditorModal) { console.error('AnsiEditorModal not loaded'); return; }
        if (AnsiEditorModal.isOpen) return;
        ansiToggle.classList.add('active');
        ansiToggle.textContent = 'Text';
        ansiEditorActive = true;

        AnsiEditorModal.open({
            title: 'ANSI Editor — Chat',
            columns: 80,
            rows: 25,
            fontUrl: './fonts/ansi-editor/IBM VGA.F16',
            onDone: function (editor) {
                // editor.doc is still available because we receive it before destroy
                if (editor && editor.doc) {
                    var doc = editor.doc;
                    var cells = doc.data;
                    var cols = doc.columns;
                    var rows = doc.rows;
                    var fromName = (window.sbbsConfig && window.sbbsConfig.userAlias) || '';
                    chatService.buildBitmapPayload(cells, cols, rows, fromName).then(function (payload) {
                        return chatService.send(payload);
                    });
                }
                resetAnsiToggle();
            },
            onCancel: function () {
                resetAnsiToggle();
            }
        });
    }

    function closeAnsiEditor() {
        if (AnsiEditorModal && AnsiEditorModal.isOpen) {
            AnsiEditorModal.close();
        }
        resetAnsiToggle();
    }

    function resetAnsiToggle() {
        if (ansiToggle) {
            ansiToggle.classList.remove('active');
            ansiToggle.textContent = 'ANSI';
        }
        ansiEditorActive = false;
        ansiEditorInstance = null;
    }

    if (ansiToggle) {
        ansiToggle.addEventListener('click', function () {
            if (ansiEditorActive) {
                closeAnsiEditor();
            } else {
                openAnsiEditor();
            }
        });
    }


    /* ── MOTD ticker ── */
    var motdBar = document.getElementById('chat-motd');
    var motdWindow = document.getElementById('chat-motd-window');
    var motdTrack = document.getElementById('chat-motd-track');
    var motdPrimary = document.getElementById('chat-motd-primary');
    var motdClone = document.getElementById('chat-motd-clone');
    var motdText = '';
    var motdRenderSignature = '';

    function syncMotdTicker() {
        var primaryWidth = 0;
        var windowWidth = 0;
        var gap = 40;
        var distance = 0;
        var duration = 0;

        if (!motdBar || !motdWindow || !motdTrack || !motdPrimary || !motdClone) return;

        motdBar.classList.remove('is-scrolling');
        motdTrack.style.removeProperty('--motd-scroll-width');
        motdTrack.style.removeProperty('--motd-duration');
        motdClone.style.display = 'none';

        if (!motdText.length) {
            motdBar.classList.add('is-empty');
            return;
        }

        motdBar.classList.remove('is-empty');
        primaryWidth = motdPrimary.scrollWidth || 0;
        windowWidth = motdWindow.clientWidth || 0;

        if (primaryWidth <= windowWidth + 8) return;

        distance = primaryWidth + gap;
        duration = Math.max(12, Math.round(distance / 42));
        motdClone.style.display = 'inline-block';
        motdBar.classList.add('is-scrolling');
        motdTrack.style.setProperty('--motd-scroll-width', String(distance) + 'px');
        motdTrack.style.setProperty('--motd-duration', String(duration) + 's');
    }

    function renderMotdBar(text) {
        text = (text || '').replace(/^\s+|\s+$/g, '');
        motdText = text;
        var primaryText = text.length ? text : '';
        var cloneText = text.length ? text : '';
        var sig = primaryText + '|' + cloneText;

        if (!motdPrimary || !motdClone) return;
        if (motdRenderSignature === sig) return;

        motdRenderSignature = sig;
        motdPrimary.textContent = primaryText;
        motdClone.textContent = cloneText;
        window.requestAnimationFrame(syncMotdTicker);
    }

    function loadMotd() {
        window.fetch('./api/chat.ssjs?action=motd', { credentials: 'include' })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data && data.previewText) {
                    renderMotdBar(data.previewText);
                } else {
                    renderMotdBar('');
                }
            })
            .catch(function () { renderMotdBar(''); });
    }

    loadMotd();
    // refresh MOTD every 5 minutes
    var motdRefreshTimer = setInterval(loadMotd, 5 * 60 * 1000);


    /* ── MOTD ticker ── */
    var motdBar = document.getElementById('chat-motd');
    var motdWindow = document.getElementById('chat-motd-window');
    var motdTrack = document.getElementById('chat-motd-track');
    var motdPrimary = document.getElementById('chat-motd-primary');
    var motdClone = document.getElementById('chat-motd-clone');
    var motdText = '';
    var motdRenderSignature = '';

    function syncMotdTicker() {
        var primaryWidth = 0;
        var windowWidth = 0;
        var gap = 40;
        var distance = 0;
        var duration = 0;

        if (!motdBar || !motdWindow || !motdTrack || !motdPrimary || !motdClone) return;

        motdBar.classList.remove('is-scrolling');
        motdTrack.style.removeProperty('--motd-scroll-width');
        motdTrack.style.removeProperty('--motd-duration');
        motdClone.style.display = 'none';

        if (!motdText.length) {
            motdBar.classList.add('is-empty');
            return;
        }

        motdBar.classList.remove('is-empty');
        primaryWidth = motdPrimary.scrollWidth || 0;
        windowWidth = motdWindow.clientWidth || 0;

        if (primaryWidth <= windowWidth + 8) return;

        distance = primaryWidth + gap;
        duration = Math.max(12, Math.round(distance / 42));
        motdClone.style.display = 'inline-block';
        motdBar.classList.add('is-scrolling');
        motdTrack.style.setProperty('--motd-scroll-width', String(distance) + 'px');
        motdTrack.style.setProperty('--motd-duration', String(duration) + 's');
    }

    function renderMotdBar(text) {
        text = (text || '').replace(/^\s+|\s+$/g, '');
        motdText = text;
        var primaryText = text.length ? text : '';
        var cloneText = text.length ? text : '';
        var sig = primaryText + '|' + cloneText;

        if (!motdPrimary || !motdClone) return;
        if (motdRenderSignature === sig) return;

        motdRenderSignature = sig;
        motdPrimary.textContent = primaryText;
        motdClone.textContent = cloneText;
        window.requestAnimationFrame(syncMotdTicker);
    }

    function loadMotd() {
        window.fetch('./api/chat.ssjs?action=motd', { credentials: 'include' })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data && data.previewText) {
                    renderMotdBar(data.previewText);
                } else {
                    renderMotdBar('');
                }
            })
            .catch(function () { renderMotdBar(''); });
    }

    loadMotd();
    // refresh MOTD every 5 minutes
    var motdRefreshTimer = setInterval(loadMotd, 5 * 60 * 1000);

        chatService.setChatPageActive(true);
    renderAll();
    if (!syncRouteIntoService()) {
        chatService.loadHistory();
        chatService.getUsers();
    }

    window.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && usersModal && usersModal.classList.contains('is-open')) {
            closeUsersModal();
            return;
        }
        if (event.key === 'Escape' && roomModal && roomModal.classList.contains('is-open')) {
            closeRoomModal();
        }
    });

    function cleanup() {
        if (ansiEditorActive) closeAnsiEditor();
        window.removeEventListener('chat:messagesUpdated', onMessagesUpdated);
        window.removeEventListener('chat:roomsUpdated', onRoomsUpdated);
        window.removeEventListener('chat:privateUpdated', onPrivateUpdated);
        window.removeEventListener('chat:usersUpdated', onUsersUpdated);
        window.removeEventListener('chat:status', onStatusUpdated);
        window.removeEventListener('chat:viewChanged', onViewChanged);
        window.removeEventListener('spa:beforeNavigate', cleanup);
        if (motdRefreshTimer) clearInterval(motdRefreshTimer);
        if (motdRefreshTimer) clearInterval(motdRefreshTimer);
        chatService.setChatPageActive(false);
    }

    window.addEventListener('spa:beforeNavigate', cleanup);
})();
</script>
