}
.chat-web-page .chat-rich-audio-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
.chat-web-page .chat-rich-audio-card.is-ready .chat-rich-audio-status {
    color: #55FF55;
}
.chat-web-page .chat-rich-audio-card.is-missing .chat-rich-audio-status {
    color: #FF5555;
}

/* ── Composer form ── */
.chat-web-page .chat-web-form {
    margin: 0;
    padding: 8px 10px;
    border-top: 1px solid var(--chat-border);
    background: transparent;
}
.chat-web-page .chat-web-login {
    color: var(--chat-muted);
    text-align: center;
    margin: 0;
    padding: 10px;
    border-top: 1px solid var(--chat-border);
    font-size: 0.85rem;
}
.chat-web-page .chat-web-login a {
    color: #55FFFF;
}

/* ── Responsive ── */
@media (max-width: 980px) {
    .chat-web-page {
        width: calc(100% + 1rem);
        max-width: 100vw;
        margin-left: -0.5rem;
        margin-right: -0.5rem;
    }
    .chat-web-page .chat-web-shell {
        border-left: none;
        border-right: none;
        border-radius: 0;
    }
    .chat-web-page .chat-web-layout {
        grid-template-columns: 1fr;
        grid-template-rows: minmax(0, auto) minmax(0, 1fr);
        gap: 0;
    }
    .chat-web-page .chat-web-sidebar {
        max-height: none;
        border-right: none;
        border-bottom: 1px solid var(--chat-border);
        overflow: visible;
    }
    .chat-web-page .chat-web-mobile-strip {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
        gap: 0;
        border-bottom: 1px solid var(--chat-border);
        background: rgba(85, 255, 255, 0.05);
    }
    .chat-web-page .chat-web-mobile-toggle,
    .chat-web-page .chat-web-mobile-create {
        border-top: none;
        border-bottom: none;
    }
    .chat-web-page .chat-web-mobile-toggle + .chat-web-mobile-toggle,
    .chat-web-page .chat-web-mobile-create {
        border-left: none;
    }
    .chat-web-page .chat-web-sidebar-create-desktop,
    .chat-web-page .chat-web-sidebar-section[data-panel] .chat-web-sidebar-header {
        display: none;
    }
    .chat-web-page .chat-web-sidebar-section[data-panel] {
        display: none;
        border-top: 1px solid var(--chat-border);
    }
    .chat-web-page .chat-web-sidebar-section[data-panel] + .chat-web-sidebar-section[data-panel] {
        margin-top: 0;
        padding-top: 0;
    }
    .chat-web-page .chat-web-sidebar[data-mobile-panel="rooms"] .chat-web-sidebar-section[data-panel="rooms"],
    .chat-web-page .chat-web-sidebar[data-mobile-panel="private"] .chat-web-sidebar-section[data-panel="private"] {
        display: flex;
    }
    .chat-web-page .chat-web-sidebar-section[data-panel] .chat-web-nav-list {
        max-height: min(26vh, 17rem);
        overflow-y: auto;
    }
}
@media (max-width: 768px) {
    .chat-web-page {
        width: calc(100% + 1.5rem);
        margin-left: -0.75rem;
        margin-right: -0.75rem;
        padding-top: 0;
        padding-bottom: 0;
    }
    .chat-web-page .chat-web-mobile-toggle,
    .chat-web-page .chat-web-mobile-create {
        padding: 0.5rem 0.55rem;
        font-size: 0.72rem;
        min-height: 2.3rem;
    }
    .chat-web-page .chat-web-shell {
        height: calc(100vh - 120px);
        height: calc(100dvh - 120px);
    }
    .chat-web-page .chat-msg-group,
    .chat-web-page .chat-web-group {
        max-width: 100%;
    }
    .chat-web-page .chat-web-messages {
        padding: 6px 8px;
    }
}

/* ── ANSI Editor in chat ── */
.chat-web-page .chat-ansi-toggle {
    border: 1px solid var(--chat-border);
    background: transparent;
    color: #AAAAAA;
    border-radius: 0;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    font-size: 0.82rem;
    white-space: nowrap;
}
.chat-web-page .chat-ansi-toggle:hover {
    border-color: #FF55FF;
    color: #FF55FF;
}
.chat-web-page .chat-ansi-toggle.active {
    border-color: #FF55FF;
    color: #FF55FF;
    background: transparent;
    font-weight: bold;
}
.chat-web-page .chat-ansi-wrap {
    display: none;
    width: 100%;
    border: 1px solid #333;
    border-radius: 0;
    overflow: hidden;
    background: #000;
}
.chat-web-page .chat-ansi-wrap.active {
