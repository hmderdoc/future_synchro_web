<!--Chat-->
<script type="text/javascript" src="./js/ansi-editor.js"></script>
<script type="text/javascript" src="./js/ansi-editor-modal.js"></script>
<link rel="stylesheet" href="./css/ansi-editor-modal.css">
<style>
/* ═══ Chat page – CGA BBS aesthetic ═══ */
.chat-web-page {
    --chat-bg: #000;
    --chat-panel: #000;
    --chat-border: #555555;
    --chat-border-accent: #55FFFF;
    --chat-muted: #AAAAAA;
    --chat-fg: #AAAAAA;
    color: var(--chat-fg);
    min-height: 0;
    padding: 0 0 0.25rem;
}

/* ── Shell ── */
.chat-web-page .chat-web-shell {
    display: flex;
    flex-direction: column;
    gap: 0;
    height: calc(100vh - 140px);
    height: calc(100dvh - 140px);
    min-height: 0;
    overflow: hidden;
    padding: 0;
    border: 1px solid #AAAAAA;
    border-radius: 0.375rem;
    background: #000;
}

/* ── Layout grid ── */
.chat-web-page .chat-web-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 0;
    align-items: stretch;
    flex: 1 1 auto;
    min-height: 0;
}

/* ── Sidebar + Main common ── */
.chat-web-page .chat-web-sidebar,
.chat-web-page .chat-web-main {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-height: 0;
}

/* ── Sidebar ── */
.chat-web-page .chat-web-sidebar {
    border-right: 1px solid var(--chat-border);
    background: #000;
    padding: 0;
    overflow-y: auto;
}
.chat-web-page .chat-web-mobile-strip {
    display: none;
}
.chat-web-page .chat-web-mobile-toggle,
.chat-web-page .chat-web-mobile-create {
    border: 1px solid var(--chat-border);
    background: #000;
    color: #AAAAAA;
    border-radius: 0;
    padding: 0.55rem 0.7rem;
    cursor: pointer;
    font-size: 0.76rem;
    line-height: 1.1;
    min-height: 2.5rem;
}
.chat-web-page .chat-web-mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-width: 0;
}
.chat-web-page .chat-web-mobile-toggle > span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.chat-web-page .chat-web-mobile-toggle:hover,
.chat-web-page .chat-web-mobile-create:hover:not(:disabled) {
    border-color: #55FFFF;
    color: #55FFFF;
}
.chat-web-page .chat-web-mobile-toggle.is-active {
    color: #55FFFF;
    border-color: #55FFFF;
    background: rgba(85, 255, 255, 0.08);
}
.chat-web-page .chat-web-mobile-chevron {
    width: 0.48rem;
    height: 0.48rem;
    flex: 0 0 auto;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    transform-origin: center;
    transition: transform 0.12s ease;
}
.chat-web-page .chat-web-mobile-toggle.is-active .chat-web-mobile-chevron {
    transform: rotate(-135deg) translateY(-1px);
}
.chat-web-page .chat-web-mobile-create {
    color: #55FF55;
    white-space: nowrap;
}
.chat-web-page .chat-web-sidebar-create-desktop {
    display: inline-flex;
}

.chat-web-page .chat-web-main {
    min-width: 0;
    overflow: hidden;
    gap: 0;
}

/* ── Sidebar sections ── */
.chat-web-page .chat-web-sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 0;
}
.chat-web-page .chat-web-sidebar-section + .chat-web-sidebar-section {
    margin-top: 0;
    padding-top: 0;
    border-top: 1px solid var(--chat-border);
}

.chat-web-page .chat-web-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 6px 8px;
    border-bottom: 1px solid #333;
    background: rgba(85, 255, 255, 0.06);
}
.chat-web-page .chat-web-sidebar-heading,
.chat-web-page .chat-web-title {
    margin: 0;
    font-size: 0.85rem;
    color: #FFFF55;
}

/* ── Sidebar inputs / buttons ── */
.chat-web-page .chat-web-sidebar-form,
.chat-web-page .chat-web-form {
    display: flex;
    gap: 0.4rem;
}
.chat-web-page .chat-web-sidebar-input,
.chat-web-page .chat-web-input {
    flex: 1 1 auto;
    border: 1px solid var(--chat-border);
    background: #000;
    color: #FFFFFF;
    border-radius: 0;
    padding: 0.5rem 0.6rem;
}
textarea.chat-web-input {
    resize: none;
    overflow: hidden;
    min-height: 2.6rem;
    max-height: 8rem;
    line-height: 1.4;
    font-family: inherit;
    font-size: inherit;
    overflow-y: auto;
    field-sizing: content;
}
#chat-text {
    border-color: #FFFF55;
}
#chat-text:focus {
    border-color: #FFFF55;
    outline: none;
    box-shadow: 0 0 0 1px rgba(255, 255, 85, 0.3);
}
.chat-web-page .chat-web-sidebar-button,
.chat-web-page .chat-web-send,
.chat-web-page .chat-web-status-button,
.chat-web-page .chat-web-users-close {
    border: 1px solid var(--chat-border);
    background: #000;
    color: #AAAAAA;
    border-radius: 0;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    font-size: 0.82rem;
}
#chat-room-open {
    color: #55FF55;
    text-decoration: underline;
    text-decoration-color: #FF55FF;
    text-underline-offset: 3px;
}
.chat-web-page .chat-web-sidebar-button:hover {
    border-color: #55FFFF;
    color: #55FFFF;
}
.chat-web-page .chat-web-send {
    background: #000;
    color: #FF55FF;
    border-color: #55FF55;
    font-weight: bold;
    min-width: 70px;
}
.chat-web-page .chat-web-send:hover {
    background: rgba(85, 255, 85, 0.1);
}

/* ── MOTD ticker ── */
.chat-web-page .chat-motd-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #000;
    padding: 4px 8px;
    border-bottom: 1px solid var(--chat-border);
    min-height: 0;
    overflow: hidden;
}
.chat-web-page .chat-motd-bar.is-empty {
    display: none;
}
.chat-web-page .chat-motd-label {
    font-size: 0.72rem;
    font-weight: bold;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #55FF55;
    flex-shrink: 0;
}
.chat-web-page .chat-motd-window {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
}
.chat-web-page .chat-motd-track {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    min-width: 100%;
    --motd-scroll-width: 0px;
    --motd-duration: 18s;
}
.chat-web-page .chat-motd-bar.is-scrolling .chat-motd-track {
    animation: chat-motd-scroll var(--motd-duration) linear infinite;
}
.chat-web-page .chat-motd-item {
    display: inline-block;
    white-space: nowrap;
    color: #55FF55;
    font-size: 0.82rem;
}
.chat-web-page .chat-motd-item-clone {
    display: none;
}
@keyframes chat-motd-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-1 * var(--motd-scroll-width))); }
}

/* ── Nav list (rooms / private threads) ── */
.chat-web-page .chat-web-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0;
}
.chat-web-page .chat-web-nav-empty,
.chat-web-page .chat-web-empty {
    color: var(--chat-muted);
    padding: 8px;
    font-size: 0.82rem;
}
.chat-web-page .chat-web-nav-item {
    border: none;
    border-bottom: 1px solid #222;
    background: transparent;
    color: var(--chat-fg);
    border-radius: 0;
    padding: 6px 8px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.chat-web-page .chat-web-nav-item:hover {
    background: rgba(85, 255, 255, 0.05);
}
.chat-web-page .chat-web-nav-item.is-active {
    border-left: 2px solid #55FFFF;
    background: rgba(85, 255, 255, 0.08);
}
.chat-web-page .chat-web-nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
}
.chat-web-page .chat-web-nav-title {
    font-weight: bold;
    min-width: 0;
    font-size: 0.85rem;
    color: #FFFFFF;
}
.chat-web-page .chat-web-nav-title.is-user,
.chat-web-page .chat-web-user-name {
    color: #55FFFF;
}
.chat-web-page .chat-web-nav-secondary,
.chat-web-page .chat-web-nav-preview {
    color: #555555;
    font-size: 0.78rem;
}
.chat-web-page .chat-web-channel,
.chat-web-page .chat-web-system-name {
    color: #FF55FF;
    font-size: 0.78rem;
}
.chat-web-page .chat-web-nav-preview {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.chat-web-page .chat-web-nav-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
    margin-top: 2px;
}
.chat-web-page .chat-web-nav-action,
.chat-web-page .chat-web-nav-state {
    border: 1px solid #555;
    border-radius: 0;
    padding: 2px 8px;
    font-size: 0.75rem;
    line-height: 1.2;
}
.chat-web-page .chat-web-nav-action {
    background: transparent;
    color: #AAAAAA;
    cursor: pointer;
}
.chat-web-page .chat-web-nav-action:hover {
    border-color: #55FFFF;
    color: #55FFFF;
}
.chat-web-page .chat-web-nav-action.is-primary {
    border-color: #55FFFF;
    color: #55FFFF;
    background: transparent;
    font-weight: bold;
}
.chat-web-page .chat-web-nav-state {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border-color: #00AAAA;
    color: #55FFFF;
    font-size: 0.72rem;
}

/* ── Badge ── */
.chat-web-page .chat-web-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.2rem;
    padding: 1px 5px;
    border-radius: 0;
    font-size: 0.7rem;
    font-weight: bold;
    background: transparent;
    color: #55FFFF;
    border: 1px solid #55FFFF;
}
.chat-web-page .chat-web-badge.is-unread {
    background: transparent;
    color: #FFFF55;
    border-color: #FFFF55;
}

/* ── Private thread row ── */
.chat-web-page .chat-web-thread-row {
    display: grid;
    grid-template-columns: 10px 36px minmax(0, 1fr);
    gap: 6px;
    align-items: center;
}
.chat-web-page .chat-web-presence-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
}
.chat-web-page .chat-web-presence-dot.is-online {
    background: #55FF55;
}
.chat-web-page .chat-web-presence-dot.is-offline {
    background: #AA0000;
}
.chat-web-page .chat-web-thread-avatar {
    width: 36px;
    min-width: 36px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #333;
    border-radius: 0;
    background: #000;
    overflow: hidden;
}
.chat-web-page .chat-web-thread-avatar img {
    max-width: 100%;
    max-height: 100%;
    image-rendering: pixelated;
}

/* ── Modals ── */
.chat-web-page .chat-web-modal {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.8);
    padding: 1rem;
    z-index: 1050;
}
.chat-web-page .chat-web-modal.is-open {
    display: flex;
}
.chat-web-page .chat-web-modal-card {
    width: min(400px, 100%);
    border: 1px solid var(--chat-border);
    border-radius: 0;
    background: #000;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.chat-web-page .chat-web-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
}
.chat-web-page .chat-web-modal-title {
    margin: 0;
    color: #FFFF55;
}
.chat-web-page .chat-web-modal-text {
    color: var(--chat-muted);
    margin: 0;
    font-size: 0.85rem;
}
.chat-web-page .chat-web-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.4rem;
}

/* ── Topbar ── */
.chat-web-page .chat-web-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
}
.chat-web-page .chat-web-count {
    border: 1px solid var(--chat-border);
    background: transparent;
    color: #55FFFF;
    border-radius: 0;
    padding: 3px 8px;
    cursor: pointer;
    font-size: 0.82rem;
}

/* ── Status bar ── */
.chat-web-page .chat-web-status {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    border: none;
    border-bottom: 1px solid #333;
    border-radius: 0;
    padding: 6px 10px;
    background: rgba(85, 85, 85, 0.08);
    font-size: 0.82rem;
}
.chat-web-page .chat-web-status.is-visible {
    display: flex;
}
.chat-web-page .chat-web-status.is-warning {
    border-bottom-color: #AA5500;
    color: #FFFF55;
}
.chat-web-page .chat-web-status.is-error {
    border-bottom-color: #AA0000;
    color: #FF5555;
}

/* ── Users modal ── */
.chat-web-page .chat-web-users-modal-card {
    width: min(480px, 100%);
    max-height: min(72vh, 600px);
}
.chat-web-page .chat-web-users-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0;
    color: #FFFF55;
}
.chat-web-page .chat-web-users-list {
    display: grid;
    gap: 0;
    flex: 1 1 auto;
    min-height: 0;
    max-height: none;
    overflow-y: auto;
}
.chat-web-page .chat-web-user {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 8px;
    align-items: center;
    border: none;
    border-bottom: 1px solid #222;
    background: transparent;
    color: var(--chat-fg);
    border-radius: 0;
    padding: 6px 8px;
    text-align: left;
}
.chat-web-page .chat-web-user:hover {
    background: rgba(85, 255, 255, 0.05);
}
.chat-web-page .chat-web-user-avatar,
.chat-web-page .chat-web-avatar {
    width: 40px;
    min-width: 40px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #333;
    border-radius: 0;
    background: #000;
    overflow: hidden;
}
.chat-web-page .chat-web-user-avatar img,
.chat-web-page .chat-web-avatar img {
    max-width: 100%;
    max-height: 100%;
    image-rendering: pixelated;
}

/* ── Chat panel (messages area) ── */
.chat-web-page .chat-web-chatpanel {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    border: none;
    border-radius: 0;
    background: #000;
}
.chat-web-page .chat-web-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #555555;
    font-weight: bold;
    font-size: 1rem;
}
.chat-web-page .chat-web-actor,
.chat-web-page .chat-web-sender-button {
    border: 0;
    background: transparent;
    color: inherit;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font: inherit;
    text-align: inherit;
}
.chat-web-page .chat-web-sender-button {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
}

/* ── Messages container ── */
.chat-web-page .chat-web-messages {
    flex: 1 1 0;
    border: 0;
    background: transparent;
    border-radius: 0;
    padding: 8px 10px 6px;
    overflow-y: auto;
    overflow-anchor: none;
    min-height: 0;
    margin: 0;
}

/* ── System messages ── */
.chat-web-page .chat-web-system,
.chat-web-page .chat-system-msg {
    text-align: center;
    color: #555555;
    margin: 4px 0 8px;
    font-size: 0.78rem;
    font-style: italic;
}

/* ── Message groups ── */
.chat-web-page .chat-web-group,
.chat-web-page .chat-msg-group {
    display: flex;
    gap: 8px;
    margin-bottom: 8px;
    max-width: 88%;
}
.chat-web-page .chat-web-group.is-self,
.chat-web-page .chat-msg-group-self {
    margin-left: auto;
    flex-direction: row-reverse;
    align-self: flex-end;
}
.chat-web-page .chat-msg-group-other {
    align-self: flex-start;
}

/* ── Content column ── */
.chat-web-page .chat-web-content,
.chat-web-page .chat-msg-content {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

/* ── Header ── */
.chat-web-page .chat-web-header,
.chat-web-page .chat-header {
    font-size: 0.82rem;
    margin-bottom: 2px;
}
.chat-web-page .chat-web-group.is-self .chat-web-header,
.chat-web-page .chat-msg-group-self .chat-header {
    text-align: right;
}

/* ── Sender / timestamp ── */
.chat-web-page .chat-web-time,
.chat-web-page .chat-timestamp {
    color: #55FF55;
    font-size: 0.72rem;
}
.chat-web-page .chat-sender {
    font-size: 0.82rem;
    font-weight: 700;
    color: #FF55FF;
    padding: 0;
    margin: 0;
}
.chat-web-page .chat-sender-name {
    color: #55FFFF;
}

/* ── Avatars (message bubbles) ── */
.chat-web-page .chat-avatar {
    flex-shrink: 0;
    align-self: flex-start;
    width: 44px;
    border-radius: 0;
    overflow: hidden;
    background: #000;
    border: 1px solid #333;
}
.chat-web-page .chat-avatar img {
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    display: block;
}
.chat-web-page .chat-avatar-placeholder {
    color: #555;
    font-size: 14px;
    font-weight: bold;
    line-height: 58px;
    text-align: center;
    display: block;
    width: 100%;
}

/* ════════════════════════════════════════════════
   Chat Bubbles – CGA bordered style
   ════════════════════════════════════════════════ */
.chat-web-page .chat-web-bubble,
.chat-web-page .chat-bubble {
    display: block;
    padding: 6px 10px;
    border-radius: 0;
    margin-bottom: 3px;
    max-width: 100%;
    word-break: break-word;
    line-height: 1.45;
    font-weight: normal;
    background: transparent;
}

/* Other people's bubbles: cyan border, white text */
.chat-web-page .chat-web-group:not(.is-self) .chat-web-bubble,
.chat-web-page .chat-bubble-other {
    border: 1px solid #55FFFF;
    color: #FFFFFF;
    background: transparent;
}

/* Self bubbles: blue border, light gray text */
.chat-web-page .chat-web-group.is-self .chat-web-bubble,
.chat-web-page .chat-bubble-self {
    border: 1px solid #5555FF;
    color: #AAAAAA;
    background: transparent;
}
.chat-web-page .chat-bubble-self a {
    color: #55FFFF;
}
.chat-web-page .chat-bubble-other a {
    color: #FF55FF;
}

/* ── Bitmap bubbles ── */
.chat-web-page .chat-bubble.chat-bitmap-bubble {
    padding: 4px;
    overflow: hidden;
}
.chat-web-page .chat-bitmap-shell {
    width: 100%;
}
.chat-web-page .chat-bitmap-frame {
    width: 100%;
    border: 1px solid #333;
    border-radius: 0;
    background: #000;
    overflow: hidden;
}
.chat-web-page .chat-bitmap-stage {
    width: 100%;
    background: #000;
    position: relative;
}
.chat-web-page .chat-bitmap-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 5rem;
    padding: 8px;
    color: #555555;
    font-size: 0.78rem;
    text-align: center;
}
.chat-web-page .chat-bitmap-stage.is-error .chat-bitmap-placeholder {
    color: #FF5555;
}
.chat-web-page .chat-bitmap-image {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    background: #000;
}
.chat-web-page .chat-rich-block {
    display: grid;
    gap: 8px;
}
.chat-web-page .chat-rich-text {
    min-width: 0;
}
.chat-web-page .chat-rich-image-card,
.chat-web-page .chat-rich-audio-card {
    border: 1px solid #333333;
    background: #050505;
    padding: 8px;
    width: min(100%, 420px);
}
.chat-web-page .chat-rich-image-link {
    display: block;
    text-decoration: none;
}
.chat-web-page .chat-rich-image-frame {
    display: block;
    border: 1px solid #222222;
    background: #000000;
    overflow: hidden;
}
.chat-web-page .chat-rich-image-preview {
    display: block;
    width: 100%;
    height: auto;
    max-height: 22rem;
    object-fit: contain;
    background: #000000;
}
.chat-web-page .chat-rich-image-card.is-error .chat-rich-image-frame {
    display: none;
}
.chat-web-page .chat-rich-image-fallback {
    display: none;
    color: #AAAAAA;
    font-size: 0.78rem;
}
.chat-web-page .chat-rich-image-card.is-error .chat-rich-image-fallback {
    display: block;
}
.chat-web-page .chat-rich-image-caption,
.chat-web-page .chat-rich-audio-title {
    color: #FFFFFF;
    margin-top: 8px;
}
.chat-web-page .chat-rich-image-meta,
.chat-web-page .chat-rich-audio-meta,
.chat-web-page .chat-rich-audio-status {
    color: #AAAAAA;
    font-size: 0.76rem;
}
.chat-web-page .chat-rich-image-meta {
    margin-top: 4px;
}
.chat-web-page .chat-rich-audio-main {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
}
.chat-web-page .chat-rich-audio-icon {
    color: #55FFFF;
    font-size: 1.2rem;
    line-height: 1;
}
.chat-web-page .chat-rich-audio-copy {
    min-width: 0;
}
.chat-web-page .chat-rich-audio-title {
    margin-top: 0;
    color: #55FFFF;
}
.chat-web-page .chat-rich-audio-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 8px;
    flex-wrap: wrap;
}
.chat-web-page .chat-rich-audio-link {
    color: #FF55FF;
    font-size: 0.78rem;
}
.chat-web-page .chat-rich-audio-button {
    border: 1px solid #00AA00;
    background: transparent;
    color: #55FFFF;
    font-family: inherit;
    font-size: 0.78rem;
    line-height: 1.2;
    padding: 6px 10px;
    cursor: pointer;
}
.chat-web-page .chat-rich-audio-button:hover:not(:disabled) {
    background: #00AA00;
