<!--Chat-->
<script type="text/javascript" src="./js/ansi-editor.js"></script>
<script type="text/javascript" src="./js/ansi-editor-modal.js"></script>
<script type="text/javascript" src="./js/chat-embeds.js"></script>
<script type="text/javascript" src="./js/chat-upload.js"></script>
<link rel="stylesheet" href="./css/ansi-editor-modal.css">
<style>
/* ═══ Chat page – CGA BBS aesthetic ═══ */
.chat-web-page {
    --chat-bg: #000;
    --chat-panel: #000;
    --chat-border: #555555;
    --chat-border-accent: #55FFFF;
    --chat-muted: #AAAAAA;
    --chat-fg: #AAAAAA;
    color: var(--chat-fg);
    min-height: 0;
    padding: 0 0 0.25rem;
}

/* Beside a taller site sidebar the content column stretches to the sidebar's
   height, so scrolling the page used to carry the chat off the top and leave
   the column blank. Pin it where it already sits (.spa-container's 70px
   navbar offset). Desktop only: below md the sidebar stacks underneath. */
@media (min-width: 768px) {
    .chat-web-page {
        position: sticky;
        top: 70px;
    }
}

/* ── Shell ── */
.chat-web-page .chat-web-shell {
    display: flex;
    flex-direction: column;
    gap: 0;
    height: calc(100vh - 140px);
    height: calc(100dvh - 140px);
    min-height: 0;
    overflow: hidden;
    padding: 0;
    border: 1px solid #AAAAAA;
    border-radius: 0.375rem;
    background: #000;
}

/* ── Layout grid ── */
.chat-web-page .chat-web-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 0;
    align-items: stretch;
    flex: 1 1 auto;
    min-height: 0;
}

/* ── Sidebar + Main common ── */
.chat-web-page .chat-web-sidebar,
.chat-web-page .chat-web-main {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-height: 0;
}

/* ── Sidebar ── */
.chat-web-page .chat-web-sidebar {
    border-right: 1px solid var(--chat-border);
    background: #000;
    padding: 0;
    overflow-y: auto;
}
.chat-web-page .chat-web-mobile-strip {
    display: none;
}
.chat-web-page .chat-web-mobile-toggle,
.chat-web-page .chat-web-mobile-create {
    border: 1px solid var(--chat-border);
    background: #000;
    color: #AAAAAA;
    border-radius: 0;
    padding: 0.55rem 0.7rem;
    cursor: pointer;
    font-size: 0.76rem;
    line-height: 1.1;
    min-height: 2.5rem;
}
.chat-web-page .chat-web-mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-width: 0;
}
.chat-web-page .chat-web-mobile-toggle > span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.chat-web-page .chat-web-mobile-toggle:hover,
.chat-web-page .chat-web-mobile-create:hover:not(:disabled) {
    border-color: #55FFFF;
    color: #55FFFF;
}
.chat-web-page .chat-web-mobile-toggle.is-active {
    color: #55FFFF;
    border-color: #55FFFF;
    background: rgba(85, 255, 255, 0.08);
}
.chat-web-page .chat-web-mobile-chevron {
    width: 0.48rem;
    height: 0.48rem;
    flex: 0 0 auto;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    transform-origin: center;
    transition: transform 0.12s ease;
}
.chat-web-page .chat-web-mobile-toggle.is-active .chat-web-mobile-chevron {
    transform: rotate(-135deg) translateY(-1px);
}
.chat-web-page .chat-web-mobile-create {
    color: #55FF55;
    white-space: nowrap;
}
.chat-web-page .chat-web-sidebar-create-desktop {
    display: inline-flex;
}

.chat-web-page .chat-web-main {
    min-width: 0;
    overflow: hidden;
    gap: 0;
}

/* ── Sidebar sections ── */
.chat-web-page .chat-web-sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 0;
}
.chat-web-page .chat-web-sidebar-section + .chat-web-sidebar-section {
    margin-top: 0;
    padding-top: 0;
    border-top: 1px solid var(--chat-border);
}

.chat-web-page .chat-web-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 6px 8px;
    border-bottom: 1px solid #333;
    background: rgba(85, 255, 255, 0.06);
}
.chat-web-page .chat-web-sidebar-heading,
.chat-web-page .chat-web-title {
    margin: 0;
    font-size: 0.85rem;
    color: #FFFF55;
}

/* ── Sidebar inputs / buttons ── */
.chat-web-page .chat-web-sidebar-form,
.chat-web-page .chat-web-form {
    display: flex;
    gap: 0.4rem;
}
.chat-web-page .chat-web-sidebar-input,
.chat-web-page .chat-web-input {
    flex: 1 1 auto;
    border: 1px solid var(--chat-border);
    background: #000;
    color: #FFFFFF;
    border-radius: 0;
    padding: 0.5rem 0.6rem;
}
textarea.chat-web-input {
    resize: none;
    overflow: hidden;
    min-height: 2.6rem;
    max-height: 8rem;
    line-height: 1.4;
    font-family: inherit;
    font-size: inherit;
    overflow-y: auto;
    field-sizing: content;
}
#chat-text {
    border-color: #FFFF55;
}
#chat-text:focus {
    border-color: #FFFF55;
    outline: none;
    box-shadow: 0 0 0 1px rgba(255, 255, 85, 0.3);
}
.chat-web-page .chat-web-sidebar-button,
.chat-web-page .chat-web-send,
.chat-web-page .chat-web-status-button,
.chat-web-page .chat-web-users-close {
    border: 1px solid var(--chat-border);
    background: #000;
    color: #AAAAAA;
    border-radius: 0;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    font-size: 0.82rem;
}
#chat-room-open {
    color: #55FF55;
    text-decoration: underline;
    text-decoration-color: #FF55FF;
    text-underline-offset: 3px;
}
.chat-web-page .chat-web-sidebar-button:hover {
    border-color: #55FFFF;
    color: #55FFFF;
}
.chat-web-page .chat-web-send {
    background: #000;
    color: #FF55FF;
    border-color: #55FF55;
    font-weight: bold;
    min-width: 70px;
}
.chat-web-page .chat-web-send:hover {
    background: rgba(85, 255, 85, 0.1);
}

/* ── MOTD ticker ── */
.chat-web-page .chat-motd-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #000;
    padding: 4px 8px;
    border-bottom: 1px solid var(--chat-border);
    min-height: 0;
    overflow: hidden;
}
/* No MOTD/topic text: hide the ticker, keep the bar when it has actions. */
.chat-web-page .chat-motd-bar.is-empty .chat-motd-label,
.chat-web-page .chat-motd-bar.is-empty .chat-motd-window {
    display: none;
}
.chat-web-page .chat-motd-bar.is-empty:not(.has-actions) {
    display: none;
}
/* Join / Leave / Switch rooms, beside the room's MOTD or topic. */
.chat-web-page .chat-motd-actions {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
}
.chat-web-page .chat-motd-actions:empty {
    display: none;
}
.chat-web-page .chat-motd-action {
    background: transparent;
    color: #AAAAAA;
    border: 1px solid #555;
    border-radius: 0;
    padding: 2px 8px;
    font: inherit;
    font-size: 0.75rem;
    line-height: 1.2;
    cursor: pointer;
    white-space: nowrap;
}
.chat-web-page .chat-motd-action:hover {
    border-color: #55FFFF;
    color: #55FFFF;
}
.chat-web-page .chat-motd-action.is-primary {
    border-color: #55FFFF;
    color: #55FFFF;
    font-weight: bold;
}
.chat-web-page .chat-motd-action.is-leave:hover {
    border-color: #FF5555;
    color: #FF5555;
}
/* Parked in a room without being in any: the offer to join. */
.chat-web-page .chat-web-norooms {
    margin: 8px;
    padding: 8px 10px;
    border: 1px dashed #AA5500;
    color: #FFFF55;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}
.chat-web-page .chat-rich-image-card.is-nsfw .chat-rich-image-preview { filter: blur(16px) brightness(.55); }
.chat-web-page .chat-rich-image-card.is-nsfw.is-revealed .chat-rich-image-preview { filter: none; }
.chat-web-page .chat-rich-image-card.is-nsfw.is-revealed .chat-rich-nsfw-veil { display: none; }
.chat-web-page .chat-rich-nsfw-veil { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; background: rgba(0,0,0,.35); font-weight: bold; letter-spacing: .12em; text-shadow: 0 0 6px #000; cursor: pointer; }
.chat-web-page .chat-rich-nsfw-veil small { font-weight: normal; letter-spacing: 0; font-size: .75em; opacity: .85; }
.chat-web-page .chat-rich-image-frame { position: relative; display: block; }
.chat-web-page .chat-motd-label {
    font-size: 0.72rem;
    font-weight: bold;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #55FF55;
    flex-shrink: 0;
}
.chat-web-page .chat-motd-window {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
}
.chat-web-page .chat-motd-track {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    min-width: 100%;
    --motd-scroll-width: 0px;
    --motd-duration: 18s;
}
.chat-web-page .chat-motd-bar.is-scrolling .chat-motd-track {
    animation: chat-motd-scroll var(--motd-duration) linear infinite;
}
.chat-web-page .chat-motd-item {
    display: inline-block;
    white-space: nowrap;
    color: #55FF55;
    font-size: 0.82rem;
}
.chat-web-page .chat-motd-item-clone {
    display: none;
}
@keyframes chat-motd-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-1 * var(--motd-scroll-width))); }
}

/* ── Nav list (rooms / private threads) ── */
.chat-web-page .chat-web-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0;
}
.chat-web-page .chat-web-nav-empty,
.chat-web-page .chat-web-empty {
    color: var(--chat-muted);
    padding: 8px;
    font-size: 0.82rem;
}
.chat-web-page .chat-web-nav-item {
    border: none;
    border-bottom: 1px solid #222;
    background: transparent;
    color: var(--chat-fg);
    border-radius: 0;
    padding: 6px 8px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.chat-web-page .chat-web-nav-item:hover {
    background: rgba(85, 255, 255, 0.05);
}
.chat-web-page .chat-web-nav-item.is-active {
    border-left: 2px solid #55FFFF;
    background: rgba(85, 255, 255, 0.08);
}
.chat-web-page .chat-web-nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
}
.chat-web-page .chat-web-nav-title {
    font-weight: bold;
    min-width: 0;
    font-size: 0.85rem;
    color: #FFFFFF;
}
.chat-web-page .chat-web-nav-title.is-user,
.chat-web-page .chat-web-user-name {
    color: #55FFFF;
}
.chat-web-page .chat-web-nav-secondary,
.chat-web-page .chat-web-nav-preview {
    color: #555555;
    font-size: 0.78rem;
}
.chat-web-page .chat-web-channel,
.chat-web-page .chat-web-system-name {
    color: #FF55FF;
    font-size: 0.78rem;
}
.chat-web-page .chat-web-nav-preview {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.chat-web-page .chat-web-nav-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
    margin-top: 2px;
}
.chat-web-page .chat-web-nav-action,
.chat-web-page .chat-web-nav-state {
    border: 1px solid #555;
    border-radius: 0;
    padding: 2px 8px;
    font-size: 0.75rem;
    line-height: 1.2;
}
.chat-web-page .chat-web-nav-action {
    background: transparent;
    color: #AAAAAA;
    cursor: pointer;
}
.chat-web-page .chat-web-nav-action:hover {
    border-color: #55FFFF;
    color: #55FFFF;
}
.chat-web-page .chat-web-nav-action.is-primary {
    border-color: #55FFFF;
    color: #55FFFF;
    background: transparent;
    font-weight: bold;
}
.chat-web-page .chat-web-nav-state {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border-color: #00AAAA;
    color: #55FFFF;
    font-size: 0.72rem;
}

/* ── Badge ── */
.chat-web-page .chat-web-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.2rem;
    padding: 1px 5px;
    border-radius: 0;
    font-size: 0.7rem;
    font-weight: bold;
    background: transparent;
    color: #55FFFF;
    border: 1px solid #55FFFF;
}
.chat-web-page .chat-web-badge.is-unread {
    background: transparent;
    color: #FFFF55;
    border-color: #FFFF55;
}

/* ── Private thread row ── */
.chat-web-page .chat-web-thread-row {
    display: grid;
    grid-template-columns: 10px 36px minmax(0, 1fr);
    gap: 6px;
    align-items: center;
}
.chat-web-page .chat-web-presence-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
}
.chat-web-page .chat-web-presence-dot.is-online {
    background: #55FF55;
}
.chat-web-page .chat-web-presence-dot.is-offline {
    background: #AA0000;
}
.chat-web-page .chat-web-thread-avatar {
    width: 36px;
    min-width: 36px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #333;
    border-radius: 0;
    background: #000;
    overflow: hidden;
}
.chat-web-page .chat-web-thread-avatar img {
    max-width: 100%;
    max-height: 100%;
    image-rendering: pixelated;
}
/* A thread row is a div (it holds its own dismiss button), styled as the
   button rows around it. */
.chat-web-page .chat-web-nav-item.chat-web-thread {
    position: relative;
    cursor: pointer;
    padding-right: 24px;
    font: inherit;
}
.chat-web-page .chat-web-nav-item.chat-web-thread:focus-visible {
    outline: 1px solid #55FFFF;
    outline-offset: -1px;
}
.chat-web-page .chat-web-thread-dismiss {
    position: absolute;
    top: 3px;
    right: 4px;
    background: transparent;
    border: 0;
    color: #555555;
    font: inherit;
    font-size: 1rem;
    line-height: 1;
    padding: 2px 5px;
    cursor: pointer;
    opacity: 0;
}
.chat-web-page .chat-web-thread:hover .chat-web-thread-dismiss,
.chat-web-page .chat-web-thread:focus-within .chat-web-thread-dismiss {
    opacity: 1;
}
.chat-web-page .chat-web-thread-dismiss:hover {
    color: #FF5555;
}
@media (hover: none) {
    .chat-web-page .chat-web-thread-dismiss {
        opacity: 0.7;
    }
}
/* Which network a private thread runs over (MRC / DDial); local ones have none. */
.chat-web-page .chat-web-net-pill {
    flex: none;
    font-size: 0.66rem;
    line-height: 1.3;
    border: 1px solid #AA00AA;
    color: #FF55FF;
    padding: 0 4px;
    margin-left: 4px;
    letter-spacing: 0.02em;
}
.chat-web-page .chat-web-thread .chat-web-nav-top {
    justify-content: flex-start;
}
.chat-web-page .chat-web-thread .chat-web-badge.is-unread {
    margin-left: auto;
}

/* Room rows: divs (they carry their own leave / switch buttons). */
.chat-web-page .chat-web-nav-item.chat-web-room {
    cursor: pointer;
    font: inherit;
}
.chat-web-page .chat-web-nav-item.chat-web-room:focus-visible {
    outline: 1px solid #55FFFF;
    outline-offset: -1px;
}
.chat-web-page .chat-web-room .chat-web-nav-top {
    justify-content: flex-start;
}
.chat-web-page .chat-web-room .chat-web-badge.is-unread {
    margin-left: auto;
}
.chat-web-page .chat-web-room .chat-web-nav-icons {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 2px;
}
.chat-web-page .chat-web-room .chat-web-badge.is-unread + .chat-web-nav-icons {
    margin-left: 4px;
}
.chat-web-page .chat-web-nav-icon {
    background: transparent;
    border: 0;
    color: #555555;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1;
    padding: 0 4px;
    cursor: pointer;
}
.chat-web-page .chat-web-nav-icon:hover {
    color: #55FFFF;
}
.chat-web-page .chat-web-nav-icon.is-leave:hover {
    color: #FF5555;
}
.chat-web-page .chat-web-room .chat-web-presence-dot {
    flex: none;
    margin-right: 6px;
}

/* ── Modals ── */
.chat-web-page .chat-web-modal {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.8);
    padding: 1rem;
    z-index: 1050;
}
.chat-web-page .chat-web-modal.is-open {
    display: flex;
}
.chat-web-page .chat-web-modal-card {
    width: min(400px, 100%);
    border: 1px solid var(--chat-border);
    border-radius: 0;
    background: #000;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.chat-web-page .chat-web-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
}
.chat-web-page .chat-web-modal-title {
    margin: 0;
    color: #FFFF55;
}
.chat-web-page .chat-web-modal-text {
    color: var(--chat-muted);
    margin: 0;
    font-size: 0.85rem;
}
.chat-web-page .chat-web-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.4rem;
}

/* ── Topbar ── */
.chat-web-page .chat-web-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
}
.chat-web-page .chat-web-count {
    border: 1px solid var(--chat-border);
    background: transparent;
    color: #55FFFF;
    border-radius: 0;
    padding: 3px 8px;
    cursor: pointer;
    font-size: 0.82rem;
}

/* ── Status bar ── */
.chat-web-page .chat-web-status {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    border: none;
    border-bottom: 1px solid #333;
    border-radius: 0;
    padding: 6px 10px;
    background: rgba(85, 85, 85, 0.08);
    font-size: 0.82rem;
}
.chat-web-page .chat-web-status.is-visible {
    display: flex;
}
.chat-web-page .chat-web-status.is-warning {
    border-bottom-color: #AA5500;
    color: #FFFF55;
}
.chat-web-page .chat-web-status.is-error {
    border-bottom-color: #AA0000;
    color: #FF5555;
}

/* ── Users modal ── */
.chat-web-page .chat-web-users-modal-card {
    width: min(480px, 100%);
    max-height: min(72vh, 600px);
}
.chat-web-page .chat-web-users-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0;
    color: #FFFF55;
}
.chat-web-page .chat-web-users-list {
    display: grid;
    gap: 0;
    flex: 1 1 auto;
    min-height: 0;
    max-height: none;
    overflow-y: auto;
}
.chat-web-page .chat-web-user {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 8px;
    align-items: center;
    border: none;
    border-bottom: 1px solid #222;
    background: transparent;
    color: var(--chat-fg);
    border-radius: 0;
    padding: 6px 8px;
    text-align: left;
}
.chat-web-page .chat-web-user:hover {
    background: rgba(85, 255, 255, 0.05);
}
.chat-web-page .chat-web-user-avatar,
.chat-web-page .chat-web-avatar {
    width: 40px;
    min-width: 40px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #333;
    border-radius: 0;
    background: #000;
    overflow: hidden;
}
.chat-web-page .chat-web-user-avatar img,
.chat-web-page .chat-web-avatar img {
    max-width: 100%;
    max-height: 100%;
    image-rendering: pixelated;
}

/* ── Chat panel (messages area) ── */
.chat-web-page .chat-web-chatpanel {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    border: none;
    border-radius: 0;
    background: #000;
}
.chat-web-page .chat-web-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #555555;
    font-weight: bold;
    font-size: 1rem;
}
.chat-web-page .chat-web-actor,
.chat-web-page .chat-web-sender-button {
    border: 0;
    background: transparent;
    color: inherit;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font: inherit;
    text-align: inherit;
}
.chat-web-page .chat-web-sender-button {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
}

/* ── Messages container ── */
.chat-web-page .chat-web-messages {
    flex: 1 1 0;
    border: 0;
    background: transparent;
    border-radius: 0;
    padding: 8px 10px 6px;
    overflow-y: auto;
    overflow-anchor: none;
    min-height: 0;
    margin: 0;
}

/* ── System messages ── */
.chat-web-page .chat-web-system,
.chat-web-page .chat-system-msg {
    text-align: center;
    color: #555555;
    margin: 4px 0 8px;
    font-size: 0.78rem;
    font-style: italic;
}

/* ── Message groups ── */
.chat-web-page .chat-web-group,
.chat-web-page .chat-msg-group {
    display: flex;
    gap: 8px;
    margin-bottom: 8px;
    max-width: 88%;
}
.chat-web-page .chat-web-group.is-self,
.chat-web-page .chat-msg-group-self {
    margin-left: auto;
    flex-direction: row-reverse;
    align-self: flex-end;
}
.chat-web-page .chat-msg-group-other {
    align-self: flex-start;
}

/* ── Content column ── */
.chat-web-page .chat-web-content,
.chat-web-page .chat-msg-content {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

/* ── Header ── */
.chat-web-page .chat-web-header,
.chat-web-page .chat-header {
    font-size: 0.82rem;
    margin-bottom: 2px;
}
.chat-web-page .chat-web-group.is-self .chat-web-header,
.chat-web-page .chat-msg-group-self .chat-header {
    text-align: right;
}

/* ── Sender / timestamp ── */
.chat-web-page .chat-web-time,
.chat-web-page .chat-timestamp {
    color: #55FF55;
    font-size: 0.72rem;
}
.chat-web-page .chat-sender {
    font-size: 0.82rem;
    font-weight: 700;
    color: #FF55FF;
    padding: 0;
    margin: 0;
}
.chat-web-page .chat-sender-name {
    color: #55FFFF;
}

/* ── Avatars (message bubbles) ── */
.chat-web-page .chat-avatar {
    flex-shrink: 0;
    align-self: flex-start;
    width: 44px;
    border-radius: 0;
    overflow: hidden;
    background: #000;
    border: 1px solid #333;
}
.chat-web-page .chat-avatar img {
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    display: block;
}
.chat-web-page .chat-avatar-placeholder {
    color: #555;
    font-size: 14px;
    font-weight: bold;
    line-height: 58px;
    text-align: center;
    display: block;
    width: 100%;
}

/* ════════════════════════════════════════════════
   Chat Bubbles – CGA bordered style
   ════════════════════════════════════════════════ */
.chat-web-page .chat-web-bubble,
.chat-web-page .chat-bubble {
    display: block;
    padding: 6px 10px;
    border-radius: 0;
    margin-bottom: 3px;
    max-width: 100%;
    word-break: break-word;
    line-height: 1.45;
    font-weight: normal;
    background: transparent;
}

/* Other people's bubbles: cyan border, white text */
.chat-web-page .chat-web-group:not(.is-self) .chat-web-bubble,
.chat-web-page .chat-bubble-other {
    border: 1px solid #55FFFF;
    color: #FFFFFF;
    background: transparent;
}

/* Self bubbles: blue border, light gray text */
.chat-web-page .chat-web-group.is-self .chat-web-bubble,
.chat-web-page .chat-bubble-self {
    border: 1px solid #5555FF;
    color: #AAAAAA;
    background: transparent;
}
.chat-web-page .chat-bubble-self a {
    color: #55FFFF;
}
.chat-web-page .chat-bubble-other a {
    color: #FF55FF;
}

/* Room picker (join a local room / change MRC room) */
.chat-web-page .chat-picker-room-list {
    display: flex;
    flex-direction: column;
    max-height: 50vh;
    overflow-y: auto;
    border: 1px solid #222;
}
.chat-web-page .chat-picker-room {
    display: flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid #222;
    color: var(--chat-fg);
    padding: 6px 8px;
    font: inherit;
    text-align: left;
    cursor: pointer;
}
.chat-web-page .chat-picker-room:hover {
    background: rgba(85, 255, 255, 0.05);
}
.chat-web-page .chat-picker-room.is-current {
    border-left: 2px solid #55FFFF;
    background: rgba(85, 255, 255, 0.08);
}
.chat-web-page .chat-picker-room-name {
    color: #FFFFFF;
    font-weight: bold;
}
.chat-web-page .chat-picker-room-count {
    color: #55FFFF;
    font-size: 0.8rem;
}
.chat-web-page .chat-picker-room .chat-web-nav-state {
    margin-left: auto;
}

/* ── Logged-out view: the room's pulse, not its contents ── */
.chat-web-page .chat-web-locked-title {
    color: #FFFF55;
    font-weight: bold;
    margin-bottom: 4px;
}
.chat-web-page .chat-web-locked-facts {
    color: #AAAAAA;
}

/* ── Bitmap bubbles ── */
.chat-web-page .chat-bubble.chat-bitmap-bubble {
    padding: 4px;
    overflow: hidden;
}
.chat-web-page .chat-bitmap-shell {
    width: 100%;
}
.chat-web-page .chat-bitmap-frame {
    width: 100%;
    border: 1px solid #333;
    border-radius: 0;
    background: #000;
    overflow: hidden;
}
.chat-web-page .chat-bitmap-stage {
    width: 100%;
    background: #000;
    position: relative;
}
.chat-web-page .chat-bitmap-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 5rem;
    padding: 8px;
    color: #555555;
    font-size: 0.78rem;
    text-align: center;
}
.chat-web-page .chat-bitmap-stage.is-error .chat-bitmap-placeholder {
    color: #FF5555;
}
.chat-web-page .chat-bitmap-image {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    background: #000;
}
.chat-web-page .chat-bitmap-download {
    position: absolute;
    top: 4px;
    right: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 1px solid #333333;
    border-radius: 0;
    background: rgba(0, 0, 0, 0.7);
    color: #AAAAAA;
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 0.12s ease;
}
.chat-web-page .chat-bitmap-stage:hover .chat-bitmap-download,
.chat-web-page .chat-bitmap-download:focus-visible {
    opacity: 1;
}
.chat-web-page .chat-bitmap-download:hover {
    color: #FFFFFF;
    border-color: #555555;
}
.chat-web-page .chat-rich-block {
    display: grid;
    gap: 8px;
}
.chat-web-page .chat-rich-text {
    min-width: 0;
}
.chat-web-page .chat-rich-image-card,
.chat-web-page .chat-rich-audio-card {
    border: 1px solid #333333;
    background: #050505;
    padding: 8px;
    width: min(100%, 420px);
}
.chat-web-page .chat-rich-image-link {
    display: block;
    text-decoration: none;
}
.chat-web-page .chat-rich-image-frame {
    display: block;
    border: 1px solid #222222;
    background: #000000;
    overflow: hidden;
}
.chat-web-page .chat-rich-image-preview {
    display: block;
    width: 100%;
    height: auto;
    max-height: 22rem;
    object-fit: contain;
    background: #000000;
}
.chat-web-page .chat-rich-image-card.is-error .chat-rich-image-frame {
    display: none;
}
.chat-web-page .chat-rich-image-fallback {
    display: none;
    color: #AAAAAA;
    font-size: 0.78rem;
}
.chat-web-page .chat-rich-image-card.is-error .chat-rich-image-fallback {
    display: block;
}
.chat-web-page .chat-rich-image-caption,
.chat-web-page .chat-rich-audio-title {
    color: #FFFFFF;
    margin-top: 8px;
}
.chat-web-page .chat-rich-image-meta,
.chat-web-page .chat-rich-audio-meta,
.chat-web-page .chat-rich-audio-status {
    color: #AAAAAA;
    font-size: 0.76rem;
}
.chat-web-page .chat-rich-image-meta {
    margin-top: 4px;
}
.chat-web-page .chat-rich-audio-main {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
}
.chat-web-page .chat-rich-audio-icon {
    color: #55FFFF;
    font-size: 1.2rem;
    line-height: 1;
}
.chat-web-page .chat-rich-audio-copy {
    min-width: 0;
}
.chat-web-page .chat-rich-audio-title {
    margin-top: 0;
    color: #55FFFF;
}
.chat-web-page .chat-rich-audio-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 8px;
    flex-wrap: wrap;
}
.chat-web-page .chat-rich-audio-link {
    color: #FF55FF;
    font-size: 0.78rem;
}
.chat-web-page .chat-rich-audio-button {
    border: 1px solid #00AA00;
    background: transparent;
    color: #55FFFF;
    font-family: inherit;
    font-size: 0.78rem;
    line-height: 1.2;
    padding: 6px 10px;
    cursor: pointer;
}
.chat-web-page .chat-rich-audio-button:hover:not(:disabled) {
    background: #00AA00;
    color: #000000;
}
.chat-web-page .chat-rich-audio-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
.chat-web-page .chat-rich-audio-card.is-ready .chat-rich-audio-status {
    color: #55FF55;
}
.chat-web-page .chat-rich-audio-card.is-missing .chat-rich-audio-status {
    color: #FF5555;
}

/* ── Media poster cards (video/audio/YouTube/Vimeo — chat-embeds.js) ── */
.chat-web-page .chat-rich-media-card {
    border: 1px solid #333333;
    background: #050505;
    padding: 8px;
    width: min(100%, 420px);
}
.chat-web-page .chat-rich-media-poster {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 1px solid #222222;
    background: #000000;
    cursor: pointer;
    font: inherit;
    text-align: left;
    overflow: hidden;
}
.chat-web-page .chat-rich-media-thumb {
    display: block;
    width: 100%;
    height: auto;
    max-height: 15rem;
    object-fit: cover;
    opacity: 0.85;
}
.chat-web-page .chat-rich-media-overlay {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
}
.chat-web-page .chat-rich-media-thumb + .chat-rich-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.75), rgba(0,0,0,0.15));
}
.chat-web-page .chat-rich-media-play {
    color: #55FFFF;
    font-size: 1.4rem;
    line-height: 1;
}
.chat-web-page .chat-rich-media-poster:hover .chat-rich-media-play {
    color: #FFFFFF;
}
.chat-web-page .chat-rich-media-copy {
    min-width: 0;
    align-self: flex-end;
}
.chat-web-page .chat-rich-media-thumb + .chat-rich-media-overlay .chat-rich-media-copy {
    margin-top: auto;
}
.chat-web-page .chat-rich-media-brand {
    display: block;
    color: #AAAAAA;
    font-size: 0.72rem;
    text-transform: uppercase;
}
.chat-web-page .chat-rich-media-name {
    display: block;
    color: #FFFFFF;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.chat-web-page .chat-rich-media-card-audio .chat-rich-media-overlay {
    padding: 8px 10px;
}
.chat-web-page .chat-rich-media-actions {
    margin-top: 6px;
}
.chat-web-page .chat-rich-media-link {
    color: #FF55FF;
    font-size: 0.78rem;
}

/* ── Website link-preview cards (OpenGraph — chat-embeds.js) ── */
.chat-web-page .chat-rich-link-card {
    display: flex;
    gap: 10px;
    border: 1px solid #333333;
    border-left: 3px solid #00AA00;
    background: #050505;
    padding: 8px;
    width: min(100%, 420px);
    text-decoration: none;
}
.chat-web-page .chat-rich-link-card:hover {
    border-color: #555555;
    border-left-color: #55FF55;
}
.chat-web-page .chat-rich-link-media {
    flex: 0 0 96px;
}
.chat-web-page .chat-rich-link-media img {
    display: block;
    width: 96px;
    height: 72px;
    object-fit: cover;
    border: 1px solid #222222;
    background: #000000;
}
.chat-web-page .chat-rich-link-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.chat-web-page .chat-rich-link-site {
    color: #AAAAAA;
    font-size: 0.72rem;
    text-transform: uppercase;
}
.chat-web-page .chat-rich-link-title {
    color: #55FFFF;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}
.chat-web-page .chat-rich-link-desc {
    color: #AAAAAA;
    font-size: 0.78rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}
.chat-web-page .chat-rich-link-card.is-pending {
    opacity: 0.6;
}
.chat-web-page .chat-rich-block > * + * {
    margin-top: 6px;
}

/* ── Composer form ── */
.chat-web-page .chat-web-form {
    margin: 0;
    padding: 8px 10px;
    border-top: 1px solid var(--chat-border);
    background: transparent;
}
.chat-web-page .chat-web-login {
    color: var(--chat-muted);
    text-align: center;
    margin: 0;
    padding: 10px;
    border-top: 1px solid var(--chat-border);
    font-size: 0.85rem;
}
.chat-web-page .chat-web-login a {
    color: #55FFFF;
}

/* ── Responsive ── */
@media (max-width: 980px) {
    .chat-web-page {
        width: calc(100% + 1rem);
        max-width: 100vw;
        margin-left: -0.5rem;
        margin-right: -0.5rem;
    }
    .chat-web-page .chat-web-shell {
        border-left: none;
        border-right: none;
        border-radius: 0;
    }
    .chat-web-page .chat-web-layout {
        grid-template-columns: 1fr;
        grid-template-rows: minmax(0, auto) minmax(0, 1fr);
        gap: 0;
    }
    .chat-web-page .chat-web-sidebar {
        max-height: none;
        border-right: none;
        border-bottom: 1px solid var(--chat-border);
        overflow: visible;
    }
    .chat-web-page .chat-web-mobile-strip {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
        gap: 0;
        border-bottom: 1px solid var(--chat-border);
        background: rgba(85, 255, 255, 0.05);
    }
    .chat-web-page .chat-web-mobile-toggle,
    .chat-web-page .chat-web-mobile-create {
        border-top: none;
        border-bottom: none;
    }
    .chat-web-page .chat-web-mobile-toggle + .chat-web-mobile-toggle,
    .chat-web-page .chat-web-mobile-create {
        border-left: none;
    }
    .chat-web-page .chat-web-sidebar-create-desktop,
    .chat-web-page .chat-web-sidebar-section[data-panel] .chat-web-sidebar-header {
        display: none;
    }
    .chat-web-page .chat-web-sidebar-section[data-panel] {
        display: none;
        border-top: 1px solid var(--chat-border);
    }
    .chat-web-page .chat-web-sidebar-section[data-panel] + .chat-web-sidebar-section[data-panel] {
        margin-top: 0;
        padding-top: 0;
    }
    .chat-web-page .chat-web-sidebar[data-mobile-panel="rooms"] .chat-web-sidebar-section[data-panel="rooms"],
    .chat-web-page .chat-web-sidebar[data-mobile-panel="private"] .chat-web-sidebar-section[data-panel="private"] {
        display: flex;
    }
    .chat-web-page .chat-web-sidebar-section[data-panel] .chat-web-nav-list {
        max-height: min(26vh, 17rem);
        overflow-y: auto;
    }
}
@media (max-width: 768px) {
    .chat-web-page {
        width: calc(100% + 1.5rem);
        margin-left: -0.75rem;
        margin-right: -0.75rem;
        padding-top: 0;
        padding-bottom: 0;
    }
    .chat-web-page .chat-web-mobile-toggle,
    .chat-web-page .chat-web-mobile-create {
        padding: 0.5rem 0.55rem;
        font-size: 0.72rem;
        min-height: 2.3rem;
    }
    .chat-web-page .chat-web-shell {
        height: calc(100vh - 120px);
        height: calc(100dvh - 120px);
    }
    .chat-web-page .chat-msg-group,
    .chat-web-page .chat-web-group {
        max-width: 100%;
    }
    .chat-web-page .chat-web-messages {
        padding: 6px 8px;
    }
}

/* ── ANSI Editor in chat ── */
.chat-web-page .chat-ansi-toggle {
    border: 1px solid var(--chat-border);
    background: transparent;
    color: #AAAAAA;
    border-radius: 0;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    font-size: 0.82rem;
    white-space: nowrap;
}
.chat-web-page .chat-ansi-toggle[hidden] {
    display: none;
}
.chat-web-page .chat-ansi-toggle:hover {
    border-color: #FF55FF;
    color: #FF55FF;
}
.chat-web-page .chat-ansi-toggle.active {
    border-color: #FF55FF;
    color: #FF55FF;
    background: transparent;
    font-weight: bold;
}
.chat-web-page .chat-ansi-wrap {
    display: none;
    width: 100%;
    border: 1px solid #333;
    border-radius: 0;
    overflow: hidden;
    background: #000;
}
.chat-web-page .chat-ansi-wrap.active {
    display: block;
}
.chat-web-page .chat-ansi-wrap .me-editor {
    max-height: 520px;
}

/* ── Uploaded ANSI attachments (rendered by api/chat-ansi.ssjs) ── */
.chat-web-page .chat-rich-ansi-card {
    border: 1px solid #333333;
    border-left: 3px solid #FF55FF;
    background: #000000;
    width: min(100%, 720px);
}
.chat-web-page .chat-rich-ansi-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border-bottom: 1px solid #222222;
    font-size: 0.8rem;
}
.chat-web-page .chat-rich-ansi-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #FF55FF;
}
.chat-web-page .chat-rich-ansi-link {
    color: #AAAAAA;
    white-space: nowrap;
}
.chat-web-page .chat-rich-ansi-body {
    padding: 6px;
    color: #555555;
    font-size: 0.8rem;
    /* 80-column art is wider than the bubble on most screens; scroll it
       rather than reflowing, which would destroy the alignment. */
    overflow-x: auto;
}
.chat-web-page .chat-rich-ansi-body pre.ansi {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.02;
    white-space: pre;
}

/* ── Purged attachments (see the chat-media purge job) ── */
.chat-web-page .chat-rich-expired {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px dashed #333333;
    background: #050505;
    padding: 8px;
    width: min(100%, 420px);
    font-size: 0.82rem;
}
.chat-web-page .chat-rich-expired-icon {
    color: #555555;
}
.chat-web-page .chat-rich-expired-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
}
.chat-web-page .chat-rich-expired-title {
    color: #AAAAAA;
}
.chat-web-page .chat-rich-expired-note {
    color: #555555;
}

/* ── Drag-and-drop uploads (chat-upload.js) ── */
.chat-web-page .chat-upload-host:empty {
    display: none;
}
.chat-web-page .chat-upload-strip {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 6px;
}
.chat-web-page .chat-upload-chip {
    border: 1px solid #333333;
    border-left: 3px solid #55FFFF;
    background: #050505;
    padding: 6px 8px;
    font-size: 0.82rem;
}
.chat-web-page .chat-upload-chip[data-state="converting"] {
    border-left-color: #FFFF55;
}
.chat-web-page .chat-upload-chip[data-state="done"] {
    border-left-color: #55FF55;
}
.chat-web-page .chat-upload-chip[data-state="error"] {
    border-left-color: #FF5555;
}
.chat-web-page .chat-upload-chip-head {
    display: flex;
    align-items: center;
    gap: 8px;
}
.chat-web-page .chat-upload-chip-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #AAAAAA;
}
.chat-web-page .chat-upload-chip-size {
    color: #555555;
    white-space: nowrap;
}
.chat-web-page .chat-upload-chip-cancel {
    border: 1px solid #333333;
    background: transparent;
    color: #AAAAAA;
    cursor: pointer;
    font: inherit;
    line-height: 1;
    padding: 1px 7px;
}
.chat-web-page .chat-upload-chip-cancel:hover {
    color: #FFFFFF;
    border-color: #AAAAAA;
}
.chat-web-page .chat-upload-chip[data-state="done"] .chat-upload-chip-cancel,
.chat-web-page .chat-upload-chip[data-state="error"] .chat-upload-chip-cancel {
    visibility: hidden;
}
.chat-web-page .chat-upload-bar {
    height: 3px;
    background: #1a1a1a;
    margin: 5px 0;
}
.chat-web-page .chat-upload-bar-fill {
    height: 100%;
    width: 0;
    background: #55FFFF;
    transition: width 0.2s linear;
}
.chat-web-page .chat-upload-chip[data-state="converting"] .chat-upload-bar-fill {
    background: #FFFF55;
}
.chat-web-page .chat-upload-chip[data-state="done"] .chat-upload-bar-fill {
    background: #55FF55;
}
.chat-web-page .chat-upload-chip[data-state="error"] .chat-upload-bar-fill {
    background: #FF5555;
}
.chat-web-page .chat-upload-note {
    color: #777777;
    line-height: 1.35;
}
.chat-web-page .chat-upload-note em {
    font-style: italic;
}
/* The drop target is the transcript; the outline has to read over ANSI art. */
.chat-web-page .chat-messages.chat-upload-dragover {
    outline: 2px dashed #55FFFF;
    outline-offset: -4px;
    background: rgba(0, 170, 170, 0.06);
}

</style>

<div class="chat-web-page">
    <div class="chat-web-shell">
        <div class="chat-web-layout">
            <aside class="chat-web-sidebar" data-mobile-panel="">
                <div class="chat-web-mobile-strip" aria-label="Chat navigation">
                    <button id="chat-mobile-rooms-toggle" class="chat-web-mobile-toggle" type="button" aria-expanded="false" aria-controls="chat-rooms-panel">
                        <span>Rooms</span>
                        <span class="chat-web-mobile-chevron" aria-hidden="true"></span>
                    </button>
                    <button id="chat-mobile-private-toggle" class="chat-web-mobile-toggle" type="button" aria-expanded="false" aria-controls="chat-private-panel">
                        <span>Private Chats</span>
                        <span class="chat-web-mobile-chevron" aria-hidden="true"></span>
                    </button>
                </div>
                <div id="chat-rooms-panel" class="chat-web-sidebar-section" data-panel="rooms">
                    <div class="chat-web-sidebar-header">
                        <h4 class="chat-web-sidebar-heading">Rooms</h4>
                    </div>
                    <div id="chat-rooms" class="chat-web-nav-list"></div>
                </div>

                <div id="chat-private-panel" class="chat-web-sidebar-section" data-panel="private">
                    <div class="chat-web-sidebar-header">
                        <h4 class="chat-web-sidebar-heading">Private Chats</h4>
                    </div>
                    <div id="chat-private" class="chat-web-nav-list"></div>
                </div>
            </aside>

            <div class="chat-web-main">
                <div class="chat-web-chatpanel">
                    <div id="chat-status" class="chat-web-status" role="alert" aria-live="polite">
                        <div id="chat-status-text"></div>
                        <button id="chat-status-retry" class="chat-web-status-button" type="button">Retry now</button>
                    </div>

                    <div id="chat-motd" class="chat-motd-bar is-empty">
                        <span id="chat-motd-label" class="chat-motd-label">MOTD</span>
                        <div id="chat-motd-window" class="chat-motd-window">
                            <div id="chat-motd-track" class="chat-motd-track">
                                <span id="chat-motd-primary" class="chat-motd-item"></span>
                                <span id="chat-motd-clone" class="chat-motd-item chat-motd-item-clone" aria-hidden="true"></span>
                            </div>
                        </div>
                        <span id="chat-motd-actions" class="chat-motd-actions"></span>
                    </div>

                    <div id="chat-messages" class="chat-web-messages chat-messages">
                        <div class="chat-web-empty">Loading chat history...</div>
                    </div>

<?xjs if (user.number > 0) { ?>
                    <div id="chat-ansi-wrap" class="chat-ansi-wrap"></div>
                    <div id="chat-upload-host" class="chat-upload-host"></div>
                    <form id="chat-input" class="chat-input-area chat-web-form" autocomplete="off">
                        <textarea id="chat-text" class="chat-web-input" maxlength="2000" rows="1" placeholder="Type a message..."></textarea>
                        <button type="button" id="chat-ansi-toggle" class="chat-ansi-toggle">ANSI</button>
                        <button class="chat-web-send" type="submit">Send</button>
