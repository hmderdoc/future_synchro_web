<!--HIDDEN:Registration-->

<!--
Username/alias and password are always required. All other fields are set
as 'required' (or not) based on your New User Question Toggles as set in
the System Configuration section of scfg.  You can delete any fields of
this form that your system does not require.
-->

<?xjs
if (user.number > 0 && user.alias !== settings.guest) exit();

require('sbbsdefs.js', 'SYS_CLOSED');

if (system.settings&SYS_CLOSED) {
?>
<div class="alert alert-danger"><h3><?xjs write('Sorry, the system is closed to new users.'); ?></h3></div>
<?xjs
exit();
}

function required(mask) {
return ((system.new_user_questions&mask) ? (' ' + locale.strings.page_register.stat_suffix_field_required) : '');
}

function notRequired(mask) {
return ((system.new_user_questions&mask) ? '' : (' ' + locale.strings.page_register.stat_suffix_field_required));
}

function iconRequired(mask) {
if (required(mask).length > 0) {
?>
<span title="<?xjs write(locale.strings.page_register.label_field_required); ?>" class="text-danger fw-bold">*</span>
<?xjs
}
}

function iconNotRequired(mask) {
if (notRequired(mask).length > 0) {
?>
<span title="<?xjs write(locale.strings.page_register.label_field_required); ?>" class="text-danger fw-bold">*</span>
<?xjs
}
}
?>

<div class="card mb-3"><div class="card-body py-2"><h3 class="mb-0"><?xjs write(locale.strings.page_register.title); ?></h3></div></div>

<div id="errorbox" class="alert alert-danger" hidden></div>

<div id="form-register-container">

<div class="mb-3">
<span title="<?xjs write(locale.strings.page_register.label_field_required); ?>" class="text-danger fw-bold">*</span>
<?xjs write(locale.strings.page_register.help_text_required); ?>
</div>

<form id="form-register">

<?xjs if(system.newuser_password !== '') { ?>
<div class="mb-3">
<label for="newuser-password" class="form-label"><?xjs write(locale.strings.page_register.input_registration_password); ?></label>
<span title="<?xjs write(locale.strings.page_register.label_field_required); ?>" class="text-danger fw-bold">*</span>
<input type="password" class="form-control" id="newuser-password" name="newuser-password" placeholder="<?xjs write(locale.strings.page_register.input_registration_password); ?>" required>
</div>
<?xjs } ?>

<div class="mb-3">
<label for="alias" class="form-label"><?xjs write(locale.strings.page_register.input_alias); ?></label>
<span title="<?xjs write(locale.strings.page_register.label_field_required); ?>" class="text-danger fw-bold">*</span>
<input type="text" minlength="1" maxlength="<?xjs write(LEN_ALIAS); ?>" class="form-control" id="alias" name="alias" placeholder="<?xjs write(locale.strings.page_register.input_alias); ?>" required>
<div class="form-text">
<?xjs write(format(locale.strings.page_register.help_text_maximum_characters, LEN_ALIAS)); ?>
</div>
</div>

<div class="mb-3">
<label for="password1" class="form-label">
<?xjs write(locale.strings.page_register.input_password); ?>
</label>
<span title="<?xjs write(locale.strings.page_register.label_field_required); ?>" class="text-danger fw-bold">*</span>
<input type="password" minlength="<?xjs write(system.min_password_length) ?>" maxlength="<?xjs write(system.max_password_length) ?>" class="form-control" id="password1" name="password1" placeholder="<?xjs write(locale.strings.page_register.input_password); ?>" required>
<div class="form-text">
<?xjs write(format(locale.strings.page_register.help_text_minimum_characters, system.min_password_length)); ?>,
<?xjs write(format(locale.strings.page_register.help_text_maximum_characters, system.max_password_length)); ?>
</div>
</div>

<div class="mb-3">
<label for="password2" class="form-label">
<?xjs write(locale.strings.page_register.input_password_confirm); ?>
</label>
<span title="<?xjs write(locale.strings.page_register.label_field_required); ?>" class="text-danger fw-bold">*</span>
<input type="password" minlength="<?xjs write(system.min_password_length) ?>" maxlength="<?xjs write(system.max_password_length) ?>" class="form-control" id="password2" name="password2" placeholder="<?xjs write(locale.strings.page_register.input_password_confirm); ?>" required>
</div>

<div class="mb-3">
<label for="netmail" class="form-label"><?xjs write(locale.strings.page_register.input_email); ?></label>
<?xjs iconNotRequired(UQ_NONETMAIL); ?>
<input type="email" minlength="6" maxlength="<?xjs write(LEN_NETMAIL); ?>" class="form-control" id="netmail" name="netmail" placeholder="<?xjs write(locale.strings.page_register.placeholder_netmail); ?>"<?xjs write(notRequired(UQ_NONETMAIL)); ?>>
<div class="form-text">
<?xjs write(format(locale.strings.page_register.help_text_maximum_characters, LEN_NETMAIL)); ?>
</div>
</div>

<div class="mb-3">
<label for="realname" class="form-label"><?xjs write(locale.strings.page_register.input_name); ?></label>
<?xjs iconRequired(UQ_REALNAME); ?>
<input type="text" minlength="1" maxlength="<?xjs write(LEN_NAME); ?>" class="form-control" id="realname" name="realname" placeholder="<?xjs write(locale.strings.page_register.placeholder_name); ?>"<?xjs write(required(UQ_REALNAME)); ?>>
<div class="form-text">
<?xjs write(format(locale.strings.page_register.help_text_maximum_characters, LEN_NAME)); ?>
</div>
</div>

<div class="mb-3">
<label for="address" class="form-label">
<?xjs write(locale.strings.page_register.input_street_address); ?>
</label>
<?xjs iconRequired(UQ_ADDRESS); ?>
<input type="text" minlength="3" maxlength="<?xjs write(LEN_ADDRESS); ?>" class="form-control" id="address" name="address" placeholder="<?xjs write(locale.strings.page_register.placeholder_street_address); ?>"<?xjs write(required(UQ_ADDRESS)); ?>>
<div class="form-text">
<?xjs write(format(locale.strings.page_register.help_text_maximum_characters, LEN_ADDRESS)); ?>
</div>
</div>

<div class="mb-3">
<label for="zipcode" class="form-label"><?xjs write(locale.strings.page_register.input_zipcode); ?></label>
<?xjs iconRequired(UQ_ADDRESS); ?>
<input type="text" minlength="3" maxlength="<?xjs write(LEN_ADDRESS); ?>" class="form-control" id="zipcode" name="zipcode" placeholder="<?xjs write(locale.strings.page_register.placeholder_zipcode); ?>"<?xjs write(required(UQ_ADDRESS)); ?>>
<div class="form-text">
<?xjs write(format(locale.strings.page_register.help_text_maximum_characters, LEN_ADDRESS)); ?>
</div>
</div>

<div class="mb-3">
<label for="location" class="form-label"><?xjs write(locale.strings.page_register.input_location); ?></label>
<?xjs iconRequired(UQ_LOCATION); ?>
<input type="text" minlength="1" maxlength="<?xjs write(LEN_LOCATION); ?>" class="form-control" id="location" name="location" placeholder="<?xjs write(locale.strings.page_register.placeholder_location); ?>"<?xjs write(required(UQ_LOCATION)); ?>>
<div class="form-text">
<?xjs write(format(locale.strings.page_register.help_text_maximum_characters, LEN_LOCATION)); ?>
</div>
</div>

<div class="mb-3">
<label for="phone" class="form-label"><?xjs write(locale.strings.page_register.input_phone); ?></label>
<?xjs iconRequired(UQ_PHONE); ?>
<input type="text" minlength="3" maxlength="<?xjs write(LEN_PHONE); ?>" class="form-control" id="phone" name="phone" placeholder="<?xjs write(locale.strings.page_register.placeholder_phone); ?>"<?xjs write(required(UQ_PHONE)); ?>>
<div class="form-text">
<?xjs write(format(locale.strings.page_register.help_text_maximum_characters, LEN_PHONE)); ?>
</div>
</div>

<div class="mb-3">
<label for="birth" class="form-label"><?xjs write(locale.strings.page_register.input_birthdate); ?></label>
<?xjs iconRequired(UQ_BIRTH); ?>
<input type="text" minlength="<?xjs write(LEN_BIRTH); ?>" maxlength="<?xjs write(LEN_BIRTH); ?>" class="form-control" id="birth" name="birth" placeholder="<?xjs write(system.settings&SYS_EURODATE ? 'DD/MM/YY' : 'MM/DD/YY'); ?>" <?xjs write(required(UQ_BIRTH)); ?>>
<div class="form-text">
<?xjs write(format(locale.strings.page_register.help_text_maximum_characters, LEN_BIRTH)); ?>
</div>
</div>

<div class="mb-3">
<?xjs iconRequired(UQ_SEX); ?>
<label class="form-label"><?xjs write(locale.strings.page_register.input_gender); ?></label>
<div class="form-check">
<input class="form-check-input" type="radio" id="gender-withheld" name="gender" value="X" checked>
<label class="form-check-label" for="gender-withheld"><?xjs write(locale.strings.page_register.input_gender_withheld); ?></label>
</div>
<div class="form-check">
<input class="form-check-input" type="radio" id="gender-male" name="gender" value="M">
<label class="form-check-label" for="gender-male"><?xjs write(locale.strings.page_register.input_gender_male); ?></label>
</div>
<div class="form-check">
<input class="form-check-input" type="radio" id="gender-female" name="gender" value="F">
<label class="form-check-label" for="gender-female"><?xjs write(locale.strings.page_register.input_gender_female); ?></label>
</div>
<div class="form-check">
<input class="form-check-input" type="radio" id="gender-other" name="gender" value="O">
<label class="form-check-label" for="gender-other"><?xjs write(locale.strings.page_register.input_gender_other); ?></label>
</div>
</div>

<!-- Traps - leave these here. They will be hidden from users. -->
<input id="send-me-free-stuff" title="Don't fill this field" name="send-me-free-stuff" type="text">
<input id="subscribe-to-newsletter" title="Don't check this box" name="subscribe-to-newsletter" value="1" type="checkbox">

<div class="text-end mb-3">
<button class="btn btn-primary" type="submit">
<?xjs write(locale.strings.page_register.button_register); ?>
</button>
</div>

</form>

</div>

<script type="text/javascript">

(function () {
var form = document.getElementById('form-register');
var errorbox = document.getElementById('errorbox');
var container = document.getElementById('form-register-container');

if (!form) return;

// Hide honeypot traps
var trap1 = document.getElementById('send-me-free-stuff');
var trap2 = document.getElementById('subscribe-to-newsletter');
if (trap1) trap1.hidden = true;
if (trap2) trap2.hidden = true;

// Custom password-match validation
var pw1 = document.getElementById('password1');
var pw2 = document.getElementById('password2');
if (pw1 && pw2) {
function checkMatch() {
if (pw2.value && pw2.value !== pw1.value) {
pw2.setCustomValidity('Passwords do not match');
} else {
pw2.setCustomValidity('');
}
}
pw1.addEventListener('input', checkMatch);
pw2.addEventListener('input', checkMatch);
}

form.addEventListener('submit', function (evt) {
evt.preventDefault();

var formData = new URLSearchParams(new FormData(form));
fetch('./api/register.ssjs', {
method: 'POST',
headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
body: formData.toString()
})
.then(function (res) { return res.json(); })
.then(function (data) {
if (data.errors && data.errors.length > 0) {
errorbox.innerHTML = '';
data.errors.forEach(function (err) {
var p = document.createElement('p');
p.className = 'mb-1';
p.textContent = err;
errorbox.appendChild(p);
});
errorbox.hidden = false;
errorbox.scrollIntoView({ behavior: 'smooth' });
} else {
errorbox.hidden = true;
container.innerHTML = '<?xjs write(locale.strings.page_register.message_account_created); ?>';
}
})
.catch(function () {
errorbox.innerHTML = '<p>Registration failed. Please try again.</p>';
errorbox.hidden = false;
});
});
})();

</script>
