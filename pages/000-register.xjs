?>
<div class="alert alert-danger"><h3><?xjs write('Sorry, the system is closed to new users.'); ?></h3></div>
<?xjs
    exit();
}

function fieldRequired(mask) {
    return (system.new_user_questions & mask) ? true : false;
}

function emailRequired() {
    return !fieldRequired(UQ_NONETMAIL);
}

function writeRequiredStar(flag) {
    if (!flag) return;
?>
<span title="<?xjs write(locale.strings.page_register.label_field_required); ?>" class="text-danger fw-bold">*</span>
<?xjs
}

var showRegistrationPassword = (system.newuser_password !== '');
var showEmail = emailRequired();
var showRealname = fieldRequired(UQ_REALNAME);
var showAddress = fieldRequired(UQ_ADDRESS);
var showPhone = fieldRequired(UQ_PHONE);
var showBirth = fieldRequired(UQ_BIRTH);
var showGender = fieldRequired(UQ_SEX);
var locationRequired = fieldRequired(UQ_LOCATION);
?>

