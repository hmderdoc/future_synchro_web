<script type="text/javascript">
(function () {
var form = document.getElementById('form-register');
var errorbox = document.getElementById('errorbox');
var container = document.getElementById('form-register-container');

if (typeof initAvatarSettingsWidgets === 'function') initAvatarSettingsWidgets(document);
if (!form) return;

var pw1 = document.getElementById('password1');
var pw2 = document.getElementById('password2');
var avatarInput = form.querySelector('[data-avatar-settings-input]');
var avatarWidget = form.querySelector('[data-avatar-settings]');

function showErrors(errors) {
    errorbox.innerHTML = '';
    errors.forEach(function (err) {
        var p = document.createElement('p');
        p.className = 'mb-1';
        p.textContent = err;
        errorbox.appendChild(p);
    });
    errorbox.hidden = false;
    errorbox.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

if (pw1 && pw2) {
    function checkMatch() {
        if (pw2.value && pw2.value !== pw1.value) {
            pw2.setCustomValidity('Passwords do not match');
        } else {
            pw2.setCustomValidity('');
        }
    }
    pw1.addEventListener('input', checkMatch);
    pw2.addEventListener('input', checkMatch);
}

form.addEventListener('submit', function (evt) {
    evt.preventDefault();

    if (!avatarInput || !avatarInput.value) {
        showErrors(['<?xjs write(locale.strings.api_register.error_avatar_required); ?>']);
        if (avatarWidget) avatarWidget.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
    }

    var formData = new URLSearchParams(new FormData(form));
    fetch('./api/register.ssjs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: formData.toString()
    })
    .then(function (res) { return res.json(); })
    .then(async function (data) {
        if (data.errors && data.errors.length > 0) {
            showErrors(data.errors);
            return;
        }

        errorbox.hidden = true;
        if (typeof maybeStoreCredential === 'function') {
            await maybeStoreCredential(
                document.getElementById('alias') ? document.getElementById('alias').value.trim() : '',
                pw1 ? pw1.value : ''
            );
        }
        window.location.href = './?page=000-home.xjs';
    })
    .catch(function () {
        showErrors(['Registration failed. Please try again.']);
    });
});
})();
</script>
