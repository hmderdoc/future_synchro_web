<!--Chat-->
<style>
.chat-web-page {
    --chat-bg: #050505;
    --chat-panel: #111111;
    --chat-panel-alt: #171717;
    --chat-border: #2b2b2b;
    --chat-border-soft: rgba(255, 255, 255, 0.08);
    --chat-muted: #9e9e9e;
    --chat-fg: #efefef;
    --chat-accent: #34c6d3;
    --chat-self: #2d2ad8;
    --chat-other: #2a2a2a;
    --chat-system: #666666;
    color: var(--chat-fg);
    min-height: 0;
    padding: 0.9rem 0 0.45rem;
}
.chat-web-page .chat-web-shell {
    display: flex;
    flex-direction: column;
    gap: 0;
    height: calc(100vh - 148px);
    height: calc(100dvh - 148px);
    min-height: 0;
    overflow: hidden;
    padding: 1rem;
    border: 1px solid var(--chat-border-soft);
    border-radius: 1.35rem;
    background:
        radial-gradient(circle at top left, rgba(52, 198, 211, 0.12), transparent 32%),
        linear-gradient(180deg, rgba(15, 15, 18, 0.96), rgba(8, 8, 10, 0.97));
    box-shadow:
        0 22px 48px rgba(0, 0, 0, 0.38),
        inset 0 1px 0 rgba(255, 255, 255, 0.04);
}
.chat-web-page .chat-web-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 1.1rem;
    align-items: stretch;
    flex: 1 1 auto;
    min-height: 0;
}
.chat-web-page .chat-web-sidebar,
.chat-web-page .chat-web-main {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 0;
}
.chat-web-page .chat-web-sidebar {
    border: 1px solid var(--chat-border-soft);
    border-radius: 1.1rem;
    background: linear-gradient(180deg, rgba(18, 18, 20, 0.95), rgba(10, 10, 12, 0.96));
    padding: 1rem;
    overflow-y: auto;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
}
.chat-web-page .chat-web-main {
    min-width: 0;
    overflow: hidden;
    gap: 0;
}
.chat-web-page .chat-web-sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
}
.chat-web-page .chat-web-sidebar-section + .chat-web-sidebar-section {
    margin-top: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
}
.chat-web-page .chat-web-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
}
.chat-web-page .chat-web-sidebar-heading,
.chat-web-page .chat-web-title {
    margin: 0;
}
.chat-web-page .chat-web-sidebar-heading {
    color: #5555ff;
    letter-spacing: 0.04em;
}
.chat-web-page .chat-web-sidebar-form,
.chat-web-page .chat-web-form {
    display: flex;
    gap: 0.5rem;
}
.chat-web-page .chat-web-sidebar-input,
.chat-web-page .chat-web-input {
    flex: 1 1 auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #0b0b0c;
    color: var(--chat-fg);
    border-radius: 0.9rem;
    padding: 0.8rem 0.95rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
}
.chat-web-page .chat-web-sidebar-button,
.chat-web-page .chat-web-send,
.chat-web-page .chat-web-status-button,
.chat-web-page .chat-web-users-close {
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--chat-panel-alt);
    color: var(--chat-fg);
    border-radius: 0.85rem;
    padding: 0.65rem 0.9rem;
}
.chat-web-page .chat-web-send {
    background: var(--chat-accent);
    color: #041013;
    font-weight: bold;
    min-width: 88px;
}
.chat-web-page .chat-web-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
}
.chat-web-page .chat-web-nav-empty,
.chat-web-page .chat-web-empty {
    color: var(--chat-muted);
}
.chat-web-page .chat-web-nav-item {
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: linear-gradient(180deg, rgba(13, 13, 13, 0.96), rgba(10, 10, 10, 0.96));
    color: var(--chat-fg);
    border-radius: 0.95rem;
    padding: 0.8rem 0.9rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
}
.chat-web-page .chat-web-nav-item.is-active {
    border-color: var(--chat-accent);
    background: linear-gradient(180deg, rgba(10, 24, 28, 0.96), rgba(8, 18, 22, 0.96));
}
.chat-web-page .chat-web-nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
}
.chat-web-page .chat-web-nav-title {
    font-weight: bold;
    min-width: 0;
}
.chat-web-page .chat-web-nav-secondary,
.chat-web-page .chat-web-nav-preview,
.chat-web-page .chat-web-channel {
    color: var(--chat-muted);
    font-size: 0.9rem;
}
.chat-web-page .chat-web-nav-preview {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.chat-web-page .chat-web-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
}
.chat-web-page .chat-web-nav-action,
.chat-web-page .chat-web-nav-state {
    border: 1px solid var(--chat-border);
    border-radius: 999px;
    padding: 0.32rem 0.72rem;
    font-size: 0.82rem;
    line-height: 1.2;
}
.chat-web-page .chat-web-nav-action {
    background: var(--chat-panel-alt);
    color: var(--chat-fg);
    cursor: pointer;
}
.chat-web-page .chat-web-nav-action.is-primary {
    background: var(--chat-accent);
    border-color: transparent;
    color: #041013;
    font-weight: bold;
}
.chat-web-page .chat-web-nav-state {
    display: inline-flex;
    align-items: center;
    background: #0f1d21;
    border-color: rgba(52, 198, 211, 0.35);
    color: var(--chat-accent);
}
.chat-web-page .chat-web-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: bold;
    background: var(--chat-accent);
    color: #041013;
}
.chat-web-page .chat-web-badge.is-unread {
    background: #f1c12b;
    color: #271d00;
}
.chat-web-page .chat-web-thread-row {
    display: grid;
    grid-template-columns: 12px 48px minmax(0, 1fr);
    gap: 0.65rem;
    align-items: center;
}
.chat-web-page .chat-web-presence-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    border: 2px solid #0a0a0a;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
}
.chat-web-page .chat-web-presence-dot.is-online {
    background: #32d46b;
}
.chat-web-page .chat-web-presence-dot.is-offline {
    background: #d45151;
}
.chat-web-page .chat-web-thread-avatar {
    width: 48px;
    min-width: 48px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--chat-border);
    border-radius: 0.5rem;
    background: #0a0a0a;
    overflow: hidden;
}
.chat-web-page .chat-web-thread-avatar img {
    max-width: 100%;
    max-height: 100%;
    image-rendering: pixelated;
}
.chat-web-page .chat-web-modal {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.72);
    padding: 1rem;
    z-index: 1050;
}
.chat-web-page .chat-web-modal.is-open {
    display: flex;
}
.chat-web-page .chat-web-modal-card {
    width: min(440px, 100%);
    border: 1px solid var(--chat-border);
    border-radius: 1rem;
    background: var(--chat-panel);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
}
.chat-web-page .chat-web-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
}
.chat-web-page .chat-web-modal-title {
    margin: 0;
    color: #5555ff;
}
.chat-web-page .chat-web-modal-text {
    color: var(--chat-muted);
    margin: 0;
}
.chat-web-page .chat-web-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
}
.chat-web-page .chat-web-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
}
.chat-web-page .chat-web-count {
    border: 1px solid var(--chat-border);
    background: var(--chat-panel);
    color: var(--chat-fg);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
}
.chat-web-page .chat-web-status {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.9rem;
    padding: 0.75rem 0.9rem;
    background: #101010;
    margin: 0.85rem 0.85rem 0;
}
.chat-web-page .chat-web-status.is-visible {
    display: flex;
}
.chat-web-page .chat-web-status.is-warning {
    border-color: #8f6d1f;
    background: #171207;
}
.chat-web-page .chat-web-status.is-error {
    border-color: #9c3b3b;
    background: #190909;
}
.chat-web-page .chat-web-users-modal-card {
    width: min(560px, 100%);
    max-height: min(72vh, 640px);
}
.chat-web-page .chat-web-users-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0;
}
.chat-web-page .chat-web-users-list {
    display: grid;
    gap: 0.5rem;
    flex: 1 1 auto;
    min-height: 0;
    max-height: none;
    overflow-y: auto;
    padding-right: 0.15rem;
}
.chat-web-page .chat-web-user {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 0.6rem;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: linear-gradient(180deg, rgba(14, 14, 16, 0.96), rgba(10, 10, 12, 0.96));
    color: var(--chat-fg);
    border-radius: 0.75rem;
    padding: 0.65rem;
    text-align: left;
}
.chat-web-page .chat-web-user-avatar,
.chat-web-page .chat-web-avatar {
    width: 50px;
    min-width: 50px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--chat-border);
    border-radius: 0.5rem;
    background: #0a0a0a;
    overflow: hidden;
}
.chat-web-page .chat-web-user-avatar img,
.chat-web-page .chat-web-avatar img {
    max-width: 100%;
    max-height: 100%;
    image-rendering: pixelated;
}
.chat-web-page .chat-web-chatpanel {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--chat-border-soft);
    border-radius: 1.15rem;
    background:
        linear-gradient(180deg, rgba(6, 6, 7, 0.98), rgba(10, 10, 11, 0.99));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
}
.chat-web-page .chat-web-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--chat-muted);
    font-weight: bold;
    font-size: 1.2rem;
}
.chat-web-page .chat-web-actor,
.chat-web-page .chat-web-sender-button {
    border: 0;
    background: transparent;
    color: inherit;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font: inherit;
    text-align: inherit;
}
.chat-web-page .chat-web-sender-button {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
}
.chat-web-page .chat-web-messages {
    flex: 1 1 0;
    border: 0;
    background: transparent;
    border-radius: 0;
    padding: 1rem 1rem 0.85rem;
    overflow-y: auto;
    min-height: 0;
    margin: 0;
}
.chat-web-page .chat-web-system {
    text-align: center;
    color: var(--chat-system);
    margin: 0.5rem 0 1rem;
}
.chat-web-page .chat-web-group {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
    max-width: 92%;
}
.chat-web-page .chat-web-group.is-self {
    margin-left: auto;
    flex-direction: row-reverse;
}
.chat-web-page .chat-web-content {
    min-width: 0;
}
.chat-web-page .chat-web-header {
    font-size: 0.95rem;
    margin-bottom: 0.3rem;
}
.chat-web-page .chat-web-group.is-self .chat-web-header {
    text-align: right;
}
.chat-web-page .chat-web-system-name,
.chat-web-page .chat-web-time {
    color: var(--chat-muted);
}
.chat-web-page .chat-web-time {
    font-size: 0.85rem;
}
.chat-web-page .chat-web-bubble {
    display: block;
    padding: 0.7rem 0.9rem;
    border-radius: 0.9rem;
    margin-bottom: 0.35rem;
    max-width: 100%;
    word-break: break-word;
    line-height: 1.5;
}
.chat-web-page .chat-web-group.is-self .chat-web-bubble {
    background: var(--chat-self);
    color: #ffffff;
}
.chat-web-page .chat-web-group:not(.is-self) .chat-web-bubble {
    background: var(--chat-other);
    color: var(--chat-fg);
}
.chat-web-page .chat-bubble.chat-bitmap-bubble {
    padding: 0.45rem;
    overflow: hidden;
}
.chat-web-page .chat-bitmap-shell {
    width: 100%;
}
.chat-web-page .chat-bitmap-frame {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.65rem;
    background: #000000;
    overflow: hidden;
}
.chat-web-page .chat-bitmap-stage {
    width: 100%;
    background: #000000;
    position: relative;
}
.chat-web-page .chat-bitmap-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 7rem;
    padding: 0.9rem;
    color: var(--chat-muted);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
}
.chat-web-page .chat-bitmap-stage.is-error .chat-bitmap-placeholder {
    color: #ff8f8f;
}
.chat-web-page .chat-bitmap-image {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    background: #000000;
}
.chat-web-page .chat-web-form {
    margin: 0;
    padding: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0));
}
.chat-web-page .chat-web-login {
    color: var(--chat-muted);
    text-align: center;
    margin: 0;
    padding: 1rem 1rem 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0));
}
.chat-web-page .chat-web-login a {
    color: var(--chat-accent);
}
@media (max-width: 980px) {
    .chat-web-page .chat-web-layout {
        grid-template-columns: 1fr;
        grid-template-rows: minmax(0, auto) minmax(0, 1fr);
        gap: 0.9rem;
    }
    .chat-web-page .chat-web-sidebar {
        max-height: 34vh;
    }
}
@media (max-width: 768px) {
    .chat-web-page {
        padding-top: 0.7rem;
    }
    .chat-web-page .chat-web-shell {
        height: calc(100vh - 128px);
        height: calc(100dvh - 128px);
        padding: 0.8rem;
    }
    .chat-web-page .chat-web-group {
        max-width: 100%;
    }
    .chat-web-page .chat-web-messages {
        min-height: 0;
        padding: 0.85rem 0.85rem 0.7rem;
    }
    .chat-web-page .chat-web-form {
        padding: 0.75rem;
    }
}
</style>

<div class="chat-web-page">
    <div class="chat-web-shell">
        <div class="chat-web-layout">
            <aside class="chat-web-sidebar">
                <div class="chat-web-sidebar-section">
                    <div class="chat-web-sidebar-header">
                        <h4 class="chat-web-sidebar-heading">Public Rooms</h4>
                    </div>
<?xjs if (user.number > 0) { ?>
                    <button id="chat-room-open" class="chat-web-sidebar-button" type="button">Create Room</button>
<?xjs } ?>
                    <div id="chat-rooms" class="chat-web-nav-list"></div>
                </div>

                <div class="chat-web-sidebar-section">
                    <div class="chat-web-sidebar-header">
                        <h4 class="chat-web-sidebar-heading">Private Chats</h4>
                    </div>
                    <div id="chat-private" class="chat-web-nav-list"></div>
                </div>
            </aside>

            <div class="chat-web-main">
                <div class="chat-web-chatpanel">
                    <div id="chat-status" class="chat-web-status" role="alert" aria-live="polite">
                        <div id="chat-status-text"></div>
                        <button id="chat-status-retry" class="chat-web-status-button" type="button">Retry now</button>
                    </div>

                    <div id="chat-messages" class="chat-web-messages chat-messages">
                        <div class="chat-web-empty">Loading chat history...</div>
                    </div>

<?xjs if (user.number > 0) { ?>
                    <form id="chat-input" class="chat-input-area chat-web-form" autocomplete="off">
                        <input type="text" id="chat-text" class="chat-web-input" maxlength="500" placeholder="Type a message...">
                        <button class="chat-web-send" type="submit">Send</button>
                    </form>
<?xjs } else { ?>
                    <div class="chat-web-login">
                        You are viewing a snapshot of recent chat. <a href="/?page=000-login.xjs">Log in</a> for live updates, messaging, and private chats.
                    </div>
<?xjs } ?>
                </div>
            </div>
        </div>
    </div>

    <div id="chat-users-modal" class="chat-web-modal" aria-hidden="true">
        <div id="chat-users-panel" class="chat-web-modal-card chat-web-users-modal-card" role="dialog" aria-modal="true" aria-labelledby="chat-users-title">
            <div class="chat-web-users-header">
                <strong id="chat-users-title">Users in #main</strong>
                <button id="chat-users-close" class="chat-web-users-close" type="button">&times;</button>
            </div>
            <div id="chat-users-list" class="chat-web-users-list"></div>
        </div>
    </div>

<?xjs if (user.number > 0) { ?>
    <div id="chat-room-modal" class="chat-web-modal" aria-hidden="true">
        <div class="chat-web-modal-card">
            <div class="chat-web-modal-header">
                <h4 class="chat-web-modal-title">Create Room</h4>
                <button id="chat-room-close" class="chat-web-users-close" type="button">&times;</button>
            </div>
            <p class="chat-web-modal-text">Pick a short public room name using letters, numbers, `_` or `-`.</p>
            <form id="chat-room-form" class="chat-web-sidebar-form" autocomplete="off">
                <input id="chat-room-input" class="chat-web-sidebar-input" type="text" maxlength="32" placeholder="new-room">
                <button class="chat-web-sidebar-button" type="submit">Create</button>
            </form>
            <div class="chat-web-modal-actions">
                <button id="chat-room-cancel" class="chat-web-sidebar-button" type="button">Cancel</button>
