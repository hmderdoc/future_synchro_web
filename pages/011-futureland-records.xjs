<!--Vektrax Records-->
<?xjs
    function _recordsQueryValue(name) {
        return (
            typeof http_request.query[name] !== 'undefined' &&
            http_request.query[name].length
        ) ? String(http_request.query[name][0]) : '';
    }

    var _records_track = _recordsQueryValue('track');
    var _records_track_json = JSON.stringify(_records_track).replace(/<\//g, '<\\/');

    /* Fetch AI co-writer names + avatar data from local-aidefinitions */
    require('sbbsdefs.js', 'MSG_DELETE');
    var _cowriters = [];
    try {
        var _cw_sub = 'local-aidefinitions';
        if (msg_area.sub[_cw_sub]) {
            var _cw_mb = new MsgBase(_cw_sub);
            if (_cw_mb.open()) {
                var _cw_hdrs = _cw_mb.get_all_msg_headers(true);
                if (_cw_hdrs) {
                    var _cw_origins = {};
                    var _cw_order = [];
                    for (var _ch in _cw_hdrs) {
                        if (_cw_hdrs[_ch] === null) continue;
                        if (_cw_hdrs[_ch].attr & MSG_DELETE) continue;
                        var _cw_tid = _cw_hdrs[_ch].thread_id;
                        if (!_cw_origins[_cw_tid]) {
                            _cw_origins[_cw_tid] = _cw_hdrs[_ch];
                            _cw_order.push(_cw_tid);
                        }
                    }
                    for (var _ci = 0; _ci < _cw_order.length; _ci++) {
                        var _cw_hdr = _cw_origins[_cw_order[_ci]];
                        var _cw_name = _cw_hdr.subject.replace(/^re:\s*/ig, '').trim();
                        if (!_cw_name) continue;
                        var _cw_avatar = '';
                        try {
                            var _cw_body = _cw_mb.get_msg_body(_cw_hdr.number) || '';
                            var _m1 = _cw_body.indexOf('avatar_data_begin');
                            var _m2 = _cw_body.indexOf('avatar_data_end');
                            if (_m1 >= 0 && _m2 > _m1) {
                                _cw_avatar = _cw_body.substring(_m1 + 17, _m2).replace(/[\r\n\s]/g, '');
                            }
                        } catch (_ce) {}
                        _cowriters.push({ name: _cw_name, avatar: _cw_avatar });
                    }
                }
                _cw_mb.close();
            }
        }
    } catch (_cw_err) {
        log(LOG_WARNING, 'Vektrax cowriter fetch error: ' + _cw_err);
    }
    var _cowriters_json = JSON.stringify(_cowriters).replace(/<\//g, '<\\/');
?>

<style>
.flrd-shell {
    max-width: min(1720px, 96vw);
    margin: 0 auto;
    display: grid;
    gap: 18px;
}
.flrd-panel {
    --bs-card-border-color: #55FF55;
    --bs-card-bg: #000;
    --bs-card-cap-bg: #000;
    --bs-card-cap-color: #55FF55;
    border-color: #55FF55 !important;
    background: #000 !important;
    container-type: inline-size;
    border-radius: 18px;
    overflow: hidden;
}
.flrd-panel > .card-header {
    color: #55FF55 !important;
    background: #000 !important;
    border-bottom: 2px solid #55FF55 !important;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}
.flrd-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: bold;
    white-space: nowrap;
    color: #55FF55;
}
.flrd-brand-head {
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    display: block;
    object-fit: contain;
    background: transparent;
    image-rendering: auto;
    filter: drop-shadow(0 0 10px rgba(85, 255, 85, 0.6));
}
.flrd-brand-label {
    display: inline-block;
    color: #55FF55;
    border-bottom: 2px solid #55FF55;
    padding-bottom: 2px;
    line-height: 1;
}
.flrd-nav {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
}
.flrd-nav button {
    background: transparent;
    border: 1px solid #55FF55;
    color: #55FF55;
    font-family: monospace;
    font-size: 14px;
    line-height: 1;
    padding: 4px 10px;
    cursor: pointer;
    border-radius: 2px;
}
.flrd-nav button:hover:not(:disabled) {
    background: rgba(85, 255, 85, 0.12);
    border-color: #55FF55;
    color: #55FF55;
}
.flrd-nav button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
}
.flrd-track-select-header {
    background: #050505;
    color: #FFFFFF;
    border: 1px solid #55FF55;
    padding: 4px 8px;
    border-radius: 2px;
    font-family: inherit;
    font-size: 0.82rem;
    max-width: 260px;
    min-width: 0;
}
.flrd-counter {
    color: #AAAAAA;
    font-size: 0.78em;
    font-weight: normal;
}
.flrd-body {
    padding: clamp(18px, 2.4vw, 30px);
}
.flrd-loading,
.flrd-empty {
    color: #AAAAAA;
    padding: 36px 16px;
    text-align: center;
}
.flrd-empty {
    color: #AA5500;
}
.flrd-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
        "art"
        "meta";
    gap: clamp(18px, 2.8vw, 28px);
    align-items: center;
    justify-items: center;
}
.flrd-layout.is-hidden {
    display: none;
}
.flrd-art-wrap {
    grid-area: art;
    width: min(100%, 640px);
    aspect-ratio: 1 / 1;
    background: #111;
    border: 1px solid #333;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    transition: box-shadow 0.3s;
    padding: 0;
}
.flrd-art-wrap:hover {
    box-shadow: 0 0 22px rgba(255, 85, 255, 0.4);
}
.flrd-art-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.flrd-no-art {
    color: #555;
    font-size: clamp(3rem, 9vw, 5.5rem);
}
.flrd-play-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.74);
    color: #55FF55;
    font-size: 1.55em;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s;
}
.flrd-art-wrap:hover .flrd-play-badge {
    opacity: 1;
}
.flrd-meta {
    grid-area: meta;
    min-width: 0;
    width: min(100%, 720px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
    justify-content: center;
}
.flrd-title {
    color: #55FFFF;
    font-weight: bold;
    font-size: clamp(1.32rem, 3.1cqi, 2.65rem);
    line-height: 1.08;
}
.flrd-credits {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.36em;
    font-size: clamp(1rem, 1.95cqi, 1.34rem);
    line-height: 1.25;
}
.flrd-artist-name,
.flrd-composer-name {
    color: #55FF55;
}
.flrd-credit-sep {
    color: #AAAAAA;
}
.flrd-performers {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: flex-end;
    margin: 6px 0 2px;
}
.flrd-performer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
}
.flrd-performer-avatar {
    width: 80px;
    height: 48px;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    background: #111;
    border: 1px solid #333;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}
.flrd-performer-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    object-fit: contain;
}
.flrd-performer-avatar:empty::after {
    content: '?';
    color: #555;
    font-size: 1.2rem;
}
.flrd-performer-name {
    font-size: 0.72rem;
    color: #55FF55;
    text-align: center;
    max-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.flrd-performer-name.is-persona {
    color: #FF55FF;
}
.flrd-album-year {
    color: #FF5555;
}
.flrd-genre-line {
    color: #AAAAAA;
    font-size: clamp(0.92rem, 1.34cqi, 1.05rem);
}
.flrd-genre {
    color: #FFFF55;
}


.flrd-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
}
.flrd-play-button {
    background: transparent;
    border: 1px solid #00AA00;
    color: #55FF55;
    font-family: monospace;
    font-size: 0.92rem;
    padding: 8px 16px;
    cursor: pointer;
    border-radius: 2px;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
}
.flrd-play-button:hover:not(:disabled) {
    background: #00AA00;
    color: #000;
}
.flrd-play-button:disabled {
    cursor: default;
}
.flrd-play-button.is-playing {
    border-color: #FF55FF;
    color: #FF55FF;
}
.flrd-play-button.is-playing:hover {
    background: transparent;
    color: #FF55FF;
}
.flrd-play-icon {
    color: #55FFFF;
}
.flrd-bios-card {
    margin: 0 auto;
    width: min(100%, 920px);
    border: 1px solid #55FF55 !important;
    border-radius: 18px;
    background: #020802;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(85, 255, 85, 0.08) inset;
}
.flrd-bios-card > .card-header {
    color: #55FF55 !important;
    background: #000 !important;
    border-bottom: 2px solid #55FF55 !important;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
}
.flrd-bios-card > .card-body {
    padding: 0;
    background: #020802;
}
.flrd-bios-title {
    color: #55FF55;
    font-family: monospace;
    font-size: 0.94rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}
.flrd-bios-card img {
    display: block;
    width: 100%;
    height: auto;
}
.flrc-card-toggle {
    background: transparent;
    border: 0;
    color: #55FF55;
    font-family: monospace;
    font-size: 0.94rem;
    line-height: 1;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: color 0.15s, opacity 0.15s;
}
.flrc-card-toggle:hover {
    color: #55FF55;
    opacity: 0.82;
}
.flrc-card-toggle:focus,
.flrc-card-toggle:focus-visible {
    outline: none;
    box-shadow: none;
}
.flrc-card-toggle-icon {
    display: inline-block;
    font-size: 0.9em;
    transition: transform 0.18s ease;
}
.is-collapsed .flrc-card-toggle-icon {
    transform: rotate(-90deg);
}
.is-collapsed > .card-header {
    border-bottom-width: 1px !important;
}
.flrsb-panel {
    --bs-card-border-color: #00AA00;
    --bs-card-bg: #000;
    --bs-card-cap-bg: #000;
    --bs-card-cap-color: #55FF55;
    border-color: #00AA00 !important;
    background: #000 !important;
    container-type: inline-size;
    border-radius: 18px;
    overflow: hidden;
}
.flrsb-panel > .card-header {
    color: #55FF55 !important;
    background: #000 !important;
    border-bottom: 2px solid #00AA00 !important;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
    flex-wrap: wrap;
}
.flrsb-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 0;
    padding: 0;
    color: #55FF55;
    font: inherit;
    cursor: pointer;
}
.flrsb-brand-kicker {
    color: #55FF55;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
.flrsb-brand:hover {
    opacity: 0.82;
}
.flrsb-brand:focus,
.flrsb-brand:focus-visible {
    outline: none;
    box-shadow: none;
}
/* .flrsb-head-copy removed */
.flrsb-head-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}
.flrsb-panel.is-collapsed .flrsb-head-reset,
.flrsb-panel.is-collapsed .flrsb-head-submit {
    display: none;
}
.flrsb-panel.is-collapsed .flrsb-head-actions {
    display: none;
}
/* .flrsb-head-status removed */
/* Header submit & reset buttons */
.flrsb-head-submit {
    padding: 6px 14px;
    font-size: 0.82rem;
}
.flrsb-head-reset {
    padding: 6px 10px;
    font-size: 0.72rem;
}
.flrsb-body {
    padding: clamp(18px, 2.3vw, 30px);
}
.flrsb-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(18px, 2.5vw, 28px);
}
.flrsb-form-grid {
    display: grid;
    gap: 18px;
}
.flrsb-group {
    border: 1px solid #333333;
    background: #040404;
    padding: clamp(14px, 1.8vw, 20px);
    display: grid;
    gap: 14px;
}
.flrsb-group-head {
    display: grid;
    gap: 4px;
}
.flrsb-group-head-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
}
.flrsb-group-title {
    margin: 0;
    color: #55FFFF;
    font-size: 1rem;
}
.flrsb-group-copy {
    color: #AAAAAA;
    font-size: 0.78rem;
    line-height: 1.45;
}
.flrsb-field-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
}
.flrsb-field {
    display: grid;
    gap: 6px;
    min-width: 0;
}
.flrsb-field > span {
    color: #AAAAAA;
    font-size: 0.72rem;
    text-transform: uppercase;
}
.flrsb-field input,
.flrsb-field select,
.flrsb-field textarea,
.flrsb-preview {
    width: 100%;
    background: #050505;
    color: #FFFFFF;
    border: 1px solid #00AA00;
    border-radius: 2px;
    padding: 9px 10px;
    font-family: inherit;
    line-height: 1.35;
}
.flrsb-field textarea {
    min-height: 124px;
    resize: vertical;
}
.flrsb-field input::placeholder,
.flrsb-field textarea::placeholder {
    color: #777777;
}
.flrsb-help {
    color: #888888;
    font-size: 0.72rem;
}
.flrsb-preset-stack {
    display: grid;
    gap: 6px;
}
.flrsb-preset-stack input[hidden] {
    display: none !important;
}
.flrsb-mode-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}
.flrsb-mode-button,
.flrsb-copy-button,
.flrsb-utility-button {
    background: transparent;
    border: 1px solid #55FFFF;
    color: #55FFFF;
    font-family: monospace;
    font-size: 0.88rem;
    padding: 7px 12px;
    cursor: pointer;
    border-radius: 2px;
}
.flrsb-mode-button:hover,
.flrsb-copy-button:hover,
.flrsb-utility-button:hover {
    background: rgba(85, 255, 255, 0.12);
}
.flrsb-utility-button {
    font-size: 0.76rem;
    padding: 5px 8px;
    line-height: 1;
    white-space: nowrap;
}
.flrsb-mode-button.is-active {
    border-color: #00AA00;
    color: #55FF55;
    background: rgba(0, 170, 0, 0.14);
}
.flrsb-mode-panel[hidden] {
    display: none !important;
}
.flrsb-section-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
}
.flrsb-section-card {
    border: 1px solid #222222;
    background: #000000;
    padding: 12px;
    display: grid;
    gap: 8px;
}
.flrsb-section-label {
    color: #FFFF55;
    font-size: 0.8rem;
}
.flrsb-preview-group {
    height: 100%;
}
.flrsb-preview-col[hidden] {
    display: none !important;
}
.flrsb-preview-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
}
.flrsb-preview {
    min-height: 180px;
    max-height: 400px;
    resize: vertical;
    white-space: pre-wrap;
}
.flrsb-copy-status {
    color: #AAAAAA;
    font-size: 0.76rem;
    min-height: 1.2em;
}
@container (min-width: 760px) {
    .flrsb-field-grid.is-two {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .flrsb-section-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .flrsb-field.is-span-2,
    .flrsb-section-card.is-span-2 {
        grid-column: 1 / -1;
    }
}
@container (min-width: 1220px) {
    .flrsb-layout.is-preview-open {
        grid-template-columns: minmax(0, 1fr);
    }
}
@container (min-width: 980px) {
    .flrd-layout {
        grid-template-columns: minmax(340px, 1fr) minmax(420px, 560px);
        grid-template-areas: "meta art";
        gap: clamp(26px, 4.2cqi, 58px);
        justify-content: center;
    }
    .flrd-art-wrap {
        width: min(44cqi, 560px);
    }
    .flrd-meta {
        width: min(100%, 560px);
    }
}
@media (max-width: 760px) {
    .flrd-art-wrap {
        width: min(88vw, 520px);
    }
}
.flrsb-collapsible {
    border: 1px solid #333333;
    background: #040404;
    padding: 0;
    margin: 0;
}
.flrsb-collapsible > summary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 10px;
    cursor: pointer;
    list-style: none;
    padding: clamp(10px, 1.4vw, 16px) clamp(14px, 1.8vw, 20px);
    color: #FF55FF;
    font-size: 1rem;
    font-family: monospace;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 2px solid #55FF55;
    user-select: none;
    transition: background 0.15s;
    position: relative;
}
.flrsb-collapsible > summary:hover {
    background: rgba(255, 85, 255, 0.06);
}
.flrsb-collapsible > summary::-webkit-details-marker {
    display: none;
}
.flrsb-collapsible > summary::before {
    content: '\25B8';
    display: inline-block;
    color: #55FF55;
    font-size: 0.82em;
    transition: transform 0.18s;
    flex-shrink: 0;
}
.flrsb-collapsible[open] > summary::before {
    transform: rotate(90deg);
}
.flrsb-collapsible[open] > summary {
    border-bottom-color: #55FF55;
}
.flrsb-collapsible:not([open]) > summary {
    border-bottom-color: #333333;
}
.flrsb-collapsible > .flrsb-collapsible-body {
    padding: clamp(14px, 1.8vw, 20px);
    display: grid;
    gap: 14px;
}
.flrsb-collapsible > summary {
    justify-content: space-between;
}
.flrsb-summary-text {
    flex: 1;
}
.flrsb-summary-shuffle {
    font-size: 0.72rem;
    padding: 3px 10px;
    margin-left: auto;
    text-transform: none;
    letter-spacing: normal;
}
/* ── Submit + Vektrax Feed ── */
.flrsb-submit-row {
    display: flex;
    gap: 10px;
    margin-top: 14px;
}
.flrsb-submit-button {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    background: rgba(85, 255, 85, 0.08);
    border: 2px solid #55FF55;
    color: #55FF55;
    font-family: monospace;
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    border-radius: 3px;
    transition: background 0.2s, box-shadow 0.2s, border-color 0.2s;
}
.flrsb-submit-button:hover {
    background: rgba(85, 255, 85, 0.16);
    box-shadow: 0 0 12px rgba(85, 255, 85, 0.2);
}
.flrsb-submit-button:active {
    background: rgba(85, 255, 85, 0.24);
}
.flrsb-submit-button.is-confirm {
    border-color: #FFFF55;
    color: #FFFF55;
    background: rgba(255, 255, 85, 0.08);
    box-shadow: 0 0 10px rgba(255, 255, 85, 0.18);
}
.flrsb-submit-button.is-confirm:hover {
    background: rgba(255, 255, 85, 0.18);
    box-shadow: 0 0 16px rgba(255, 255, 85, 0.3);
}
.flrsb-submit-button.is-sending {
    border-color: #FFFF55;
    color: #FFFF55;
    pointer-events: none;
    opacity: 0.7;
}
.flrsb-submit-button.is-empty {
    border-color: #FF5555;
    color: #FF5555;
    animation: flrsb-shake 0.4s ease;
}
@keyframes flrsb-shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-4px); }
    40% { transform: translateX(4px); }
    60% { transform: translateX(-3px); }
    80% { transform: translateX(3px); }
}
.flrsb-submit-button.is-sending .flrsb-submit-icon {
    animation: flrsb-pulse 1s infinite;
}
@keyframes flrsb-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}
.flrsb-submit-icon {
    font-size: 0.78em;
}
.flrsb-reset-button {
    padding: 10px 14px;
    background: transparent;
    border: 1px solid #555;
    color: #888;
    font-family: monospace;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    border-radius: 3px;
    transition: border-color 0.15s, color 0.15s;
}
.flrsb-reset-button:hover {
    border-color: #FF5555;
    color: #FF5555;
}
.flrsb-vx-feed {
    margin-top: 14px;
    border: 1px solid #333;
    border-radius: 3px;
    background: #080808;
    overflow: hidden;
}
.flrsb-vx-feed[hidden] {
    display: none !important;
}
.flrsb-vx-feed-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    border-bottom: 1px solid #333;
    background: #0c0c0c;
}
.flrsb-vx-feed-title {
    font-family: monospace;
    font-size: 0.82rem;
    color: #55FF55;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}
.flrsb-vx-feed-status {
    font-family: monospace;
    font-size: 0.68rem;
    color: #888;
}
.flrsb-vx-feed-status.is-live {
    color: #55FF55;
}
.flrsb-vx-feed-status.is-error {
    color: #FF5555;
}
.flrsb-vx-feed-messages {
    max-height: 280px;
    overflow-y: auto;
    padding: 0;
}
.flrsb-vx-msg {
    padding: 8px 12px;
    border-bottom: 1px solid #1a1a1a;
    font-family: monospace;
    font-size: 0.78rem;
    line-height: 1.45;
    color: #AAAAAA;
    white-space: pre-wrap;
    word-break: break-word;
}
.flrsb-vx-msg:last-child {
    border-bottom: none;
}
.flrsb-vx-msg-time {
    color: #555;
    font-size: 0.68rem;
    margin-right: 6px;
}
.flrsb-vx-msg.is-sent {
    color: #FFFF55;
    background: rgba(255, 255, 85, 0.03);
    border-left: 2px solid #FFFF55;
}
.flrsb-vx-msg.is-success {
    color: #55FF55;
}
.flrsb-vx-msg.is-error {
    color: #FF5555;
}
/* ── Clipboard icon button ── */
.flrsb-copy-icon {
    background: transparent;
    border: 1px solid #555;
    color: #AAAAAA;
    font-size: 1.1rem;
    padding: 3px 6px;
    border-radius: 2px;
    cursor: pointer;
    line-height: 1;
    transition: border-color 0.15s, color 0.15s;
    flex-shrink: 0;
}
.flrsb-copy-icon:hover {
    border-color: #55FF55;
    color: #55FF55;
}
/* ── Preview close button ── */
.flrsb-close-preview {
    background: transparent;
    border: 1px solid #555;
    color: #FF5555;
    font-size: 1rem;
    font-family: monospace;
    font-weight: bold;
    padding: 2px 7px;
    border-radius: 2px;
    cursor: pointer;
    line-height: 1;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    flex-shrink: 0;
}
.flrsb-close-preview:hover {
    border-color: #FF5555;
    background: rgba(255, 85, 85, 0.14);
    color: #FF5555;
}
/* ── Vektrax feed at top of card body ── */
.flrsb-vx-feed-top {
    margin-bottom: clamp(14px, 2vw, 22px);
}
.flrsb-vx-feed-top[hidden] {
    display: none !important;
}
.flrsb-vx-feed-top .flrsb-vx-feed {
    margin-top: 0;
}
/* ── Success banner ── */
.flrsb-success-banner {
    padding: 14px 18px;
    border: 2px solid #55FF55;
    border-radius: 3px;
    background: rgba(85, 255, 85, 0.06);
    color: #55FF55;
    font-family: monospace;
    font-size: 0.88rem;
    text-align: center;
    margin-bottom: 14px;
    animation: flrsb-success-glow 2s ease-in-out infinite;
}
.flrsb-success-banner a {
    color: #55FFFF;
    text-decoration: underline;
}
@keyframes flrsb-success-glow {
    0%, 100% { box-shadow: 0 0 8px rgba(85, 255, 85, 0.2); }
    50% { box-shadow: 0 0 20px rgba(85, 255, 85, 0.4); }
}
/* ── Preview col ordering (above form) ── */
.flrsb-layout .flrsb-preview-col {
    order: -1;
}
.flrsb-layout .flrsb-form-col {
    order: 1;
}
/* ── Memory Mode toggle ── */
.flrsb-memory-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    padding: 4px 12px 4px 8px;
    background: transparent;
    border: 1px solid #555;
    border-radius: 3px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.3s;
    flex-shrink: 0;
    font-family: monospace;
    font-size: 0.72rem;
    text-transform: none;
    letter-spacing: normal;
    color: #888;
    line-height: 1;
    user-select: none;
}
.flrsb-memory-toggle:hover {
    border-color: #FFFF55;
    background: rgba(255, 255, 85, 0.04);
}
.flrsb-memory-toggle.is-active {
    border-color: #FFFF55;
    color: #FFFF55;
    background: rgba(255, 255, 85, 0.08);
    box-shadow: 0 0 8px rgba(255, 255, 85, 0.15);
}
.flrsb-memory-icon {
    display: inline-block;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid currentColor;
    position: relative;
    flex-shrink: 0;
    transition: border-color 0.2s, box-shadow 0.3s;
}
.flrsb-memory-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    transform: translate(-50%, -50%) scale(0);
    transition: transform 0.2s ease, background 0.2s;
}
.flrsb-memory-toggle.is-active .flrsb-memory-icon {
    border-color: #FFFF55;
    box-shadow: 0 0 6px rgba(255, 255, 85, 0.4);
}
.flrsb-memory-toggle.is-active .flrsb-memory-icon::after {
    transform: translate(-50%, -50%) scale(1);
    background: #FFFF55;
}
.flrsb-memory-label {
    white-space: nowrap;
}
/* ── Co-writer picker ── */
.flrsb-summary-cowriter {
    font-size: 0.72rem;
    padding: 3px 10px;
    margin-left: auto;
    text-transform: none;
    letter-spacing: normal;
    flex-shrink: 0;
}
.flrsb-cowriter-badge {
