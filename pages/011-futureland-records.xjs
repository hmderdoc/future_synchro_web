<script>
(function() {
    var COMPOSER = <?xjs write(JSON.stringify(user.alias).replace(/<\//g, '<\\/')); ?>;
    var API_URL  = './api/files.ssjs?call=list-files&dir=originalcontent_mp3s';
    var STREAM_URL = './radio-stream/';
    var RANGE_BYTES = 262144;

    var searchInput = document.getElementById('tm-search');
    var dropdown    = document.getElementById('tm-dropdown');
    var detailEl    = document.getElementById('tm-detail');
    var emptyEl     = document.getElementById('tm-empty');
    var artSlot     = document.getElementById('tm-art-slot');
    var titleEl     = document.getElementById('tm-title');
    var artistEl    = document.getElementById('tm-artist');
    var genreEl     = document.getElementById('tm-genre');
    var albumEl     = document.getElementById('tm-album');
    var previewBtn  = document.getElementById('tm-btn-preview');
    var assignBtn   = document.getElementById('tm-btn-assign');
    var editBtn     = document.getElementById('tm-btn-edit');

    var myTracks = [];
    var hlIndex  = -1;
    var selectedTrack = null;

    function esc(s) {
        var d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
    }

    /* ── Merge helpers (mirrors the radio player) ── */
    function mergeTrackTags(base, over) {
        var m = {}, k;
        base = base || {}; over = over || {};
        for (k in base)  if (base.hasOwnProperty(k))  m[k] = base[k];
        for (k in over)  if (over.hasOwnProperty(k) && over[k] !== undefined && over[k] !== null && over[k] !== '') m[k] = over[k];
        return m;
    }

    function tagVal(track, key) {
        return (track.tags && track.tags[key]) ? track.tags[key] : '';
    }
    function trackTitle(track) {
        return tagVal(track, 'title') || track.name.replace(/\.mp3$/i, '').replace(/_/g, ' ');
    }

    /* ── Parse track list exactly like the radio player ── */
    function parseTrackList(list) {
        return Promise.all(list.map(function(item) {
            var url = STREAM_URL + encodeURIComponent(item.name);
            return fetch(url, {
                headers: { Range: 'bytes=0-' + (RANGE_BYTES - 1) }
            })
            .then(function(r) { return r.arrayBuffer(); })
            .then(function(buf) {
                var tags = {};
                var artURL = '';
                var overrideTags = item && item.tags ? item.tags : {};
                if (typeof window.parseID3v2 === 'function') {
                    try { tags = window.parseID3v2(buf) || {}; } catch(_) { tags = {}; }
                }
                if (tags.picture && tags.picture.blob) {
                    artURL = URL.createObjectURL(tags.picture.blob);
                }
                tags = mergeTrackTags(tags, overrideTags);
                return { name: item.name, desc: item.desc || '', tags: tags, artURL: artURL };
            })
            .catch(function() {
                return { name: item.name, desc: item.desc || '',
                         tags: mergeTrackTags({}, item && item.tags ? item.tags : {}), artURL: '' };
            });
        }));
    }

    /* ── Load ── */
    showEmpty('Loading your tracks…');
    fetch(API_URL)
        .then(function(r) { return r.json(); })
        .then(function(list) {
            if (!Array.isArray(list)) { showEmpty('Could not load tracks.'); return; }
            return parseTrackList(list);
        })
        .then(function(parsed) {
            if (!parsed) return;
            /* Filter by composer from fully-merged tags (ID3 + overrides) */
            var composerLower = COMPOSER.toLowerCase();
            myTracks = parsed.filter(function(tr) {
                var c = tagVal(tr, 'composer');
                return c.toLowerCase() === composerLower;
            });
            if (!myTracks.length) {
                showEmpty('No tracks found for your account.');
            } else {
                showEmpty('Select a track above to view details.');
            }
        })
        .catch(function() { showEmpty('Error loading track list.'); });

    function showEmpty(msg) {
        emptyEl.textContent = msg;
        emptyEl.style.display = '';
        detailEl.style.display = 'none';
    }

    /* ── Dropdown typeahead ── */
    searchInput.addEventListener('focus', function() { showDropdown(''); });
    searchInput.addEventListener('input', function() { showDropdown(searchInput.value); });
    document.addEventListener('click', function(e) {
        if (!document.getElementById('tm-search-wrap').contains(e.target)) {
            dropdown.classList.remove('open');
        }
    });

    searchInput.addEventListener('keydown', function(e) {
        var items = dropdown.querySelectorAll('.tm-dropdown-item');
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            hlIndex = Math.min(hlIndex + 1, items.length - 1);
            updateHighlight(items);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            hlIndex = Math.max(hlIndex - 1, 0);
            updateHighlight(items);
        } else if (e.key === 'Enter' && hlIndex >= 0 && hlIndex < items.length) {
            e.preventDefault();
            items[hlIndex].click();
        } else if (e.key === 'Escape') {
            dropdown.classList.remove('open');
        }
    });

    function updateHighlight(items) {
        for (var i = 0; i < items.length; i++) {
            items[i].classList.toggle('highlighted', i === hlIndex);
        }
        if (items[hlIndex]) items[hlIndex].scrollIntoView({ block: 'nearest' });
    }

    function showDropdown(query) {
        var q = query.toLowerCase().trim();
        var matches = myTracks.filter(function(tr) {
            if (!q) return true;
            return trackTitle(tr).toLowerCase().indexOf(q) >= 0 ||
                   tagVal(tr, 'artist').toLowerCase().indexOf(q) >= 0 ||
                   tagVal(tr, 'album').toLowerCase().indexOf(q) >= 0;
        });
        hlIndex = -1;
        if (!matches.length) {
            dropdown.innerHTML = '<div class="tm-dropdown-empty">No matching tracks</div>';
        } else {
            dropdown.innerHTML = matches.map(function(tr, i) {
                var artHtml = tr.artURL
                    ? '<img class="tm-dropdown-art" src="' + esc(tr.artURL) + '" alt="" />'
                    : '<div class="tm-dropdown-art-placeholder">\u266b</div>';
                return '<div class="tm-dropdown-item" data-idx="' + i + '" data-name="' + esc(tr.name) + '">'
                     + artHtml
                     + '<span class="tm-dropdown-name">' + esc(trackTitle(tr)) + '</span>'
                     + '</div>';
            }).join('');
            var items = dropdown.querySelectorAll('.tm-dropdown-item');
            for (var ii = 0; ii < items.length; ii++) {
                (function(el) {
                    el.addEventListener('click', function() {
                        var name = el.getAttribute('data-name');
                        var track = myTracks.filter(function(t) { return t.name === name; })[0];
                        if (track) selectTrack(track);
                        dropdown.classList.remove('open');
                    });
                })(items[ii]);
            }
        }
        dropdown.classList.add('open');
    }

    function selectTrack(track) {
        selectedTrack = track;
        searchInput.value = trackTitle(track);
        showDetail(track);
        previewBtn.disabled = false;
        previewBtn.disabled = false;
        assignBtn.disabled = false;
        editBtn.disabled = false;
    }

    function showDetail(track) {
        emptyEl.style.display = 'none';
        detailEl.style.display = '';
        titleEl.textContent = trackTitle(track);
        artistEl.textContent = tagVal(track, 'artist') || '\u2014';
        genreEl.textContent  = tagVal(track, 'genre')  || '\u2014';
        albumEl.textContent  = tagVal(track, 'album')  || '\u2014';
        if (track.artURL) {
            artSlot.innerHTML = '<img class="tm-detail-art" src="' + esc(track.artURL) + '" alt="" />';
        } else {
            artSlot.innerHTML = '<div class="tm-detail-art-placeholder">\u266b</div>';
        }
    }

    // ── Preview Character: play the selected track + show designer char in visualizer ──
    previewBtn.addEventListener('click', function () {
        if (!selectedTrack) return;
        var radio = window.sbbsRadio;
        if (!radio) return;

        // Get the current character from the Rock Star Designer
        var charJson = typeof window.getRockstarDesignerCharacter === 'function'
            ? window.getRockstarDesignerCharacter() : null;
        if (!charJson) {
            alert('Design a character first using the Rock Star Designer above.');
            return;
        }

        // Inject character definition into the visualizer's registry
        try {
            var def = JSON.parse(charJson);
            def.name = def.name || 'Custom Character';
            if (window._CHARS) window._CHARS['_rsd_preview'] = def;
        } catch (e) {}

        // Open visualizer, play the track, then keep re-applying our character
        // until the metadata fetch cycle settles (it resets the character)
        document.dispatchEvent(new CustomEvent('viz:open'));
        radio.playByFile(selectedTrack.name);

        function applyChar() {
            if (window._setChar) window._setChar('_rsd_preview');
        }
        applyChar();
        setTimeout(applyChar, 300);
        setTimeout(applyChar, 800);
        setTimeout(applyChar, 1500);
        setTimeout(applyChar, 3000);
    });

    // ── Assign Character: save designer char to the selected track ──
    assignBtn.addEventListener('click', function () {
        if (!selectedTrack) return;
        var radio = window.sbbsRadio;
        if (!radio) return;

        var charJson = typeof window.getRockstarDesignerCharacter === 'function'
            ? window.getRockstarDesignerCharacter() : null;
        if (!charJson) {
            alert('Design a character first using the Rock Star Designer above.');
            return;
        }

        var csrfToken = (window.sbbsConfig && window.sbbsConfig.csrfToken)
            ? String(window.sbbsConfig.csrfToken) : '';

        var body = new URLSearchParams();
        body.set('file', selectedTrack.name);
        body.set('character', charJson);

        assignBtn.disabled = true;
        assignBtn.textContent = 'Saving\u2026';

        fetch('./api/files.ssjs?call=update-track-meta&dir=' + encodeURIComponent(radio.dirCode), {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'x-csrf-token': csrfToken
            },
            body: body
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data && data.error) throw new Error(data.error);
            assignBtn.textContent = '\u2605 Assigned!';
            document.dispatchEvent(new CustomEvent('rsd:character-assigned', {
                detail: { file: selectedTrack.name, character: charJson }
            }));
            setTimeout(function () {
                assignBtn.disabled = false;
                assignBtn.textContent = '\ud83c\udfad Assign Character';
            }, 2000);
        })
        .catch(function (err) {
            alert('Could not assign character: ' + (err.message || err));
            assignBtn.disabled = false;
            assignBtn.textContent = '\ud83c\udfad Assign Character';
        });
    });

    // ── Edit Metadata: open the radio library's track editor ──
    editBtn.addEventListener('click', function () {
        if (!selectedTrack) return;
        var radio = window.sbbsRadio;
        if (!radio) return;

        if (typeof radio.openEditorByFile === 'function') {
            var ok = radio.openEditorByFile(selectedTrack.name);
            if (!ok) {
                // Track might not be in the loaded playlist yet — open library so it loads
                radio.openLibraryPanel();
                setTimeout(function () {
                    if (!radio.openEditorByFile(selectedTrack.name)) {
                        alert('Could not find "' + selectedTrack.name + '" in the music library. Try playing it first.');
                    }
                }, 1500);
            }
        } else {
            // Fallback: just open the library panel (old cached radio.js)
            radio.openLibraryPanel();
        }
    });
})();
</script>

    <?xjs } ?>
    </div><!-- /vr-tab-label -->
</div>

<script>

    // ── Tab Navigation ──
    (function() {
        var tabs = document.querySelectorAll('.vr-tab');
        var panels = document.querySelectorAll('.vr-tab-content');
        tabs.forEach(function(tab) {
            tab.addEventListener('click', function() {
                var target = tab.getAttribute('data-vr-tab');
                tabs.forEach(function(t) { t.classList.remove('active'); });
                panels.forEach(function(p) { p.classList.remove('active'); });
                tab.classList.add('active');
                var panel = document.getElementById('vr-tab-' + target);
                if (panel) panel.classList.add('active');
                // Trigger canvas resize for designer tab
                if (target === 'label') {
                    var rsdCanvas = document.getElementById('rsd-canvas');
                    if (rsdCanvas) {
                        setTimeout(function() { window.dispatchEvent(new Event('resize')); }, 50);
                    }
                }
            });
        });
    })();

(function () {
    'use strict';

    function bindCardCollapse(options) {
        var card = document.getElementById(options.cardId);
        var body = document.getElementById(options.bodyId);
        var button = document.getElementById(options.buttonId);
        var collapsed = false;

        if (!card || !body || !button || button.dataset.collapseBound === '1') return;
        button.dataset.collapseBound = '1';

        function apply(nextCollapsed) {
            collapsed = !!nextCollapsed;
            card.classList.toggle('is-collapsed', collapsed);
            body.hidden = collapsed;
            button.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        }

        apply(false);

        button.addEventListener('click', function (event) {
            event.preventDefault();
            apply(!collapsed);
        });
    }

    bindCardCollapse({
        cardId: 'flrd-bios-card',
        bodyId: 'flrd-bios-body',
        buttonId: 'flrd-bios-toggle'
    });

    bindCardCollapse({
        cardId: 'flrsb-panel',
        bodyId: 'flrsb-body',
        buttonId: 'flrsb-panel-toggle'
    });
})();

(function () {
    'use strict';

    var PAGE_FILE = '011-futureland-records.xjs';
    var API_URL = './api/files.ssjs?call=list-files&dir=originalcontent_mp3s';
    var STREAM_URL = './radio-stream/';
    var RANGE_BYTES = 262144;
    var REQUESTED_TRACK = <?xjs write(_records_track_json); ?>;
    var PERSONA_LIST = [];
    try { PERSONA_LIST = <?xjs write(typeof _cowriters_json === 'string' ? _cowriters_json : '[]'); ?>; } catch(_e) {}

    var panel = document.getElementById('flrd-panel');
    if (!panel || panel.dataset.bound === '1') return;
    panel.dataset.bound = '1';

    var loadingEl = document.getElementById('flrd-loading');
    var emptyEl = document.getElementById('flrd-empty');
    var layoutEl = document.getElementById('flrd-layout');
    var titleEl = document.getElementById('flrd-title');
    var creditsEl = document.getElementById('flrd-credits');
    var performersEl = document.getElementById('flrd-performers');
    var genreLineEl = document.getElementById('flrd-genre-line');
    var counterEl = document.getElementById('flrd-counter');
    var prevButton = document.getElementById('flrd-prev');
    var nextButton = document.getElementById('flrd-next');
    var shareButton = document.getElementById('flrd-share');
    var trackSelect = document.getElementById('flrd-track-select');
    var playButton = document.getElementById('flrd-play-button');
    var artWrap = document.getElementById('flrd-art-wrap');
    var artImg = document.getElementById('flrd-art');
    var noArtEl = document.getElementById('flrd-no-art');
    var shareResetTimer = 0;
    var tracks = [];
    var cur = 0;
    var nowPlaying = (window.sbbsRadio && window.sbbsRadio.currentTrackFile) || '';

    function esc(value) {
        return String(value === undefined || value === null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function filenameTitle(name) {
        return String(name || '')
            .replace(/\.mp3$/i, '')
            .replace(/_/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
    }

    function trackTitle(track) {
        return String((track.tags && track.tags.title) || filenameTitle(track.name) || 'Unknown Track');
    }

    function trackArtist(track) {
        return String((track.tags && track.tags.artist) || '');
    }

    function trackComposer(track) {
        return String((track.tags && track.tags.composer) || '');
    }

    function trackAlbum(track) {
        return String((track.tags && track.tags.album) || '');
    }

    function trackYear(track) {
        return String((track.tags && track.tags.year) || '');
    }

    function trackGenre(track) {
        return String((track.tags && track.tags.genre) || '');
    }

    function mergeTrackTags(base, override) {
        var merged = {};
        var key;

        base = base || {};
        override = override || {};

        for (key in base) {
            if (!Object.prototype.hasOwnProperty.call(base, key)) continue;
            merged[key] = base[key];
        }
        for (key in override) {
            if (!Object.prototype.hasOwnProperty.call(override, key)) continue;
            if (override[key] === undefined || override[key] === null || override[key] === '') continue;
            merged[key] = override[key];
        }

        return merged;
    }

    function optionLabel(track) {
        var artist = trackArtist(track);
        return artist.length ? (trackTitle(track) + ' - ' + artist) : trackTitle(track);
    }

    function setLoading(loading) {
        if (loading) {
            loadingEl.hidden = false;
            emptyEl.hidden = true;
            layoutEl.classList.add('is-hidden');
        } else {
            loadingEl.hidden = true;
        }

        [prevButton, nextButton, shareButton, trackSelect, playButton, artWrap].forEach(function (el) {
            if (!el) return;
            if (loading) {
                el.setAttribute('disabled', 'disabled');
            } else {
                el.removeAttribute('disabled');
            }
        });
    }

    function setEmpty(message) {
        loadingEl.hidden = true;
        layoutEl.classList.add('is-hidden');
        emptyEl.hidden = false;
        emptyEl.textContent = message;
        counterEl.textContent = '0 / 0';
        document.title = 'Vektrax Records';
        [prevButton, nextButton, shareButton, trackSelect, playButton, artWrap].forEach(function (el) {
            if (!el) return;
            el.setAttribute('disabled', 'disabled');
        });
    }

    function parseTrackList(list) {
        return Promise.all(list.map(function (item) {
            var url = STREAM_URL + encodeURIComponent(item.name);
            return fetch(url, {
                headers: { Range: 'bytes=0-' + (RANGE_BYTES - 1) }
            })
                .then(function (response) { return response.arrayBuffer(); })
                .then(function (buf) {
                    var tags = {};
                    var artURL = '';
                    var overrideTags = item && item.tags ? item.tags : {};

                    if (typeof window.parseID3v2 === 'function') {
                        try {
                            tags = window.parseID3v2(buf) || {};
                        } catch (_) {
                            tags = {};
                        }
                    }

                    if (tags.picture && tags.picture.blob) {
                        artURL = URL.createObjectURL(tags.picture.blob);
                    }

                    tags = mergeTrackTags(tags, overrideTags);

                    return {
                        name: item.name,
                        desc: item.desc || '',
                        added: item.added || 0,
                        tags: tags,
                        artURL: artURL
                    };
                })
                .catch(function () {
                    return {
                        name: item.name,
                        desc: item.desc || '',
                        added: item.added || 0,
                        tags: mergeTrackTags({}, item && item.tags ? item.tags : {}),
                        artURL: ''
                    };
                });
        }));
    }

    function findTrackIndex(name) {
        var lower = String(name || '').toLowerCase();
        var idx = -1;

        tracks.forEach(function (track, index) {
            if (String(track.name).toLowerCase() === lower) idx = index;
        });

        return idx;
    }

    function chooseInitialTrack() {
        var idx = -1;

        if (REQUESTED_TRACK) {
            idx = findTrackIndex(REQUESTED_TRACK);
        }

        if (idx < 0 && nowPlaying) {
            idx = findTrackIndex(nowPlaying);
        }

        cur = idx >= 0 ? idx : 0;
    }

    function fillTrackSelect() {
        trackSelect.innerHTML = '';

        tracks.forEach(function (track) {
            var option = document.createElement('option');
            option.value = track.name;
            option.textContent = optionLabel(track);
            if (track.name === tracks[cur].name) option.selected = true;
            trackSelect.appendChild(option);
        });
    }

    function buildUrl(track) {
        var next = new URL(window.location.href);
        next.searchParams.set('page', PAGE_FILE);
        next.searchParams.delete('gallery');
        next.searchParams.delete('dir');
        next.searchParams.delete('file');

        if (track && track.name) {
            next.searchParams.set('track', track.name);
        } else {
            next.searchParams.delete('track');
        }

        return next;
    }

    function syncUrl(track) {
        var next;

        if (!window.history || !window.history.replaceState) return;
        next = buildUrl(track);
        window.history.replaceState({ track: track && track.name ? track.name : '' }, '', next.toString());
    }

    function flashShareState(label) {
        clearTimeout(shareResetTimer);
        shareButton.textContent = label;
        shareResetTimer = setTimeout(function () {
            shareButton.textContent = 'Share';
        }, 1600);
    }

    function renderCredits(track) {
        var artist = trackArtist(track);
        creditsEl.innerHTML = artist
            ? ('<span class="flrd-artist-name">' + esc(artist) + '</span>')
            : '<span class="flrd-credit-sep">Unknown artist</span>';
    }

    /**
     * Parse artist string like "Data feat. ALF & Hm Derdoc" into performers.
     * Names at start/end = BBS user accounts. If 3 names, middle = AI persona.
     */
    function parsePerformers(artistStr) {
        if (!artistStr) return [];
        var parts = artistStr.split(/\s*(?:feat\.?|ft\.?|&|,|\band\b)\s*/i)
            .map(function (s) { return s.trim(); })
            .filter(Boolean);
        if (parts.length === 0) return [];
        return parts.map(function (name, idx) {
            var isPersona = parts.length === 3 && idx === 1;
            return { name: name, persona: isPersona };
        });
    }

    function findPersonaAvatar(name) {
        for (var i = 0; i < PERSONA_LIST.length; i++) {
            if (PERSONA_LIST[i].name.toLowerCase() === name.toLowerCase()) {
                return PERSONA_LIST[i].avatar || '';
            }
        }
        return '';
    }

    function renderPerformers(track) {
        if (!performersEl) return;
        performersEl.innerHTML = '';
        var performers = parsePerformers(trackArtist(track));
        if (!performers.length) return;
        var userAvatarsNeeded = [];
        performers.forEach(function (p) {
            var wrap = document.createElement('div');
            wrap.className = 'flrd-performer';
            var avDiv = document.createElement('div');
            avDiv.className = 'flrd-performer-avatar';
            if (p.persona) {
                var b64 = findPersonaAvatar(p.name);
                if (b64 && window.GraphicsConverter) {
                    try {
                        GraphicsConverter.shared().from_bin(
                            atob(b64), 10, 6,
                            function (img) {
                                avDiv.innerHTML = '';
                                if (typeof img === 'string') {
                                    var i = new Image(); i.src = img;
                                    avDiv.appendChild(i);
                                } else {
                                    avDiv.appendChild(img);
                                }
                            }, true
                        );
                    } catch (_e) {}
                }
            } else {
                avDiv.setAttribute('data-avatar', p.name);
                userAvatarsNeeded.push(p.name);
            }
            var label = document.createElement('div');
            label.className = 'flrd-performer-name' + (p.persona ? ' is-persona' : '');
            label.textContent = p.name;
            wrap.appendChild(avDiv);
            wrap.appendChild(label);
            performersEl.appendChild(wrap);
        });
        if (userAvatarsNeeded.length && typeof Avatars !== 'undefined' && Avatars.draw) {
            Avatars.draw(userAvatarsNeeded);
        }
    }



    function renderGenreline(track) {
        var genre = trackGenre(track);
        var year = trackYear(track);
        var html = '';
        if (year) html += '<span class="flrd-album-year">' + esc(year) + '</span>';
        if (year && genre) html += ' ';
        if (genre) html += '<span class="flrd-genre">' + esc(genre) + '</span>';
        genreLineEl.innerHTML = html || '<span class="flrd-credit-sep">No genre metadata</span>';
    }

    function renderArt(track) {
        if (track.artURL) {
            artImg.src = track.artURL;
            artImg.alt = trackTitle(track) + ' album art';
            artImg.hidden = false;
            noArtEl.hidden = true;
            return;
        }

        artImg.removeAttribute('src');
        artImg.alt = '';
        artImg.hidden = true;
        noArtEl.hidden = false;
    }

    function renderPlayState(track) {
        var isPlaying = nowPlaying === track.name;
        playButton.disabled = isPlaying;
        playButton.classList.toggle('is-playing', isPlaying);
        playButton.innerHTML = isPlaying
            ? '♫ Now Playing'
            : '<span class="flrd-play-icon">▶</span> Play This Track';
    }

    function render() {
        var track;

        if (!tracks.length) return;

        track = tracks[cur];
        loadingEl.hidden = true;
        emptyEl.hidden = true;
        layoutEl.classList.remove('is-hidden');
        counterEl.textContent = (cur + 1) + ' / ' + tracks.length;
        titleEl.textContent = trackTitle(track);
        renderPerformers(track);
        renderCredits(track);
        renderGenreline(track);
        fillTrackSelect();
        renderArt(track);
        syncUrl(track);
        document.title = trackTitle(track) + ' | Vektrax Records';
        [prevButton, nextButton, shareButton, trackSelect, artWrap].forEach(function (el) {
            if (!el) return;
            el.removeAttribute('disabled');
        });
        renderPlayState(track);
    }

    function playSelectedTrack() {
        var track = tracks[cur];
        if (!track || track.name === nowPlaying) return;

        document.dispatchEvent(new CustomEvent('viz:picktrack', {
            detail: { name: track.name }
        }));
        document.dispatchEvent(new CustomEvent('viz:open'));
        nowPlaying = track.name;
        render();
    }

    function go(dir) {
        if (!tracks.length) return;
        cur = ((cur + dir) % tracks.length + tracks.length) % tracks.length;
        render();
    }

    function shareCurrent() {
        var url;
        var track;

        if (!tracks.length) return;
        track = tracks[cur];
        url = buildUrl(track).toString();

        if (navigator.share) {
            navigator.share({
                title: document.title || 'Vektrax Records',
                url: url
            })
                .then(function () {
                    flashShareState('Shared');
                })
                .catch(function (error) {
                    if (error && error.name === 'AbortError') return;
                    console.error('[records] share failed:', error);
                    flashShareState('Error');
                });
            return;
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url)
                .then(function () {
                    flashShareState('Copied');
                })
                .catch(function (error) {
                    console.error('[records] clipboard failed:', error);
                    window.prompt('Copy this link:', url);
                    flashShareState('Ready');
                });
            return;
        }

        window.prompt('Copy this link:', url);
        flashShareState('Ready');
    }

    prevButton.addEventListener('click', function () {
        go(-1);
    });

    nextButton.addEventListener('click', function () {
        go(1);
    });

    shareButton.addEventListener('click', shareCurrent);
    playButton.addEventListener('click', playSelectedTrack);
    artWrap.addEventListener('click', playSelectedTrack);

    trackSelect.addEventListener('change', function () {
        var nextIndex = findTrackIndex(trackSelect.value);
        if (nextIndex < 0) return;
        cur = nextIndex;
        render();
    });

    document.addEventListener('radio:trackchange', function (event) {
        if (event.detail && event.detail.filename) {
            nowPlaying = event.detail.filename;
            render();
        }
    });

    setLoading(true);
    fetch(API_URL, { credentials: 'same-origin' })
        .then(function (response) { return response.json(); })
        .then(function (list) {
            if (!list || !list.length) {
                setEmpty('No tracks available.');
                return null;
            }
            return parseTrackList(list);
        })
        .then(function (parsed) {
            if (!parsed) return;

            tracks = parsed.filter(function (track) {
                return !!track && !!track.name;
            });

            if (!tracks.length) {
                setEmpty('No tracks available.');
                return;
            }

            setLoading(false);
            chooseInitialTrack();
            render();
        })
        .catch(function (error) {
            console.error('[records] init failed:', error);
            setEmpty('Unable to load tracks.');
        });
})();

