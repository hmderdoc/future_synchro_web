            { value: 'accelerando', label: 'Gradual accelerando' },
            { value: 'custom_numeric', label: 'Custom numeric' }
        ]
    };

    function byId(id) {
        return document.getElementById(id);
    }

    function trimValue(value) {
        return String(value || '').replace(/\r/g, '').trim();
    }

    function sentence(text) {
        var value = trimValue(text);
        if (!value) return '';
        return /[.!?]$/.test(value) ? value : (value + '.');
    }

    function populateSelect(select, options, includeCustom, includeBlank, blankLabel) {
        var defaultValue;

        if (!select) return;
        defaultValue = select.getAttribute('data-default') || '';
        select.innerHTML = '';

        if (includeBlank) {
            var blankOption = document.createElement('option');
            blankOption.value = UNSPECIFIED_OPTION_VALUE;
            blankOption.textContent = blankLabel || 'Unspecified';
            select.appendChild(blankOption);
        }

        options.forEach(function (entry) {
            var option = document.createElement('option');
            if (typeof entry === 'string') {
                option.value = entry;
                option.textContent = entry;
            } else {
                option.value = entry.value;
                option.textContent = entry.label;
            }
            if (defaultValue && option.value === defaultValue) option.selected = true;
            select.appendChild(option);
        });

        if (includeCustom) {
            var customOption = document.createElement('option');
            customOption.value = CUSTOM_OPTION_VALUE;
            customOption.textContent = 'Custom...';
            select.appendChild(customOption);
        }

        if (!select.value && select.options.length) {
            select.selectedIndex = 0;
        }
    }

    function getPresetControls(name) {
        return {
            select: byId('flrsb-' + name + '-select'),
            custom: byId('flrsb-' + name + '-custom')
        };
    }

    function customOptionFor(select) {
        return select ? select.querySelector('option[value="' + CUSTOM_OPTION_VALUE + '"]') : null;
    }

    function syncPresetField(name, focusCustom) {
        var controls = getPresetControls(name);
        var select = controls.select;
        var custom = controls.custom;
        var customOption = customOptionFor(select);
        var customValue = custom ? trimValue(custom.value) : '';
        var showCustom = select && select.value === CUSTOM_OPTION_VALUE;

        if (!select || !custom || !customOption) return;

        customOption.textContent = customValue ? ('Custom: ' + customValue) : 'Custom...';
        custom.hidden = !showCustom;
        custom.disabled = !showCustom;

        if (showCustom && focusCustom) {
            custom.focus();
            custom.select();
        }
    }

    function getPresetValue(name) {
        var controls = getPresetControls(name);
        var select = controls.select;
        var custom = controls.custom;
        var customValue = custom ? trimValue(custom.value) : '';
        if (select && select.value === CUSTOM_OPTION_VALUE) return customValue;
        return select ? trimValue(select.value) : '';
    }

    function getTempoLabel() {
        var mode = trimValue(bpmModeEl.value);
        var customBpm = trimValue(bpmValueEl.value);

        if (!mode) return '';
        if (mode === 'custom_numeric') {
            return customBpm ? (customBpm + ' BPM') : '';
        }
        if (mode === 'slow_genre') return 'Slow for the chosen genre';
        if (mode === 'mid_genre') return 'Midtempo for the chosen genre';
        if (mode === 'fast_genre') return 'Fast for the chosen genre';
        if (mode === 'half_time') return 'Half-time feel';
        if (mode === 'double_time') return 'Double-time feel';
        return 'Match the genre default';
    }

    function buildStylePrompt() {
        var genre = getPresetValue('genre');
        var feel = getPresetValue('feel');
        var tone = getPresetValue('tone');
        var arrangement = getPresetValue('arrangement');
        var instrumentation = getPresetValue('instrumentation');
        var groove = getPresetValue('groove');
        var band = getPresetValue('band');
        var leadvocal = getPresetValue('leadvocal');
        var backingvocal = getPresetValue('backingvocal');
        var brief = trimValue(byId('flrsb-brief').value);
        var notes = trimValue(byId('flrsb-notes').value);
        var phrases = [];
        var prefix = genre ? (genre + ': ') : '';

        if (brief) phrases.push(sentence(brief));
        if (feel || tone) {
            phrases.push(sentence('Mood and feel: ' + [feel, tone].filter(Boolean).join(', ')));
        }
        if (instrumentation) phrases.push(sentence('Built around ' + instrumentation));
        if (groove) phrases.push(sentence('Groove: ' + groove));
        if (band) phrases.push(sentence('Players: ' + band));
        if (leadvocal) phrases.push(sentence('Lead singer type: ' + leadvocal));
        if (backingvocal) phrases.push(sentence('Background singer type: ' + backingvocal));
        if (arrangement) phrases.push(sentence('Arrangement: ' + arrangement));
        if (notes) phrases.push(sentence('Extra direction: ' + notes));

        if (!phrases.length) return genre;
        return prefix + phrases.join(' ');
    }

    function buildGuidedLyrics() {
        var blocks = [];

        sectionDefs.forEach(function (section) {
            var notes = trimValue(byId('flrsb-section-' + section.key + '-notes').value);
            var text = trimValue(byId('flrsb-section-' + section.key + '-text').value);
            var heading;

            if (!notes && !text) return;

            heading = '[' + section.label;
            if (notes) heading += ' - ' + notes;
            heading += ']';
            blocks.push(heading);
            if (text) blocks.push(text);
            blocks.push('');
        });

        while (blocks.length && !trimValue(blocks[blocks.length - 1])) {
            blocks.pop();
        }

        return blocks.length ? blocks.join('\n') : '';
    }

    function buildLyricsPrompt() {
        var freeform = trimValue(byId('flrsb-lyrics-freeform').value);
        if (lyricMode === 'guided') return buildGuidedLyrics();
        return freeform;
    }

    function buildPreview() {
        var workingTitle = trimValue(byId('flrsb-song-title').value);
        var stylePrompt = buildStylePrompt();
        var lyricsPrompt = buildLyricsPrompt();
        var language = trimValue(byId('flrsb-language-select').value);
        var tempo = getTempoLabel();
        var key = trimValue(byId('flrsb-key-select').value);
        var timeSig = trimValue(byId('flrsb-timesig-select').value);
        var duration = trimValue(byId('flrsb-duration-value').value);
        var lines = [];
        var explicitLines = [];

        /* Build the command prefix:
           +++ = memory on, ++++ = memory off
           ^NAME = invoke ghost-writer (co-writer) */
        var cmdPrefix = memoryActive ? '+++' : '++++';
        if (selectedCowriter) cmdPrefix += '^' + selectedCowriter;
        lines.push(cmdPrefix);
        lines.push('');

        if (workingTitle) {
            lines.push('Title: ' + workingTitle);
            lines.push('');
        }

        if (stylePrompt) {
            lines.push('[Style Prompt]');
            lines.push(stylePrompt);
            lines.push('');
        }

        if (lyricsPrompt) {
            lines.push('[Lyrics Director]');
            lines.push(lyricsPrompt);
            lines.push('');
        }

        if (language) explicitLines.push('Language: ' + language);
        if (tempo) explicitLines.push('BPM: ' + tempo);
        if (timeSig) explicitLines.push('Time Signature: ' + timeSig);
        if (key) explicitLines.push('Key Signature: ' + key);
        if (duration) explicitLines.push('Duration: ' + duration + ' seconds');

        if (explicitLines.length) {
            lines.push('[Musical Composition Director]');
            explicitLines.forEach(function (line) {
                lines.push(line);
            });
        }

        while (lines.length && !trimValue(lines[lines.length - 1])) {
            lines.pop();
        }

        if (!lines.length) {
            lines.push('Add a story seed, lyrics, notes, or use Shuffle Band Type to build a minimal Vektrax prompt.');
        }

        return lines.join('\n');
    }

    function setLyricMode(nextMode) {
        lyricMode = nextMode === 'guided' ? 'guided' : 'freeform';
        freeformPanel.hidden = lyricMode !== 'freeform';
        guidedPanel.hidden = lyricMode !== 'guided';
        modeButtons.forEach(function (button) {
            button.classList.toggle('is-active', button.getAttribute('data-lyric-mode') === lyricMode);
        });
        renderPreview();
    }

    function syncTempoState() {
        var usesCustom = trimValue(bpmModeEl.value) === 'custom_numeric';
        bpmValueEl.disabled = !usesCustom;
        if (!usesCustom) bpmValueEl.removeAttribute('aria-invalid');
    }

    function pickRandom(items) {
        if (!items || !items.length) return '';
        return items[Math.floor(Math.random() * items.length)];
    }

    function setHybridPresetValue(name, value) {
        var controls = getPresetControls(name);
        if (!controls.select || !controls.custom) return;
        controls.custom.value = '';
        controls.select.value = value || UNSPECIFIED_OPTION_VALUE;
        syncPresetField(name, false);
    }

    /* ── Co-writer picker ── */
    function renderCowriterAvatar(base64, targetEl) {
        if (!base64 || !cowriterGC) {
            targetEl.innerHTML = '<span style="color:#555;font-size:2rem">?</span>';
            return;
        }
        try {
            cowriterGC.from_bin(atob(base64), 10, 6, function (dataURL) {
                var img = document.createElement('img');
                img.src = dataURL;
                img.alt = 'AI Co-writer';
                targetEl.innerHTML = '';
                targetEl.appendChild(img);
            }, true);
        } catch (e) {
            targetEl.innerHTML = '<span style="color:#555;font-size:2rem">?</span>';
        }
    }

    function buildCowriterList() {
        if (!cowriterListEl) return;
        if (!COWRITER_LIST || !COWRITER_LIST.length) {
            cowriterListEl.innerHTML = '<div style="padding:12px;color:#888;font-family:monospace;font-size:0.8rem">No AI co-writers defined yet.</div>';
            return;
        }
        cowriterListEl.innerHTML = '';
        COWRITER_LIST.forEach(function (cw) {
            var item = document.createElement('div');
            item.className = 'flrsb-cowriter-item';
            item.setAttribute('data-cowriter', cw.name);
            var avBox = document.createElement('div');
            avBox.className = 'flrsb-cowriter-item-avatar';
            if (cw.avatar && cowriterGC) {
                try {
                    cowriterGC.from_bin(atob(cw.avatar), 10, 6, function (dataURL) {
                        var img = document.createElement('img');
                        img.src = dataURL;
                        avBox.appendChild(img);
                    }, true);
                } catch (e) {}
            }
            var nameSpan = document.createElement('span');
            nameSpan.className = 'flrsb-cowriter-item-name';
            nameSpan.textContent = cw.name;
            item.appendChild(avBox);
            item.appendChild(nameSpan);
            item.addEventListener('click', function () { selectCowriter(cw.name, cw.avatar); });
            cowriterListEl.appendChild(item);
        });
    }

    function selectCowriter(name, avatarData) {
        selectedCowriter = name || '';
        if (cowriterNameEl) cowriterNameEl.value = selectedCowriter;
        if (cowriterPicker) { cowriterPicker.hidden = true; cowriterPicker.style.display = 'none'; }

        if (selectedCowriter) {
            if (cowriterButton) { cowriterButton.hidden = true; cowriterButton.style.display = 'none'; }
            if (cowriterBadge) {
                cowriterBadge.hidden = false;
                cowriterBadge.style.display = 'flex';
                cowriterBadge.title = selectedCowriter + ' (click to change)';
            }
            if (cowriterBadgeAvatar) renderCowriterAvatar(avatarData, cowriterBadgeAvatar);
            if (cowriterBadgeName) cowriterBadgeName.textContent = selectedCowriter;
            if (cowriterClear) { cowriterClear.hidden = false; cowriterClear.style.display = 'flex'; }
        } else {
            if (cowriterButton) { cowriterButton.hidden = false; cowriterButton.style.display = ''; }
            if (cowriterBadge) { cowriterBadge.hidden = true; cowriterBadge.style.display = 'none'; }
            if (cowriterClear) { cowriterClear.hidden = true; cowriterClear.style.display = 'none'; }
        }
        renderPreview();
    }

    function toggleCowriterPicker(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        if (!cowriterPicker) return;
        var isHidden = cowriterPicker.hidden;
        cowriterPicker.hidden = !isHidden;
        /* Force display style as fallback in case hidden attr isn't working */
        cowriterPicker.style.display = isHidden ? 'block' : 'none';
    }

    function clearCowriter() {
        selectCowriter('', '');
    }

    /* ── Vektrax Submit + Feed ── */
    function vxTimeStr() {
        var d = new Date();
        var h = d.getHours(), m = d.getMinutes();
        return (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
    }

    function vxAddMessage(text, cls) {
        if (!vxFeedMessages) return;
        var el = document.createElement('div');
        el.className = 'flrsb-vx-msg' + (cls ? ' ' + cls : '');
        var timeSpan = document.createElement('span');
        timeSpan.className = 'flrsb-vx-msg-time';
        timeSpan.textContent = vxTimeStr();
        el.appendChild(timeSpan);
        el.appendChild(document.createTextNode(text));
        vxFeedMessages.appendChild(el);
        vxFeedMessages.scrollTop = vxFeedMessages.scrollHeight;
    }

    function vxSetStatus(text, cls) {
        if (!vxFeedStatus) return;
        vxFeedStatus.textContent = text;
        vxFeedStatus.className = 'flrsb-vx-feed-status' + (cls ? ' ' + cls : '');
    }

    function vxStartListening() {
        if (vxEventSource) { try { vxEventSource.close(); } catch(_e) {} }
        vxEventSource = null;
        try {
            vxEventSource = new EventSource('./api/events.ssjs?subscribe=chat&channel=main');
            vxSetStatus('listening\u2026', 'is-live');
            vxEventSource.addEventListener('chat', function (evt) {
                try {
                    var payload = JSON.parse(evt.data);
                    if (payload.type !== 'message') return;
                    if (payload.sender !== 'Vektrax') return;
                    /* Only show messages that arrived after we submitted */
                    if (payload.timestamp && payload.timestamp < vxSubmitTime) return;
                    var text = payload.text || '';
                    var cls = '';
                    if (text.toLowerCase().indexOf('song complete') >= 0 || text.toLowerCase().indexOf('uploaded') >= 0) cls = 'is-success';
                    if (text.toLowerCase().indexOf('busy') >= 0 || text.toLowerCase().indexOf('error') >= 0 || text.toLowerCase().indexOf('cannot') >= 0) cls = 'is-error';
                    vxAddMessage(text, cls);
                    /* Auto-detect successful upload */
                    if (text.indexOf('uploaded to ORIGINALCONTENT_MP3S') >= 0) {
                        handleVxSuccess(text);
                    }
                } catch (_pe) {}
            });
            vxEventSource.addEventListener('error', function () {
                vxSetStatus('reconnecting\u2026', 'is-error');
            });
        } catch (_sse) {
            vxSetStatus('stream unavailable', 'is-error');
        }
    }

    function vxStopListening() {
        if (vxEventSource) { try { vxEventSource.close(); } catch(_e) {} }
        vxEventSource = null;
    }

    function collapseAllSections() {
        var details = panel.querySelectorAll('details.flrsb-collapsible');
        Array.prototype.slice.call(details).forEach(function (d) { d.removeAttribute('open'); });
    }

    function handleVxSuccess(text) {
        vxStopListening();
        vxSetStatus('complete!', 'is-live');
        setSubmitPhase('idle');
        var banner = document.createElement('div');
        banner.className = 'flrsb-success-banner';
        var linkMatch = text.match(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/);
        if (linkMatch) {
            var a = document.createElement('a');
            a.href = linkMatch[2];
            a.target = '_blank';
            a.textContent = linkMatch[1];
            banner.appendChild(document.createTextNode('\u2705 '));
            banner.appendChild(a);
            banner.appendChild(document.createTextNode(' \u2014 Song uploaded!'));
        } else {
            banner.textContent = '\u2705 Song uploaded to ORIGINALCONTENT_MP3S!';
        }
        if (vxFeedTop) {
            vxFeedTop.insertBefore(banner, vxFeedTop.firstChild);
        }
        setTimeout(function () {
            resetForm();
            setPreviewOpen(false);
            if (vxFeedTop) vxFeedTop.hidden = false;
        }, 1500);
    }

    function isPromptEmpty() {
        /* Check if every meaningful field is blank/default */
        var title = trimValue(byId('flrsb-song-title').value);
        var style = buildStylePrompt();
        var lyrics = buildLyricsPrompt();
        var lang = trimValue(byId('flrsb-language-select').value);
        var tempo = getTempoLabel();
        var key = trimValue(byId('flrsb-key-select').value);
        var timeSig = trimValue(byId('flrsb-timesig-select').value);
        var dur = trimValue(byId('flrsb-duration-value').value);
        return !title && !style && !lyrics && !lang && !tempo && !key && !timeSig && !dur;
    }

    function setSubmitPhase(phase) {
        submitPhase = phase;
        if (!submitButton) return;
        submitButton.classList.remove('is-confirm', 'is-sending', 'is-empty');
        switch (phase) {
            case 'idle':
                if (submitLabel) submitLabel.textContent = 'Preview';
                submitButton.querySelector('.flrsb-submit-icon').textContent = '\u25B6';
                break;
            case 'confirm':
                submitButton.classList.add('is-confirm');
                if (submitLabel) submitLabel.textContent = 'Confirm';
                submitButton.querySelector('.flrsb-submit-icon').textContent = '\u2714';
                break;
            case 'sending':
                submitButton.classList.add('is-sending');
                if (submitLabel) submitLabel.textContent = 'Sending';
                submitButton.querySelector('.flrsb-submit-icon').textContent = '\u23F3';
                break;
        }
    }

    function handleSubmitClick() {
        /* Guard: reject if everything is blank */
        if (isPromptEmpty()) {
            if (submitButton) {
                submitButton.classList.add('is-empty');
                setTimeout(function () { submitButton.classList.remove('is-empty'); }, 600);
            }
            if (copyStatusEl) copyStatusEl.textContent = 'Nothing to submit \u2014 fill in at least one field.';
            return;
        }

        if (submitPhase === 'idle' || submitPhase === 'confirm') {
            if (submitPhase === 'idle') {
                /* Phase 1: open preview so user can verify the prompt */
                renderPreview();
                if (!previewOpen) setPreviewOpen(true);
                setSubmitPhase('confirm');
                return;
            }
            /* Phase 2: user confirmed - actually send */
            submitToVektrax();
        }
    }

    function submitToVektrax() {
        var prompt = buildPreview();
        if (!prompt || !prompt.trim()) return;

        /* Collapse form sections, show feed at top */
        collapseAllSections();
        setSubmitPhase('sending');

        /* Show the feed at the top */
        if (vxFeedTop) vxFeedTop.hidden = false;
        vxSubmitTime = Date.now();
        vxAddMessage('Prompt sent to Vektrax\u2026', 'is-sent');

        /* Start listening for Vektrax responses BEFORE sending */
        vxStartListening();

        /* Send the message to the main chat channel */
        var body = new URLSearchParams();
        body.set('action', 'send');
        body.set('channel', 'main');
        body.set('message', prompt);

        fetch('./api/chat.ssjs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        }).then(function (res) {
            return res.json();
        }).then(function (data) {
            if (data && data.error) {
                vxAddMessage('Send failed: ' + data.error, 'is-error');
                vxSetStatus('send error', 'is-error');
                setSubmitPhase('idle');
            } else {
                vxSetStatus('awaiting Vektrax\u2026', 'is-live');
            }
        }).catch(function (err) {
            vxAddMessage('Network error: ' + (err.message || err), 'is-error');
            vxSetStatus('send failed', 'is-error');
            setSubmitPhase('idle');
        });
    }

    function resetForm() {
        /* Clear all form inputs but preserve structure */
        var inputs = panel.querySelectorAll('input[type="text"], input[type="number"], textarea, select');
        Array.prototype.slice.call(inputs).forEach(function (el) {
            if (el.id === 'flrsb-preview' || el.id === 'flrsb-memory-mode' || el.id === 'flrsb-cowriter-name') return;
            if (el.tagName === 'SELECT') {
                el.selectedIndex = 0;
            } else {
                el.value = '';
            }
        });
        /* Reset custom text inputs */
        var customs = panel.querySelectorAll('input[type="text"][hidden]');
        Array.prototype.slice.call(customs).forEach(function (el) { el.value = ''; });
        /* Reset memory mode */
        memoryActive = false;
        if (memoryInput) memoryInput.value = 'off';
        if (memoryToggle) memoryToggle.classList.remove('is-active');
        if (memoryLabel) memoryLabel.textContent = 'Blank Slate';
        /* Reset co-writer */
        if (typeof clearCowriter === 'function') clearCowriter();
        /* Clear feed */
        vxStopListening();
        if (vxFeedTop) {
            var banners = vxFeedTop.querySelectorAll('.flrsb-success-banner');
            Array.prototype.slice.call(banners).forEach(function (b) { b.parentNode.removeChild(b); });
            vxFeedTop.hidden = true;
        }
        if (vxFeedMessages) vxFeedMessages.innerHTML = '';
        /* Reset submit phase */
        setSubmitPhase('idle');
        /* Hide preview */
        setPreviewOpen(false);
        /* Reset lyric mode */
        setLyricMode('freeform');
        /* Sync presets */
        hybridPresetFields.forEach(function (name) { syncPresetField(name, false); });
        syncTempoState();
        renderPreview();
    }

    function toggleMemoryMode(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        memoryActive = !memoryActive;
        if (memoryInput) memoryInput.value = memoryActive ? 'on' : 'off';
        if (memoryToggle) memoryToggle.classList.toggle('is-active', memoryActive);
        if (memoryLabel) memoryLabel.textContent = memoryActive ? 'Memory' : 'Blank Slate';
        if (memoryToggle) memoryToggle.title = memoryActive
            ? 'Memory Mode ON: the generator weaves its learned experience into the song. Click to switch to Blank Slate.'
            : 'Memory Mode OFF: the generator creates from a blank slate. Click to activate Memory Mode.';
        renderPreview();
    }

        function shuffleBandType() {
        hybridPresetFields.forEach(function (name) {
            if (!presetOptions[name] || !presetOptions[name].length) return;
            setHybridPresetValue(name, pickRandom(presetOptions[name]));
        });
        renderPreview();
    }

    function setPreviewOpen(nextOpen) {
        previewOpen = !!nextOpen;
        if (previewCol) previewCol.hidden = !previewOpen;
        if (layoutEl) layoutEl.classList.toggle('is-preview-open', previewOpen);
        /* When closing, revert submit button to pre-preview idle state */
        if (!previewOpen && submitPhase === 'confirm') {
            setSubmitPhase('idle');
        }
    }

    function renderPreview() {
        previewEl.value = buildPreview();
        copyStatusEl.textContent = 'Preview updates as you type.';
    }

    function copyPreview() {
        var value = previewEl.value;

        clearTimeout(copyTimer);

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(value)
                .then(function () {
                    copyStatusEl.textContent = 'Preview copied.';
                    copyTimer = setTimeout(function () {
                        copyStatusEl.textContent = 'Preview updates as you type.';
                    }, 1800);
                })
                .catch(function (error) {
                    console.error('[records-builder] clipboard failed:', error);
                    window.prompt('Copy this preview:', value);
                    copyStatusEl.textContent = 'Preview ready to copy.';
                });
            return;
        }

        window.prompt('Copy this preview:', value);
        copyStatusEl.textContent = 'Preview ready to copy.';
    }

    populateSelect(byId('flrsb-genre-select'), presetOptions.genre, true, true, 'Unspecified / let Vektrax decide');
    populateSelect(byId('flrsb-feel-select'), presetOptions.feel, true, true, 'Unspecified / let Vektrax decide');
    populateSelect(byId('flrsb-tone-select'), presetOptions.tone, true, true, 'Unspecified / let Vektrax decide');
    populateSelect(byId('flrsb-arrangement-select'), presetOptions.arrangement, true, true, 'Unspecified / let Vektrax decide');
    populateSelect(byId('flrsb-instrumentation-select'), presetOptions.instrumentation, true, true, 'Unspecified / let Vektrax decide');
    populateSelect(byId('flrsb-groove-select'), presetOptions.groove, true, true, 'Unspecified / let Vektrax decide');
    populateSelect(byId('flrsb-band-select'), presetOptions.band, true, true, 'Unspecified / let Vektrax decide');
    populateSelect(byId('flrsb-leadvocal-select'), presetOptions.leadvocal, true, true, 'Unspecified / let Vektrax decide');
    populateSelect(byId('flrsb-backingvocal-select'), presetOptions.backingvocal, true, true, 'Unspecified / let Vektrax decide');
    populateSelect(byId('flrsb-language-select'), presetOptions.language, false, true, 'Unspecified / auto');
    populateSelect(byId('flrsb-key-select'), presetOptions.key, false, true, 'Unspecified / auto');
    populateSelect(byId('flrsb-timesig-select'), presetOptions.timesig, false, true, 'Unspecified / auto');
    populateSelect(byId('flrsb-bpm-mode'), presetOptions.bpmMode, false, true, 'Unspecified / auto');

    hybridPresetFields.forEach(function (name) {
        var controls = getPresetControls(name);
        if (!controls.select || !controls.custom) return;

        controls.select.addEventListener('change', function () {
            syncPresetField(name, controls.select.value === CUSTOM_OPTION_VALUE);
            renderPreview();
        });

        controls.custom.addEventListener('input', function () {
            if (controls.select.value !== CUSTOM_OPTION_VALUE) {
                controls.select.value = CUSTOM_OPTION_VALUE;
            }
            syncPresetField(name, false);
            renderPreview();
        });

        controls.custom.addEventListener('change', function () {
            syncPresetField(name, false);
            renderPreview();
        });

        syncPresetField(name, false);
    });

    Array.prototype.slice.call(panel.querySelectorAll('input, select, textarea')).forEach(function (el) {
        if (el.id === 'flrsb-preview') return;
        el.addEventListener('input', function () {
            syncTempoState();
            renderPreview();
        });
        el.addEventListener('change', function () {
            syncTempoState();
            renderPreview();
        });
    });

    modeButtons.forEach(function (button) {
        button.addEventListener('click', function () {
            setLyricMode(button.getAttribute('data-lyric-mode'));
        });
    });

    /* previewToggle removed - submit button now in header */

    if (shuffleButton) {
        shuffleButton.addEventListener('click', shuffleBandType);
    }

    if (memoryToggle) {
        memoryToggle.addEventListener('click', toggleMemoryMode);
    }

    if (submitButton) {
        submitButton.addEventListener('click', handleSubmitClick);
    }
    if (resetButton) {
        resetButton.addEventListener('click', function () {
            if (confirm('Clear the entire form and start a new song?')) resetForm();
        });
    }

    /* Co-writer picker */
    buildCowriterList();
    if (cowriterButton) {
        cowriterButton.addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            toggleCowriterPicker(e);
        });
    }
    if (cowriterBadge) {
        cowriterBadge.addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            toggleCowriterPicker(e);
        });
    }
    if (cowriterClear) {
        cowriterClear.addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            clearCowriter();
        });
    }
    document.addEventListener('click', function (e) {
        if (cowriterPicker && !cowriterPicker.hidden) {
            var summaryEl = cowriterPicker.closest('summary');
            if (!summaryEl || !summaryEl.contains(e.target)) {
                cowriterPicker.hidden = true;
                cowriterPicker.style.display = 'none';
            }
        }
    });
    if (!COWRITER_LIST || !COWRITER_LIST.length) {
        if (cowriterButton) { cowriterButton.hidden = true; cowriterButton.style.display = 'none'; }
    }

    if (copyButton) {
        copyButton.addEventListener('click', copyPreview);
    }

    /* Revert to 'idle' phase when any form input changes after preview */
    panel.addEventListener('input', function () {
        if (submitPhase === 'confirm') setSubmitPhase('idle');
    });
    panel.addEventListener('change', function () {
        if (submitPhase === 'confirm') setSubmitPhase('idle');
    });

    syncTempoState();
    setPreviewOpen(false);
    setLyricMode('freeform');
    /* Close-preview button */
    if (closePreviewBtn) closePreviewBtn.addEventListener('click', function () {
        setPreviewOpen(false);
    });
})();
</script>
