            'Industrial Pop',
            'Industrial Metal',
            'Post-Punk',
            'Punkfuture',
            'Metal Future',
            'Ska',
            'Funk',
            'Boogie',
            'Jazz Fusion',
            'Ambient Techno',
            'Chiptune',
            'Eurodance',
            'Experimental Pop',
            'K-Pop Futurism'
        ],
        feel: [
            'euphoric and driving',
            'warm and intimate',
            'swaggering and playful',
            'melancholy but resilient',
            'hypnotic and nocturnal',
            'tense and cinematic',
