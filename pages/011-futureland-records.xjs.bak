                                    <span>Key Signature</span>
                                    <select id="flrsb-key-select"></select>
                                </label>
                                <label class="flrsb-field" for="flrsb-timesig-select">
                                    <span>Time Signature</span>
                                    <select id="flrsb-timesig-select"></select>
                                </label>
                                <label class="flrsb-field" for="flrsb-bpm-mode">
                                    <span>BPM Strategy</span>
                                    <select id="flrsb-bpm-mode"></select>
                                </label>
                                <label class="flrsb-field" for="flrsb-bpm-value">
                                    <span>Custom BPM</span>
                                    <input type="number" id="flrsb-bpm-value" min="40" max="260" step="1" placeholder="128">
                                    <div class="flrsb-help">Only used when BPM Strategy is set to Custom numeric.</div>
                                </label>
                                <label class="flrsb-field" for="flrsb-duration-value">
                                    <span>Duration (Seconds)</span>
                                    <input type="number" id="flrsb-duration-value" min="15" max="1200" step="1" placeholder="142">
                                    <div class="flrsb-help">Optional explicit target duration for the generated song.</div>
                                </label>
                            </div>
                        </section>

                        <section class="flrsb-group">
                            <div class="flrsb-group-head">
                                <h3 class="flrsb-group-title">Lyric Prompt</h3>
                                <div class="flrsb-group-copy">Stay in a single freeform prompt by default, or switch to guided sections when you want more structure and per-section instrumentation notes.</div>
                            </div>
                            <div class="flrsb-mode-row" role="tablist" aria-label="Lyric builder mode">
                                <button type="button" class="flrsb-mode-button is-active" data-lyric-mode="freeform">Freeform Prompt</button>
                                <button type="button" class="flrsb-mode-button" data-lyric-mode="guided">Guided Sections</button>
                            </div>
                            <div class="flrsb-mode-panel" id="flrsb-freeform-panel">
                                <label class="flrsb-field" for="flrsb-lyrics-freeform">
                                    <span>Full Lyric / Song Layout Prompt</span>
                                    <textarea id="flrsb-lyrics-freeform" placeholder="[Intro - Guitar Riff & Drums]&#10;Set the scene...&#10;&#10;[Verse 1]&#10;..."></textarea>
                                </label>
                            </div>
                            <div class="flrsb-mode-panel" id="flrsb-guided-panel" hidden>
                                <div class="flrsb-section-grid">
                                    <div class="flrsb-section-card">
                                        <div class="flrsb-section-label">Intro</div>
                                        <label class="flrsb-field" for="flrsb-section-intro-notes">
                                            <span>Instrumentation / Section Note</span>
                                            <input type="text" id="flrsb-section-intro-notes" placeholder="Filtered pads, guitar motif, distant ad-libs">
                                        </label>
                                        <label class="flrsb-field" for="flrsb-section-intro-text">
                                            <span>Intro Text</span>
                                            <textarea id="flrsb-section-intro-text" placeholder="Open the world of the song."></textarea>
                                        </label>
                                    </div>
                                    <div class="flrsb-section-card">
                                        <div class="flrsb-section-label">Verse 1</div>
                                        <label class="flrsb-field" for="flrsb-section-verse1-notes">
                                            <span>Instrumentation / Section Note</span>
                                            <input type="text" id="flrsb-section-verse1-notes" placeholder="Tight drums, bass pocket, restrained synth stabs">
                                        </label>
                                        <label class="flrsb-field" for="flrsb-section-verse1-text">
                                            <span>Verse 1 Text</span>
                                            <textarea id="flrsb-section-verse1-text" placeholder="Start the story."></textarea>
                                        </label>
                                    </div>
                                    <div class="flrsb-section-card">
                                        <div class="flrsb-section-label">Chorus</div>
                                        <label class="flrsb-field" for="flrsb-section-chorus-notes">
                                            <span>Instrumentation / Section Note</span>
                                            <input type="text" id="flrsb-section-chorus-notes" placeholder="Wider drums, stacked harmonies, hook doubles">
                                        </label>
                                        <label class="flrsb-field" for="flrsb-section-chorus-text">
                                            <span>Chorus Text</span>
                                            <textarea id="flrsb-section-chorus-text" placeholder="Write the main hook."></textarea>
                                        </label>
                                    </div>
                                    <div class="flrsb-section-card">
                                        <div class="flrsb-section-label">Verse 2</div>
                                        <label class="flrsb-field" for="flrsb-section-verse2-notes">
                                            <span>Instrumentation / Section Note</span>
                                            <input type="text" id="flrsb-section-verse2-notes" placeholder="More movement, secondary counter-melody">
                                        </label>
                                        <label class="flrsb-field" for="flrsb-section-verse2-text">
                                            <span>Verse 2 Text</span>
                                            <textarea id="flrsb-section-verse2-text" placeholder="Push the story forward."></textarea>
                                        </label>
                                    </div>
                                    <div class="flrsb-section-card">
                                        <div class="flrsb-section-label">Bridge</div>
                                        <label class="flrsb-field" for="flrsb-section-bridge-notes">
                                            <span>Instrumentation / Section Note</span>
                                            <input type="text" id="flrsb-section-bridge-notes" placeholder="Drop drums, shift harmony, spotlight one instrument">
                                        </label>
                                        <label class="flrsb-field" for="flrsb-section-bridge-text">
                                            <span>Bridge Text</span>
                                            <textarea id="flrsb-section-bridge-text" placeholder="Optional contrast section."></textarea>
                                        </label>
                                    </div>
                                    <div class="flrsb-section-card">
                                        <div class="flrsb-section-label">Outro</div>
                                        <label class="flrsb-field" for="flrsb-section-outro-notes">
                                            <span>Instrumentation / Section Note</span>
                                            <input type="text" id="flrsb-section-outro-notes" placeholder="Strip back to motif, long reverb tail, final ad-lib">
                                        </label>
                                        <label class="flrsb-field" for="flrsb-section-outro-text">
                                            <span>Outro Text</span>
                                            <textarea id="flrsb-section-outro-text" placeholder="How the song lands and leaves."></textarea>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>

                <aside class="flrsb-preview-col" id="flrsb-preview-col" hidden>
                    <section class="flrsb-group flrsb-preview-group">
                        <div class="flrsb-preview-head">
                            <div class="flrsb-group-head">
                                <h3 class="flrsb-group-title">Vektrax Payload Preview</h3>
                                <div class="flrsb-group-copy">This mirrors the two-prompt flow: style / arrangement first, lyric prompt second, with explicit settings called out underneath.</div>
                            </div>
                            <button type="button" class="flrsb-copy-button" id="flrsb-copy-button">Copy Preview</button>
                        </div>
                        <textarea readonly class="flrsb-preview" id="flrsb-preview"></textarea>
                        <div class="flrsb-copy-status" id="flrsb-copy-status">Preview updates as you type.</div>
                    </section>
                </aside>
            </div>
        </div>
    </div>
    <?xjs } ?>
</div>

<script>
(function () {
    'use strict';

    var PAGE_FILE = '011-futureland-records.xjs';
    var API_URL = './api/files.ssjs?call=list-files&dir=originalcontent_mp3s';
    var STREAM_URL = './radio-stream/';
    var RANGE_BYTES = 262144;
    var REQUESTED_TRACK = <?xjs write(_records_track_json); ?>;

    var panel = document.getElementById('flrd-panel');
    if (!panel || panel.dataset.bound === '1') return;
    panel.dataset.bound = '1';

    var loadingEl = document.getElementById('flrd-loading');
    var emptyEl = document.getElementById('flrd-empty');
    var layoutEl = document.getElementById('flrd-layout');
    var titleEl = document.getElementById('flrd-title');
    var creditsEl = document.getElementById('flrd-credits');
    var albumlineEl = document.getElementById('flrd-albumline');
    var genreLineEl = document.getElementById('flrd-genre-line');
    var filelineEl = document.getElementById('flrd-fileline');
    var statusEl = document.getElementById('flrd-status');
    var counterEl = document.getElementById('flrd-counter');
    var prevButton = document.getElementById('flrd-prev');
    var nextButton = document.getElementById('flrd-next');
    var shareButton = document.getElementById('flrd-share');
    var trackSelect = document.getElementById('flrd-track-select');
    var playButton = document.getElementById('flrd-play-button');
    var artWrap = document.getElementById('flrd-art-wrap');
    var artImg = document.getElementById('flrd-art');
    var noArtEl = document.getElementById('flrd-no-art');
    var shareResetTimer = 0;
    var tracks = [];
    var cur = 0;
    var nowPlaying = (window.sbbsRadio && window.sbbsRadio.currentTrackFile) || '';

    function esc(value) {
        return String(value === undefined || value === null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function filenameTitle(name) {
        return String(name || '')
            .replace(/\.mp3$/i, '')
            .replace(/_/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
    }

    function trackTitle(track) {
        return String((track.tags && track.tags.title) || filenameTitle(track.name) || 'Unknown Track');
    }

    function trackArtist(track) {
        return String((track.tags && track.tags.artist) || '');
    }

    function trackComposer(track) {
        return String((track.tags && track.tags.composer) || '');
    }

    function trackAlbum(track) {
        return String((track.tags && track.tags.album) || '');
    }

    function trackYear(track) {
        return String((track.tags && track.tags.year) || '');
    }

    function trackGenre(track) {
        return String((track.tags && track.tags.genre) || '');
    }

    function optionLabel(track) {
        var artist = trackArtist(track);
        return artist.length ? (trackTitle(track) + ' - ' + artist) : trackTitle(track);
    }

    function setLoading(loading) {
        if (loading) {
            loadingEl.hidden = false;
            emptyEl.hidden = true;
            layoutEl.classList.add('is-hidden');
        } else {
            loadingEl.hidden = true;
        }

        [prevButton, nextButton, shareButton, trackSelect, playButton, artWrap].forEach(function (el) {
            if (!el) return;
            if (loading) {
                el.setAttribute('disabled', 'disabled');
            } else {
                el.removeAttribute('disabled');
            }
        });
    }

    function setEmpty(message) {
        loadingEl.hidden = true;
        layoutEl.classList.add('is-hidden');
        emptyEl.hidden = false;
        emptyEl.textContent = message;
        counterEl.textContent = '0 / 0';
        statusEl.textContent = '';
        document.title = 'Futureland Records';
        [prevButton, nextButton, shareButton, trackSelect, playButton, artWrap].forEach(function (el) {
            if (!el) return;
            el.setAttribute('disabled', 'disabled');
        });
    }

    function parseTrackList(list) {
        return Promise.all(list.map(function (item) {
            var url = STREAM_URL + encodeURIComponent(item.name);
            return fetch(url, {
                headers: { Range: 'bytes=0-' + (RANGE_BYTES - 1) }
            })
                .then(function (response) { return response.arrayBuffer(); })
                .then(function (buf) {
                    var tags = {};
                    var artURL = '';

                    if (typeof window.parseID3v2 === 'function') {
                        try {
                            tags = window.parseID3v2(buf) || {};
                        } catch (_) {
                            tags = {};
                        }
                    }

                    if (tags.picture && tags.picture.blob) {
                        artURL = URL.createObjectURL(tags.picture.blob);
                    }

                    return {
                        name: item.name,
                        desc: item.desc || '',
                        added: item.added || 0,
                        tags: tags,
                        artURL: artURL
                    };
                })
                .catch(function () {
                    return {
                        name: item.name,
                        desc: item.desc || '',
                        added: item.added || 0,
                        tags: {},
                        artURL: ''
                    };
                });
        }));
    }

    function findTrackIndex(name) {
        var lower = String(name || '').toLowerCase();
        var idx = -1;

        tracks.forEach(function (track, index) {
            if (String(track.name).toLowerCase() === lower) idx = index;
        });

        return idx;
    }

    function chooseInitialTrack() {
        var idx = -1;

        if (REQUESTED_TRACK) {
            idx = findTrackIndex(REQUESTED_TRACK);
        }

        if (idx < 0 && nowPlaying) {
            idx = findTrackIndex(nowPlaying);
        }

        cur = idx >= 0 ? idx : 0;
    }

    function fillTrackSelect() {
        trackSelect.innerHTML = '';

        tracks.forEach(function (track) {
            var option = document.createElement('option');
            option.value = track.name;
            option.textContent = optionLabel(track);
            if (track.name === tracks[cur].name) option.selected = true;
            trackSelect.appendChild(option);
        });
    }

    function buildUrl(track) {
        var next = new URL(window.location.href);
        next.searchParams.set('page', PAGE_FILE);
        next.searchParams.delete('gallery');
        next.searchParams.delete('dir');
        next.searchParams.delete('file');

        if (track && track.name) {
            next.searchParams.set('track', track.name);
        } else {
            next.searchParams.delete('track');
        }

        return next;
    }

    function syncUrl(track) {
        var next;

        if (!window.history || !window.history.replaceState) return;
        next = buildUrl(track);
        window.history.replaceState({ track: track && track.name ? track.name : '' }, '', next.toString());
    }

    function flashShareState(label) {
        clearTimeout(shareResetTimer);
        shareButton.textContent = label;
        shareResetTimer = setTimeout(function () {
            shareButton.textContent = 'Share';
        }, 1600);
    }

    function renderCredits(track) {
        var artist = trackArtist(track);
        var composer = trackComposer(track);
        var html = '';

        if (artist) {
            html += '<span class="flrd-artist-name">' + esc(artist) + '</span>';
        }
        if (artist && composer) {
            html += '<span class="flrd-credit-sep">and</span>';
        }
        if (composer) {
            html += '<span class="flrd-composer-name">' + esc(composer) + '</span>';
        }

        creditsEl.innerHTML = html || '<span class="flrd-credit-sep">Unknown artist</span>';
    }

    function renderAlbumline(track) {
        var album = trackAlbum(track);
        var year = trackYear(track);
        var html = '';

        if (album) {
            html += '<span class="flrd-album-name">' + esc(album) + '</span>';
            if (year) html += '<span class="flrd-album-year"> (' + esc(year) + ')</span>';
        } else if (year) {
            html += '<span class="flrd-album-year">' + esc(year) + '</span>';
        }

        albumlineEl.innerHTML = html || '<span class="flrd-credit-sep">No album metadata</span>';
    }

    function renderGenreline(track) {
        var genre = trackGenre(track);
        genreLineEl.innerHTML = genre.length
            ? ('<span class="flrd-genre">' + esc(genre) + '</span>')
            : '<span class="flrd-credit-sep">No genre metadata</span>';
    }

    function renderArt(track) {
        if (track.artURL) {
            artImg.src = track.artURL;
            artImg.alt = trackTitle(track) + ' album art';
            artImg.hidden = false;
            noArtEl.hidden = true;
            return;
        }

        artImg.removeAttribute('src');
        artImg.alt = '';
        artImg.hidden = true;
        noArtEl.hidden = false;
    }

    function renderPlayState(track) {
        var isPlaying = nowPlaying === track.name;
        playButton.disabled = isPlaying;
        playButton.classList.toggle('is-playing', isPlaying);
        playButton.innerHTML = isPlaying
            ? '♫ Now Playing'
            : '<span class="flrd-play-icon">▶</span> Play This Track';
    }

    function render() {
        var track;

        if (!tracks.length) return;

        track = tracks[cur];
        loadingEl.hidden = true;
        emptyEl.hidden = true;
        layoutEl.classList.remove('is-hidden');
        counterEl.textContent = (cur + 1) + ' / ' + tracks.length;
        titleEl.textContent = trackTitle(track);
        renderCredits(track);
        renderAlbumline(track);
        renderGenreline(track);
        filelineEl.textContent = track.name;
        statusEl.textContent = 'Track ' + (cur + 1) + ' of ' + tracks.length;
        fillTrackSelect();
        renderArt(track);
        syncUrl(track);
        document.title = trackTitle(track) + ' | Futureland Records';
        [prevButton, nextButton, shareButton, trackSelect, artWrap].forEach(function (el) {
            if (!el) return;
            el.removeAttribute('disabled');
        });
        renderPlayState(track);
    }

    function playSelectedTrack() {
        var track = tracks[cur];
        if (!track || track.name === nowPlaying) return;

        document.dispatchEvent(new CustomEvent('viz:picktrack', {
            detail: { name: track.name }
        }));
        document.dispatchEvent(new CustomEvent('viz:open'));
        nowPlaying = track.name;
        render();
    }

    function go(dir) {
        if (!tracks.length) return;
        cur = ((cur + dir) % tracks.length + tracks.length) % tracks.length;
        render();
    }

    function shareCurrent() {
        var url;
        var track;

        if (!tracks.length) return;
        track = tracks[cur];
        url = buildUrl(track).toString();

        if (navigator.share) {
            navigator.share({
                title: document.title || 'Futureland Records',
                url: url
            })
                .then(function () {
                    flashShareState('Shared');
                })
                .catch(function (error) {
                    if (error && error.name === 'AbortError') return;
                    console.error('[records] share failed:', error);
                    flashShareState('Error');
                });
            return;
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url)
                .then(function () {
                    flashShareState('Copied');
                })
                .catch(function (error) {
                    console.error('[records] clipboard failed:', error);
                    window.prompt('Copy this link:', url);
                    flashShareState('Ready');
                });
            return;
        }

        window.prompt('Copy this link:', url);
        flashShareState('Ready');
    }

    prevButton.addEventListener('click', function () {
        go(-1);
    });

    nextButton.addEventListener('click', function () {
        go(1);
    });

    shareButton.addEventListener('click', shareCurrent);
    playButton.addEventListener('click', playSelectedTrack);
    artWrap.addEventListener('click', playSelectedTrack);

    trackSelect.addEventListener('change', function () {
        var nextIndex = findTrackIndex(trackSelect.value);
        if (nextIndex < 0) return;
        cur = nextIndex;
        render();
    });

    document.addEventListener('radio:trackchange', function (event) {
        if (event.detail && event.detail.filename) {
            nowPlaying = event.detail.filename;
            render();
        }
    });

    setLoading(true);
    fetch(API_URL, { credentials: 'same-origin' })
        .then(function (response) { return response.json(); })
        .then(function (list) {
            if (!list || !list.length) {
                setEmpty('No tracks available.');
                return null;
            }
            return parseTrackList(list);
        })
        .then(function (parsed) {
            if (!parsed) return;

            tracks = parsed.filter(function (track) {
                return !!track && !!track.name;
            });

            if (!tracks.length) {
                setEmpty('No tracks available.');
                return;
            }

            setLoading(false);
            chooseInitialTrack();
            render();
        })
        .catch(function (error) {
            console.error('[records] init failed:', error);
            setEmpty('Unable to load tracks.');
        });
})();

(function () {
    'use strict';

    var panel = document.getElementById('flrsb-panel');
    if (!panel || panel.dataset.bound === '1') return;
    panel.dataset.bound = '1';

    var copyButton = document.getElementById('flrsb-copy-button');
    var previewEl = document.getElementById('flrsb-preview');
    var copyStatusEl = document.getElementById('flrsb-copy-status');
    var headStatusEl = document.getElementById('flrsb-head-status');
    var previewToggle = document.getElementById('flrsb-preview-toggle');
    var shuffleButton = document.getElementById('flrsb-shuffle-button');
    var previewCol = document.getElementById('flrsb-preview-col');
    var bpmModeEl = document.getElementById('flrsb-bpm-mode');
    var bpmValueEl = document.getElementById('flrsb-bpm-value');
    var freeformPanel = document.getElementById('flrsb-freeform-panel');
    var guidedPanel = document.getElementById('flrsb-guided-panel');
    var layoutEl = panel.querySelector('.flrsb-layout');
    var modeButtons = Array.prototype.slice.call(panel.querySelectorAll('[data-lyric-mode]'));
    var hybridPresetFields = ['genre', 'feel', 'tone', 'arrangement', 'instrumentation', 'groove', 'band', 'leadvocal', 'backingvocal'];
    var CUSTOM_OPTION_VALUE = '__custom__';
    var UNSPECIFIED_OPTION_VALUE = '';
    var lyricMode = 'freeform';
    var previewOpen = false;
    var copyTimer = 0;
    var sectionDefs = [
        { key: 'intro', label: 'Intro' },
        { key: 'verse1', label: 'Verse 1' },
        { key: 'chorus', label: 'Chorus' },
        { key: 'verse2', label: 'Verse 2' },
        { key: 'bridge', label: 'Bridge' },
        { key: 'outro', label: 'Outro' }
    ];
    var presetOptions = {
        genre: [
            'Futurepop / Synthpop',
