    function _recordsQueryValue(name) {
        return (
            typeof http_request.query[name] !== 'undefined' &&
            http_request.query[name].length
        ) ? String(http_request.query[name][0]) : '';
    }

    var _records_track = _recordsQueryValue('track');
    var _records_track_json = JSON.stringify(_records_track).replace(/<\//g, '<\\/');
