        var _sc = sub.scan_cfg || 0;
        var _scNew = (_sc & SCAN_CFG_NEW) && !(_sc & SCAN_CFG_YONLY);
        var _scYou = !!(_sc & SCAN_CFG_YONLY);
        var _scOff = !_scNew && !_scYou;
    ?>
    <div class="pull-right">
        <button id="scan-cfg-new" class="btn <? write(_scNew ? 'btn-primary' : 'btn-default'); ?> icon" aria-label="<? locale.write('button_scan_new'); ?>" title="<? locale.write('button_scan_new'); ?>" onclick="setScanCfg('<? write(sub.code); ?>', 1)">
            <span class="bin-icon" data-icon="heart"></span>
        </button>
        <button id="scan-cfg-youonly" class="btn <? write(_scYou ? 'btn-primary' : 'btn-default'); ?> icon" aria-label="<? locale.write('button_scan_you'); ?>" title="<? locale.write('button_scan_you'); ?>" onclick="setScanCfg('<? write(sub.code); ?>', 2)">
            <span class="bin-icon" data-icon="at_symbol"></span>
        </button>
        <button id="scan-cfg-off" class="btn <? write(_scOff ? 'btn-primary' : 'btn-default'); ?> icon" aria-label="<? locale.write('button_scan_off'); ?>" title="<? locale.write('button_scan_off'); ?>" onclick="setScanCfg('<? write(sub.code); ?>', 0)">
            <span class="bin-icon" data-icon="stop"></span>
