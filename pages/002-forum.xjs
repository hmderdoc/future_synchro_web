<?xjs
    var _searchScope = 'forum';
    var _searchGroup = '';
    var _searchSub = '';
    var _searchQuery = request.has_param('q') ? request.get_param('q') : '';
    var _searchSort = request.has_param('sort') ? request.get_param('sort') : '';
    var _searchDir = request.has_param('dir') ? request.get_param('dir') : '';
    var _forumCrumbTitle = 'Forums';
    if (request.has_param('sub') && msg_area.sub[request.get_param('sub')] !== undefined) {
        if (!request.has_param('thread')) {
            _searchScope = 'sub';
            _searchSub = request.get_param('sub');
            _searchGroup = String(msg_area.sub[request.get_param('sub')].grp_index);
        }
    } else if (request.has_param('group') && msg_area.grp_list[request.get_param('group')] !== undefined) {
        _searchScope = 'group';
        _searchGroup = request.get_param('group');
    }
?>

