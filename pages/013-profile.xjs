<!--HIDDEN:Profile-->
<?xjs
    /* 013-profile.xjs - a member's profile page (?user=<alias|number>, default: you)
     *
     * Two-column layout in the spirit of the classic social-network profile:
     * the left column is the person (avatar, mood, details, contact, song,
     * creations), the right column is what they and their friends wrote
     * (updates, About Me from their wiki page, friends, wall). Every action
     * goes through root/api/social.ssjs, which shares its store with the
     * terminal shell. Theme presets + per-user colours come from the profile.
     */
    load('sbbsdefs.js');
    load(system.mods_dir + 'load/social_lib.js');
    var request = require({}, settings.web_lib + 'request.js', 'request');

    var WIKI_DIR = '/sbbs/xtrn/wiki/';
    var wikiCore = null;
    var embedRenderer = undefined;
    try { load(WIKI_DIR + 'dist/wiki-core.js'); wikiCore = WikiCore; } catch (_wikiLoadError) { wikiCore = null; }
    try { load(settings.web_lib + 'wiki-embeds.js'); embedRenderer = WikiEmbeds.renderer(settings); } catch (_embedLoadError) { embedRenderer = undefined; }

    function esc(value) {
        return String(value === undefined || value === null ? '' : value)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function isGuest() { return user.number < 1 || user.alias === settings.guest; }
    var me = isGuest() ? 0 : user.number;

    /* Synchronet Ctrl-A colour codes (\x01 + letter/digit) and Mystic pipe
       codes (|00-|23) -> spans. Colours come from fixed tables, so nothing a
       member types can reach a style attribute. Same rules as oneliners.js. */
    var CGA_HEX = ['#000000', '#0000aa', '#00aa00', '#00aaaa', '#aa0000', '#aa00aa', '#aa5500', '#aaaaaa',
        '#555555', '#5555ff', '#55ff55', '#55ffff', '#ff5555', '#ff55ff', '#ffff55', '#ffffff'];
    var CTRLA_FG = { k: 0, b: 1, g: 2, c: 3, r: 4, m: 5, y: 6, w: 7 };
    var CTRLA_BG = { '0': 0, '1': 4, '2': 2, '3': 6, '4': 1, '5': 5, '6': 3, '7': 7 };
    function pipeHtml(text) {
        var src = String(text || '');
        var out = '', fg = 7, bg = -1, high = false, run = '', i = 0;
        function flush() {
            if (!run.length) return;
            var html = esc(run).replace(/\n/g, '<br>');
            var style = '';
            if (fg !== 7 || high) style += 'color:' + CGA_HEX[high ? (fg | 8) : fg] + ';';
            if (bg >= 0) style += 'background-color:' + CGA_HEX[bg] + ';';
            out += style ? '<span style="' + style + '">' + html + '</span>' : html;
            run = '';
        }
        while (i < src.length) {
            var ch = src.charAt(i);
            if (ch === '\x01' && i + 1 < src.length) {
                var code = src.charAt(i + 1), lower = code.toLowerCase();
                flush(); i += 2;
                if (lower === 'n' || code === '-' || code === '_') { fg = 7; bg = -1; high = false; }
                else if (lower === 'h') high = true;
                else if (CTRLA_FG.hasOwnProperty(lower)) fg = CTRLA_FG[lower];
                else if (CTRLA_BG.hasOwnProperty(code)) bg = CTRLA_BG[code];
                continue;
            }
            if (ch === '|' && /^[0-2][0-9]$/.test(src.substr(i + 1, 2))) {
                var pipe = parseInt(src.substr(i + 1, 2), 10);
                if (pipe <= 23) {
                    flush(); i += 3;
                    if (pipe <= 15) { fg = pipe & 7; high = !!(pipe & 8); }
                    else bg = pipe === 16 ? -1 : pipe - 16;
                    continue;
                }
            }
            run += ch; i++;
        }
        flush();
        return out;
    }

    function fmtDate(ms) {
        if (!ms) return '';
        return strftime('%b %d, %Y', Math.floor(ms / 1000));
    }
    function fmtAgo(seconds) {
        if (!seconds) return 'never';
        var delta = time() - seconds;
        if (delta < 60) return 'just now';
        if (delta < 3600) return Math.floor(delta / 60) + ' min ago';
        if (delta < 86400) return Math.floor(delta / 3600) + ' hours ago';
        if (delta < 86400 * 14) return Math.floor(delta / 86400) + ' days ago';
        return strftime('%b %d, %Y', seconds);
    }
    function fmtMinutes(minutes) {
        var m = Math.max(0, Math.floor(minutes || 0));
        if (m >= 1440) return Math.floor(m / 1440) + 'd ' + Math.floor((m % 1440) / 60) + 'h';
        if (m >= 60) return Math.floor(m / 60) + 'h ' + (m % 60) + 'm';
        return m + 'm';
    }
    function profileUrl(alias) { return './?page=013-profile.xjs&user=' + encodeURIComponent(alias); }

    /* ---- who ---- */
    var rawUser = request.has_param('user') ? String(request.get_param('user')) : '';
    var who = 0;
    if (!rawUser.length) who = me;
    else if (/^\d+$/.test(rawUser)) who = Social.account(parseInt(rawUser, 10)) ? parseInt(rawUser, 10) : 0;
    else who = Social.localUserByAlias(rawUser);
    var summary = who ? Social.summary(who, me) : null;
    var isSelf = !!summary && me > 0 && me === who;
    if (summary && !isSelf) Social.recordView(who, me);

    var creations = summary ? Social.creations(who, {}) : [];
    var wall = summary ? Social.feed(who, { kind: 'wall', limit: 60 }) : [];
    var updates = summary ? Social.feed(who, { kind: 'update', limit: 60 }) : [];
    var incoming = isSelf ? Social.incomingRequests(me) : [];
    var outgoing = isSelf ? Social.outgoingRequests(me) : [];
    var tracks = [], ansiPieces = [], imagePieces = [], otherPieces = [];
    for (var ci = 0; ci < creations.length; ci++) {
        var ck = creations[ci].kind;
        if (ck === 'track') tracks.push(creations[ci]);
        else if (ck === 'ansi' || ck === 'art') ansiPieces.push(creations[ci]);
        else if (ck === 'image') imagePieces.push(creations[ci]);
        else otherPieces.push(creations[ci]);
    }
    /* Profile song leads the mini player. */
    if (summary && summary.profile.song) {
        var songName = summary.profile.song;
        var lead = null;
        for (var ti0 = 0; ti0 < tracks.length; ti0++) if (tracks[ti0].name === songName) { lead = tracks.splice(ti0, 1)[0]; break; }
        tracks.unshift(lead || { kind: 'track', dir: 'originalcontent_mp3s', name: songName, desc: '', added: 0 });
    }
    function trackTitle(name) { try { return Social.trackMeta(name); } catch (_tm) { return { title: name.replace(/\.mp3$/i, '').replace(/_/g, ' '), artist: '' }; } }
    var playCounts = {};
    try { load(system.mods_dir + 'load/fl_playcounts.js'); playCounts = FLPlayCounts.counts(); } catch (_pcErr) { playCounts = {}; }
    function jsonForScript(value) { return JSON.stringify(value).replace(/<\//g, '<\\/'); }
    var mediaTracks = [];
    for (var mt0 = 0; mt0 < tracks.length; mt0++) {
        var tk = tracks[mt0], tmeta = trackTitle(tk.name), pc = playCounts[String(tk.name).toLowerCase()];
        mediaTracks.push({ name: tk.name, title: tmeta.title, artist: tmeta.artist, added: tk.added || 0, plays: pc ? pc.plays : 0,
            collab: !!tk.collab, collabWith: String(tk.collabWith || ''),
            song: !!(summary && summary.profile.song && tk.name === summary.profile.song) });
    }
    var mediaCollabs = 0;
    for (var mc0 = 0; mc0 < mediaTracks.length; mc0++) if (mediaTracks[mc0].collab) mediaCollabs++;
    function caption(item) { return item.desc || item.name.replace(/\.[^.]+$/, '').replace(/_/g, ' '); }
    var mediaAnsi = [], mediaImages = [];
    var canModerate = false;
    try { canModerate = Social.canModerate(); } catch (_modErr) { canModerate = false; }
    for (var ma0 = 0; ma0 < ansiPieces.length; ma0++) mediaAnsi.push({ dir: ansiPieces[ma0].dir, name: ansiPieces[ma0].name, caption: caption(ansiPieces[ma0]), added: ansiPieces[ma0].added || 0, nsfw: !!ansiPieces[ma0].nsfw });
    for (var mi0 = 0; mi0 < imagePieces.length; mi0++) mediaImages.push({ dir: imagePieces[mi0].dir, name: imagePieces[mi0].name, caption: caption(imagePieces[mi0]), added: imagePieces[mi0].added || 0, nsfw: !!imagePieces[mi0].nsfw,
        src: './api/social.ssjs?call=image&dir=' + encodeURIComponent(imagePieces[mi0].dir) + '&name=' + encodeURIComponent(imagePieces[mi0].name) });
    /* Every program ever launched is too much for a sidebar box: keep the
       union of the top 12 by time, by launches and by recency, which is all
       the client's three sort views can ever show. */
    var allPlays = [];
    (function () {
        var everything = summary ? Social.topPrograms(who, 0) : [];
        var keep = {};
        ['seconds', 'count', 'last'].forEach(function (key) {
            everything.slice().sort(function (x, y) { return (y[key] || 0) - (x[key] || 0); }).slice(0, 12)
                .forEach(function (entry) { keep[entry.code] = entry; });
        });
        for (var code in keep) if (keep.hasOwnProperty(code)) allPlays.push(keep[code]);
    })();
    /* The same 12x6 icon bins the games list draws (text/icons/<CODE>.bin). */
    var playIcons = {};
    if (summary) {
        for (var pi0 = 0; pi0 < allPlays.length && pi0 < 40; pi0++) {
            var code = String(allPlays[pi0].code || '').toUpperCase();
            if (!/^[A-Z0-9_-]+$/.test(code)) continue;
            var iconPath = system.text_dir + 'icons/' + code + '.bin';
            if (!file_exists(iconPath)) iconPath = system.text_dir + 'icons/' + code.toLowerCase() + '.bin';
            if (!file_exists(iconPath)) continue;
            var bf = new File(iconPath);
            if (bf.open('rb')) { playIcons[code] = base64_encode(bf.read()); bf.close(); }
        }
    }

    /* ---- theme ---- */
    var PRESETS = {
        classic:  { bg: '#ffffff', box: '#ffffff', border: '#6699cc', title: '#6699cc', titleText: '#ffffff', text: '#000000', link: '#003399', accent: '#ff6600', muted: '#666666' },
        midnight: { bg: '#0b0f1a', box: '#121a2b', border: '#33415c', title: '#1e2a44', titleText: '#ffffff', text: '#d0d6e0', link: '#7fb3ff', accent: '#ffcc00', muted: '#8892a6' },
        cga:      { bg: '#000000', box: '#000000', border: '#5555ff', title: '#0000aa', titleText: '#ffffff', text: '#ffffff', link: '#55ffff', accent: '#ffff55', muted: '#aaaaaa', emph: '#55ff55', button: '#aa00aa' },
        sunset:   { bg: '#2b1b17', box: '#3a231d', border: '#b5573c', title: '#c1440e', titleText: '#fff3e0', text: '#f5e6d3', link: '#ffb347', accent: '#ff6b35', muted: '#c9a48f' },
        terminal: { bg: '#000000', box: '#000000', border: '#00aa00', title: '#005500', titleText: '#55ff55', text: '#55ff55', link: '#55ffff', accent: '#ffff55', muted: '#00aa00' }
    };
    var themeSpec = summary ? summary.profile.theme : { preset: 'cga', accent: '', background: '', text: '', link: '' };
    var preset = PRESETS[themeSpec.preset] || PRESETS.classic;
    function hex(v, fallback) { return /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(String(v || '')) ? String(v) : fallback; }
    var theme = {
        bg: hex(themeSpec.background, preset.bg), box: preset.box, border: preset.border,
        title: hex(themeSpec.accent, preset.title), titleText: preset.titleText,
        text: hex(themeSpec.text, preset.text), link: hex(themeSpec.link, preset.link),
        accent: hex(themeSpec.accent, preset.accent), muted: preset.muted,
        /* text drawn in the title colour (headings inside boxes); dark title bars need a readable stand-in */
        emph: preset.emph || hex(themeSpec.accent, preset.title),
        /* filled buttons carry white text: a bright accent (CGA yellow) needs a darker fill */
        button: preset.button || hex(themeSpec.accent, preset.accent)
    };
    if (themeSpec.background && !themeSpec.accent) theme.box = theme.bg;

    function writePost(p, ownerNumber) {
        var canDelete = me > 0 && (me === ownerNumber || me === p.author || user.is_sysop);
        writeln('<div class="pp-post" data-post-id="' + esc(p.id) + '">');
        writeln('  <div class="pp-post-head"><a href="' + esc(profileUrl(p.alias)) + '" class="pp-post-author">' + esc(p.alias) + '</a>' +
            '<span class="pp-post-date">' + esc(fmtDate(p.at)) + '</span>' +
            (canDelete ? '<button type="button" class="pp-link-btn pp-post-delete" data-post-id="' + esc(p.id) + '" title="Delete">delete</button>' : '') + '</div>');
        writeln('  <div class="pp-post-body">' + pipeHtml(p.body) + '</div>');
        writeln('</div>');
    }

    /* Colour toolbar under a composer: Synchronet Ctrl-A codes, picked not typed. */
    function writeColorToolbar() {
        var fgCodes = 'krgybmcw';
        var fgHex = ['#000000', '#aa0000', '#00aa00', '#aa5500', '#0000aa', '#aa00aa', '#00aaaa', '#aaaaaa'];
        var hiHex = ['#555555', '#ff5555', '#55ff55', '#ffff55', '#5555ff', '#ff55ff', '#55ffff', '#ffffff'];
        var dark = { 0: 1, 1: 1, 4: 1, 5: 1 };
        var html = '<div class="pp-colors" title="Insert a colour at the cursor"><span class="pp-colors-label">text</span>';
        for (var i = 0; i < 8; i++) html += '<button type="button" class="pp-color-btn" data-code="' + fgCodes.charAt(i) + '" style="background:' + fgHex[i] + ';color:' + (dark[i] ? '#ddd' : '#111') + '">' + fgCodes.charAt(i) + '</button>';
        for (var j = 0; j < 8; j++) html += '<button type="button" class="pp-color-btn" data-code="h' + fgCodes.charAt(j) + '" style="background:' + hiHex[j] + ';color:#111">' + fgCodes.charAt(j).toUpperCase() + '</button>';
        html += '<span class="pp-colors-label">back</span>';
        for (var k = 0; k < 8; k++) html += '<button type="button" class="pp-color-btn" data-code="' + k + '" style="background:' + fgHex[k] + ';color:' + (dark[k] ? '#ddd' : '#111') + '">' + k + '</button>';
        html += '<button type="button" class="pp-color-btn pp-color-reset" data-code="n" title="Back to normal">N</button></div>';
        html += '<div class="pp-compose-preview"></div>';
        writeln(html);
    }

    function relationButton(rel) {
        if (rel === 'friends') return { label: 'Remove from Friends', action: 'unfriend', cls: 'pp-btn-quiet' };
        if (rel === 'incoming') return { label: 'Accept Friend Request', action: 'accept', cls: 'pp-btn-primary' };
        if (rel === 'outgoing') return { label: 'Request Pending (withdraw)', action: 'cancel', cls: 'pp-btn-quiet' };
        return { label: 'Add to Friends', action: 'request', cls: 'pp-btn-primary' };
    }
?>
<style>
.profile-page {
    --pp-bg: <?xjs write(theme.bg); ?>;
    --pp-box: <?xjs write(theme.box); ?>;
    --pp-border: <?xjs write(theme.border); ?>;
    --pp-title: <?xjs write(theme.title); ?>;
    --pp-title-text: <?xjs write(theme.titleText); ?>;
    --pp-text: <?xjs write(theme.text); ?>;
    --pp-link: <?xjs write(theme.link); ?>;
    --pp-accent: <?xjs write(theme.accent); ?>;
    --pp-muted: <?xjs write(theme.muted); ?>;
    --pp-emph: <?xjs write(theme.emph); ?>;
    --pp-button: <?xjs write(theme.button); ?>;
    background: var(--pp-bg);
    color: var(--pp-text);
    font-family: Verdana, Arial, Helvetica, sans-serif;
    font-size: 12px;
    line-height: 1.45;
    padding: 12px;
    border: 1px solid var(--pp-border);
}
.profile-page a { color: var(--pp-link); text-decoration: underline; }
.profile-page a:hover { color: var(--pp-accent); }
.profile-page h1, .profile-page h2, .profile-page h3 { margin: 0; font-family: inherit; }
.pp-topbar { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; margin-bottom: 10px; }
.pp-topbar h1 { font-size: 22px; font-weight: bold; color: var(--pp-text); }
.pp-topbar .pp-headline { font-size: 13px; font-weight: bold; color: var(--pp-accent); }
.pp-topbar .pp-online { font-size: 11px; font-weight: bold; color: #ffffff; background: #1a9e3c; padding: 1px 7px; border-radius: 3px; }
.pp-grid { display: grid; grid-template-columns: 300px 1fr; gap: 14px; align-items: start; }
@media (max-width: 860px) { .pp-grid { grid-template-columns: 1fr; } }
.pp-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.pp-box { background: var(--pp-box); border: 1px solid var(--pp-border); }
.pp-box-title { background: var(--pp-title); color: var(--pp-title-text); font-weight: bold; font-size: 12px; padding: 3px 8px; }
.pp-box-body { padding: 8px; }
.pp-box-body p { margin: 0 0 6px; }
.pp-avatar-box { text-align: center; }
.pp-avatar { display: flex; justify-content: center; margin: 4px 0 8px; }
.pp-avatar img { width: 160px; height: auto; image-rendering: pixelated; border: 1px solid var(--pp-border); background: #000; }
.pp-mood { font-style: italic; color: var(--pp-muted); }
.pp-status { margin-top: 4px; }
.pp-meta { color: var(--pp-muted); font-size: 11px; }
.pp-details { width: 100%; border-collapse: collapse; }
.pp-details td { padding: 3px 4px; vertical-align: top; border-bottom: 1px dotted var(--pp-border); }
.pp-details td:first-child { background: var(--pp-title); color: var(--pp-title-text); width: 38%; font-weight: bold; }
.pp-btn { display: inline-block; padding: 4px 10px; margin: 2px 4px 2px 0; border: 1px solid var(--pp-border); background: var(--pp-box); color: var(--pp-text); font: inherit; font-weight: bold; cursor: pointer; }
.pp-btn-primary { background: var(--pp-button); color: #ffffff; border-color: var(--pp-button); }
.pp-btn-quiet { opacity: 0.85; }
.pp-btn:disabled { opacity: 0.5; cursor: default; }
.pp-link-btn { background: none; border: none; color: var(--pp-link); text-decoration: underline; cursor: pointer; font: inherit; font-size: 11px; padding: 0; margin-left: 8px; }
.pp-contact { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
.pp-contact .pp-btn { margin: 0; text-align: center; }
.pp-song { display: flex; align-items: center; gap: 8px; }
.pp-song .pp-song-name { font-weight: bold; word-break: break-all; }
.pp-friends-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; text-align: center; }
@media (max-width: 500px) { .pp-friends-grid { grid-template-columns: repeat(2, 1fr); } }
.pp-friend { font-size: 11px; word-break: break-word; }
.pp-friend .pp-friend-avatar { display: flex; justify-content: center; min-height: 48px; }
.pp-friend img { image-rendering: pixelated; width: 80px; height: auto; border: 1px solid var(--pp-border); background: #000; }
.pp-friend a { font-weight: bold; }
.pp-friend .pp-friend-online { color: #1a9e3c; font-weight: bold; }
.pp-post { border-bottom: 1px dotted var(--pp-border); padding: 6px 0; }
.pp-post:last-child { border-bottom: none; }
.pp-post-head { display: flex; align-items: baseline; gap: 8px; margin-bottom: 2px; }
.pp-post-author { font-weight: bold; }
.pp-post-date { color: var(--pp-muted); font-size: 11px; }
.pp-post-body { white-space: pre-wrap; word-break: break-word; }
.pp-form textarea { width: 100%; min-height: 60px; font: inherit; padding: 4px; border: 1px solid var(--pp-border); background: #fff; color: #000; box-sizing: border-box; }
.pp-form input[type=text], .pp-form select { width: 100%; font: inherit; padding: 3px; border: 1px solid var(--pp-border); background: #fff; color: #000; box-sizing: border-box; }
.pp-form label { display: block; font-weight: bold; margin-top: 6px; }
.pp-form .pp-hint { color: var(--pp-muted); font-size: 11px; }
.pp-colors { display: flex; flex-wrap: wrap; align-items: center; gap: 2px; margin: 4px 0; }
.pp-colors-label { font-size: 10px; text-transform: uppercase; color: var(--pp-muted); margin: 0 4px 0 2px; }
.pp-color-btn { width: 22px; height: 20px; padding: 0; border: 1px solid #333; font: bold 10px/1 monospace; cursor: pointer; }
.pp-color-btn:hover { outline: 2px solid var(--pp-accent); }
.pp-color-reset { background: var(--pp-box); color: var(--pp-text); border-color: var(--pp-border); }
.pp-compose-preview { min-height: 1.4em; padding: 3px 5px; margin-bottom: 4px; background: #000; color: #aaa; font-family: "Spleen", "VT323", monospace; font-size: 13px; white-space: pre-wrap; word-break: break-word; }
.pp-compose-preview:empty { display: none; }
.pp-note { color: var(--pp-muted); font-style: italic; }
.pp-creation { display: flex; align-items: center; gap: 6px; padding: 3px 0; border-bottom: 1px dotted var(--pp-border); }
.pp-creation:last-child { border-bottom: none; }
.pp-creation .pp-kind { font-size: 10px; font-weight: bold; text-transform: uppercase; color: var(--pp-title-text); background: var(--pp-title); padding: 0 4px; }
.pp-creation .pp-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pp-ansi-view { margin: 4px 0 8px; overflow-x: auto; background: #000; }
.pp-ansi-view pre.ansi { margin: 0; font-family: "Spleen", "VT323", monospace; font-size: 12px; line-height: 1; }
.pp-about .wiki-body, .pp-about { word-break: break-word; }
.pp-about .wiki-embed-ansi { display: block; margin: 6px 0; overflow-x: auto; background: #000; }
.pp-about .wiki-embed-ansi pre.ansi { margin: 0; font-family: "Spleen", "VT323", monospace; font-size: 12px; line-height: 1; }
.pp-about .wiki-embed-image img { max-width: 100%; height: auto; }
.pp-about .wiki-embed-avatar img { image-rendering: pixelated; height: 48px; width: auto; vertical-align: middle; }
.pp-about .wiki-track-play { font: inherit; cursor: pointer; }
.pp-about .wiki-embed-missing { opacity: .7; font-style: italic; }
.pp-about img, .pp-about pre { max-width: 100%; }
.pp-requests { background: #fff8d6; color: #333; border: 1px solid #e0c060; padding: 8px; margin-bottom: 12px; }
/* Fixed light box: pin every descendant dark, or the site's CGA theme (white <b>) and the
   profile's own light link/muted colours leak in and vanish on the cream background. */
.pp-requests b, .pp-requests strong, .profile-page .pp-requests a, .pp-requests .pp-meta { color: #333 !important; }
.pp-requests .pp-btn { color: #000; background: #fff; border-color: #999; }
.pp-requests .pp-btn-primary { background: #ff6600; border-color: #ff6600; color: #fff; }
.pp-status-line { min-height: 1.2em; color: var(--pp-accent); font-weight: bold; margin-top: 4px; }
.pp-toggle { cursor: pointer; }
.pp-hidden { display: none; }
.pp-box-title-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.pp-title-link { color: var(--pp-title-text) !important; font-weight: normal; font-size: 11px; }
.pp-sort { display: inline-flex; gap: 2px; }
.pp-sort-btn { font: inherit; font-size: 10px; text-transform: uppercase; letter-spacing: .04em; padding: 1px 6px; border: 1px solid var(--pp-border); background: var(--pp-box); color: var(--pp-text); cursor: pointer; }
.pp-sort-btn.is-active { background: var(--pp-button); color: #fff; border-color: var(--pp-button); }
.pp-box-title .pp-sort-btn { border-color: rgba(255,255,255,.4); background: transparent; color: var(--pp-title-text); }
.pp-box-title .pp-sort-btn.is-active { background: rgba(255,255,255,.25); }
.pp-plays-head { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }
.pp-plays-title { font-weight: bold; color: var(--pp-emph); }
.pp-plays { display: flex; flex-direction: column; gap: 4px; margin-top: 4px; }
.pp-play-row { display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--pp-text); border: 1px solid var(--pp-border); padding: 3px 6px 3px 3px; background: var(--pp-box); }
.pp-play-row:hover { border-color: var(--pp-accent); color: var(--pp-text); }
.pp-play-rank { width: 1.4em; text-align: right; color: var(--pp-muted); font-size: 11px; }
.pp-play-icon { width: 48px; height: 48px; flex-shrink: 0; background: #000; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.pp-play-icon img { width: 48px; height: 48px; image-rendering: pixelated; display: block; }
.pp-play-icon .pp-play-blank { width: 48px; height: 48px; background: #111; opacity: .5; }
.pp-play-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: bold; }
.pp-play-count { color: var(--pp-muted); font-size: 11px; white-space: nowrap; }
.pp-player-body { padding: 4px 8px 8px; }
.pp-player { max-height: 340px; overflow-y: auto; display: flex; flex-direction: column; }
.pp-track { display: flex; align-items: center; gap: 8px; padding: 3px 4px; border-bottom: 1px dotted var(--pp-border); }
.pp-track-art { width: 40px; height: 40px; flex-shrink: 0; background: #000; border: 1px solid var(--pp-border); display: flex; align-items: center; justify-content: center; color: #555; font-size: 16px; overflow: hidden; }
.pp-track-art img { width: 40px; height: 40px; object-fit: cover; display: block; }
.pp-track-btn { width: 26px; height: 26px; flex-shrink: 0; border: 1px solid var(--pp-border); background: var(--pp-button); color: #fff; cursor: pointer; font: inherit; font-size: 11px; line-height: 1; }
.pp-track.is-playing { background: rgba(127,127,127,.12); }
.pp-track.is-playing .pp-track-btn { background: var(--pp-title); }
.pp-track-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.pp-track-title { font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pp-track-artist { color: var(--pp-muted); font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pp-track-plays { color: var(--pp-muted); font-size: 11px; white-space: nowrap; }
.pp-track-tag { font-size: 10px; text-transform: uppercase; color: var(--pp-title-text); background: var(--pp-title); padding: 0 5px; white-space: nowrap; }
.pp-track-song { border: 1px solid var(--pp-accent); margin-bottom: 4px; }
.pp-pager { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 6px; font-size: 11px; }
.pp-pager button { font: inherit; font-size: 11px; padding: 1px 8px; border: 1px solid var(--pp-border); background: var(--pp-box); color: var(--pp-text); cursor: pointer; }
.pp-pager button:disabled { opacity: .4; cursor: default; }
.pp-forum { display: flex; flex-direction: column; }
.pp-forum-row { display: flex; gap: 8px; padding: 6px 0; border-bottom: 1px dotted var(--pp-border); }
.pp-forum-row:last-child { border-bottom: none; }
.pp-forum-icon { width: 48px; height: 24px; flex-shrink: 0; background: #000; border: 1px solid var(--pp-border); overflow: hidden; }
.pp-forum-icon img { width: 48px; height: 24px; display: block; image-rendering: pixelated; }
.pp-forum-icon.is-blank { background: var(--pp-title); }
.pp-forum-main { flex: 1; min-width: 0; }
.pp-forum-head { display: flex; flex-wrap: wrap; gap: 0 8px; font-size: 11px; color: var(--pp-muted); }
.pp-forum-where { color: var(--pp-emph); font-weight: bold; }
.pp-forum-origin { font-style: italic; }
.pp-forum-subject { font-weight: bold; overflow: hidden; text-overflow: ellipsis; }
.pp-forum-subject a { color: var(--pp-link); }
.pp-forum-snippet { font-size: 12px; color: var(--pp-text); word-break: break-word; }
.pp-forum-full { margin-top: 4px; padding: 6px 8px; border: 1px solid var(--pp-border); background: rgba(127,127,127,.06); font-size: 12px; max-height: 60vh; overflow: auto; }
.pp-forum-full .message { white-space: pre-wrap; word-break: break-word; font-family: monospace; }
.pp-forum-full pre { margin: 0; }
.pp-forum-tools { display: flex; gap: 6px; margin-top: 3px; align-items: center; }
.pp-forum-tools button, .pp-forum-tools a.pp-forum-open { font: inherit; font-size: 11px; padding: 1px 8px; border: 1px solid var(--pp-border); background: var(--pp-box); color: var(--pp-text); cursor: pointer; text-decoration: none; }
.pp-forum-tools a.pp-forum-open { color: var(--pp-link); }
.pp-forum-tools button.is-open { background: var(--pp-title); color: var(--pp-title-text); }
.pp-forum-hint { font-weight: normal; color: var(--pp-title-text); opacity: .75; font-size: 10px; }
.pp-player-status { color: var(--pp-muted); font-size: 11px; min-height: 1.2em; margin-top: 2px; }
.pp-strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 6px; }
.pp-tile { display: flex; flex-direction: column; text-decoration: none; color: var(--pp-text); border: 1px solid var(--pp-border); background: #000; overflow: hidden; cursor: pointer; }
.pp-tile:hover { border-color: var(--pp-accent); color: var(--pp-text); }
.pp-tile-art { display: block; width: 100%; aspect-ratio: 4 / 3; overflow: hidden; background: #000; position: relative; }
.pp-tile-art img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
.pp-tile-ansi .pp-tile-art img { image-rendering: pixelated; }
.pp-tile-wait { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #555; font-size: 11px; letter-spacing: .1em; }
.pp-tile-caption { font-size: 10px; padding: 2px 4px; background: var(--pp-box); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border-top: 1px solid var(--pp-border); }
.pp-tile-more .pp-tile-art { display: flex; align-items: center; justify-content: center; color: var(--pp-accent); font-weight: bold; font-size: 13px; background: var(--pp-box); }
.pp-other a { word-break: break-all; }
.pp-carousel { position: fixed; inset: 0; z-index: 2000; background: rgba(0,0,0,.94); display: flex; flex-direction: column; font-family: Verdana, Arial, sans-serif; color: #ddd; }
.pp-carousel-bar { display: flex; align-items: center; justify-content: space-between; padding: 8px 14px; font-size: 12px; background: #111; border-bottom: 1px solid #333; }
.pp-carousel-bar button, .pp-carousel-nav { font: inherit; color: #fff; background: #222; border: 1px solid #555; padding: 3px 10px; cursor: pointer; }
.pp-carousel-stage { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; position: relative; overflow: auto; padding: 12px; }
.pp-carousel-stage img { display: block; margin: auto; box-shadow: 0 0 24px #000; }
.pp-carousel-stage img.pp-ansi-full { image-rendering: pixelated; max-width: none; }
.pp-carousel-stage img.pp-photo-full { max-width: 100%; max-height: 100%; object-fit: contain; }
.pp-carousel-stage .pp-carousel-wait { color: #777; }
.pp-carousel-nav { position: absolute; top: 50%; transform: translateY(-50%); font-size: 24px; line-height: 1; padding: 12px 10px; opacity: .8; }
.pp-carousel-nav.prev { left: 8px; } .pp-carousel-nav.next { right: 8px; }
.pp-carousel-caption { padding: 8px 14px; font-size: 12px; text-align: center; background: #111; border-top: 1px solid #333; }
.pp-tile-art.is-nsfw img { filter: blur(14px) brightness(.6); transform: scale(1.1); }
.pp-tile-art.is-nsfw.is-revealed img { filter: none; transform: none; }
.pp-tile-art.is-nsfw.is-revealed .pp-nsfw-veil { display: none; }
.pp-nsfw-veil { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; color: #fff; background: rgba(0,0,0,.35); font: bold 13px Verdana, Arial, sans-serif; letter-spacing: .12em; text-shadow: 0 0 6px #000; cursor: pointer; border: none; }
.pp-nsfw-veil small { font-weight: normal; letter-spacing: 0; font-size: 10px; opacity: .85; }
.pp-carousel-view { position: relative; }
.pp-carousel-view.is-nsfw img { filter: blur(24px) brightness(.5); }
.pp-carousel-view.is-nsfw.is-revealed img { filter: none; }
.pp-carousel-view.is-nsfw.is-revealed .pp-nsfw-veil { display: none; }
.pp-nsfw-veil-big { font-size: 18px; }
.pp-carousel-mod { font: inherit; color: #ffff55; background: #222; border: 1px solid #555; padding: 3px 10px; cursor: pointer; margin-right: 8px; }
</style>

<?xjs if (!summary) { ?>
<div class="profile-page"><div class="pp-box"><div class="pp-box-title">Profile</div><div class="pp-box-body">
<?xjs if (!who && !rawUser.length && !me) { ?>
    <p>Log in to see your own profile, or open someone's from the <a href="./?page=005-userlist.xjs">user list</a>.</p>
<?xjs } else { ?>
    <p>There is no member called <b><?xjs write(esc(rawUser)); ?></b> here.</p>
    <p><a href="./?page=005-userlist.xjs">Back to the user list</a></p>
<?xjs } ?>
</div></div></div>
<?xjs } else {
    var rel = summary.relation;
    var relBtn = relationButton(rel);
    var canWall = me > 0 && !isSelf && Social.canPostWall(who, me);
    var songOnPage = summary.profile.song;
?>
<div class="profile-page" id="pp-root"
     data-user="<?xjs write(esc(summary.alias)); ?>" data-number="<?xjs write(summary.number); ?>"
     data-self="<?xjs write(isSelf ? '1' : '0'); ?>" data-me="<?xjs write(me); ?>"
     data-song="<?xjs write(esc(songOnPage)); ?>">

<?xjs if (isSelf && incoming.length) { ?>
    <div class="pp-requests" id="pp-requests">
        <b><?xjs write(incoming.length); ?> friend request<?xjs write(incoming.length === 1 ? '' : 's'); ?> waiting:</b>
<?xjs for (var ri = 0; ri < incoming.length; ri++) { var rq = incoming[ri]; ?>
        <div class="pp-request" data-user="<?xjs write(esc(rq.fromAlias)); ?>">
            <a href="<?xjs write(esc(profileUrl(rq.fromAlias))); ?>"><?xjs write(esc(rq.fromAlias)); ?></a>
            <?xjs if (rq.message) { ?><span class="pp-meta">&ldquo;<?xjs write(esc(rq.message)); ?>&rdquo;</span><?xjs } ?>
            <button type="button" class="pp-btn pp-btn-primary pp-friend-btn" data-action="accept" data-user="<?xjs write(esc(rq.fromAlias)); ?>">Accept</button>
            <button type="button" class="pp-btn pp-friend-btn" data-action="decline" data-user="<?xjs write(esc(rq.fromAlias)); ?>">Decline</button>
        </div>
<?xjs } ?>
    </div>
<?xjs } ?>

    <div class="pp-topbar">
        <h1><?xjs write(esc(summary.alias)); ?></h1>
        <?xjs if (summary.profile.headline) { ?><span class="pp-headline">&ldquo;<?xjs write(esc(summary.profile.headline)); ?>&rdquo;</span><?xjs } ?>
        <?xjs if (summary.online) { ?><span class="pp-online">ONLINE NOW</span><?xjs } ?>
        <?xjs if (isSelf) { ?><a href="#" class="pp-toggle" data-toggle="pp-edit">Edit my profile</a><?xjs } ?>
    </div>

    <div class="pp-grid">
    <div class="pp-col">
        <div class="pp-box pp-avatar-box">
            <div class="pp-box-body">
                <div class="pp-avatar"><div data-avatar="<?xjs write(esc(summary.alias)); ?>"></div></div>
                <?xjs if (summary.profile.mood) { ?><div class="pp-mood">feeling <?xjs write(esc(summary.profile.mood)); ?></div><?xjs } ?>
                <?xjs if (summary.latestUpdate) { ?><div class="pp-status">&ldquo;<?xjs write(pipeHtml(summary.latestUpdate.body)); ?>&rdquo;
                    <div class="pp-meta"><?xjs write(esc(fmtDate(summary.latestUpdate.at))); ?></div></div><?xjs } ?>
                <div class="pp-meta">
                    <?xjs if (summary.location) { ?><?xjs write(esc(summary.location)); ?><br><?xjs } ?>
                    Last login: <?xjs write(esc(fmtAgo(summary.lastOn))); ?><br>
                    Member since <?xjs write(esc(summary.firstOn ? strftime('%b %Y', summary.firstOn) : '?')); ?>
                    &middot; <?xjs write(summary.profile.views); ?> profile views
                </div>
            </div>
        </div>

        <div class="pp-box">
            <div class="pp-box-title">Contacting <?xjs write(esc(summary.alias)); ?></div>
            <div class="pp-box-body">
<?xjs if (isSelf) { ?>
                <div class="pp-contact">
                    <a class="pp-btn pp-toggle" href="#" data-toggle="pp-edit">Edit Profile</a>
                    <a class="pp-btn pp-toggle" href="#" data-toggle="pp-update-form">Post an Update</a>
                    <a class="pp-btn" href="./?page=010-wiki.xjs#wiki/<?xjs write(esc(summary.about.slug)); ?>/edit">Edit About Me</a>
                    <a class="pp-btn" href="./?page=010-settings.xjs">Change Avatar</a>
                </div>
<?xjs } else if (me > 0) { ?>
                <div class="pp-contact">
                    <button type="button" class="pp-btn <?xjs write(relBtn.cls); ?> pp-friend-btn" id="pp-friend-main"
                        data-action="<?xjs write(relBtn.action); ?>" data-user="<?xjs write(esc(summary.alias)); ?>"><?xjs write(esc(relBtn.label)); ?></button>
                    <?xjs if (canWall) { ?><a class="pp-btn pp-toggle" href="#" data-toggle="pp-wall-form">Write on Wall</a><?xjs } else { ?><span class="pp-btn" style="opacity:.5" title="Only friends can write here">Wall: friends only</span><?xjs } ?>
                    <a class="pp-btn" href="./?page=001-chat.xjs">Send a Message</a>
                    <?xjs if (summary.about.exists) { ?><a class="pp-btn" href="./?page=010-wiki.xjs#wiki/<?xjs write(esc(summary.about.slug)); ?>">Wiki Page</a><?xjs } ?>
                </div>
<?xjs } else { ?>
                <p class="pp-note">Log in to add <?xjs write(esc(summary.alias)); ?> as a friend or write on their wall.</p>
<?xjs } ?>
                <div class="pp-status-line" id="pp-friend-status"><?xjs
                    if (rel === 'friends') write('You are friends.');
                    else if (rel === 'incoming') write(esc(summary.alias) + ' wants to be your friend.');
                    else if (rel === 'outgoing') write('Your friend request is waiting.');
                ?></div>
            </div>
        </div>


        <div class="pp-box">
            <div class="pp-box-title"><?xjs write(esc(summary.alias)); ?>'s Details</div>
            <div class="pp-box-body">
                <table class="pp-details">
                    <tr><td>Member since</td><td><?xjs write(esc(summary.firstOn ? strftime('%b %d, %Y', summary.firstOn) : '-')); ?></td></tr>
                    <tr><td>Logons</td><td><?xjs write(summary.logons); ?></td></tr>
                    <tr><td>Time online</td><td><?xjs write(esc(fmtMinutes(summary.timeOnMinutes))); ?></td></tr>
                    <tr><td>Posts</td><td><?xjs write(summary.posts); ?></td></tr>
                    <tr><td>Files</td><td><?xjs write(summary.uploads); ?> up / <?xjs write(summary.downloads); ?> down</td></tr>
                    <tr><td>Points</td><td><?xjs write(summary.points.balance); ?> <span class="pp-meta">(<?xjs write(summary.points.lifetime); ?> lifetime)</span></td></tr>
                </table>
<?xjs if (allPlays.length) { ?>
                <div class="pp-plays-head">
                    <span class="pp-plays-title">Plays most</span>
                    <span class="pp-sort" data-sort-for="plays">
                        <button type="button" class="pp-sort-btn is-active" data-sort="seconds">time</button>
                        <button type="button" class="pp-sort-btn" data-sort="count">launches</button>
                        <button type="button" class="pp-sort-btn" data-sort="last">recent</button>
                    </span>
                </div>
                <div class="pp-plays" id="pp-plays"></div>
<?xjs } ?>
            </div>
        </div>

    </div>

    <div class="pp-col">
<?xjs if (isSelf) { ?>
        <div class="pp-box pp-hidden" id="pp-edit">
            <div class="pp-box-title">Edit My Profile</div>
            <div class="pp-box-body pp-form">
                <form id="pp-edit-form">
                    <label>Headline <span class="pp-hint">(one line under your name)</span></label>
                    <input type="text" name="headline" maxlength="60" value="<?xjs write(esc(summary.profile.headline)); ?>">
                    <label>Mood <span class="pp-hint">(shows as "feeling ...")</span></label>
                    <input type="text" name="mood" maxlength="40" value="<?xjs write(esc(summary.profile.mood)); ?>">
                    <label>Profile song <span class="pp-hint">(one of your tracks)</span></label>
                    <select name="song">
                        <option value="">(none)</option>
<?xjs for (var si = 0; si < tracks.length; si++) { ?>
                        <option value="<?xjs write(esc(tracks[si].name)); ?>"<?xjs write(tracks[si].name === summary.profile.song ? ' selected' : ''); ?>><?xjs write(esc(tracks[si].name)); ?></option>
<?xjs } if (summary.profile.song && !tracks.some(function (t) { return t.name === summary.profile.song; })) { ?>
                        <option value="<?xjs write(esc(summary.profile.song)); ?>" selected><?xjs write(esc(summary.profile.song)); ?></option>
<?xjs } ?>
                    </select>
                    <label>Who can write on my wall</label>
                    <select name="wallPolicy">
                        <option value="friends"<?xjs write(summary.profile.wallPolicy === 'friends' ? ' selected' : ''); ?>>Friends</option>
                        <option value="nobody"<?xjs write(summary.profile.wallPolicy === 'nobody' ? ' selected' : ''); ?>>Nobody (read-only)</option>
                    </select>
                    <label>Theme</label>
                    <select name="preset">
<?xjs var presetNames = ['classic', 'midnight', 'cga', 'sunset', 'terminal']; for (var pi = 0; pi < presetNames.length; pi++) { ?>
                        <option value="<?xjs write(presetNames[pi]); ?>"<?xjs write(summary.profile.theme.preset === presetNames[pi] ? ' selected' : ''); ?>><?xjs write(presetNames[pi]); ?></option>
<?xjs } ?>
                    </select>
                    <label>Colours <span class="pp-hint">(hex like #ff6600; blank keeps the theme's)</span></label>
                    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px">
                        <input type="text" name="accent" placeholder="accent" maxlength="7" value="<?xjs write(esc(summary.profile.theme.accent)); ?>">
                        <input type="text" name="background" placeholder="background" maxlength="7" value="<?xjs write(esc(summary.profile.theme.background)); ?>">
                        <input type="text" name="text" placeholder="text" maxlength="7" value="<?xjs write(esc(summary.profile.theme.text)); ?>">
                        <input type="text" name="link" placeholder="links" maxlength="7" value="<?xjs write(esc(summary.profile.theme.link)); ?>">
                    </div>
<?xjs if (summary.friends.length) { ?>
                    <label>Featured friends <span class="pp-hint">(up to 8, shown first)</span></label>
                    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:2px">
<?xjs for (var fi = 0; fi < summary.friends.length; fi++) { var fr = summary.friends[fi]; ?>
                        <label style="font-weight:normal;margin:0"><input type="checkbox" name="featured" value="<?xjs write(fr.number); ?>"<?xjs write(summary.profile.featured.indexOf(fr.number) !== -1 ? ' checked' : ''); ?>> <?xjs write(esc(fr.alias)); ?></label>
<?xjs } ?>
                    </div>
<?xjs } ?>
                    <div style="margin-top:8px">
                        <button type="submit" class="pp-btn pp-btn-primary">Save</button>
                        <a href="#" class="pp-btn pp-toggle" data-toggle="pp-edit">Cancel</a>
                        <span class="pp-status-line" id="pp-edit-status"></span>
                    </div>
                </form>
            </div>
        </div>
<?xjs } ?>

<?xjs if (mediaTracks.length) { ?>
        <div class="pp-box pp-media">
            <div class="pp-box-title pp-box-title-row"><span><?xjs write(esc(summary.alias)); ?>'s Music (<?xjs write(mediaTracks.length - mediaCollabs); ?><?xjs if (mediaCollabs) write(' + ' + mediaCollabs + ' collab' + (mediaCollabs === 1 ? '' : 's')); ?>)</span>
                <span class="pp-sort" data-sort-for="tracks">
                    <button type="button" class="pp-sort-btn is-active" data-sort="plays">top</button>
                    <button type="button" class="pp-sort-btn" data-sort="name">name</button>
                    <button type="button" class="pp-sort-btn" data-sort="added">newest</button>
                </span>
            </div>
            <div class="pp-box-body pp-player-body">
                <div class="pp-player" id="pp-player"></div>
                <div class="pp-pager" id="pp-player-pager"></div>
                <div class="pp-player-status" id="pp-player-status"></div>
            </div>
        </div>
<?xjs } ?>
<?xjs if (mediaAnsi.length) { ?>
        <div class="pp-box pp-media">
            <div class="pp-box-title pp-box-title-row"><span><?xjs write(esc(summary.alias)); ?>'s ANSI Gallery (<?xjs write(mediaAnsi.length); ?>)</span>
                <a href="#" class="pp-title-link pp-open-carousel" data-gallery="ansi">view all &raquo;</a></div>
            <div class="pp-box-body">
                <div class="pp-strip" id="pp-strip-ansi"></div>
            </div>
        </div>
<?xjs } ?>
<?xjs if (mediaImages.length) { ?>
        <div class="pp-box pp-media">
            <div class="pp-box-title pp-box-title-row"><span><?xjs write(esc(summary.alias)); ?>'s Pictures (<?xjs write(mediaImages.length); ?>)</span>
                <a href="#" class="pp-title-link pp-open-carousel" data-gallery="images">view all &raquo;</a></div>
            <div class="pp-box-body">
                <div class="pp-strip" id="pp-strip-images"></div>
            </div>
        </div>
<?xjs } ?>
<?xjs if (otherPieces.length) { ?>
        <div class="pp-box pp-media">
            <div class="pp-box-title">Other files by <?xjs write(esc(summary.alias)); ?> (<?xjs write(otherPieces.length); ?>)</div>
            <div class="pp-box-body pp-other">
<?xjs for (var oi = 0; oi < otherPieces.length && oi < 10; oi++) { var op = otherPieces[oi]; ?>
                <a href="./api/files.ssjs?call=download-file&dir=<?xjs write(esc(op.dir)); ?>&file=<?xjs write(encodeURIComponent(op.name)); ?>"><?xjs write(esc(op.name)); ?></a><?xjs write(oi < Math.min(otherPieces.length, 10) - 1 ? ' &middot; ' : ''); ?>
<?xjs } if (otherPieces.length > 10) { ?> <span class="pp-meta">and <?xjs write(otherPieces.length - 10); ?> more in the <a href="./?page=006-files.xjs">file areas</a></span><?xjs } ?>
            </div>
        </div>
<?xjs } ?>

        <div class="pp-box" id="pp-forum-box">
            <div class="pp-box-title pp-box-title-row"><span><?xjs write(esc(summary.alias)); ?>'s Forum Activity <span id="pp-forum-count"></span></span>
                <span class="pp-meta pp-forum-hint">alias + linked handles, every board you can read</span>
            </div>
            <div class="pp-box-body">
                <div class="pp-forum" id="pp-forum"><span class="pp-meta">Looking through the message bases...</span></div>
                <div class="pp-pager" id="pp-forum-pager"></div>
            </div>
        </div>

        <div class="pp-box">
            <div class="pp-box-title"><?xjs write(esc(summary.alias)); ?>'s Updates (<?xjs write(summary.updateCount); ?>)</div>
            <div class="pp-box-body">
<?xjs if (isSelf) { ?>
                <form class="pp-form <?xjs write(updates.length ? 'pp-hidden' : ''); ?>" id="pp-update-form" data-kind="update">
                    <textarea name="body" maxlength="1000" placeholder="What are you up to?"></textarea>
                    <?xjs writeColorToolbar(); ?>
                    <button type="submit" class="pp-btn pp-btn-primary">Post Update</button>
                    <span class="pp-status-line pp-form-status"></span>
                </form>
<?xjs } ?>
                <div id="pp-updates">
<?xjs if (!updates.length) { ?><p class="pp-note"><?xjs write(isSelf ? 'Nothing yet. Post what you are up to.' : 'No updates yet.'); ?></p><?xjs } ?>
<?xjs for (var ui = 0; ui < updates.length; ui++) writePost(updates[ui], who); ?>
                </div>
            </div>
        </div>

        <div class="pp-box">
            <div class="pp-box-title">About <?xjs write(esc(summary.alias)); ?></div>
            <div class="pp-box-body pp-about">
<?xjs
    var page = Social.wikiPage(who);
    if (page.exists && wikiCore) {
        var resolver = function (target) {
            var slug = wikiCore.slugify(target);
            return { href: './?page=010-wiki.xjs#wiki/' + slug, cls: 'wiki-link' };
        };
        var aboutHtml = '';
        try { aboutHtml = wikiCore.renderHtml(wikiCore.parse(page.body), resolver, embedRenderer); } catch (_renderError) { aboutHtml = ''; }
        if (aboutHtml) { writeln('<div class="wiki-body">' + aboutHtml + '</div>'); }
        else { var pl = Social.plainLines(page.body, 0); for (var li = 0; li < pl.length; li++) writeln('<p>' + esc(pl[li]) + '</p>'); }
        writeln('<div class="pp-meta">From their wiki page &middot; <a href="./?page=010-wiki.xjs#wiki/' + esc(page.slug) + '">open</a>' + (isSelf ? ' &middot; <a href="./?page=010-wiki.xjs#wiki/' + esc(page.slug) + '/edit">edit</a>' : '') + '</div>');
    } else if (page.exists) {
        var pl2 = Social.plainLines(page.body, 0);
        for (var li2 = 0; li2 < pl2.length; li2++) writeln('<p>' + esc(pl2[li2]) + '</p>');
    } else if (isSelf) {
        writeln('<p class="pp-note">Nothing here yet. <a href="./?page=010-wiki.xjs#wiki/' + esc(summary.about.slug) + '/edit">Write your About Me</a> on your wiki page: headings, links, and embedded art all work.</p>');
    } else {
        writeln('<p class="pp-note">' + esc(summary.alias) + ' has not written an About Me yet.</p>');
    }
?>
            </div>
        </div>

        <div class="pp-box">
            <div class="pp-box-title"><?xjs write(esc(summary.alias)); ?>'s Friends (<?xjs write(summary.friendCount); ?>)</div>
            <div class="pp-box-body">
<?xjs if (!summary.friends.length) { ?>
                <p class="pp-note"><?xjs write(isSelf ? 'No friends yet. Find people in the user list and add them.' : esc(summary.alias) + ' has no friends listed yet.'); ?></p>
<?xjs } else { ?>
                <div class="pp-friends-grid" id="pp-featured">
<?xjs for (var ff = 0; ff < summary.featured.length; ff++) { var fe = summary.featured[ff]; ?>
                    <div class="pp-friend">
                        <div class="pp-friend-avatar"><div data-avatar="<?xjs write(esc(fe.alias)); ?>"></div></div>
                        <a href="<?xjs write(esc(profileUrl(fe.alias))); ?>"><?xjs write(esc(fe.alias)); ?></a>
                        <?xjs if (fe.online) { ?><div class="pp-friend-online">online</div><?xjs } ?>
                    </div>
<?xjs } ?>
                </div>
<?xjs if (summary.friends.length > summary.featured.length) { ?>
                <p style="margin-top:8px"><a href="#" class="pp-toggle" data-toggle="pp-all-friends">View all of <?xjs write(esc(summary.alias)); ?>'s friends</a></p>
                <div class="pp-hidden" id="pp-all-friends">
<?xjs var names = []; for (var fa = 0; fa < summary.friends.length; fa++) names.push('<a href="' + esc(profileUrl(summary.friends[fa].alias)) + '">' + esc(summary.friends[fa].alias) + '</a>' + (summary.friends[fa].online ? ' <span class="pp-friend-online">(online)</span>' : '')); write(names.join(', ')); ?>
                </div>
<?xjs } } ?>
            </div>
        </div>

        <div class="pp-box">
            <div class="pp-box-title"><?xjs write(esc(summary.alias)); ?>'s Wall (<?xjs write(summary.wallCount); ?>)</div>
            <div class="pp-box-body">
<?xjs if (canWall) { ?>
                <form class="pp-form pp-hidden" id="pp-wall-form" data-kind="wall">
                    <textarea name="body" maxlength="1000" placeholder="Write something on <?xjs write(esc(summary.alias)); ?>'s wall"></textarea>
                    <?xjs writeColorToolbar(); ?>
                    <button type="submit" class="pp-btn pp-btn-primary">Post</button>
                    <span class="pp-status-line pp-form-status"></span>
                </form>
<?xjs } ?>
                <div id="pp-wall">
<?xjs if (!wall.length) { ?><p class="pp-note"><?xjs write(isSelf ? 'Friends can write here.' : (canWall ? 'Be the first to write something.' : 'Nothing here yet.')); ?></p><?xjs } ?>
<?xjs for (var wi = 0; wi < wall.length; wi++) writePost(wall[wi], who); ?>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

<script>
(function () {
    var root = document.getElementById('pp-root');
    if (!root) return;
    var alias = root.getAttribute('data-user');
    var isSelf = root.getAttribute('data-self') === '1';
    var me = parseInt(root.getAttribute('data-me') || '0', 10);
    var API = './api/social.ssjs';

    function csrf() {
        var meta = document.querySelector('meta[name="csrf-token"]');
        return (window.sbbsConfig && window.sbbsConfig.csrfToken) || (meta ? meta.getAttribute('content') : '') || '';
    }
    function post(call, body) {
        return fetch(API + '?call=' + encodeURIComponent(call), {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf() },
            body: JSON.stringify(body || {})
        }).then(function (r) { return r.json(); });
    }
    function esc(s) {
        return String(s === undefined || s === null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    var CGA_HEX = ['#000000', '#0000aa', '#00aa00', '#00aaaa', '#aa0000', '#aa00aa', '#aa5500', '#aaaaaa',
        '#555555', '#5555ff', '#55ff55', '#55ffff', '#ff5555', '#ff55ff', '#ffff55', '#ffffff'];
    var CTRLA_FG = { k: 0, b: 1, g: 2, c: 3, r: 4, m: 5, y: 6, w: 7 };
    var CTRLA_BG = { '0': 0, '1': 4, '2': 2, '3': 6, '4': 1, '5': 5, '6': 3, '7': 7 };
    /* Ctrl-A + pipe colour codes -> spans (mirror of the server's pipeHtml). */
    function pipeHtml(text) {
        var src = String(text || '');
        var out = '', fg = 7, bg = -1, high = false, run = '', i = 0;
        function flush() {
            if (!run.length) return;
            var html = esc(run).replace(/\n/g, '<br>');
            var style = '';
            if (fg !== 7 || high) style += 'color:' + CGA_HEX[high ? (fg | 8) : fg] + ';';
            if (bg >= 0) style += 'background-color:' + CGA_HEX[bg] + ';';
            out += style ? '<span style="' + style + '">' + html + '</span>' : html;
            run = '';
        }
        while (i < src.length) {
            var ch = src.charAt(i);
            if (ch === '\x01' && i + 1 < src.length) {
                var code = src.charAt(i + 1), lower = code.toLowerCase();
                flush(); i += 2;
                if (lower === 'n' || code === '-' || code === '_') { fg = 7; bg = -1; high = false; }
                else if (lower === 'h') high = true;
                else if (CTRLA_FG.hasOwnProperty(lower)) fg = CTRLA_FG[lower];
                else if (CTRLA_BG.hasOwnProperty(code)) bg = CTRLA_BG[code];
                continue;
            }
            if (ch === '|' && /^[0-2][0-9]$/.test(src.substr(i + 1, 2))) {
                var pipe = parseInt(src.substr(i + 1, 2), 10);
                if (pipe <= 23) {
                    flush(); i += 3;
                    if (pipe <= 15) { fg = pipe & 7; high = !!(pipe & 8); }
                    else bg = pipe === 16 ? -1 : pipe - 16;
                    continue;
                }
            }
            run += ch; i++;
        }
        flush();
        return out;
    }
    function fmtDate(ms) {
        var d = new Date(ms);
        return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    }
    function relationLabel(rel) {
        if (rel === 'friends') return { label: 'Remove from Friends', action: 'unfriend', cls: 'pp-btn-quiet', text: 'You are friends.' };
        if (rel === 'incoming') return { label: 'Accept Friend Request', action: 'accept', cls: 'pp-btn-primary', text: alias + ' wants to be your friend.' };
        if (rel === 'outgoing') return { label: 'Request Pending (withdraw)', action: 'cancel', cls: 'pp-btn-quiet', text: 'Your friend request is waiting.' };
        return { label: 'Add to Friends', action: 'request', cls: 'pp-btn-primary', text: '' };
    }

    /* toggles */
    root.addEventListener('click', function (e) {
        var t = e.target.closest('.pp-toggle');
        if (!t) return;
        e.preventDefault();
        var el = document.getElementById(t.getAttribute('data-toggle'));
        if (el) { el.classList.toggle('pp-hidden'); if (!el.classList.contains('pp-hidden')) { var f = el.querySelector('textarea,input'); if (f) f.focus(); } }
    });

    /* friend buttons (contact box + request banner) */
    root.addEventListener('click', function (e) {
        var b = e.target.closest('.pp-friend-btn');
        if (!b) return;
        e.preventDefault();
        var target = b.getAttribute('data-user');
        var action = b.getAttribute('data-action');
        b.disabled = true;
        post('friend', { user: target, action: action }).then(function (res) {
            b.disabled = false;
            var status = document.getElementById('pp-friend-status');
            if (!res.ok) { if (status) status.textContent = res.error || res.reason || 'Could not do that'; return; }
            if (b.id === 'pp-friend-main') {
                var next = relationLabel(res.relation);
                b.textContent = next.label;
                b.setAttribute('data-action', next.action);
                b.className = 'pp-btn ' + next.cls + ' pp-friend-btn';
                if (status) status.textContent = res.status === 'requested' ? 'Friend request sent.' : next.text;
            } else {
                var row = b.closest('.pp-request');
                if (row) row.innerHTML = '<b>' + esc(target) + '</b>: ' + (action === 'accept' ? 'you are now friends.' : 'declined.');
            }
        }).catch(function () { b.disabled = false; });
    });

    /* colour toolbar: insert Ctrl-A codes at the cursor; live preview under the box */
    Array.prototype.forEach.call(root.querySelectorAll('form[data-kind]'), function (form) {
        var box = form.querySelector('textarea[name=body]');
        var preview = form.querySelector('.pp-compose-preview');
        function refresh() { if (preview) preview.innerHTML = box.value.length ? pipeHtml(box.value) : ''; }
        box.addEventListener('input', refresh);
        form.addEventListener('click', function (e) {
            var b = e.target.closest('.pp-color-btn');
            if (!b) return;
            e.preventDefault();
            var code = b.getAttribute('data-code');
            var insert = '';
            for (var i = 0; i < code.length; i++) insert += '\x01' + code.charAt(i);
            var start = box.selectionStart || 0, end = box.selectionEnd || start;
            box.value = box.value.substring(0, start) + insert + box.value.substring(end);
            box.selectionStart = box.selectionEnd = start + insert.length;
            box.focus();
            refresh();
        });
    });

    /* wall + update forms */
    Array.prototype.forEach.call(root.querySelectorAll('form[data-kind]'), function (form) {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var body = form.querySelector('textarea[name=body]').value;
            var status = form.querySelector('.pp-form-status');
            post('post', { user: alias, body: body }).then(function (res) {
                if (!res.ok) { status.textContent = res.error || res.reason || 'Could not post'; return; }
                status.textContent = '';
                form.querySelector('textarea[name=body]').value = '';
                var pv = form.querySelector('.pp-compose-preview'); if (pv) pv.innerHTML = '';
                var list = document.getElementById(form.getAttribute('data-kind') === 'wall' ? 'pp-wall' : 'pp-updates');
                var note = list.querySelector('.pp-note');
                if (note) note.remove();
                var p = res.post;
                var div = document.createElement('div');
                div.className = 'pp-post';
                div.setAttribute('data-post-id', p.id);
                div.innerHTML = '<div class="pp-post-head"><a class="pp-post-author" href="./?page=013-profile.xjs&user=' + encodeURIComponent(p.alias) + '">' + esc(p.alias) + '</a>' +
                    '<span class="pp-post-date">' + esc(fmtDate(p.at)) + '</span>' +
                    '<button type="button" class="pp-link-btn pp-post-delete" data-post-id="' + esc(p.id) + '">delete</button></div>' +
                    '<div class="pp-post-body">' + pipeHtml(p.body) + '</div>';
                list.insertBefore(div, list.firstChild);
                if (form.getAttribute('data-kind') === 'wall') form.classList.add('pp-hidden');
            });
        });
    });

    /* delete a post */
    root.addEventListener('click', function (e) {
        var b = e.target.closest('.pp-post-delete');
        if (!b) return;
        e.preventDefault();
        if (!window.confirm('Delete this post?')) return;
        var id = b.getAttribute('data-post-id');
        post('delete-post', { user: alias, id: id }).then(function (res) {
            if (res.ok) { var el = root.querySelector('.pp-post[data-post-id="' + id + '"]'); if (el) el.remove(); }
        });
    });

    /* ---- media data (rendered here, 20 per page, so the page stays light) ---- */
    var MEDIA = {
        tracks: <?xjs write(jsonForScript(mediaTracks)); ?>,
        ansi: <?xjs write(jsonForScript(mediaAnsi)); ?>,
        images: <?xjs write(jsonForScript(mediaImages)); ?>,
        plays: <?xjs write(jsonForScript(allPlays)); ?>,
        icons: <?xjs write(jsonForScript(playIcons)); ?>,
        canModerate: <?xjs write(canModerate ? 'true' : 'false'); ?>
    };
    var PAGE = 20, STRIP = 6;
    function converter() {
        return (window.GraphicsConverter && typeof GraphicsConverter.shared === 'function') ? GraphicsConverter.shared() : null;
    }
    function fmtDate(ms) {
        var d = new Date(ms);
        return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    }
    function fmtSeconds(sec) {
        var m = Math.floor((sec || 0) / 60);
        if (m >= 60) return Math.floor(m / 60) + 'h ' + (m % 60) + 'm';
        return m + 'm';
    }
    function bindSort(container, onChange) {
        Array.prototype.forEach.call(container.querySelectorAll('.pp-sort-btn'), function (btn) {
            btn.addEventListener('click', function () {
                Array.prototype.forEach.call(container.querySelectorAll('.pp-sort-btn'), function (b) { b.classList.toggle('is-active', b === btn); });
                onChange(btn.getAttribute('data-sort'));
            });
        });
    }

    /* ---- "Plays most": sort by time / launches / recent ---- */
    (function () {
        var host = document.getElementById('pp-plays');
        if (!host || !MEDIA.plays.length) return;
        var gc = converter();
        var iconCache = {};
        function drawIcon(el, code) {
            var b64 = MEDIA.icons[code];
            if (iconCache[code]) { var im = new Image(); im.src = iconCache[code]; el.appendChild(im); return; }
            if (!b64 || !gc) { el.innerHTML = '<span class="pp-play-blank"></span>'; return; }
            gc.from_bin(atob(b64), 12, 6, function (dataURL) {
                iconCache[code] = dataURL;
                var img = new Image(); img.src = dataURL; el.innerHTML = ''; el.appendChild(img);
            }, true);
        }
        function render(by) {
            var list = MEDIA.plays.slice().sort(function (a, b) { return (b[by] || 0) - (a[by] || 0); }).slice(0, 8);
            host.innerHTML = '';
            list.forEach(function (p, i) {
                var value = by === 'count' ? p.count + ' launch' + (p.count === 1 ? '' : 'es')
                    : by === 'last' ? (p.last ? fmtDate(p.last) : '-') : fmtSeconds(p.seconds);
                var row = document.createElement('a');
                row.className = 'pp-play-row';
                row.href = './?page=003-games.xjs';
                row.title = p.name;
                row.innerHTML = '<span class="pp-play-rank">' + (i + 1) + '</span><span class="pp-play-icon"></span>' +
                    '<span class="pp-play-name">' + esc(p.name) + '</span><span class="pp-play-count">' + esc(value) + '</span>';
                host.appendChild(row);
                drawIcon(row.querySelector('.pp-play-icon'), String(p.code || '').toUpperCase());
            });
        }
        bindSort(root.querySelector('[data-sort-for="plays"]') || host, render);
        render('seconds');
    })();

    /* ---- mini player: sorted, paged, album art for rows on screen ---- */
    var fallbackAudio = null;
    function radio() { return (window.sbbsRadio && typeof window.sbbsRadio.playByFile === 'function') ? window.sbbsRadio : null; }
    function setPlayerStatus(text) { var el = document.getElementById('pp-player-status'); if (el) el.textContent = text || ''; }
    var artCache = {};
    var artObserver = null;
    function loadArt(el, name, attempt) {
        if (artCache[name] !== undefined) { if (artCache[name]) { el.innerHTML = '<img alt="">'; el.firstChild.src = artCache[name]; } return; }
        /* On a full page load this script runs before ./js/id3parser.js (it
           is included after the content); wait for it rather than caching
           "no art" for whichever rows happened to be on screen first. */
        if (typeof window.parseID3v2 !== 'function') {
            attempt = (attempt || 0) + 1;
            if (attempt <= 20) window.setTimeout(function () { loadArt(el, name, attempt); }, 250);
            return;
        }
        artCache[name] = '';
        fetch('./radio-stream/' + encodeURIComponent(name), { headers: { Range: 'bytes=0-262143' }, credentials: 'same-origin' })
            .then(function (r) { if (!r.ok) throw new Error(r.status); return r.arrayBuffer(); })
            .then(function (buf) {
                var tags = {};
                try { tags = window.parseID3v2(buf) || {}; } catch (_) { tags = {}; }
                if (tags.picture && tags.picture.blob) {
                    artCache[name] = URL.createObjectURL(tags.picture.blob);
                    if (document.body.contains(el)) { el.innerHTML = '<img alt="">'; el.firstChild.src = artCache[name]; }
                }
            }).catch(function () { /* no art: the note stays */ });
    }
    (function () {
        var host = document.getElementById('pp-player');
        var pager = document.getElementById('pp-player-pager');
        if (!host || !MEDIA.tracks.length) return;
        var by = 'plays', page = 0;
        if ('IntersectionObserver' in window) {
            artObserver = new IntersectionObserver(function (entries) {
                entries.forEach(function (en) {
                    if (!en.isIntersecting) return;
                    artObserver.unobserve(en.target);
                    loadArt(en.target, en.target.getAttribute('data-art'));
                });
            }, { root: host, rootMargin: '80px' });
        }
        function sorted() {
            var list = MEDIA.tracks.filter(function (t) { return !t.song; });
            list.sort(function (a, b) {
                if (by === 'name') return a.title.toLowerCase() < b.title.toLowerCase() ? -1 : a.title.toLowerCase() > b.title.toLowerCase() ? 1 : 0;
                if (by === 'added') return (b.added || 0) - (a.added || 0);
                return (b.plays || 0) - (a.plays || 0) || (b.added || 0) - (a.added || 0);
            });
            return list;
        }
        function rowHtml(t, tag) {
            return '<span class="pp-track-art" data-art="' + esc(t.name) + '">&#9835;</span>' +
                '<button type="button" class="pp-track-btn pp-play" data-track="' + esc(t.name) + '" title="Play">&#9654;</button>' +
                '<span class="pp-track-text"><span class="pp-track-title">' + esc(t.title) + '</span>' +
                (t.artist ? '<span class="pp-track-artist">' + esc(t.artist) + '</span>' : '') + '</span>' +
                (tag ? '<span class="pp-track-tag">' + tag + '</span>' : (t.collab ? '<span class="pp-track-tag" title="Fronted this track; ' + esc(t.collabWith) + ' made it">with ' + esc(t.collabWith) + '</span>' : '')) +
                '<span class="pp-track-plays">' + (t.plays || 0) + ' play' + ((t.plays || 0) === 1 ? '' : 's') + '</span>';
        }
        function render() {
            var list = sorted();
            var pages = Math.max(1, Math.ceil(list.length / PAGE));
            page = Math.max(0, Math.min(page, pages - 1));
            host.innerHTML = '';
            MEDIA.tracks.filter(function (t) { return t.song; }).forEach(function (t) {
                var row = document.createElement('div');
                row.className = 'pp-track pp-track-song';
                row.setAttribute('data-track', t.name);
                row.innerHTML = rowHtml(t, 'profile song');
                host.appendChild(row);
            });
            list.slice(page * PAGE, page * PAGE + PAGE).forEach(function (t) {
                var row = document.createElement('div');
                row.className = 'pp-track';
                row.setAttribute('data-track', t.name);
                row.innerHTML = rowHtml(t, '');
                host.appendChild(row);
            });
            Array.prototype.forEach.call(host.querySelectorAll('.pp-track-art'), function (el) {
                if (artObserver) artObserver.observe(el); else loadArt(el, el.getAttribute('data-art'));
            });
            host.scrollTop = 0;
            pager.innerHTML = pages > 1
                ? '<button type="button" data-page="prev"' + (page === 0 ? ' disabled' : '') + '>&lsaquo; prev</button>' +
                  '<span>page ' + (page + 1) + ' of ' + pages + '</span>' +
                  '<button type="button" data-page="next"' + (page >= pages - 1 ? ' disabled' : '') + '>next &rsaquo;</button>'
                : '';
            refreshNowPlaying();
        }
        pager.addEventListener('click', function (e) {
            var b = e.target.closest('button[data-page]');
            if (!b) return;
            page += b.getAttribute('data-page') === 'next' ? 1 : -1;
            render();
        });
        bindSort(root.querySelector('[data-sort-for="tracks"]'), function (key) { by = key; page = 0; render(); });
        render();
    })();
    function refreshNowPlaying() {
        var r = radio();
        var current = r ? r.currentTrackFile : (fallbackAudio && !fallbackAudio.paused ? fallbackAudio.getAttribute('data-track') : '');
        var playing = r ? !!r.isPlaying : !!(fallbackAudio && !fallbackAudio.paused);
        Array.prototype.forEach.call(root.querySelectorAll('.pp-track'), function (row) {
            var mine = playing && row.getAttribute('data-track') === current;
            row.classList.toggle('is-playing', mine);
            var btn = row.querySelector('.pp-track-btn');
            if (btn) btn.innerHTML = mine ? '&#10074;&#10074;' : '&#9654;';
        });
        if (r && playing && current) setPlayerStatus('Now playing: ' + (r.currentTrackTitle || current));
        else if (!playing) setPlayerStatus('');
    }
    root.addEventListener('click', function (e) {
        var b = e.target.closest('.pp-play, .wiki-track-play');
        if (!b) return;
        e.preventDefault();
        var name = b.getAttribute('data-track');
        var r = radio();
        if (r) {
            if (r.currentTrackFile === name && typeof r.togglePlay === 'function') { r.togglePlay(); window.setTimeout(refreshNowPlaying, 200); return; }
            if (r.playByFile(name)) { window.setTimeout(refreshNowPlaying, 300); return; }
            setPlayerStatus('That track is not in the radio library yet; playing it directly.');
        }
        if (!fallbackAudio) { fallbackAudio = document.createElement('audio'); fallbackAudio.controls = true; fallbackAudio.style.width = '100%'; fallbackAudio.addEventListener('play', refreshNowPlaying); fallbackAudio.addEventListener('pause', refreshNowPlaying); }
        if (fallbackAudio.getAttribute('data-track') === name && !fallbackAudio.paused) { fallbackAudio.pause(); return; }
        fallbackAudio.setAttribute('data-track', name);
        fallbackAudio.src = './radio-stream/' + encodeURIComponent(name);
        var host = document.getElementById('pp-player-pager') || b.closest('.pp-box-body');
        if (host && !fallbackAudio.parentNode) host.parentNode.insertBefore(fallbackAudio, host);
        fallbackAudio.play().catch(function () { /* autoplay blocked: the controls are there */ });
    });
    var nowPlayingTimer = window.setInterval(function () {
        if (!document.body.contains(root)) { window.clearInterval(nowPlayingTimer); return; }
        refreshNowPlaying();
    }, 1000);

    /* ---- ANSI thumbnails: cell grid -> PNG, cached per piece ---- */
    var ansiCache = {};
    function renderAnsi(item, done) {
        var key = item.dir + '/' + item.name;
        if (ansiCache[key]) { done(ansiCache[key]); return; }
        var gc = converter();
        if (!gc) { done(null); return; }
        fetch(API + '?call=ansi-bin&dir=' + encodeURIComponent(item.dir) + '&name=' + encodeURIComponent(item.name), { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (!res.ok) { done(null); return; }
                gc.from_bin(atob(res.bin), res.cols, res.rows, function (dataURL) { ansiCache[key] = dataURL; done(dataURL); }, true);
            }).catch(function () { done(null); });
    }
    var drawQueue = [], drawing = false;
    function drawNext() {
        if (drawing || !drawQueue.length) return;
        drawing = true;
        var job = drawQueue.shift();
        renderAnsi(job.item, function (dataURL) {
            if (dataURL && document.body.contains(job.el)) {
                var veil = job.el.querySelector('.pp-nsfw-veil');
                job.el.innerHTML = '<img alt="">'; job.el.firstChild.src = dataURL;
                if (veil) job.el.appendChild(veil);
            }
            else if (job.el.querySelector('.pp-tile-wait')) job.el.querySelector('.pp-tile-wait').textContent = dataURL ? '' : 'n/a';
            drawing = false;
            drawNext();
        });
    }

    /* ---- gallery strips: the first few, then "view all" opens the carousel ---- */
    function buildStrip(kind) {
        var host = document.getElementById('pp-strip-' + kind);
        var items = MEDIA[kind];
        if (!host || !items.length) return;
        items.slice(0, STRIP).forEach(function (item, i) {
            var tile = document.createElement('a');
            tile.href = '#';
            tile.className = 'pp-tile' + (kind === 'ansi' ? ' pp-tile-ansi' : ' pp-tile-image');
            tile.title = item.caption;
            tile.innerHTML = '<span class="pp-tile-art' + (item.nsfw ? ' is-nsfw' : '') + '">' + (kind === 'ansi' ? '<span class="pp-tile-wait">ANSI</span>' : '<img loading="lazy" alt="">') +
                (item.nsfw ? '<span class="pp-nsfw-veil">NSFW<small>click to reveal</small></span>' : '') + '</span>' +
                '<span class="pp-tile-caption">' + esc(item.caption) + '</span>';
            if (kind === 'images') tile.querySelector('img').src = item.src;
            else drawQueue.push({ item: item, el: tile.querySelector('.pp-tile-art') });
            tile.addEventListener('click', function (e) {
                e.preventDefault();
                var art = tile.querySelector('.pp-tile-art');
                if (art.classList.contains('is-nsfw') && !art.classList.contains('is-revealed')) { art.classList.add('is-revealed'); return; }
                openCarousel(kind, i);
            });
            host.appendChild(tile);
        });
        if (items.length > STRIP) {
            var more = document.createElement('a');
            more.href = '#';
            more.className = 'pp-tile pp-tile-more';
            more.innerHTML = '<span class="pp-tile-art">+' + (items.length - STRIP) + ' more</span><span class="pp-tile-caption">view all</span>';
            more.addEventListener('click', function (e) { e.preventDefault(); openCarousel(kind, STRIP); });
            host.appendChild(more);
        }
        drawNext();
    }
    buildStrip('ansi');
    buildStrip('images');
    root.addEventListener('click', function (e) {
        var t = e.target.closest('.pp-open-carousel');
        if (!t) return;
        e.preventDefault();
        openCarousel(t.getAttribute('data-gallery'), 0);
    });

    /* ---- carousel: one piece at a time, arrows / keys, loads as you go ---- */
    var carousel = null;
    function openCarousel(kind, index) {
        closeCarousel();
        var items = MEDIA[kind];
        if (!items || !items.length) return;
        var box = document.createElement('div');
        box.className = 'pp-carousel';
        box.innerHTML = '<div class="pp-carousel-bar"><span class="pp-carousel-title"></span><span>' +
            (MEDIA.canModerate ? '<button type="button" class="pp-carousel-mod" data-act="nsfw"></button> ' : '') +
            '<span class="pp-carousel-count"></span> <button type="button" data-act="close">close &times;</button></span></div>' +
            '<div class="pp-carousel-stage"><button type="button" class="pp-carousel-nav prev" data-act="prev">&lsaquo;</button><div class="pp-carousel-view"></div><button type="button" class="pp-carousel-nav next" data-act="next">&rsaquo;</button></div>' +
            '<div class="pp-carousel-caption"></div>';
        document.body.appendChild(box);
        carousel = { box: box, kind: kind, items: items, index: index };
        box.addEventListener('click', function (ev) {
            var b = ev.target.closest('[data-act]');
            if (b) {
                ev.preventDefault();
                var act = b.getAttribute('data-act');
                if (act === 'close') closeCarousel();
                else if (act === 'nsfw') toggleNsfw();
                else if (act === 'reveal') { var v = box.querySelector('.pp-carousel-view'); if (v) v.classList.add('is-revealed'); }
                else step(act === 'next' ? 1 : -1);
                return;
            }
            if (ev.target === box.querySelector('.pp-carousel-stage')) closeCarousel();
        });
        document.addEventListener('keydown', carouselKeys);
        showCurrent();
    }
    function carouselKeys(ev) {
        if (!carousel) return;
        if (ev.key === 'Escape') closeCarousel();
        else if (ev.key === 'ArrowRight') step(1);
        else if (ev.key === 'ArrowLeft') step(-1);
    }
    function step(delta) {
        if (!carousel) return;
        carousel.index = (carousel.index + delta + carousel.items.length) % carousel.items.length;
        showCurrent();
    }
    function showCurrent() {
        var c = carousel;
        if (!c) return;
        var item = c.items[c.index];
        var view = c.box.querySelector('.pp-carousel-view');
        c.box.querySelector('.pp-carousel-title').textContent = (c.kind === 'ansi' ? 'ANSI Gallery' : 'Pictures') + ' - ' + alias;
        c.box.querySelector('.pp-carousel-count').textContent = (c.index + 1) + ' / ' + c.items.length;
        c.box.querySelector('.pp-carousel-caption').textContent = item.caption + (item.added ? '  (' + fmtDate(item.added * 1000) + ')' : '') + (item.nsfw ? '  [NSFW]' : '');
        view.className = 'pp-carousel-view' + (item.nsfw ? ' is-nsfw' : '');
        var mod = c.box.querySelector('.pp-carousel-mod');
        if (mod) mod.textContent = item.nsfw ? 'Clear NSFW tag' : 'Mark NSFW';
        var veil = item.nsfw ? '<button type="button" class="pp-nsfw-veil pp-nsfw-veil-big" data-act="reveal">NSFW<small>click to reveal</small></button>' : '';
        if (c.kind === 'images') {
            view.innerHTML = '<img class="pp-photo-full" alt="">' + veil;
            view.firstChild.src = item.src;
            return;
        }
        view.innerHTML = '<div class="pp-carousel-wait">loading...</div>';
        var wanted = c.index;
        renderAnsi(item, function (dataURL) {
            if (!carousel || carousel.index !== wanted) return;
            if (dataURL) { view.innerHTML = '<img class="pp-ansi-full" alt="">' + veil; view.firstChild.src = dataURL; }
            else view.innerHTML = '<div class="pp-carousel-wait">could not render this piece</div>';
        });
        /* warm the next one */
        var next = c.items[(c.index + 1) % c.items.length];
        if (next) renderAnsi(next, function () {});
    }
    /* Moderators: flag / clear the piece on screen; the strips follow on reload. */
    function toggleNsfw() {
        var c = carousel;
        if (!c) return;
        var item = c.items[c.index];
        post('nsfw', { dir: item.dir, name: item.name, on: !item.nsfw }).then(function (res) {
            if (!res.ok) { window.alert(res.error || res.reason || 'Could not change the tag'); return; }
            item.nsfw = !!(res.info && res.info.nsfw);
            showCurrent();
        });
    }
    function closeCarousel() {
        if (carousel) { carousel.box.remove(); carousel = null; }
        document.removeEventListener('keydown', carouselKeys);
    }
    document.addEventListener('spa:beforeNavigate', closeCarousel);

    /* ---- Forum Activity: a page of their posts, expand in place, deep link ---- */
    (function () {
        var host = document.getElementById('pp-forum');
        var pager = document.getElementById('pp-forum-pager');
        var countEl = document.getElementById('pp-forum-count');
        if (!host || !pager) return;
        var page = 0, PER = 10, current = null;
        var gc = converter();
        var iconCache = {};
        function forumUrl(item) {
            var url = './?page=002-forum.xjs&sub=' + encodeURIComponent(item.sub);
            return item.threadKey ? url + '&thread=' + encodeURIComponent(item.threadKey) : url;
        }
        function netLabel(item) {
            if (item.netType === 'fidonet') return 'FTN';
            if (item.netType === 'qwknet') return 'QWK';
            if (item.netType === 'internet') return 'NNTP';
            if (item.netType === 'postlink') return 'PostLink';
            return 'local';
        }
        function drawIcon(el, item) {
            if (!item.icon || !gc) { el.classList.add('is-blank'); return; }
            if (iconCache[item.sub]) { var im = new Image(); im.src = iconCache[item.sub]; el.appendChild(im); return; }
            gc.from_bin(atob(item.icon), 12, 6, function (dataURL) {
                iconCache[item.sub] = dataURL;
                var img = new Image(); img.src = dataURL; el.innerHTML = ''; el.appendChild(img);
            }, true);
        }
        function rowHtml(item) {
            var where = esc(item.group ? item.group + ' \u203a ' + item.subName : item.subName);
            return '<span class="pp-forum-icon"></span><div class="pp-forum-main">' +
                '<div class="pp-forum-head"><span class="pp-forum-date">' + esc(fmtDate(item.at)) + '</span>' +
                '<span class="pp-forum-where" title="' + esc(netLabel(item)) + '">' + where + '</span>' +
                '<span class="pp-forum-to">to ' + esc(item.to || 'All') + '</span>' +
                (item.origin ? '<span class="pp-forum-origin">from ' + esc(item.origin) + '</span>' : '') + '</div>' +
                '<div class="pp-forum-subject"><a href="' + esc(forumUrl(item)) + '" class="pp-forum-open-link" data-number="' + item.number + '">' + esc(item.subject || '(no subject)') + '</a>' +
                (item.poll ? ' <span class="pp-meta">(poll)</span>' : '') + '</div>' +
                '<div class="pp-forum-snippet">' + esc(item.snippet || '') + '</div>' +
                '<div class="pp-forum-full" hidden></div>' +
                '<div class="pp-forum-tools"><button type="button" class="pp-forum-expand">Expand</button>' +
                '<a class="pp-forum-open pp-forum-open-link" data-number="' + item.number + '" href="' + esc(forumUrl(item)) + '">Open thread</a></div></div>';
        }
        function render(data) {
            current = data;
            host.innerHTML = '';
            if (countEl) countEl.textContent = '(' + data.total + ')';
            if (!data.items.length) {
                host.innerHTML = '<span class="pp-meta">' + (data.total ? 'Nothing on this page.' : 'No posts yet.') + '</span>';
            }
            data.items.forEach(function (item) {
                var row = document.createElement('div');
                row.className = 'pp-forum-row';
                row.innerHTML = rowHtml(item);
                row.querySelector('.pp-forum-expand').addEventListener('click', function () { toggle(row, item, this); });
                host.appendChild(row);
                drawIcon(row.querySelector('.pp-forum-icon'), item);
            });
            pager.innerHTML = '';
            if (data.pages > 1) {
                var prev = document.createElement('button'); prev.type = 'button'; prev.textContent = '\u2039 newer'; prev.disabled = data.page <= 0;
                var next = document.createElement('button'); next.type = 'button'; next.textContent = 'older \u203a'; next.disabled = data.page >= data.pages - 1;
                var label = document.createElement('span'); label.textContent = 'Page ' + (data.page + 1) + ' of ' + data.pages;
                prev.addEventListener('click', function () { load(page - 1); });
                next.addEventListener('click', function () { load(page + 1); });
                pager.appendChild(prev); pager.appendChild(label); pager.appendChild(next);
            }
        }
        function toggle(row, item, btn) {
            var full = row.querySelector('.pp-forum-full');
            var snippet = row.querySelector('.pp-forum-snippet');
            if (!full.hidden) { full.hidden = true; snippet.hidden = false; btn.textContent = 'Expand'; btn.classList.remove('is-open'); return; }
            btn.disabled = true;
            fetch('./api/social.ssjs?call=forum-post&sub=' + encodeURIComponent(item.sub) + '&number=' + item.number, { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    btn.disabled = false;
                    if (!res.ok || !res.post) { full.innerHTML = '<span class="pp-meta">That post can no longer be read.</span>'; }
                    else if (res.post.html) full.innerHTML = '<div class="message">' + res.post.html + '</div>';
                    else full.innerHTML = '<div class="message">' + esc(res.post.body || '') + '</div>';
                    full.hidden = false; snippet.hidden = true; btn.textContent = 'Collapse'; btn.classList.add('is-open');
                }).catch(function () { btn.disabled = false; });
        }
        function load(next) {
            page = Math.max(0, next);
            host.innerHTML = '<span class="pp-meta">Looking through the message bases...</span>';
            fetch('./api/social.ssjs?call=forum&user=' + encodeURIComponent(alias) + '&page=' + page + '&per=' + PER, { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (!res.ok) { host.innerHTML = '<span class="pp-meta">' + esc(res.error || 'Forum activity is unavailable.') + '</span>'; return; }
                    page = res.forum.page;
                    render(res.forum);
                }).catch(function () { host.innerHTML = '<span class="pp-meta">Forum activity is unavailable.</span>'; });
        }
        /* Deep link: the SPA drops the URL hash, so remember the message and
           highlight it once the thread has rendered (messages load async). */
        host.addEventListener('click', function (e) {
            var a = e.target.closest('a.pp-forum-open-link');
            if (!a) return;
            window.__pendingForumMessage = parseInt(a.getAttribute('data-number'), 10) || 0;
        });
        if (!window.__forumJumpBound) {
            window.__forumJumpBound = true;
            document.addEventListener('spa:afterNavigate', function () {
                var number = window.__pendingForumMessage;
                if (!number) return;
                window.__pendingForumMessage = 0;
                var tries = 0;
                (function look() {
                    var el = document.getElementById('forum-message-' + number);
                    if (el) {
                        Array.prototype.forEach.call(document.querySelectorAll('.forum-message-card.current'), function (c) { c.classList.remove('current'); });
                        el.classList.add('current');
                        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (++tries < 40) window.setTimeout(look, 250);
                })();
            });
        }
        load(0);
    })();

    /* profile editor */
    var edit = document.getElementById('pp-edit-form');
    if (edit) {
        edit.addEventListener('submit', function (e) {
            e.preventDefault();
            var status = document.getElementById('pp-edit-status');
            var featured = [];
            Array.prototype.forEach.call(edit.querySelectorAll('input[name=featured]:checked'), function (cb) { featured.push(parseInt(cb.value, 10)); });
            var patch = {
                headline: edit.headline.value, mood: edit.mood.value, song: edit.song.value,
                wallPolicy: edit.wallPolicy.value, featured: featured.slice(0, 8),
                theme: { preset: edit.preset.value, accent: edit.accent.value, background: edit.background.value, text: edit.text.value, link: edit.link.value }
            };
            post('save-profile', patch).then(function (res) {
                if (!res.ok) { status.textContent = res.error || res.reason || 'Could not save'; return; }
                status.textContent = 'Saved. Reloading...';
                if (window.spaNavigate) window.spaNavigate('./?page=013-profile.xjs&user=' + encodeURIComponent(alias) + '&_=' + Date.now());
                else location.reload();
            });
        });
    }
})();
</script>
<?xjs } ?>
