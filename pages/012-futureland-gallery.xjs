    color: #55FFFF;
    font-size: 0.8em;
    white-space: nowrap;
}
.ahv-file {
    color: #FF55FF;
    font-size: 0.8em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.ahv-toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    flex-wrap: wrap;
    flex: 1 1 460px;
}
.ahv-toolbar-field {
    flex: 1 1 260px;
    min-width: min(100%, 240px);
}
.ahv-toolbar select,
.ahv-toolbar button,
.ahv-nav button {
    background: transparent;
    border: 1px solid #AAAAAA;
    color: #FFFF55;
    font-family: monospace;
    font-size: 14px;
    line-height: 1.1;
    padding: 4px 10px;
    border-radius: 2px;
}
.ahv-toolbar select {
    width: 100%;
    background: #050505;
    color: #FFFFFF;
    border-color: #5555FF;
    padding-right: 28px;
}
.ahv-toolbar button,
.ahv-nav button {
    cursor: pointer;
}
.ahv-toolbar select:focus,
.ahv-toolbar button:focus,
.ahv-nav button:focus {
    outline: none;
    box-shadow: 0 0 0 1px #55FFFF;
}
.ahv-toolbar button:hover:not(:disabled),
.ahv-nav button:hover:not(:disabled) {
    background: #AAAAAA;
    color: #000;
}
.ahv-toolbar select:disabled,
.ahv-toolbar button:disabled,
.ahv-nav button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
}
.ahv-toolbar button.is-active,
.ahv-nav button.is-active {
    border-color: #00AA00;
    color: #55FF55;
}
.ahv-toolbar button.is-active:hover:not(:disabled),
.ahv-nav button.is-active:hover:not(:disabled) {
    background: #00AA00;
    color: #000;
}
.ahv-nav {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
}
.ahv-share {
    border-color: #55FFFF !important;
    color: #55FFFF !important;
}
.ahv-share:hover:not(:disabled) {
    background: #55FFFF !important;
    color: #000 !important;
}
.ahv-panel .card-body {
    background: #000;
    padding: clamp(16px, 2.2vw, 24px);
}
.ahv-stage-wrap {
    border: 1px solid #333333;
    background: #000;
    padding: 0;
    overflow: auto;
    scrollbar-width: none;
    min-height: clamp(360px, 62vh, 980px);
}
.ahv-stage-wrap::-webkit-scrollbar {
    display: none;
}
.ahv-stage-wrap.is-slideshow {
    cursor: pointer;
}
.ahv-stage {
    position: relative;
    margin: 0 auto;
    width: fit-content;
}
.ahv-stage-inner {
    display: inline-block;
    transform-origin: top left;
}
.ahv-stage pre.ahv-ansi-pre {
    margin: 0;
    background: transparent;
    color: #A8A8A8;
    display: inline-block;
    white-space: pre;
}
.ahv-slide-note {
    color: #AAAAAA;
}
.ahv-empty {
    color: #AAAAAA;
    padding: 32px 12px;
    text-align: center;
}
.ahv-status {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 10px;
    font-size: 0.8em;
}
.ahv-status-text {
    color: #55FFFF;
}
.ahv-error {
    color: #FF5555;
}
@media (max-width: 980px) {
    .ahv-title-row {
        align-items: flex-start;
        flex-direction: column;
        gap: 4px;
    }
    .ahv-toolbar {
        width: 100%;
        justify-content: flex-start;
    }
    .ahv-toolbar-field {
        flex-basis: 100%;
    }
}
