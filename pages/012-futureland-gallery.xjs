<!--Futureland Gallery-->
<?xjs
    var ansi_viewer = load({}, settings.web_lib + 'ansi-viewer.js');

    function _galleryQueryValue(name) {
        return (
            typeof http_request.query[name] !== 'undefined' &&
            http_request.query[name].length
        ) ? String(http_request.query[name][0]) : '';
    }

    function _galleryEsc(value) {
        return ansi_viewer.escape_html(value);
    }

    var _gallery_id = _galleryQueryValue('gallery');
    var _gallery_dir = _galleryQueryValue('dir');
    var _gallery_file = _galleryQueryValue('file');
    var _gallery_look = _galleryQueryValue('look');
    var _gallery_slide_scope = _galleryQueryValue('slide_scope');
    var _gallery_slide_order = _galleryQueryValue('slide_order');
    var _gallery_slide_action = _galleryQueryValue('slide_action');
    var _gallery_slideshow = _galleryQueryValue('slideshow') === '1';
    var _gallery_mode = 'random';
    var _gallery_initial_look = _gallery_look;
    var _gallery_state;
    var _gallery_state_client;
    var _gallery_state_json;

    if (!_gallery_initial_look.length) {
        if (_gallery_slide_scope === 'all') {
            _gallery_initial_look = 'all';
        } else if (_gallery_slide_scope === 'gallery') {
            _gallery_initial_look = 'gallery';
        } else if (_gallery_file.length) {
            _gallery_initial_look = 'file';
        } else if (_gallery_dir.length) {
            _gallery_initial_look = 'directory';
        } else {
            _gallery_initial_look = 'all';
        }
    }

    if ((_gallery_initial_look === 'all' || _gallery_initial_look === 'directory') && !_gallery_dir.length) {
        if (
            !_gallery_slide_scope.length ||
            _gallery_slide_scope === 'directory' ||
            _gallery_slide_scope === 'gallery'
        ) {
            _gallery_slide_scope = 'all';
        }
        if (
            !_gallery_slide_action.length &&
            !_gallery_file.length &&
            !_gallery_dir.length
        ) {
            _gallery_slide_action = 'random';
        }
    }

    if (_gallery_file.length) {
        _gallery_mode = 'select';
    } else if (_gallery_id.length || _gallery_dir.length) {
        _gallery_mode = 'first';
    }

    _gallery_state = ansi_viewer.build_state({
        gallery_id: _gallery_id,
        relative_dir: _gallery_dir,
        file_name: _gallery_file,
        mode: _gallery_mode,
        slide_scope: _gallery_slide_scope,
        slide_order: _gallery_slide_order,
        slide_action: _gallery_slide_action,
        slideshow_active: _gallery_slideshow
    });

    _gallery_state_client = {
        ok: _gallery_state.ok,
        galleries: _gallery_state.galleries,
        gallery: _gallery_state.gallery,
        directories: _gallery_state.directories,
        current_dir: _gallery_state.current_dir,
        current_dir_label: _gallery_state.current_dir_label,
        files: _gallery_state.files,
        current_file: _gallery_state.current_file,
        current_file_label: _gallery_state.current_file_label,
        current_index: _gallery_state.current_index,
        current_count: _gallery_state.current_count,
        slide_scope: _gallery_state.slide_scope,
        slide_order: _gallery_state.slide_order,
        slide_index: _gallery_state.slide_index,
        slide_count: _gallery_state.slide_count,
        slide_scope_label: _gallery_state.slide_scope_label,
        slideshow_active: _gallery_state.slideshow_active,
        slide_status_text: _gallery_state.slide_status_text,
        render_html: '',
        error: _gallery_state.error,
        status_text: _gallery_state.status_text
    };

    _gallery_state_json = JSON.stringify(_gallery_state_client).replace(/<\//g, '<\\/');
?>

<style>
.flg-shell {
    max-width: min(1720px, 96vw);
    margin: 0 auto;
    display: grid;
    gap: 18px;
}
.ahv-panel {
    --bs-card-border-color: #AAAAAA;
    --bs-card-bg: #000;
    --bs-card-cap-bg: #000;
    --bs-card-cap-color: #AAAAAA;
    border-color: #AAAAAA !important;
    background: #000 !important;
}
.ahv-panel > .card-header {
    color: #FFFF55 !important;
    background: #000 !important;
    border-bottom: 2px solid #AAAAAA !important;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
}
.ahv-header-copy {
    min-width: 0;
    flex: 1 1 320px;
}
.ahv-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
}
.ahv-title {
    color: #FFFF55;
    font-weight: bold;
}
