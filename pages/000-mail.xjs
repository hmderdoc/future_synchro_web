<!--HIDDEN:Mail-->

<?xjs
    if (user.number == 0 || user.alias == settings.guest) exit();
    load('sbbsdefs.js');
    load(settings.web_lib + 'forum.js');
    var _mail_tab = http_request.query.tab ? http_request.query.tab[0] : 'inbox';
    var _mail = get_mail_headers(_mail_tab, true);
    function _active_tab(tab) {
        return tab == _mail_tab ? 'active' : '';
    }
?>

<? function writeMessage(header) { ?>
	<li id="li-<? write(header.number); ?>" class="list-group-item mail striped <? write(header.attr&MSG_READ ? 'read' : 'unread'); ?>">
		<div class="row">
			<div class="col-sm-1">
				<div class="checkbox">
					<label class="checkbox-inline">
						<input id="check-<? write(header.number); ?>" type="checkbox" class="mail-select">
                        <? write(header.attr&MSG_READ ? '' : '<span class="badge new">' + locale.strings.page_mail.label_new_message + '</span>') ?>
					</label>
				</div>
			</div>
			<div class="col-sm-11" style="cursor:pointer;" onclick="getMailBody(<? write(header.number); ?>)">
                <? write(_mail_tab == 'sent' ? locale.strings.page_mail.label_message_to : locale.strings.page_mail.label_message_from); ?>:
                <strong><? write(_mail_tab == 'sent' ? header.to : header.from); ?></strong>
                <? if (_mail_tab == 'sent' ? header.to_net_type : header.from_net_type) { ?>
                    &lt;<? write(_mail_tab == 'sent' ? header.to_net_addr : header.from_net_addr); ?>&gt;
                <? } ?>
				<? write(locale.strings.page_mail.label_message_date); ?>
				<? write((new Date(header.when_written_time * 1000)).toLocaleString()); ?>
				<p>
					<? write(locale.strings.page_mail.label_message_subject); ?>:
					<strong><? write(header.subject); ?></strong>
				</p>
			</div>
        </div>
		<div class="message" id="message-<? write(header.number); ?>" hidden></div>
	</li>
<? } ?>

<?xjs
    function _unread(tab) {
        if (_mail[tab].unread) write('(<strong>' + _mail[tab].unread + '</strong>)');
    }
?>

<script type="text/javascript" src="./js/forum.js?_v=<? write(time()); ?>"></script>
<script type="text/javascript" src="./js/mail-attach.js?_v=<? write(file_date(settings.web_root + 'js/mail-attach.js')); ?>"></script>

<style>
/* ── Composer attachments (js/mail-attach.js) ── */
.mail-attach { margin: 0 0 10px; }
.mail-attach-drop {
    border: 1px dashed #555555;
    padding: 8px 10px;
    color: #AAAAAA;
    font-size: 0.9em;
}
.mail-attach-label { color: #55FFFF; }
.mail-attach-browse {
    border: 1px solid #555555;
    background: transparent;
    color: #FFFFFF;
    font: inherit;
    padding: 0 6px;
    cursor: pointer;
}
.mail-attach-browse:hover { border-color: #55FFFF; color: #55FFFF; }
.mail-attach-hint { color: #555555; margin-left: 10px; }
.mail-attach-dragover .mail-attach-drop {
    border-color: #55FFFF;
    border-style: solid;
    background: rgba(85, 255, 255, 0.08);
    color: #FFFFFF;
}
.mail-attach-list { list-style: none; margin: 6px 0 0; padding: 0; }
.mail-attach-item {
    border: 1px solid #333333;
    border-left: 3px solid #55FFFF;
    background: #050505;
    padding: 5px 8px;
    margin-bottom: 4px;
    font-size: 0.85em;
}
.mail-attach-item[data-state="done"] { border-left-color: #55FF55; }
.mail-attach-item[data-state="error"] { border-left-color: #FF5555; }
.mail-attach-head { display: flex; align-items: center; gap: 8px; }
.mail-attach-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #AAAAAA;
}
.mail-attach-size { color: #555555; white-space: nowrap; }
.mail-attach-remove {
    border: 1px solid #333333;
    background: transparent;
    color: #AAAAAA;
    cursor: pointer;
    font: inherit;
    line-height: 1;
    padding: 1px 6px;
}
.mail-attach-remove:hover { color: #FFFFFF; border-color: #AAAAAA; }
.mail-attach-bar { height: 3px; background: #1a1a1a; margin-top: 4px; }
.mail-attach-fill { height: 100%; width: 0; background: #55FFFF; transition: width 0.2s linear; }
.mail-attach-item[data-state="done"] .mail-attach-fill { background: #55FF55; }
.mail-attach-item[data-state="error"] .mail-attach-fill { background: #FF5555; }
.mail-attach-msg:empty { display: none; }
.mail-attach-msg, .mail-attach-error { color: #FF5555; margin-top: 4px; }
</style>

<script type="text/javascript">

    function selectAllMail() {
        document.querySelectorAll('input.mail-select').forEach(function (cb) {
            cb.checked = !cb.checked;
        });
    }

    async function deleteSelectedMail() {
        var numbers = [];
        document.querySelectorAll('input.mail-select:checked').forEach(function (cb) {
            numbers.push(cb.id.split('-')[1]);
        });
        if (!numbers.length) return;
        var data = await v4_get('./api/forum.ssjs?call=delete-mail&number=' + numbers.join('&number='));
        if (!data.success) return;
        numbers.forEach(function (e) {
            var el = document.getElementById('li-' + e);
            if (el) el.remove();
        });
    }

</script>

<? if (typeof http_request.query.notice != "undefined") { ?>
    <div id="noticebox" class="alert alert-warning">
        <? write(http_request.query.notice[0]); ?>
    </div>
    <script type="text/javascript">
        (function () {
            var box = document.getElementById('noticebox');
            if (!box) return;
            setTimeout(function () {
                box.style.transition = 'opacity 1s';
                box.style.opacity = '0';
                setTimeout(function () { box.remove(); }, 1000);
            }, 3000);
        })();
    </script>
<? } ?>

<? if (!(user.security.restrictions&UFLAG_E) && !(user.security.restrictions&UFLAG_M)) { ?>
	<button class="btn btn-default icon" aria-label="<? write(locale.strings.page_mail.button_post_new); ?>" title="<? write(locale.strings.page_mail.button_post_new); ?>" onclick="addNew('mail')">
		<span class="bin-icon" data-icon="doc_edit"></span>
	</button>
	<button class="btn btn-default icon" aria-label="<? write(locale.strings.page_mail.button_select_all); ?>" title="<? write(locale.strings.page_mail.button_select_all); ?>" onclick="selectAllMail()">
		<span class="bin-icon" data-icon="checkmark"></span>
	</button>
	<button class="btn btn-default icon" aria-label="<? write(locale.strings.page_mail.button_delete_selected); ?>" title="<? write(locale.strings.page_mail.button_delete_selected); ?>" onclick="deleteSelectedMail()">
		<span class="bin-icon" data-icon="trash"></span>
	</button>
<? } ?>

<ul class="nav nav-tabs">
	<li role="presentation" class="<? write(_active_tab('inbox')); ?>">
		<a href="./?page=<? write(page); ?>&amp;tab=inbox">
			<? write(locale.strings.page_mail.label_tab_inbox); ?>
            <? _unread('inbox'); ?>
		</a>
	</li>
    <li role="presentation" class="<? write(_active_tab('spam')); ?>">
		<a href="./?page=<? write(page); ?>&amp;tab=spam">
			Spam
            <? _unread('spam'); ?>
		</a>
	</li>
	<li role="presentation" class="<? write(_active_tab('sent')); ?>">
		<a href="./?page=<? write(page); ?>&amp;tab=sent">
			<? write(locale.strings.page_mail.label_tab_sent); ?>
		</a>
	</li>
</ul>
<br>

<ul id="forum-list-container" class="list-group">
    <? _mail.headers.forEach(writeMessage); ?>
</ul>
<script type="text/javascript">
    (function () {
        /* Person menu > Email / Netmail lands here with the recipient chosen
           (window.__pendingCompose = { to, subject }, set just before the
           SPA navigated): open the composer and fill it in. */
        var pending = window.__pendingCompose || null;
        window.__pendingCompose = null;
        try {
            var raw = window.sessionStorage.getItem('fl.__pendingCompose');
            if (raw !== null) window.sessionStorage.removeItem('fl.__pendingCompose');
            if (!pending && raw) { var parsed = JSON.parse(raw); if (parsed && parsed.value && Date.now() - (parsed.at || 0) < 60000) pending = parsed.value; }
        } catch (_e) { }
        if (!pending || typeof pending !== 'object' || typeof addNew !== 'function') return;
        addNew('mail');
        var to = document.getElementById('newmessage-to');
        var subject = document.getElementById('newmessage-subject');
        if (to && pending.to) to.value = pending.to;
        if (subject && pending.subject) subject.value = pending.subject;
        try { (to && pending.to ? subject || to : to).focus({ preventScroll: true }); } catch (_f) { }
        /* The composer sits under the whole mail list and the SPA scrolls
           to the top once the page is in (then refreshes the sidebar), so
           one scrollIntoView at insert time lands wherever the layout was
           at that instant. Bring it into view again as things settle. */
        function reveal() {
            var box = document.getElementById('newmessage');
            if (box) box.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        reveal();
        [300, 900, 1800].forEach(function (ms) { window.setTimeout(reveal, ms); });
        window.addEventListener('spa:afterNavigate', function once() {
            window.removeEventListener('spa:afterNavigate', once);
            window.setTimeout(reveal, 50);
        });
    })();
</script>
