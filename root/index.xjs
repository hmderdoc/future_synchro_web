<div class="container<? if (settings.layout_full_width) write('-fluid'); ?> spa-container">
    <div class="row">
<?xjs if (!_sidebarOff() && settings.layout_sidebar_left) { ?>
        <div class="col-md-3" id="sidebar"><? writeSidebarModules(); ?></div>
<?xjs } ?>
        <div class="col-md-<? write(_sidebarOff() ? '12' : '9'); ?>" id="content">
            <? writePage(page); ?>
        </div>
<?xjs if (!_sidebarOff() && !settings.layout_sidebar_left) { ?>
        <div class="col-md-3" id="sidebar"><? writeSidebarModules(); ?></div>
<?xjs } ?>
    </div>
</div>

<!-- Config passed to client JS -->
<script>
    window.sbbsConfig = {
        systemName: '<? write(system.name.replace(/'/g, "\\'")); ?>',
        guest: '<? write(settings.guest); ?>',
        userAlias: '<? write(user.alias.replace(/'/g, "\\'")); ?>',
        userNumber: <? write(user.number); ?>,
        userPassword: '<? write((user.alias !== settings.guest && user.number > 0) ? user.security.password.replace(/'/g, "\\'" ) : ''); ?>',
        isLoggedIn: <? write(user.alias !== settings.guest && user.number > 0); ?>,
        isSysop: <? write(user.is_sysop ? true : false); ?>,
        csrfToken: '<? write(getCsrfToken()); ?>',
        sidebarOff: <? write(_sidebarOff()); ?>,
        sidebarLeft: <? write(settings.layout_sidebar_left ? true : false); ?>,
        fullWidth: <? write(settings.layout_full_width ? true : false); ?>,
        ftelnet: <? write(settings.ftelnet ? true : false); ?>,
<?xjs if (settings.ftelnet) { ?>
        ftelnetUrl: '<? write(ftelnet_url); ?>',
        ftelnetSplash: '<? write(ftelnet_splash); ?>',
        hostname: '<? write(http_request.vhost); ?>',
        wsp: <? write(wsp); ?>,
        wssp: <? write(wssp); ?>,
        telnetPort: <? write(system.telnet_port || 23); ?>,
        rloginPort: <? write(settings.rlogin_port || 1513); ?>,
<?xjs } ?>
        mqttEnabled: <? write(broker_enabled); ?>,
<?xjs if (broker_enabled && broker_addr && broker_ws_port && broker_wss_port) { ?>
        mqttQwkId: '<? write(system.qwk_id); ?>',
        mqttAddr: '<? write(broker_addr); ?>',
        mqttUser: '<? write(broker_username); ?>',
        mqttPass: '<? write(broker_password); ?>',
        mqttWsPort: <? write(broker_ws_port); ?>,
        mqttWssPort: <? write(broker_wss_port); ?>,
<?xjs } ?>
        currentPage: '<? write(page); ?>',
        avatarsEnabled: true,
        darkmodeAllow: <? write(settings.darkmode_allow ? true : false); ?>,
        darkmodeOn: <? write(settings.darkmode_on ? true : false); ?>,
        webBuildLabel: '<? write(build_info.label.replace(/'/g, "\\'")); ?>',
        webBuildToken: '<? write(build_info.token); ?>'
    };
</script>

<!-- Scripts -->
<?xjs if (settings.ftelnet) { ?>
<script src="./js/flweb.js?_v=<? write(time()); ?>"></script>
<script src="./js/terminal.js?_v=<? write(time()); ?>"></script>
<?xjs } ?>
<?xjs if (broker_enabled && broker_addr && broker_ws_port && broker_wss_port) { ?>
<script src="https://unpkg.com/mqtt@5.0.2/dist/mqtt.min.js"></script>
<script src="./js/mqtt.js?_v=<? write(time()); ?>"></script>
<?xjs } ?>
<script src="./js/spa.js?_v=<? write(time()); ?>"></script>
<script src="./js/radio.js?_v=<? write(time()); ?>"></script>
<script src="./lib/butterchurn.min.js"></script>
<script src="./lib/butterchurnPresets.min.js"></script>
<script src="./js/id3parser.js?_v=<? write(time()); ?>"></script>
<script src="./js/visualizer.js?_v=<? write(time()); ?>"></script>
<div id="chat-toasts"></div>

<!-- PWA Service Worker -->
<script>
if ('serviceWorker' in navigator) {
    var _swRefreshing = false;
    navigator.serviceWorker.addEventListener('controllerchange', function () {
        if (_swRefreshing) return;
        _swRefreshing = true;
        window.location.reload();
    });
    window.addEventListener('load', function () {
        navigator.serviceWorker.register('./sw.ssjs', { updateViaCache: 'none' }).then(function (reg) {
            console.log('[SW] registered, scope:', reg.scope);

            // Check for updates immediately, then every 60 seconds.
            // iOS Safari only checks for SW updates on navigation —
            // this ensures the PWA detects updates even if left open.
            reg.update().catch(function () {});
            setInterval(function () {
                reg.update().catch(function () {});
            }, 60 * 1000);

            // When a new SW is waiting, show an update banner
            function promptUpdate(worker) {
                if (!worker) return;
                // If user already dismissed, skip (sessionStorage flag)
                if (sessionStorage.getItem('sw-update-dismissed')) return;
                var banner = document.createElement('div');
                banner.id = 'sw-update-banner';
                banner.style.cssText =
                    'position:fixed;bottom:0;left:0;right:0;z-index:99999;' +
                    'background:rgba(10,10,20,0.97);border-top:2px solid #0ff;' +
                    'padding:12px 16px;display:flex;align-items:center;' +
                    'justify-content:space-between;gap:12px;font-family:monospace;' +
                    'color:#0ff;font-size:13px;';
                banner.innerHTML =
                    '<span>Update available — tap to refresh</span>' +
                    '<div style="display:flex;gap:8px">' +
                    '<button id="sw-update-btn" style="background:#0ff;color:#000;' +
                    'border:none;border-radius:4px;padding:6px 16px;font-weight:bold;' +
                    'font-family:monospace;cursor:pointer">Update</button>' +
                    '<button id="sw-dismiss-btn" style="background:transparent;' +
                    'color:#0ff;border:1px solid #0ff;border-radius:4px;padding:6px 12px;' +
                    'font-family:monospace;cursor:pointer">Later</button></div>';
                document.body.appendChild(banner);
                document.getElementById('sw-update-btn').addEventListener('click', function () {
                    worker.postMessage({ type: 'SKIP_WAITING' });
                    banner.remove();
                });
                document.getElementById('sw-dismiss-btn').addEventListener('click', function () {
                    banner.remove();
                    sessionStorage.setItem('sw-update-dismissed', '1');
                });
            }

            if (reg.waiting) {
                promptUpdate(reg.waiting);
            }
            reg.addEventListener('updatefound', function () {
                var newWorker = reg.installing;
                if (!newWorker) return;
                newWorker.addEventListener('statechange', function () {
                    if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                        promptUpdate(newWorker);
                    }
                });
            });
        }).catch(function (err) {
            console.log('[SW] registration failed:', err);
        });
    });
}
</script>
</body>
</html>
