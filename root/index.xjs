<?xjs
    var page = typeof http_request.query.page == 'undefined'
        ? '000-home.xjs' : http_request.query.page[0];
    if (page.search(/^http(s)*:\/\//) > -1) exit();

    var settings = load('modopts.js', 'web') || { web_directory: web_root_dir + '/..' };
    load(settings.web_directory + '/lib/init.js');
    load(settings.web_lib + 'auth.js');
    load(settings.web_lib + 'pages.js');
    load(settings.web_lib + 'sidebar.js');

    /* Redirect .link pages */
    if (page.search(/\.link$/) > -1) {
        var loc = getExternalLink(page);
        http_reply.status = '301 Moved Permanently';
        http_reply.header['Location'] = loc;
        exit();
    }

    var pagePath = getPagePath(page);
    if (pagePath == null) {
        page = '000-home.xjs';
        pagePath = getPagePath('000-home.xjs');
    }
    var page_ctrl = getCtrlLine(pagePath);

    /* fTelnet config */
    if (settings.ftelnet) {
        load(settings.web_lib + 'ftelnet.js');
        load('ftelnethelper.js');
        var ftelnet_url = get_url();
        var ftelnet_splash = get_splash();
        var wsp = settings.wsp || GetWebSocketServicePort();
        var wssp = settings.wssp || GetWebSocketServicePort(true);
    }

    /* MQTT config */
    var broker_enabled = false;
    var broker_password = '';
    var broker_username = '';
    var broker_addr = settings.mqtt_hostname || '';
    var broker_ws_port = settings.mqtt_ws_port || 0;
    var broker_wss_port = settings.mqtt_wss_port || 0;
    var f = new File(system.ctrl_dir + 'main.ini');
    if (f.open('r')) {
        try {
            broker_enabled = f.iniGetValue('MQTT', 'Enabled', false);
            broker_password = f.iniGetValue('MQTT', 'Password', '');
            broker_username = f.iniGetValue('MQTT', 'Username', '');
        } finally { f.close(); }
    }

    function computeBuildInfo() {
        var rootDir = backslash(web_root_dir);
        var buildFiles = [
            rootDir + 'index.xjs',
            rootDir + 'sw.ssjs',
            rootDir + 'terminal-iframe.html',
            rootDir + 'js/mobile-input.js',
            rootDir + 'js/terminal.js',
            rootDir + 'js/spa.js',
            rootDir + 'css/spa.css',
            rootDir + 'css/style.css'
        ];
        var latest = 0;
        var manifest = [];

        buildFiles.forEach(function (filePath) {
            var stamp;
            if (!file_exists(filePath)) return;
            stamp = file_date(filePath);
            latest = Math.max(latest, stamp);
            manifest.push(
                filePath.replace(rootDir, '') + ':' +
                file_size(filePath) + ':' + stamp
            );
        });

        return {
            label: latest ? strftime('%Y-%m-%d %H:%M', latest) : 'unknown',
            token: manifest.length
                ? md5_calc(manifest.join('\n'), true).substr(0, 8)
                : 'unknown'
        };
    }

    var build_info = computeBuildInfo();

    /* Build page list for nav */
    var nav_pages = getPageList();
    /* Pages to move into "More" dropdown */
    /* Pages to move into "More" dropdown */
    var more_nav_names = [
        'futureland-records',
        'futureland-gallery',
        'nodespy',
        'webmonitor'
    ];

    /* Pages hidden from nav entirely (accessed via other UI) */
    pullNavPage(nav_pages, 'newsflip');

    /* Pages hidden from nav entirely (accessed via other UI) */
    pullNavPage(nav_pages, 'newsflip');

    function pullNavPage(list, name) {
        var idx = list.findIndex(function (item) {
            return item.name === name;
        });
        if (idx < 0) return null;
        return list.splice(idx, 1)[0];
    }

    var more_nav_pages = more_nav_names.reduce(function (items, name) {
        var page = pullNavPage(nav_pages, name);
        if (page) items.push(page);
        return items;
    }, []);

    if (more_nav_pages.length) {
        nav_pages.push({
            file: '999-more',
            name: 'more',
            title: 'More',
            type: 'list',
            list: more_nav_pages,
            path_prefix: ''
        });
    }

    /* Sidebar HTML (captured for initial load) */
    function _sidebarOff() {
        return settings.layout_sidebar_off || page_ctrl.options.no_sidebar;
    }
?>
<?xjs
    /* Nav menu helpers */
    function navHref(e, path) {
        return './?page=' + ((path || '') + e.page);
    }

    function navIcon(e) {
        return e.icon || e.name || '';
    }

    function navItem(e, path) {
        if (e.type == 'list') {
            navDropdown(e, path);
        } else if (e.type == 'link') {
?>
    <li class="nav-item">
        <a class="nav-link" href="<? write(navHref(e, path)); ?>" target="_blank"><span class="bin-icon" data-icon="<? write(navIcon(e)); ?>"></span><span class="nav-label"><? write(e.title); ?></span></a>
    </li>
<?xjs
        } else {
?>
    <li class="nav-item">
        <a class="nav-link<? if (e.name === 'chat') write(' nav-link-chat'); ?>" href="<? write(navHref(e, path)); ?>"<?xjs if (e.name === 'chat') { ?> id="nav-link-chat"<?xjs } ?>><span class="bin-icon" data-icon="<? write(navIcon(e)); ?>"></span><span class="nav-label"><? write(e.title); ?></span><?xjs if (e.name === 'chat') { ?><span class="badge bg-danger" id="badge-chat-unread" style="display:none;"></span><?xjs } ?></a>
    </li>
<?xjs
        }
    }

    function navDropdownItem(e, path) {
        var target_attr = e.type == 'link' ? ' target="_blank"' : '';
        if (e.type == 'list') {
?>
            <li><h6 class="dropdown-header"><? write(e.title.replace(/^.*\-/, '')); ?></h6></li>
<?xjs
            e.list.forEach(function (child) {
                navDropdownItem(child, (path || '') + e.file + '/');
            });
            return;
        }
?>
            <li>
                <a class="dropdown-item" href="<? write(navHref(e, path)); ?>"<? write(target_attr); ?>>
                    <span class="bin-icon" data-icon="<? write(navIcon(e)); ?>"></span><span class="nav-label"><? write(e.title); ?></span>
                </a>
            </li>
<?xjs
    }

    function navDropdown(obj, path) {
        var child_path = (typeof obj.path_prefix === 'string')
            ? obj.path_prefix
            : ((path || '') + obj.file + '/');
?>
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="bin-icon" data-icon="<? write(navIcon(obj)); ?>"></span><span class="nav-label"><? write(obj.title.replace(/^.*\-/, '')); ?></span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
<?xjs obj.list.forEach(function(e) { navDropdownItem(e, child_path); }); ?>
        </ul>
    </li>
<?xjs
    }
?>
