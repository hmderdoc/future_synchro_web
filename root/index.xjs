<!-- BIN icon data (server-side encoded) -->
<?xjs
    var _binIconDir = system.mods_dir;
    if (_binIconDir && _binIconDir.slice(-1) !== '/' && _binIconDir.slice(-1) !== '\\') _binIconDir += '/';
    _binIconDir += 'future_shell/assets/';
    var _binIconMap = {
        home: 'home2', forum: 'forum_lda', files: 'floppy_disk_icon_final',
        games: 'games', chat: 'json_chat_lda', terminal: 'monitor',
        register: 'edit', mail: 'mailbox', logout: 'exit',
        bar_chart: 'bar_chart', calendar: 'calendar',
        doc_edit: 'doc_edit', gear: 'gear', chat_new: 'chat_new', users: 'smiley',
        search: 'search', trash: 'trash_can', pencil: 'hand_pencil_icon',
        thumbs_up: 'thumbs_up', thumbs_down: 'thumbs_down',
        comment: 'chat_new', checkmark: 'checkmark', stop: 'stop_sign_icon',
        link: 'WALLETLINK', poll: 'bar_chart', group: 'group',
        oneliners: 'oneliner', nodespy: 'sbbslist', webmonitor: 'bar_chart',
        fire: 'fire', sysinfo: 'sysinfo', irc: 'irc', userlist: 'smiley',
        heart: 'heart_normal',
        at_symbol: 'at_symbol',
        news: 'newsitems',
        more: 'group',
        'futureland-records': 'headphones',
        'futureland-gallery': 'art_gallery',
        newsflip: 'rssfeed',
        music_note: 'music_note'
    };
    var _binIconData = {};
    for (var _bk in _binIconMap) {
        var _bp = _binIconDir + _binIconMap[_bk] + '.bin';
        try {
            if (file_exists(_bp)) {
                var _bf = new File(_bp);
                if (_bf.open('rb')) { _binIconData[_bk] = base64_encode(_bf.read()); _bf.close(); }
            }
        } catch(e) {}
    }
?>
<script>window.sbbsBinIcons = <? write(JSON.stringify(_binIconData)); ?>;</script>
</head>
