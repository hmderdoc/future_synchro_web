<style>
.wo-panel {
    --bs-card-border-color: #00AA00;
    --bs-card-bg: #000;
    --bs-card-cap-bg: #000;
    --bs-card-cap-color: #55FF55;
    border-color: #00AA00 !important;
}
.wo-panel > .card-header {
    color: #55FF55 !important;
    background: #000 !important;
    border-bottom: 2px solid #00AA00 !important;
    font-weight: bold;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.wo-panel .wo-count { font-size: 0.8em; font-weight: normal; color: #00AA00; }
/* One row per person: a badge counts their nodes and the activity cell
   cycles through what each node is doing. */
.wo-panel .nl-nodes {
    font-size: 0.7em;
    line-height: 1.3;
    padding: 0 4px;
    border-radius: 2px;
    background: #00AA00;
    color: #000;
    font-weight: bold;
    flex-shrink: 0;
}
.wo-panel .nl-where { color: #00AA00; margin-right: 3px; }
.wo-panel .table { margin: 0; --bs-table-bg: transparent; }
.wo-panel .table td {
    border-color: rgba(0,170,0,0.2) !important;
    vertical-align: middle;
}
.wo-panel .table thead th {
    background: #00AA00 !important;
    color: #000 !important;
    border-color: #00AA00 !important;
    font-weight: bold;
}
.wo-panel .nl-user-cell {
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 4px;
}
.wo-panel .nl-user-cell .avatar-inline { flex-shrink: 0; }
.wo-panel .nl-username { color: #55FF55; overflow: hidden; text-overflow: ellipsis; }
.wo-panel .nl-activity {
    font-size: 0.8em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 0;
}
</style>
<div class="card wo-panel">
    <div class="card-header"><span>Who's Online</span><span class="wo-count" id="wo-online-count"></span></div>
    <div class="card-body p-0" id="sbbs-nodelist">
        <table class="table table-sm" style="table-layout:fixed;">
            <colgroup><col style="width:50%;"><col style="width:50%;"></colgroup>
            <thead><tr><th>User</th><th>Activity</th></tr></thead>
            <tbody id="sbbs-nodelist-body">
                <tr><td colspan="2" style="color:#55FF55;">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>
<script type="text/javascript">
    var nll = <? write(system.node_list.length); ?>;
    var niu = 0;
    function _activityColor(str) {
        var pool = [
            '#00AA00','#55FF55','#00AAAA','#55FFFF',
            '#0000AA','#5555FF','#AA00AA','#FF55FF',
            '#AA5500','#FFFF55','#FFFFFF','#AAAAAA'
        ];
        var h = 0;
        var s = (str || '').toLowerCase().replace(/\s*\(.*\)\s*$/, '').replace(/\[.*\]$/, '').trim();
        for (var i = 0; i < s.length; i++) {
            h = ((h << 5) - h + s.charCodeAt(i)) | 0;
        }
        return pool[Math.abs(h) % pool.length];
    }
    /* Where a node entry is: 'N3' for a terminal node, 'Web' for a website session. */
    function _nodeLabel(c) {
        if (typeof c.node === 'number') return 'N' + c.node;
        return c.connection === 'Web' || c.node === 'W' ? 'Web' : String(c.node || '');
    }
    var _nlGroups = [];
    var _nlTick = 0;
    /* The activity cell of everyone on more than one node: show the next node's. */
    function _cycleActivities() {
        _nlTick++;
        _nlGroups.forEach(function (g) {
            if (g.entries.length < 2 || !g.cell) return;
            _paintActivity(g.cell, g.entries[_nlTick % g.entries.length], true);
        });
    }
    function _paintActivity(td, e, showWhere) {
        var actText = e.action || e.status || '';
        td.innerHTML = '';
        if (showWhere) {
            var where = document.createElement('span');
            where.className = 'nl-where';
            where.textContent = _nodeLabel(e) + ':';
            td.appendChild(where);
        }
        td.appendChild(document.createTextNode(actText));
        td.title = (showWhere ? _nodeLabel(e) + ': ' : '') + actText;
        td.style.color = _activityColor(actText);
    }
    function _render_nodelist(data) {
        var tbody = document.getElementById('sbbs-nodelist-body');
        if (!tbody) return;
        tbody.innerHTML = '';
        niu = 0;
        var count = 0;
        var avatarUsers = [];
        /* One row per person: the same account on several nodes (telnet +
           web, two browsers, two terminals) is grouped, keeping every node's
           activity for the cycling cell. */
        var groups = [];
        var byKey = {};
        data.forEach(function (c) {
            if (!c.user) return;
            if (typeof c.node === 'number') niu++;
            var key = c.useron ? 'u' + c.useron : 'n' + String(c.user).toLowerCase();
            if (!byKey[key]) { byKey[key] = { user: c.user, useron: c.useron, entries: [], cell: null }; groups.push(byKey[key]); }
            byKey[key].entries.push(c);
        });
        _nlGroups = groups;
        groups.forEach(function (g) {
            var c = g.entries[0];
            var tr = document.createElement('tr');
            var tdUser = document.createElement('td');
            var userWrap = document.createElement('div');
            userWrap.className = 'nl-user-cell';
            if (c.useron) {
                var avatar = document.createElement('div');
                avatar.setAttribute('data-avatar', String(c.useron));
                avatar.className = 'avatar-inline';
                userWrap.appendChild(avatar);
                if (avatarUsers.indexOf(c.useron) < 0) avatarUsers.push(c.useron);
            }
            var nameSpan = document.createElement('span');
            nameSpan.className = 'nl-username';
            nameSpan.textContent = c.user;
            userWrap.appendChild(nameSpan);
            if (g.entries.length > 1) {
                var badge = document.createElement('span');
                badge.className = 'nl-nodes';
                badge.textContent = 'x' + g.entries.length;
                badge.title = 'On ' + g.entries.length + ' nodes: ' + g.entries.map(_nodeLabel).join(', ');
                userWrap.appendChild(badge);
            }
            if (c.user) {
                /* The person menu (profile, PM, telegram, ignore...) for the
                   whole cell; the avatar itself already opens it site-wide,
                   so only the name part needs a handler here. */
                userWrap.title = c.user;
                userWrap.style.cursor = 'pointer';
                userWrap.addEventListener('click', (function (u, n) {
                    return function (ev) {
                        if (ev.target.closest('[data-avatar]') || !window.PersonMenu) return;
                        PersonMenu.open({ name: n ? String(n) : u, network: 'local', x: ev.clientX, y: ev.clientY });
                    };
                })(c.user, c.useron));
            }
            tdUser.appendChild(userWrap);
            var tdActivity = document.createElement('td');
            tdActivity.className = 'nl-activity';
            g.cell = tdActivity;
            _paintActivity(tdActivity, g.entries.length > 1 ? g.entries[_nlTick % g.entries.length] : c, g.entries.length > 1);
            tr.appendChild(tdUser);
            tr.appendChild(tdActivity);
            tbody.appendChild(tr);
            count++;
        });
        var countEl = document.getElementById('wo-online-count');
        if (countEl) countEl.textContent = count ? String(count) : '';
        if (count === 0) {
            var tr = document.createElement('tr');
            var td = document.createElement('td');
            td.setAttribute('colspan', '2');
            td.style.color = '#00AA00';
            td.textContent = 'No users online';
            tr.appendChild(td);
            tbody.appendChild(tr);
        }
        if (avatarUsers.length && typeof Avatars !== 'undefined' && Avatars.draw) {
            Avatars.draw(avatarUsers);
        }
        var sidebarEl = document.getElementById('sidebar');
        if (sidebarEl) {
            sidebarEl.querySelectorAll('.sb-nodes-in-use').forEach(function (el) { el.textContent = niu; });
            sidebarEl.querySelectorAll('.sb-nodes-available').forEach(function (el) { el.textContent = nll - niu; });
        }
    }
    function _sb_nodelist(evt) {
        _render_nodelist(JSON.parse(evt.data));
    }
    function _load_nodelist_snapshot() {
        if (typeof v4_get !== 'function') return;
        v4_get('./api/system.ssjs?call=node-list').then(function (data) {
            if (!Array.isArray(data)) return;
            _render_nodelist(data);
        }).catch(function (err) {
            console.error("Who's Online snapshot error:", err);
        });
    }
    registerEventListener('nodelist', _sb_nodelist);
    _load_nodelist_snapshot();
    if (!window.__nlCycleTimer) window.__nlCycleTimer = setInterval(_cycleActivities, 3000);
</script>
