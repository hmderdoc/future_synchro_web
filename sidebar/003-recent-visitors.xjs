<?xjs
    var logonlist_lib = load({}, 'logonlist_lib.js');
    var options = load("modopts.js", "logonlist") || {};
    if (options.last_few_callers === undefined) options.last_few_callers = 10;
    var ll = logonlist_lib.get(-options.last_few_callers);
    if (!Array.isArray(ll)) ll = [];
    ll.reverse();
    var avatarNumbers = [];
?>

<style>
.rv-panel {
    --bs-card-border-color: #AA0000;
    --bs-card-bg: #000;
    --bs-card-cap-bg: #000;
    --bs-card-cap-color: #FF5555;
    border-color: #AA0000 !important;
}
.rv-panel > .card-header {
    color: #FF5555 !important;
    background: #000 !important;
    border-bottom: 2px solid #FFFF55 !important;
    font-weight: bold;
}
.rv-row { display: flex; align-items: center; gap: 6px; padding: 5px 8px; }
.rv-row + .rv-row { border-top: 1px solid rgba(170,0,0,0.25); }
.rv-row .avatar-inline { flex-shrink: 0; }
.rv-details { flex: 1; min-width: 0; overflow: hidden; }
.rv-alias { color: #FF5555; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rv-when { color: #FFFF55; font-size: 0.78em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rv-loc { color: #FFFFFF; font-size: 0.75em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rv-conn { color: #AAAAAA; font-size: 0.75em; }
</style>

<div class="card rv-panel">
    <div class="card-header">Recent Visitors</div>
    <div class="card-body p-0">
<?xjs
    if (ll.length === 0) {
?>
        <div class="p-2" style="color:#AA0000;">No recent visitors</div>
<?xjs
    }
    ll.forEach(function (e) {
        var un = (e.user && e.user.number) ? e.user.number : 0;
        if (un > 0 && avatarNumbers.indexOf(un) < 0) avatarNumbers.push(un);
        var alias = e.user ? e.user.alias.replace(/</g, '&lt;') : 'Unknown';
        var loc = e.user && e.user.location ? e.user.location.replace(/</g, '&lt;') : '';
        var conn = e.user ? (e.user.connection || e.protocol || '') : '';
        var when = system.timestr(e.time);
?>
        <div class="rv-row">
<?xjs if (un > 0) { ?>
            <div data-avatar="<?xjs write(un); ?>" class="avatar-inline"></div>
<?xjs } ?>
            <div class="rv-details">
                <div class="rv-alias"><?xjs write(alias); ?></div>
                <div class="rv-when"><?xjs write(when); ?></div>
<?xjs if (loc || conn) { ?>
                <div><?xjs if (loc) { ?><span class="rv-loc"><?xjs write(loc); ?></span><?xjs } if (loc && conn) { ?> <span class="rv-conn">&middot;</span> <?xjs } if (conn) { ?><span class="rv-conn"><?xjs write(conn); ?></span><?xjs } ?></div>
<?xjs } ?>
            </div>
        </div>
<?xjs
    });
?>
    </div>
</div>

<?xjs if (avatarNumbers.length > 0) { ?>
<script type="text/javascript">
    (function () {
        var nums = [<?xjs write(avatarNumbers.join(',')); ?>];
        if (typeof Avatars !== 'undefined' && Avatars.draw) {
            Avatars.draw(nums);
        } else {
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof Avatars !== 'undefined' && Avatars.draw) Avatars.draw(nums);
            });
        }
    })();
</script>
<?xjs } ?>
